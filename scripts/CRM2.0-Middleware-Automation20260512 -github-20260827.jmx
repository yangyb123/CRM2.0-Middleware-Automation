        <stringProp name="TestPlan.comments">按CSV数据行数循环；shujuku=1时读取整份CSV聚合所有MT4/MT5登录号后DB/API对比，shujuku=0时按当前CSV行做CSV/API对比。CSV变量名从表头读取，支持手动增删校验字段。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="custom_account_metrics_stat_loop">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;custom_account_metrics_stat_ex_check.csv&apos;); int result = 0; if (f.exists()) { def lines = f.readLines(&apos;UTF-8&apos;); boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = line.indexOf(44); String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == 65279) { first = first.drop(1) }; first = first.trim(); if (first == &apos;1&apos;) { hasDb = true } else if (first == &apos;0&apos;) { csvCount++ } } }; result = csvCount + (hasDb ? 1 : 0) }; result)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="11-2自定义统计聚合(SUM、AVG、MINMAX等)，支持可选分组-数据库校验事务" enabled="true">
