          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="交易大赛V1历史生命周期-DB/API与字段缺失配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="competition_history_db_api_manual_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_manual_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动追加DB/API对比字段名；英文逗号、分号或换行分隔，例如rate_profit。默认V1字段始终对比；如需排除字段，请填写到disabled_compare_fields，未配置跳过的默认字段和手动追加字段全部参与对比。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API及自行计算/API无条件跳过字段；支持默认字段、手动追加字段、接口字段名或calc_*字段名；英文逗号、分号或换行分隔，*表示全部。不填写则所有字段继续对比。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_missing_field_skip_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_missing_field_skip_fields</stringProp>
                <stringProp name="Argument.value">notional_calculation_version,notional_calculation_version,position_lifecycle_id,open_notional_value_usd,close_notional_value_usd,notional_status,notional_method,notional_calculation_version</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">这些字段属于中间件生命周期/名义价值投影，原始 MT4/MT5 报表库没有对应列；接口字段本身仍做必返、类型、枚举和语义校验。移除字段后，数据库无此字段将判失败。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,open_price=0.01,close_price=0.01,calc_open_notional_value_usd=5,calc_close_notional_value_usd=5</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动字段百分比误差，格式字段名=百分比；例如rate_profit=20。以DB或自行计算期望值为基准计算abs(API-期望值)/abs(期望值)*100%，不大于配置百分比通过，大于配置百分比失败。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_api_field_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_field_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">volume_lots=0.00000001,open_price=0.00001,close_price=0.00001,profit=0.01,open_time_ms=1000,close_time_ms=1000,calc_open_notional_value_usd=0.00001,calc_close_notional_value_usd=0.00001</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动字段绝对误差，格式字段名=数值；最终允许差值=max(绝对误差,abs(DB或自行计算期望值)*百分比/100)。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_api_default_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_default_tolerance_percent</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_api_default_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_api_default_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_history_allow_partial_errors" elementType="Argument">
                <stringProp name="Argument.name">competition_history_allow_partial_errors</stringProp>
                <stringProp name="Argument.value">false</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">false 时 HTTP 200 中 errors 非空仍判失败；无论是否允许，errors[] 每个字段都会校验。</stringProp>
              </elementProp>
              <elementProp name="competition_history_db_unmatched_row_policy" elementType="Argument">
                <stringProp name="Argument.name">competition_history_db_unmatched_row_policy</stringProp>
                <stringProp name="Argument.value">fail</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">默认fail：无cursor的完整结果集中，数据库正常查询到但接口未返回的记录列入失败明细；仅排查接口分页时才可临时改为skip。存在cursor时始终只校验当前页，API行找不到唯一DB行在任何策略下都失败。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">volume_lots=0.00000001,open_price=0.00001,close_price=0.00001,profit=0.01,open_time_ms=1000,close_time_ms=1000</stringProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="交易大赛V1历史生命周期-CSV/API配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="competition_history_csv_api_manual_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_manual_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动追加CSV/API对比字段名；英文逗号、分号或换行分隔，例如rate_profit。默认V1字段始终对比；如需排除字段，请填写到disabled_compare_fields，未配置跳过的默认字段和手动追加字段全部参与对比。</stringProp>
              </elementProp>
              <elementProp name="competition_history_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API无条件跳过字段；支持默认字段和手动追加字段，英文逗号、分号或换行分隔，*表示全部。不填写则所有字段继续对比。CSV单元格留空表示不设置期望值；填写&lt;empty&gt;或&lt;null&gt;才断言为空。</stringProp>
              </elementProp>
              <elementProp name="competition_history_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,open_price=0.01,close_price=0.01</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动字段百分比误差，格式字段名=百分比；例如rate_profit=20。以CSV期望值为基准计算abs(API-CSV)/abs(CSV)*100%，不大于配置百分比通过，大于配置百分比失败。</stringProp>
              </elementProp>
              <elementProp name="competition_history_csv_api_field_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_field_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">volume_lots=0.00000001,open_price=0.00001,close_price=0.00001,profit=0.01,open_time_ms=1000,close_time_ms=1000</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">手动字段绝对误差，格式字段名=数值；最终允许差值=max(绝对误差,abs(CSV期望值)*百分比/100)。</stringProp>
              </elementProp>
              <elementProp name="competition_history_csv_api_default_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_default_tolerance_percent</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_history_csv_api_default_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_history_csv_api_default_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化交易大赛V1历史生命周期参数、请求Body和数据库SQL" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;交易大赛-批量查询已经完全关闭的持仓生命周期.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;CSV文件不存在: &apos; + csvFile.getPath())
List&lt;String&gt; rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim() }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List&lt;String&gt; values = []
    StringBuilder cell = new StringBuilder()
    boolean quoted = false
    for (int i = 0; i &lt; line.length(); i++) {
        char ch = line.charAt(i)
        if (ch == (&apos;&quot;&apos; as char)) {
            if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) { cell.append(&apos;&quot;&apos;); i++ }
            else quoted = !quoted
        } else if (ch == (&apos;,&apos; as char) &amp;&amp; !quoted) { values &lt;&lt; cell.toString(); cell.setLength(0) }
        else cell.append(ch)
    }
    values &lt;&lt; cell.toString()
    values
}

List&lt;String&gt; headers = parseCsvLine(rawLines[0]).collect { String.valueOf(it).trim() }
if (headers &amp;&amp; headers[0].startsWith(&apos;\uFEFF&apos;)) headers[0] = headers[0].substring(1)
List&lt;Map&gt; csvRows = []
rawLines.drop(1).eachWithIndex { String line, int idx -&gt;
    List&lt;String&gt; values = parseCsvLine(line)
    Map row = new LinkedHashMap()
    headers.eachWithIndex { String h, int c -&gt; row[h] = c &lt; values.size() ? values[c].trim() : &apos;&apos; }
    row.__line_no = idx + 2
    if (String.valueOf(row.shujuku ?: &apos;&apos;).trim() in [&apos;0&apos;, &apos;1&apos;]) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;CSV没有有效数据：shujuku 必须为 1(DB/API) 或 0(CSV/API)&apos;)

List&lt;Map&gt; dbRows = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;1&apos; }
List&lt;Map&gt; csvRows0 = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;0&apos; }
List&lt;Map&gt; runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, rows: dbRows, row: dbRows[0]]
csvRows0.each { Map row -&gt; runCases &lt;&lt; [mode: &apos;CSV&apos;, rows: [row], row: row] }
int caseIndex
try { caseIndex = Integer.parseInt(vars.get(&apos;competition_history_case_index&apos;) ?: &apos;0&apos;) } catch (ignored) { caseIndex = 0 }
if (caseIndex &lt; 0 || caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;CSV执行索引越界: &apos; + caseIndex + &apos;/&apos; + runCases.size())
Map runCase = runCases[caseIndex]
Map currentRow = runCase.row as Map
vars.put(&apos;competition_history_case_index&apos;, String.valueOf(caseIndex + 1))

def textOf = { Object v -&gt; v == null ? &apos;&apos; : String.valueOf(v).trim() }
def positiveInt = { Object raw, int defaultValue, int maxValue, String field -&gt;
    String s = textOf(raw); int n = s ? Integer.parseInt(s) : defaultValue
    if (n &lt; 1 || n &gt; maxValue) throw new AssertionError(field + &apos; 超出范围[1,&apos; + maxValue + &apos;]: &apos; + n)
    n
}
def nonNegativeLong = { Object raw, long defaultValue, String field -&gt;
    String s = textOf(raw)
    BigInteger n = s ? new BigInteger(s) : BigInteger.valueOf(defaultValue)
    if (n &lt; BigInteger.ZERO || n &gt; new BigInteger(&apos;9223372036854775807&apos;)) throw new AssertionError(field + &apos; 必须是非负int64: &apos; + s)
    n.longValue()
}
def inferPlatform = { Map row, String instanceId -&gt;
    String p = textOf(row.platform).toLowerCase()
    if (p in [&apos;mt4&apos;, &apos;mt5&apos;]) return p
    String upper = instanceId.toUpperCase()
    upper.contains(&apos;MT4&apos;) ? &apos;mt4&apos; : (upper.contains(&apos;MT5&apos;) ? &apos;mt5&apos; : &apos;&apos;)
}

long fromTime = nonNegativeLong(currentRow.from_time_ms, 0L, &apos;from_time_ms&apos;)
long toTime = nonNegativeLong(currentRow.to_time_ms, 0L, &apos;to_time_ms&apos;)
if (fromTime &gt; 0L &amp;&amp; toTime &gt; 0L &amp;&amp; fromTime &gt; toTime) throw new AssertionError(&apos;from_time_ms 不能大于 to_time_ms&apos;)
int limit = positiveInt(currentRow.limit, 1000, 10000, &apos;limit&apos;)
String cursorText = textOf(currentRow.cursor)
Object cursor = (!cursorText || cursorText.equalsIgnoreCase(&apos;null&apos;) || cursorText == &apos;&lt;empty&gt;&apos;) ? null : cursorText

if (runCase.mode == &apos;DB&apos;) {
    (runCase.rows as List&lt;Map&gt;).each { Map row -&gt;
        long f = nonNegativeLong(row.from_time_ms, 0L, &apos;from_time_ms&apos;)
        long t = nonNegativeLong(row.to_time_ms, 0L, &apos;to_time_ms&apos;)
        int l = positiveInt(row.limit, 1000, 10000, &apos;limit&apos;)
        String c = textOf(row.cursor)
        c = (!c || c.equalsIgnoreCase(&apos;null&apos;) || c == &apos;&lt;empty&gt;&apos;) ? &apos;&apos; : c
        if (f != fromTime || t != toTime || l != limit || c != (cursor == null ? &apos;&apos; : String.valueOf(cursor))) throw new AssertionError(&apos;DB模式所有行必须使用相同的时间范围、limit和cursor；差异位于CSV第&apos; + row.__line_no + &apos;行&apos;)
    }
}

List&lt;Map&gt; accounts = []
Set&lt;String&gt; seen = new LinkedHashSet&lt;String&gt;()
(runCase.rows as List&lt;Map&gt;).each { Map row -&gt;
    String instanceId = textOf(row.instanceid ?: row.instance_id)
    String loginText = textOf(row.login)
    if (!instanceId) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 instanceid 不能为空&apos;)
    if (!(loginText ==~ /^\d+$/)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 必须为正int64数字: &apos; + loginText)
    BigInteger loginBig = new BigInteger(loginText)
    if (loginBig &lt;= BigInteger.ZERO || loginBig &gt; new BigInteger(&apos;9223372036854775807&apos;)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 超出范围: &apos; + loginText)
    String key = instanceId + &apos;|&apos; + loginText
    if (seen.add(key)) accounts &lt;&lt; [instance_id: instanceId, login: loginBig.longValue(), platform: inferPlatform(row, instanceId), __line_no: row.__line_no]
}
if (!accounts) throw new AssertionError(&apos;没有可用 accounts&apos;)
List&lt;Map&gt; requestAccounts = accounts.collect { [instance_id: it.instance_id, login: it.login] }
Map request = [accounts: requestAccounts, from_time_ms: fromTime, to_time_ms: toTime, limit: limit, cursor: cursor]
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(request))

int dbMaxRows = positiveInt(currentRow.db_result_max_rows, 50000, 50000, &apos;db_result_max_rows&apos;)
def sqlQuote = { Object raw -&gt; &quot;&apos;&quot; + textOf(raw).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot; }
def instanceCase = { String loginExpr, Map&lt;String,String&gt; loginInstance -&gt;
    String cases = loginInstance.collect { String login, String instance -&gt; &apos;WHEN &apos; + login + &apos; THEN &apos; + sqlQuote(instance) }.join(&apos; &apos;)
    &apos;CASE &apos; + loginExpr + &apos; &apos; + cases + &quot; ELSE &apos;&lt;unknown-instance&gt;&apos; END&quot;
}

List&lt;String&gt; sqlParts = []
if (runCase.mode == &apos;DB&apos;) {
    Map&lt;String,String&gt; mt4Map = new LinkedHashMap&lt;String,String&gt;()
    Map&lt;String,String&gt; mt5Map = new LinkedHashMap&lt;String,String&gt;()
    accounts.each { Map account -&gt;
        if (!(account.platform in [&apos;mt4&apos;, &apos;mt5&apos;])) throw new AssertionError(&apos;DB模式无法识别平台，请填写 platform=mt4/mt5: &apos; + account.instance_id + &apos;:&apos; + account.login)
        Map&lt;String,String&gt; target = account.platform == &apos;mt4&apos; ? mt4Map : mt5Map
        String loginKey = String.valueOf(account.login)
        if (target.containsKey(loginKey) &amp;&amp; target[loginKey] != account.instance_id) throw new AssertionError(&apos;同一平台相同login映射到多个instance，数据库无法消歧: &apos; + loginKey)
        target[loginKey] = String.valueOf(account.instance_id)
    }
    // 时间边界先转换成SQL常量，再直接比较原始时间列，避免在WHERE中包裹TIMESTAMPDIFF而阻断索引范围扫描。
    def sqlUtcDateTime = { long ms -&gt; &quot;TIMESTAMPADD(MICROSECOND, &quot; + ((ms % 1000L) * 1000L) + &quot;, TIMESTAMPADD(SECOND, &quot; + (ms / 1000L) + &quot;, TIMESTAMP(&apos;1970-01-01 00:00:00&apos;)))&quot; }
    String fromSqlDateTime = fromTime &gt; 0L ? sqlUtcDateTime(fromTime) : null
    String toSqlDateTime = toTime &gt; 0L ? sqlUtcDateTime(toTime) : null
    String mt4CloseMs = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.CLOSE_TIME) / 1000 AS UNSIGNED)&quot;
    String mt4OpenMs = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
    if (mt4Map) {
        String loginSql = mt4Map.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;mt.LOGIN&apos;, mt4Map)
        List&lt;String&gt; where = [&apos;mt.LOGIN IN (&apos; + loginSql + &apos;)&apos;, &apos;mt.TICKET &gt; 0&apos;, &apos;mt.CMD IN (0,1)&apos;, &quot;mt.SYMBOL IS NOT NULL&quot;, &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;, &apos;mt.VOLUME &gt; 0&apos;, &apos;mt.CLOSE_TIME IS NOT NULL&apos;, &quot;mt.CLOSE_TIME &gt; &apos;1970-01-02 00:00:00&apos;&quot;, &apos;mt.CLOSE_TIME &gt;= mt.OPEN_TIME&apos;]
        if (fromSqlDateTime) where &lt;&lt; &apos;mt.CLOSE_TIME &gt;= &apos; + fromSqlDateTime
        if (toSqlDateTime) where &lt;&lt; &apos;mt.CLOSE_TIME &lt;= &apos; + toSqlDateTime
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt4&apos; AS platform,
  CONCAT(CAST(mt.LOGIN AS CHAR), &apos;:&apos;, mt.SYMBOL, &apos;:&apos;, CAST(mt.TICKET AS CHAR)) AS position_id,
  mt.TICKET AS order_id,
  mt.LOGIN AS login,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE &apos;&apos; END AS side,
  mt.SYMBOL AS symbol,
  CAST(NULL AS CHAR) AS symbol_id,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS open_price,
  mt.CLOSE_PRICE AS close_price,
  ${mt4OpenMs} AS open_time_ms,
  ${mt4CloseMs} AS close_time_ms,
  mt.PROFIT AS profit,
  UPPER(TRIM(NULLIF(u.CURRENCY, &apos;&apos;))) AS account_currency,
  CAST(NULL AS DECIMAL(65,8)) AS contract_size,
  CAST(NULL AS CHAR) AS currency_profit
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE ${where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()
    }
    if (mt5Map) {
        String loginSql = mt5Map.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;d.Login&apos;, mt5Map)
        String eventMs = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, d.TimeMsc) / 1000 AS UNSIGNED)&quot;
        String volume = &apos;(CASE WHEN d.VolumeExt &gt; 0 THEN d.VolumeExt / 100000000.0 ELSE d.Volume / 10000.0 END)&apos;
        String closedVolume = &apos;(CASE WHEN d.VolumeClosedExt &gt; 0 THEN d.VolumeClosedExt / 100000000.0 WHEN d.VolumeClosed &gt; 0 THEN d.VolumeClosed / 10000.0 ELSE &apos; + volume + &apos; END)&apos;
        String openAction = &quot;CAST(NULLIF(SUBSTRING_INDEX(GROUP_CONCAT(CASE WHEN d.Entry = 0 THEN d.Action END ORDER BY d.TimeMsc ASC, d.Deal ASC), &apos;,&apos;, 1), &apos;&apos;) AS SIGNED)&quot;
        String closeAction = &quot;CAST(NULLIF(SUBSTRING_INDEX(GROUP_CONCAT(CASE WHEN d.Entry IN (1,2,3) THEN d.Action END ORDER BY d.TimeMsc ASC, d.Deal ASC), &apos;,&apos;, 1), &apos;&apos;) AS SIGNED)&quot;
        String openOrder = &quot;CAST(NULLIF(SUBSTRING_INDEX(GROUP_CONCAT(CASE WHEN d.Entry = 0 THEN d.`Order` END ORDER BY d.TimeMsc ASC, d.Deal ASC), &apos;,&apos;, 1), &apos;&apos;) AS UNSIGNED)&quot;
        String closeMs = &apos;MAX(CASE WHEN d.Entry IN (1,2,3) THEN &apos; + eventMs + &apos; END)&apos;
        List&lt;String&gt; having = [closeMs + &apos; IS NOT NULL&apos;, &apos;SUM(CASE WHEN d.Entry IN (1,2,3) THEN &apos; + closedVolume + &apos; ELSE 0 END) &gt; 0&apos;]
        if (fromTime &gt; 0L) having &lt;&lt; closeMs + &apos; &gt;= &apos; + fromTime
        if (toTime &gt; 0L) having &lt;&lt; closeMs + &apos; &lt;= &apos; + toTime
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt5&apos; AS platform,
  CONCAT(CAST(d.Login AS CHAR), &apos;:&apos;, d.Symbol, &apos;:&apos;, CAST(d.PositionID AS CHAR)) AS position_id,
  ${openOrder} AS order_id,
  d.Login AS login,
  CASE COALESCE(${openAction}, CASE ${closeAction} WHEN 0 THEN 1 WHEN 1 THEN 0 ELSE NULL END) WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE &apos;&apos; END AS side,
  d.Symbol AS symbol,
  CAST(NULL AS CHAR) AS symbol_id,
  SUM(CASE WHEN d.Entry IN (1,2,3) THEN ${closedVolume} ELSE 0 END) AS volume_lots,
  SUM(CASE WHEN d.Entry = 0 THEN d.Price * ${volume} ELSE 0 END) / NULLIF(SUM(CASE WHEN d.Entry = 0 THEN ${volume} ELSE 0 END), 0) AS open_price,
  SUM(CASE WHEN d.Entry IN (1,2,3) THEN d.Price * ${closedVolume} ELSE 0 END) / NULLIF(SUM(CASE WHEN d.Entry IN (1,2,3) THEN ${closedVolume} ELSE 0 END), 0) AS close_price,
  MIN(CASE WHEN d.Entry = 0 THEN ${eventMs} END) AS open_time_ms,
  ${closeMs} AS close_time_ms,
  SUM(CASE WHEN d.Entry IN (1,2,3) THEN d.Profit ELSE 0 END) AS profit,
  MAX(UPPER(TRIM(NULLIF(curr.Currency, &apos;&apos;)))) AS account_currency,
  MAX(CASE WHEN d.ContractSize &gt; 0 THEN d.ContractSize END) AS contract_size,
  MAX(UPPER(TRIM(NULLIF(sym.CurrencyProfit, &apos;&apos;)))) AS currency_profit
FROM mt5_report.mt5_deals d
LEFT JOIN (
  SELECT d1.Login, MAX(NULLIF(TRIM(d1.Currency), &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${loginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) curr ON curr.Login = d.Login
LEFT JOIN (
  SELECT Symbol, MAX(NULLIF(TRIM(CurrencyProfit), &apos;&apos;)) AS CurrencyProfit
  FROM mt5_report.mt5_symbols
  GROUP BY Symbol
) sym ON sym.Symbol = d.Symbol
 WHERE d.Login IN (${loginSql})
   AND d.PositionID &gt; 0
  AND d.Action IN (0,1)
  AND d.Entry IN (0,1,2,3)
  AND d.Symbol IS NOT NULL
  AND TRIM(d.Symbol) &lt;&gt; &apos;&apos;
  AND (d.VolumeExt &gt; 0 OR d.Volume &gt; 0 OR d.VolumeClosedExt &gt; 0 OR d.VolumeClosed &gt; 0)
  AND NOT EXISTS (SELECT 1 FROM mt5_report.mt5_positions p WHERE p.Login = d.Login AND p.Position = d.PositionID)
GROUP BY d.Login, d.PositionID, d.Symbol
HAVING ${having.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()
    }
}
String detailSql = sqlParts ? (&apos;SELECT * FROM (&apos; + sqlParts.join(&apos; UNION ALL &apos;) + &apos;) competition_history ORDER BY close_time_ms DESC, instance_id ASC, login ASC, position_id ASC LIMIT &apos; + dbMaxRows) : &quot;SELECT &apos;&apos; AS instance_id, &apos;&apos; AS platform, &apos;&apos; AS position_id, NULL AS order_id, NULL AS login, &apos;&apos; AS side, &apos;&apos; AS symbol, CAST(NULL AS CHAR) AS symbol_id, NULL AS volume_lots, NULL AS open_price, NULL AS close_price, NULL AS open_time_ms, NULL AS close_time_ms, NULL AS profit, CAST(NULL AS CHAR) AS account_currency, CAST(NULL AS DECIMAL(65,8)) AS contract_size, CAST(NULL AS CHAR) AS currency_profit WHERE 1=0&quot;

vars.put(&apos;competition_history_mode&apos;, String.valueOf(runCase.mode))
vars.put(&apos;competition_history_shujuku&apos;, runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;)
vars.put(&apos;competition_history_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;competition_history_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;competition_history_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;competition_history_request_body&apos;, requestBody)
vars.put(&apos;competition_history_detail_sql&apos;, detailSql.replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim())
vars.put(&apos;competition_history_from_time_ms&apos;, String.valueOf(fromTime))
vars.put(&apos;competition_history_to_time_ms&apos;, String.valueOf(toTime))
vars.put(&apos;competition_history_limit&apos;, String.valueOf(limit))
vars.put(&apos;competition_history_cursor&apos;, cursor == null ? &apos;&apos; : String.valueOf(cursor))
vars.putObject(&apos;competition_history_current_csv_row&apos;, currentRow)
vars.putObject(&apos;competition_history_request_accounts&apos;, requestAccounts)
vars.putObject(&apos;db_competition_history_rows&apos;, [])

String report = &apos;交易大赛V1历史生命周期初始化成功 | mode=&apos; + runCase.mode + &apos; | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | accounts=&apos; + requestAccounts.collect { it.instance_id + &apos;:&apos; + it.login }.join(&apos;,&apos;) + &apos; | close_time范围=[&apos; + fromTime + &apos;,&apos; + toTime + &apos;] | limit=&apos; + limit + &apos; | cursor=&apos; + (cursor == null ? &apos;&lt;empty&gt;&apos; : cursor)
log.info(report + &apos;\nrequestBody=&apos; + requestBody + (runCase.mode == &apos;DB&apos; ? &apos;\nDB SQL=&apos; + detailSql : &apos;&apos;))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
