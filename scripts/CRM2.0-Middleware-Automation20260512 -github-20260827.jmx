            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="全量数据断言" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// 预期数据（写死）
def expected = [
    [address: &quot;18.171.245.143:443&quot;,    instanceid: &quot;MT5_1_TS1&quot;, server_type: &quot;live&quot;],
    [address: &quot;43.198.103.117:443&quot;,   instanceid: &quot;MT4_1&quot;,     server_type: &quot;live&quot;],
    [address: &quot;35.178.24.153:443&quot;,    instanceid: &quot;MT4_3&quot;,     server_type: &quot;demo&quot;],
    [address: &quot;43.198.103.117:1950&quot;,  instanceid: &quot;MT5_1&quot;,     server_type: &quot;live&quot;],
    [address: &quot;35.178.24.153:443&quot;,  instanceid: &quot;MT4_2&quot;,     server_type: &quot;live&quot;],
    [address: &quot;18.162.227.129:1950&quot;,  instanceid: &quot;MT5_1_TS2&quot;, server_type: &quot;live&quot;]
]

def actual = json.data

def failures = []

// 数量检查
if (actual.size() != expected.size()) {
    failures &lt;&lt; &quot;数据条数不一致：预期=${expected.size()}，实际=${actual.size()}&quot;
}

// 逐条比对（按instanceid匹配）
expected.each { exp -&gt;
    def found = actual.find { it?.instanceid == exp.instanceid }
    if (!found) {
        failures &lt;&lt; &quot;缺少 instanceid=[${exp.instanceid}]&quot;
    } else {
        if (found.address != exp.address) {
            failures &lt;&lt; &quot;instanceid=[${exp.instanceid}] address不一致：预期=[${exp.address}]，实际=[${found.address}]&quot;
        }
        if (found.server_type != exp.server_type) {
            failures &lt;&lt; &quot;instanceid=[${exp.instanceid}] server_type不一致：预期=[${exp.server_type}]，实际=[${found.server_type}]&quot;
        }
    }
}

// 检查多余的instanceid
def expectedIds = expected*.instanceid.toSet()
def extraIds = actual.collect { it?.instanceid }.findAll { it &amp;&amp; !expectedIds.contains(it) }
if (extraIds) {
    failures &lt;&lt; &quot;多余的 instanceid：${extraIds}&quot;
}

if (failures.isEmpty()) {
    prev.setResponseMessage(&quot;get_mt_server_info 全量数据断言通过（${actual.size()}条）&quot;)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;get_mt_server_info 断言失败，共 ${failures.size()} 处不一致：\n&quot; + failures.join(&quot;\n&quot;))
    prev.setSuccessful(false)
}
</stringProp>
