                <stringProp name="Argument.value">margin_free,margin_level,metrics_degraded,metrics_updated_utc_ms,profit,currency,margin,position_count,balance,equity</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制CSV/API对比的跳过字段，多个字段用逗号分隔；例如填写 volume_current 后CSV/API不校验该字段。</stringProp>
