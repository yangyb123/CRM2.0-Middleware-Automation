              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.io.BufferedReader

// ===== 读取CSV文件，统计数据行数（跳过表头） =====
def csvPath = &quot;./充值提现modify_balance.csv&quot;
def lineCount = 0

try {
    def reader = new BufferedReader(new java.io.FileReader(csvPath))
    def headerSkipped = false
    def line
    while ((line = reader.readLine()) != null) {
        if (!line.trim().isEmpty()) {
            if (!headerSkipped) {
                headerSkipped = true
                continue
            }
            lineCount++
        }
    }
    reader.close()
} catch (Exception e) {
    log.error(&quot;&gt;&gt;&gt; 读取CSV文件失败: &quot; + e.message)
    lineCount = 0
}

// 初始化循环计数器和总行数
vars.put(&quot;csv_loop_idx&quot;, &quot;0&quot;)
vars.put(&quot;csv_total_rows&quot;, String.valueOf(lineCount))

log.info(&quot;&gt;&gt;&gt; 充值提现CSV数据行数: &quot; + lineCount + &quot; 行&quot;)</stringProp>
            </JSR223Sampler>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="计算CSV数据行数-充值提现" enabled="false">
