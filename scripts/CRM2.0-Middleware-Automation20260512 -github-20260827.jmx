        <stringProp name="TestPlan.comments">仅修改本线程组。按“交易大赛-批量查询账户的余额、净值、信用额、保证金和账户币种等资金信息.csv”执行：shujuku=1 聚合全部数据库模式账号，一次请求 /v1/accounts/query 并逐字段进行 DB/API 校验；shujuku=0 按当前 CSV 行进行 CSV/API 校验。响应字段、类型、币种与 money_scale 语义依据 mt-hub-openapi 7.html（1.0.1-beta1.60.3）。严格区分数据库字段不存在与字段值为空。LoopController使用字符码44解析CSV首列，避免JMeter把Groovy代码中的逗号误判为__groovy函数参数分隔符。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="交易大赛V1账户资金CSV循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;交易大赛-批量查询账户的余额、净值、信用额、保证金和账户币种等资金信息.csv&apos;); if (!f.exists()) return 0; def lines = f.readLines(&apos;UTF-8&apos;); if (lines.size() &lt;= 1) return 0; boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = -1; for (int j = 0; j &lt; line.length(); j++) { if ((int)line.charAt(j) == 44) { p = j; break } }; String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == (65279 as char)) first = first.drop(1); first = first.trim(); if (first.length() &gt;= 2 &amp;&amp; first.charAt(0) == (&apos;&quot;&apos; as char) &amp;&amp; first.charAt(first.length() - 1) == (&apos;&quot;&apos; as char)) first = first.drop(1).take(first.length() - 2).trim(); if (first == &apos;1&apos;) hasDb = true; else if (first == &apos;0&apos;) csvCount++ } }; return csvCount + (hasDb ? 1 : 0))}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
