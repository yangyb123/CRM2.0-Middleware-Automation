          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="打印最终profit提取、求和与equity差值比较结果" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String extractionReport = vars.get(&apos;history_positions_profit_report&apos;) ?: &apos;未生成history_positions_profit_report，请检查list_history_positions是否请求成功&apos;
String compareReport = vars.get(&apos;user_info_profit_compare_report&apos;) ?: &apos;未生成user_info_profit_compare_report，请检查比较断言是否执行&apos;
String status = vars.get(&apos;user_info_profit_compare_status&apos;) ?: &apos;FAIL&apos;
List&lt;String&gt; output = []
output &lt;&lt; &apos;计算get_user_info-profit数值 最终打印结果 | status=&apos; + status
output &lt;&lt; &apos;equityAA=&apos; + (vars.get(&apos;equityAA&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos; | equityBB=&apos; + (vars.get(&apos;equityBB&apos;) ?: &apos;&lt;empty&gt;&apos;)
output &lt;&lt; &apos;cale_user_info_profit=&apos; + (vars.get(&apos;cale_user_info_profit&apos;) ?: &apos;&lt;empty&gt;&apos;)
output &lt;&lt; &apos;history_positions_profit=&apos; + (vars.get(&apos;history_positions_profit&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos; | history_positions_profit_count=&apos; + (vars.get(&apos;history_positions_profit_count&apos;) ?: &apos;&lt;empty&gt;&apos;)
output &lt;&lt; &apos;最终公式: (equityBB - equityAA) == SUM(list_history_positions.data.items[].profit)&apos;
output &lt;&lt; &apos;实际代入: (&apos; + (vars.get(&apos;equityBB&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos; - &apos; + (vars.get(&apos;equityAA&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos;) = &apos; + (vars.get(&apos;cale_user_info_profit&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos; ; SUM(&apos; + (vars.get(&apos;history_positions_profit_values&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos;) = &apos; + (vars.get(&apos;history_positions_profit&apos;) ?: &apos;&lt;empty&gt;&apos;)
output &lt;&lt; &apos;close_time_from_utc_ms=&apos; + (vars.get(&apos;close_time_from_utc_ms&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos; | close_time_to_utc_ms=1796088341000(固定)&apos;
output &lt;&lt; &apos;&apos; &lt;&lt; &apos;================ profit提取与求和报告 ================&apos; &lt;&lt; extractionReport
output &lt;&lt; &apos;&apos; &lt;&lt; &apos;================ equity差值比较报告 ================&apos; &lt;&lt; compareReport
String finalText = output.join(&apos;\n&apos;)
boolean success = status == &apos;PASS&apos;
log.info(&apos;\n&apos; + finalText)
SampleResult.setSuccessful(success)
SampleResult.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
SampleResult.setResponseData(finalText, &apos;UTF-8&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)</stringProp>
