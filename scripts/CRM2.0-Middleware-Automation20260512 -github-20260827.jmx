                <stringProp name="script">String body = prev.getResponseDataAsString()
vars.put(&apos;acct_metrics_user_info_response&apos;, body ?: &apos;&apos;)
log.info(&apos;account metrics helper user_info captured | login=&apos; + vars.get(&apos;acct_metrics_login&apos;))</stringProp>
