              <hashTree/>
              <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell 预处理程序 固定版" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">// ===== CSV驱动的充值提现参数（从CSV Data Set Config读取） =====
// 直接使用CSV变量，不需要再计算instanceid/login/deal_type/money

String instanceid = vars.get(&quot;instanceid&quot;);
String login = vars.get(&quot;login&quot;);
String deal_type = vars.get(&quot;deal_type&quot;);
String money = vars.get(&quot;money&quot;);

// 确保变量都已从CSV读取成功
if (instanceid == null || login == null || deal_type == null || money == null) {
    log.error(&quot;&gt;&gt;&gt; CSV变量读取失败! instanceid=&quot; + instanceid + &quot; login=&quot; + login + &quot; deal_type=&quot; + deal_type + &quot; money=&quot; + money);
}

// ===== 根据 deal_type 判断断言时要比对 balance 还是 credit =====
// MT5: deal_type 2 → balance, 3 → credit
// MT4: deal_type 6 → balance, 7 → credit
String assert_field = &quot;&quot;;
if (deal_type.equals(&quot;2&quot;) || deal_type.equals(&quot;6&quot;)) {
    assert_field = &quot;balance&quot;;
} else if (deal_type.equals(&quot;3&quot;) || deal_type.equals(&quot;7&quot;)) {
    assert_field = &quot;credit&quot;;
}
vars.put(&quot;assert_field&quot;, assert_field);

log.info(&quot;&gt;&gt;&gt; CSV充值提现预处理器：instanceid=&quot; + instanceid + &quot; deal_type=&quot; + deal_type + &quot; money=&quot; + money + &quot; login=&quot; + login + &quot; assert_field=&quot; + assert_field);</stringProp>
              </BeanShellPreProcessor>
              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="充值/提现 ${instanceid} ${login}">
                <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
                <stringProp name="HTTPSampler.port">${port}</stringProp>
                <stringProp name="HTTPSampler.protocol">http</stringProp>
                <stringProp name="HTTPSampler.path">/crm20/modify_balance</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{&#xd;
    &quot;login&quot;: ${login},&#xd;
    &quot;amount&quot;: ${money},&#xd;
    &quot;instanceid&quot;: &quot;${instanceid}&quot;,&#xd;
    &quot;deal_type&quot;: ${deal_type},&#xd;
    &quot;comment&quot;: &quot;change credit&quot;&#xd;
}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell 预处理程序 随机取值版" enabled="false">
                  <boolProp name="resetInterpreter">false</boolProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="script">import java.util.Random;
Random rand = new Random();

String[] instances = {&quot;MT5_1&quot;, &quot;MT4_1&quot;};
String instanceid = instances[rand.nextInt(instances.length)];
vars.put(&quot;instanceid&quot;, instanceid);

// ===== 根据 instanceid 决定 login / deal_type =====
String login = &quot;&quot;;
String deal_type = &quot;&quot;;

String[] moneyArr = {&quot;100&quot;, &quot;-100&quot;};
String money = moneyArr[rand.nextInt(moneyArr.length)];
vars.put(&quot;money&quot;, money);

if (&quot;MT5_1&quot;.equals(instanceid)) {
    login = vars.get(&quot;userSearchValue51&quot;);

    // deal_type = 2 or 3
    String[] dealArr = {&quot;2&quot;, &quot;3&quot;};
    deal_type = dealArr[rand.nextInt(dealArr.length)];

} else if (&quot;MT4_1&quot;.equals(instanceid)) {

    login = vars.get(&quot;userSearchValue41&quot;);

    // deal_type = 6 or 7
    String[] dealArr = {&quot;6&quot;, &quot;7&quot;};
    deal_type = dealArr[rand.nextInt(dealArr.length)];
}

vars.put(&quot;login&quot;, login);
vars.put(&quot;deal_type&quot;, deal_type);</stringProp>
                </BeanShellPreProcessor>
                <hashTree/>
                <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell 预处理程序 固定版 不带csv使用" enabled="false">
                  <boolProp name="resetInterpreter">false</boolProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="script">int idx = Integer.parseInt(vars.get(&quot;__jm__充值提现__idx&quot;));
int step = idx % 16;

// 账号变量定义（通过 vars.put 写入 JMeter 变量池，供 vars.get 读取）
vars.put(&quot;login51&quot;, &quot;4086&quot;);
vars.put(&quot;login52&quot;, &quot;880020&quot;);
vars.put(&quot;login41&quot;, &quot;5232&quot;);
vars.put(&quot;login42&quot;, &quot;1103&quot;);

// 账号映射：每4步一组，MT5两个账号、MT4两个账号
// step 0-3  → MT5_1 账号1 (login51)
// step 4-7  → MT5_1 账号2 (login52)
// step 8-11 → MT4_1 账号1 (login41)
// step 12-15→ MT4_1 账号2 (login42)
int accountIdx = step / 4;
int opIdx = step % 4;

String instanceid = &quot;&quot;;
String deal_type = &quot;&quot;;
String money = &quot;&quot;;
String login = &quot;&quot;;

// ===== 1. 根据账号索引设置 instanceid 和 login =====
switch(accountIdx) {
    case 0:
        instanceid = &quot;MT5_1&quot;;
        login = vars.get(&quot;login51&quot;);
        break;
    case 1:
        instanceid = &quot;MT5_1&quot;;
        login = vars.get(&quot;login52&quot;);
        break;
    case 2:
        instanceid = &quot;MT4_1&quot;;
        login = vars.get(&quot;login41&quot;);
        break;
    case 3:
        instanceid = &quot;MT4_1&quot;;
        login = vars.get(&quot;login42&quot;);
        break;
}

// ===== 2. 根据操作索引设置 deal_type 和 money =====
// MT5 使用 deal_type 2/3，MT4 使用 deal_type 6/7
boolean isMT5 = instanceid.startsWith(&quot;MT5&quot;);

switch(opIdx) {
    case 0:
        deal_type = isMT5 ? &quot;2&quot; : &quot;6&quot;;
        money = &quot;100&quot;;
        break;
    case 1:
        deal_type = isMT5 ? &quot;2&quot; : &quot;6&quot;;
        money = &quot;-100&quot;;
        break;
    case 2:
        deal_type = isMT5 ? &quot;3&quot; : &quot;7&quot;;
        money = &quot;100&quot;;
        break;
    case 3:
        deal_type = isMT5 ? &quot;3&quot; : &quot;7&quot;;
        money = &quot;-100&quot;;
        break;
}

vars.put(&quot;instanceid&quot;, instanceid);
vars.put(&quot;deal_type&quot;, deal_type);
vars.put(&quot;money&quot;, money);
vars.put(&quot;login&quot;, login);

// ===== 3. 根据 deal_type 判断断言时要比对 balance 还是 credit =====
// MT5: deal_type 2 → balance, 3 → credit
// MT4: deal_type 6 → balance, 7 → credit
String assert_field = &quot;&quot;;
if (deal_type.equals(&quot;2&quot;) || deal_type.equals(&quot;6&quot;)) {
    assert_field = &quot;balance&quot;;
} else if (deal_type.equals(&quot;3&quot;) || deal_type.equals(&quot;7&quot;)) {
    assert_field = &quot;credit&quot;;
}
vars.put(&quot;assert_field&quot;, assert_field);
log.info(&quot;&gt;&gt;&gt; 充值提现预处理器：instanceid=&quot; + instanceid + &quot; deal_type=&quot; + deal_type + &quot; money=&quot; + money + &quot; assert_field=&quot; + assert_field);
</stringProp>
                </BeanShellPreProcessor>
                <hashTree/>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.custom_message"></stringProp>
                  <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">2</intProp>
                </ResponseAssertion>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="校验响应结构与数据完整性" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.assertions.AssertionResult

def response = prev.getResponseDataAsString()

// 1. 校验JSON可解析
def json
try {
    json = new JsonSlurper().parseText(response)
} catch (Exception e) {
    def result = new AssertionResult(&quot;JSON解析&quot;)
    result.setFailure(true)
    result.setFailureMessage(&quot;响应不是合法的JSON: &quot; + e.message)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

// 2. 校验data字段存在且非空
if (json.data == null) {
    def result = new AssertionResult(&quot;data字段&quot;)
    result.setFailure(true)
    result.setFailureMessage(&quot;响应缺少data字段或data为null&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

// 3. 校验balance和credit字段存在且为有效数值
[&quot;balance&quot;, &quot;credit&quot;].each { field -&gt;
    def value = json.data[field]
    if (value == null) {
        def result = new AssertionResult(field + &quot;字段&quot;)
        result.setFailure(true)
        result.setFailureMessage(&quot;响应data中缺少&quot; + field + &quot;字段&quot;)
        prev.setSuccessful(false)
        prev.addAssertionResult(result)
    } else {
        try {
            value.toDouble()
            log.info(&quot;&gt;&gt;&gt; &quot; + field + &quot;校验通过: &quot; + value)
        } catch (Exception e) {
            def result = new AssertionResult(field + &quot;类型&quot;)
            result.setFailure(true)
            result.setFailureMessage(field + &quot;不是有效数值: &quot; + value)
            prev.setSuccessful(false)
            prev.addAssertionResult(result)
        }
    }
}</stringProp>
                </JSR223Assertion>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="CSV数据断言-比对返回数据与CSV期望值" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.assertions.AssertionResult

// ============================================================
// CSV数据断言：比对 modify_balance 返回的 data 字段与 CSV 期望值
// ============================================================

// 1. 读取响应JSON
def response = prev.getResponseDataAsString()
def json
try {
    json = new JsonSlurper().parseText(response)
} catch (Exception e) {
    def result = new AssertionResult(&quot;CSV断言-JSON解析&quot;)
    result.setFailure(true)
    result.setFailureMessage(&quot;响应不是合法的JSON: &quot; + e.message)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

if (json.data == null) {
    def result = new AssertionResult(&quot;CSV断言-data字段&quot;)
    result.setFailure(true)
    result.setFailureMessage(&quot;响应缺少data字段或data为null&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

// 2. 读取跳过的字段（从JMeter变量 skip_fields 读取，逗号分隔）
def skipFieldsStr = vars.get(&quot;skip_fields&quot;) ?: &quot;&quot;
def skipFields = skipFieldsStr ? skipFieldsStr.split(&quot;,&quot;)*.trim().findAll { it } : []
if (skipFields) {
    log.info(&quot;CSV断言 | 跳过字段: &quot; + skipFields)
}

// 3. 构建CSV期望值映射（从JMeter变量读取CSV当前行的值）
// CSV列：instanceid,login,money,deal_type,order_ticket,margin,balance,margin_free,deal_ticket,credit,margin_level,equity,profit
// A-D列(instanceid/login/money/deal_type)为接口入参，不在返回data中，不纳入断言比对
// E-M列为接口返回字段，纳入断言比对
def csvFields = [
    &quot;order_ticket&quot;, &quot;margin&quot;, &quot;balance&quot;, &quot;margin_free&quot;,
    &quot;deal_ticket&quot;, &quot;credit&quot;, &quot;margin_level&quot;, &quot;equity&quot;, &quot;profit&quot;
]

def expectedValues = [:]
csvFields.each { fieldName -&gt;
    def csvValue = vars.get(fieldName)
    if (csvValue != null &amp;&amp; csvValue != &quot;&quot;) {
        expectedValues[fieldName] = csvValue
    }
}

log.info(&quot;CSV断言 | CSV期望值: &quot; + expectedValues)

// 4. 获取API返回的data
def respData = json.data

// 5. 确定data类型：Map(对象)直接比对；List(数组)取第一个元素
def dataToCompare
if (respData instanceof Map) {
    dataToCompare = respData
} else if (respData instanceof List) {
    if (respData.size() &gt; 0) {
        dataToCompare = respData[0]
    } else {
        def result = new AssertionResult(&quot;CSV断言-data数组&quot;)
        result.setFailure(true)
        result.setFailureMessage(&quot;data数组为空，无法比对&quot;)
        prev.setSuccessful(false)
        prev.addAssertionResult(result)
        return
    }
} else {
    def result = new AssertionResult(&quot;CSV断言-data类型&quot;)
    result.setFailure(true)
    result.setFailureMessage(&quot;data字段类型不支持: &quot; + respData.getClass().getSimpleName())
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

// 6. 逐个字段比对
def failures = []
def successCount = 0
def skipCount = 0
def EPSILON = 1e-9

expectedValues.each { fieldName, expectedValue -&gt;
    // 检查是否在跳过列表中
    if (skipFields.contains(fieldName)) {
        skipCount++
        log.info(&quot;CSV断言 | 跳过字段: &quot; + fieldName)
        return
    }

    // 获取API返回的值
    def actualValue = dataToCompare[fieldName]

    // CSV中是&quot;0&quot;但JSON中为null，视为通过（margin/margin_free等可能为0但JSON返回null）
    if (actualValue == null) {
        if (expectedValue == &quot;0&quot; || expectedValue == &quot;0.0&quot;) {
            log.info(&quot;CSV断言 | &quot; + fieldName + &quot; | 期望=&quot; + expectedValue + &quot;, 实际=null（容错通过）&quot;)
            successCount++
            return
        }
        failures &lt;&lt; &quot;字段 [&quot; + fieldName + &quot;] 期望=[&quot; + expectedValue + &quot;] 实际=[null]&quot;
        return
    }

    // 尝试数值比对（数值精度 1e-9）
    def actualStr = actualValue.toString().trim()
    def expectedStr = expectedValue.trim()

    try {
        def actualNum = actualStr.toDouble()
        def expectedNum = expectedStr.toDouble()
        if (Math.abs(actualNum - expectedNum) &gt; EPSILON) {
            failures &lt;&lt; &quot;字段 [&quot; + fieldName + &quot;] 数值不一致: 期望=[&quot; + expectedStr + &quot;] 实际=[&quot; + actualStr + &quot;] 差值=&quot; + String.format(&quot;%.6f&quot;, Math.abs(actualNum - expectedNum))
        } else {
            successCount++
            log.info(&quot;CSV断言 | &quot; + fieldName + &quot; | 期望=&quot; + expectedStr + &quot; 实际=&quot; + actualStr + &quot; \u2713&quot;)
        }
        return
    } catch (Exception ignore) {
        // 非数值，转字符串比对
    }

    // 字符串比对
    if (actualStr != expectedStr) {
        failures &lt;&lt; &quot;字段 [&quot; + fieldName + &quot;] 字符串不一致: 期望=[&quot; + expectedStr + &quot;] 实际=[&quot; + actualStr + &quot;]&quot;
    } else {
        successCount++
        log.info(&quot;CSV断言 | &quot; + fieldName + &quot; | 期望=&quot; + expectedStr + &quot; 实际=&quot; + actualStr + &quot; \u2713&quot;)
    }
}

// 7. 输出结果
def summary = &quot;CSV断言: 成功=&quot; + successCount + &quot; 跳过=&quot; + skipCount + &quot; 失败=&quot; + failures.size()
if (skipFields) {
    summary += &quot; | 跳过=[&quot; + skipFields.join(&quot;,&quot;) + &quot;]&quot;
}
log.info(summary)

if (failures.isEmpty()) {
    prev.setResponseMessage((prev.getResponseMessage() ?: &quot;&quot;) + &quot; | &quot; + summary)
} else {
    def result = new AssertionResult(&quot;CSV数据断言&quot;)
    result.setFailure(true)
    result.setFailureMessage(failures.join(&quot;\n&quot;))
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
}</stringProp>
                </JSR223Assertion>
