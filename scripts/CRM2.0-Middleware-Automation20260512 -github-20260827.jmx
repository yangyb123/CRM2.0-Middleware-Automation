    apiRows.eachWithIndex { Map apiRow, int i -&gt;
        String key = rowKey(apiRow)
        List&lt;Integer&gt; candidates = []
        dbRows.eachWithIndex { Map dbRow, int j -&gt; if (rowKey(dbRow) == key) candidates &lt;&lt; j }
        // API账户在DB中无记录时不执行无意义的账户键/资金字段对比，也不打印失败；DB重复记录仍判失败。
        if (candidates.isEmpty()) return
        if (candidates.size() &gt; 1) {
            failLines &lt;&lt; &apos; - [失败] | data.row=&apos; + (i + 1) + &apos; | key=&apos; + key + &apos; | 原因=数据库对应记录数应为1，实际=&apos; + candidates.size()
            return
        }
        int j = candidates[0]
        usedDb &lt;&lt; j
        Map dbRow = dbRows[j]
        dataFields.each { String field -&gt;
            Map apiValue = lookup(apiRow, field), dbValue = lookup(dbRow, field)
            String comparePrefix = &apos;data.row=&apos; + (i + 1) + &apos; | field=&apos; + field +
                &apos; | APIField=&apos; + (apiValue.key ?: &apos;&lt;field-missing&gt;&apos;) +
                &apos; | DBField=&apos; + (dbValue.key ?: &apos;&lt;field-missing&gt;&apos;) +
                &apos; | instanceid=&apos; + (blank(apiRow.instance_id) ? &apos;&lt;empty&gt;&apos; : String.valueOf(apiRow.instance_id).trim()) +
                &apos; | login=&apos; + (idText(apiRow.login) ?: &apos;&lt;empty&gt;&apos;)
            if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(field))) {
                skipLines &lt;&lt; &apos; - [跳过] | &apos; + comparePrefix + &apos; | API=&apos; + (apiValue.exists ? numText(apiValue.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | DB=&apos; + (dbValue.exists ? numText(dbValue.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | 备注=DB/API无条件跳过配置&apos;
                return
            }
            if (!apiValue.exists) {
                failLines &lt;&lt; &apos; - [失败] | &apos; + comparePrefix + &apos; | API=&lt;field-missing&gt; | DB=&apos; + (dbValue.exists ? numText(dbValue.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | 原因=接口缺少必返字段&apos;
                return
            }
            if (!dbValue.exists) {
                if (missingSkip.contains(&apos;*&apos;) || missingSkip.contains(norm(field))) skipLines &lt;&lt; &apos; - [跳过] | &apos; + comparePrefix + &apos; | API=&apos; + numText(apiValue.value) + &apos; | DB=&lt;field-missing&gt; | 备注=数据库无此字段，已按配置跳过&apos;
                else failLines &lt;&lt; &apos; - [失败] | &apos; + comparePrefix + &apos; | API=&apos; + numText(apiValue.value) + &apos; | DB=&lt;field-missing&gt; | 原因=数据库无此字段；字段不存在不等于字段值为空，可设置跳过&apos;
                return
            }
            Map cr = compare(field, apiValue.value, dbValue.value, &apos;DB&apos;, percentMap, defaultPercent, absoluteMap, defaultAbsolute)
            String line = comparePrefix + &apos; | API=&apos; + cr.api + &apos; | DB=&apos; + cr.expected + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        }
    }
    boolean paged = !blank(root.next_cursor) || !blank(vars.get(&apos;competition_accounts_cursor&apos;))
    dbRows.eachWithIndex { Map dbRow, int j -&gt;
        if (!usedDb.contains(j)) {
            String key = rowKey(dbRow)
            if (allowPartialErrors &amp;&amp; errorKeys.contains(key)) skipLines &lt;&lt; &apos; - [跳过] | DB未匹配记录 | key=&apos; + key + &apos; | 备注=该账户在errors中且部分错误已配置允许&apos;
            else if (paged) skipLines &lt;&lt; &apos; - [跳过] | DB未匹配记录 | key=&apos; + key + &apos; | 备注=当前请求或响应存在cursor，仅校验本页&apos;
            else failLines &lt;&lt; &apos; - [失败] | 数据库多出未匹配账户 | key=&apos; + key + &apos; | DB记录=&apos; + dbRow
        }
    }
    if (!apiRows &amp;&amp; !dbRows &amp;&amp; !errors) okLines &lt;&lt; &apos; - [通过] | DB/API记录数均为0 | 备注=请求账户集合为空结果一致&apos;
} else {
    Map csvRow = vars.getObject(&apos;competition_accounts_current_csv_row&apos;) instanceof Map ? new LinkedHashMap((Map)vars.getObject(&apos;competition_accounts_current_csv_row&apos;)) : [:]
    String expectedInstance = String.valueOf(csvRow.instance_id ?: csvRow.instanceid ?: &apos;&apos;).trim()
    String expectedLogin = idText(csvRow.login)
    List&lt;Map&gt; candidates = apiRows.findAll { Map row -&gt; String.valueOf(row.instance_id ?: &apos;&apos;) == expectedInstance &amp;&amp; idText(row.login) == expectedLogin }
    if (candidates.size() != 1) failLines &lt;&lt; &apos; - [失败] | CSV行=&apos; + vars.get(&apos;competition_accounts_csv_line_no&apos;) + &apos; | key=&apos; + expectedInstance + &apos;|&apos; + expectedLogin + &apos; | 原因=接口匹配记录数应为1，实际=&apos; + candidates.size()
    else {
        Map apiRow = candidates[0]
        dataFields.each { String field -&gt;
            Map apiValue = lookup(apiRow, field)
            Object rawObject
            boolean hasExpected = true
            if (field == &apos;instance_id&apos;) rawObject = csvRow.instance_id ?: csvRow.instanceid
            else if (field == &apos;login&apos;) rawObject = csvRow.login
            else if (field == &apos;platform&apos;) {
                String p = String.valueOf(csvRow.platform ?: &apos;&apos;).trim().toLowerCase()
                rawObject = p ?: (expectedInstance.toUpperCase().contains(&apos;MT4&apos;) ? &apos;mt4&apos; : (expectedInstance.toUpperCase().contains(&apos;MT5&apos;) ? &apos;mt5&apos; : &apos;&apos;))
            } else if (csvRow.containsKey(field)) rawObject = csvRow[field]
            else hasExpected = false
            String raw = rawObject == null ? &apos;&apos; : String.valueOf(rawObject).trim()
            if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(field))) {
                skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + field + &apos; | API=&apos; + (apiValue.exists ? numText(apiValue.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&apos; + (raw ?: &apos;&lt;empty&gt;&apos;) + &apos; | 备注=CSV/API跳过配置&apos;
                return
            }
            if (!hasExpected) {
                failLines &lt;&lt; &apos; - [失败] | field=&apos; + field + &apos; | 原因=CSV表头缺少V1字段&apos;
                return
            }
            if (!raw) {
                skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + field + &apos; | API=&apos; + (apiValue.exists ? numText(apiValue.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&lt;empty&gt; | 备注=未填写期望值；字段结构和类型仍已校验，断言空值请填写&lt;empty&gt;&apos;
                return
            }
            if (!apiValue.exists) {
                failLines &lt;&lt; &apos; - [失败] | field=&apos; + field + &apos; | API=&lt;field-missing&gt; | CSV=&apos; + raw
                return
            }
            Object expected = raw in [&apos;&lt;empty&gt;&apos;, &apos;&lt;null&gt;&apos;] ? null : raw
            Map cr = compare(field, apiValue.value, expected, &apos;CSV&apos;, percentMap, defaultPercent, absoluteMap, defaultAbsolute)
            String line = &apos;field=&apos; + field + &apos; | API=&apos; + cr.api + &apos; | CSV=&apos; + cr.expected + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        }
    }
}

// ACCOUNT_NO_DATA_ROW_V1: 最终报告不显示data.row；无field的账户key匹配明细明确标记为instance_id+login组合字段。
def formatAccountCompareOutput = { String line -&gt;
    if (!line) return line
    String outputLine = line
    boolean apiDataLine = (outputLine =~ /(?:^|\|\s*)data\.row=\d+/).find()
    boolean hasField = (outputLine =~ /(?:^|\|\s*)field=/).find()
    if (!hasField) {
        def keyMatcher = (outputLine =~ /(?:^|\|\s*)key=([^|\s]+)\|([^|\s]+)/)
        if (keyMatcher.find()) {
            String sourcePrefix = apiDataLine ? &apos;API&apos; : (outputLine.contains(&apos;CSV行=&apos;) ? &apos;CSV&apos; : (outputLine.contains(&apos;errors.row=&apos;) ? &apos;API_error&apos; : ((outputLine.contains(&apos;DB&apos;) || outputLine.contains(&apos;数据库&apos;)) ? &apos;DB&apos; : &apos;Account&apos;)))
            String identity = &apos;field=instance_id+login | &apos; + sourcePrefix + &apos;_instance_id=&apos; + keyMatcher.group(1).trim() + &apos; | &apos; + sourcePrefix + &apos;_login=&apos; + keyMatcher.group(2).trim()
            int firstPipe = outputLine.indexOf(&apos;|&apos;)
            outputLine = firstPipe &gt;= 0 ? outputLine.substring(0, firstPipe + 1) + &apos; &apos; + identity + &apos; |&apos; + outputLine.substring(firstPipe + 1) : outputLine + &apos; | &apos; + identity
        }
    }
    outputLine.replaceAll(/\s*\|\s*data\.row=\d+(?=\s*\||$)/, &apos;&apos;)
}
List&lt;String&gt; displayFailLines = failLines.collect { String line -&gt; formatAccountCompareOutput(line) }
List&lt;String&gt; displayOkLines = okLines.collect { String line -&gt; formatAccountCompareOutput(line) }
List&lt;String&gt; displaySkipLines = skipLines.collect { String line -&gt; formatAccountCompareOutput(line) }
String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List&lt;String&gt; report = []
report &lt;&lt; &apos;Assertion message: 交易大赛-批量查询账户资金 V1响应每字段/DB或CSV校验 | status=&apos; + status + &apos; | mode=&apos; + mode + &apos; | case=&apos; + vars.get(&apos;competition_accounts_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;competition_accounts_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;competition_accounts_csv_line_no&apos;) + &apos; | shujuku=&apos; + vars.get(&apos;competition_accounts_shujuku&apos;)
report &lt;&lt; &apos;接口: POST /v1/accounts/query | 文档: mt-hub-openapi 7.html | 版本: MT-Hub API 1.0.1-beta1.60.3&apos;
report &lt;&lt; &apos;已校验响应字段: envelope=[&apos; + envelopeFields.join(&apos;,&apos;) + &apos;] | data[]=[&apos; + dataFields.join(&apos;,&apos;) + &apos;] | errors[]=[&apos; + allowedErrorFields.join(&apos;,&apos;) + &apos;]&apos;
report &lt;&lt; &apos;响应信封: data=&apos; + apiRows.size() + &apos; | errors=&apos; + errors.size() + &apos; | next_cursor=&apos; + (blank(root.next_cursor) ? &apos;&lt;empty&gt;&apos; : root.next_cursor) + &apos; | as_of_time_ms=&apos; + numText(root.as_of_time_ms)
report &lt;&lt; &apos;数据库缺失字段跳过配置=[&apos; + missingSkipRaw + &apos;]；字段不存在与字段存在但值为空严格区分&apos;
report &lt;&lt; &apos;数值误差配置: percent=[&apos; + percentRaw + &apos;] | absolute=[&apos; + absoluteRaw + &apos;]&apos;
report &lt;&lt; &apos;空值规则: API/DB均空通过；API=0且DB空通过；storage均空通过；数据库无字段默认失败，只有配置后才跳过。&apos;
report &lt;&lt; &apos;打印说明: 明细不显示data.row；API账户在DB中无对应记录时不执行账户键及资金字段对比、不打印失败；同一账户匹配到多条DB记录时仍判失败。&apos;
report &lt;&lt; &apos;统计: 失败=&apos; + failLines.size() + &apos; | 通过=&apos; + okLines.size() + &apos; | 跳过=&apos; + skipLines.size() + &apos; | API记录=&apos; + apiRows.size() + &apos; | DB模式=&apos; + dbMode
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【失败明细：&apos; + failLines.size() + &apos;条】&apos;; report.addAll(displayFailLines ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【通过明细：&apos; + okLines.size() + &apos;条】&apos;; report.addAll(displayOkLines ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【跳过明细：&apos; + skipLines.size() + &apos;条】&apos;; report.addAll(displaySkipLines ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【接口请求Body】&apos; &lt;&lt; (vars.get(&apos;competition_accounts_request_body&apos;) ?: &apos;&apos;)
String finalReport = report.join(&apos;\n&apos;)
publish(finalReport, failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="23交易大赛-批量查询已经完全关闭的持仓生命周期✅✅">
        <stringProp name="TestPlan.comments">仅修改本线程组。按“交易大赛-批量查询已经完全关闭的持仓生命周期.csv”执行：shujuku=1 聚合全部数据库模式账号，一次请求 /v1/positions/history/query，并将 MT4 已关闭交易及 MT5 已关闭 Position 的 Deal 聚合结果逐字段与 API 对比；shujuku=0 按当前 CSV 行进行 CSV/API 校验。响应结构、21 个历史生命周期字段、空值和名义价值语义依据 mt-hub-openapi 7.html（1.0.1-beta1.60.3）。严格区分数据库字段不存在与字段值为空。完整结果集下，数据库正常查询到记录但接口未返回该条记录时列入失败明细；存在cursor时只校验当前页，避免把其他分页记录误判为接口遗漏。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="交易大赛V1历史生命周期CSV循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;交易大赛-批量查询已经完全关闭的持仓生命周期.csv&apos;); if (!f.exists()) return 0; def lines = f.readLines(&apos;UTF-8&apos;); if (lines.size() &lt;= 1) return 0; boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = -1; for (int j = 0; j &lt; line.length(); j++) { if ((int)line.charAt(j) == 44) { p = j; break } }; String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == (65279 as char)) first = first.drop(1); first = first.trim(); if (first.length() &gt;= 2 &amp;&amp; first.charAt(0) == (&apos;&quot;&apos; as char) &amp;&amp; first.charAt(first.length() - 1) == (&apos;&quot;&apos; as char)) first = first.drop(1).take(first.length() - 2).trim(); if (first == &apos;1&apos;) hasDb = true; else if (first == &apos;0&apos;) csvCount++ } }; return csvCount + (hasDb ? 1 : 0))}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
