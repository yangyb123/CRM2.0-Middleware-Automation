          </LoopController>
          <hashTree>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="根据MT类型获取对应的MT账号" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">String countStr = vars.get(&quot;loop_count_修改权限&quot;);
int count = (countStr == null) ? 0 : Integer.parseInt(countStr);

// ===== 账号变量定义 =====
vars.put(&quot;login51&quot;, &quot;4086&quot;);
vars.put(&quot;login52&quot;, &quot;880020&quot;);
vars.put(&quot;login41&quot;, &quot;5232&quot;);
vars.put(&quot;login42&quot;, &quot;1103&quot;);

// ===== 账号轮换（12次=4账号×3种权限）=====
// 每3次一个账号：MT5_4022 → MT4_1012 → MT5_880000 → MT4_3088
int accountGroup = count / 3;
int scenarioIdx = count % 3;

if (accountGroup == 0 || accountGroup == 2) {
    // MT5 账号
    int mt5Idx = accountGroup == 0 ? 0 : 1;  // 0→51, 2→52
    vars.put(&quot;login_val&quot;, vars.get(&quot;login5&quot; + (mt5Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    // MT4 账号
    int mt4Idx = accountGroup == 1 ? 0 : 1;  // 1→41, 3→42
    vars.put(&quot;login_val&quot;, vars.get(&quot;login4&quot; + (mt4Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

// ===== 权限值动态计算（每个账号统一循环: 871 → 354 → 866）=====
if (scenarioIdx == 0) {
    // 场景0: 871
    vars.put(&quot;rights_val&quot;, &quot;871&quot;);
    vars.put(&quot;rights_desc&quot;, &quot;871&quot;);
} else if (scenarioIdx == 1) {
    // 场景1: 354
    vars.put(&quot;rights_val&quot;, &quot;354&quot;);
    vars.put(&quot;rights_desc&quot;, &quot;354&quot;);
} else {
    // 场景2: 866
    vars.put(&quot;rights_val&quot;, &quot;866&quot;);
    vars.put(&quot;rights_desc&quot;, &quot;866&quot;);
}
</stringProp>
            </BeanShellPreProcessor>
