            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def errors = []

def responseText = prev.getResponseDataAsString()
def json

try {
    json = new JsonSlurper().parseText(responseText)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;响应不是合法 JSON: ${e.message}&quot;)
    return
}

if (json == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;响应 JSON 为空&quot;)
    return
}

if (json.code != 0) {
    errors &lt;&lt; &quot;code 不是 0，实际值=${json.code}&quot;
}

def data = json.data

if (data == null) {
    errors &lt;&lt; &quot;data 不存在或为 null&quot;
} else {
    def summary = data.summary

    if (summary == null) {
        errors &lt;&lt; &quot;data.summary 不存在或为 null&quot;
    } else {
        def summaryNumberFields = [
            &apos;standard_volume&apos;,
            &apos;total_volume&apos;,
            &apos;cent_volume&apos;,
            &apos;total_fee&apos;,
            &apos;total_storage&apos;,
            &apos;total_profit&apos;,
            &apos;total_orders&apos;
        ]

        summaryNumberFields.each { field -&gt;
            if (!summary.containsKey(field)) {
                errors &lt;&lt; &quot;summary.${field} 字段不存在&quot;
                return
            }

            def value = summary[field]

            if (value == null || value.toString().trim() == &apos;&apos;) {
                errors &lt;&lt; &quot;summary.${field} 为空，实际值=${value}&quot;
                return
            }

            if (!(value instanceof Number)) {
                errors &lt;&lt; &quot;summary.${field} 不是数字，实际值=${value}&quot;
                return
            }
        }
    }

    if (!data.containsKey(&apos;total&apos;)) {
        errors &lt;&lt; &quot;data.total 字段不存在&quot;
    } else {
        def totalValue = data.total

        if (totalValue == null || totalValue.toString().trim() == &apos;&apos;) {
            errors &lt;&lt; &quot;data.total 为空，实际值=${totalValue}&quot;
        } else if (!(totalValue instanceof Number)) {
            errors &lt;&lt; &quot;data.total 不是数字，实际值=${totalValue}&quot;
        }
    }

    def items = data.items

    if (!(items instanceof List)) {
        errors &lt;&lt; &quot;data.items 不是数组或不存在&quot;
    } else if (items.isEmpty()) {
        errors &lt;&lt; &quot;data.items 数组为空&quot;
    } else {
        def itemNumberFields = [
            &apos;reason&apos;,
            &apos;swap&apos;,
            &apos;updated_utc_ms&apos;,
            &apos;fee&apos;,
            &apos;price_open&apos;,
            &apos;price_tp&apos;,
            &apos;login&apos;,
            &apos;time_expiration_utc_ms&apos;,
            &apos;time_setup_utc_ms&apos;,
            &apos;order_ticket&apos;,
            &apos;price_sl&apos;,
            &apos;digits&apos;,
            &apos;contract_size&apos;,
            &apos;digits_currency&apos;,
            &apos;state&apos;,
            &apos;order_type&apos;,
            &apos;profit&apos;,
            &apos;price_current&apos;,
            &apos;volume_lots&apos;
        ]

        def itemStringFields = [
            &apos;symbol&apos;,
            &apos;side&apos;,
            &apos;source&apos;,
            &apos;instance_id&apos;
        ]

        def itemExistOnlyFields = [
            &apos;comment&apos;
        ]

        items.eachWithIndex { item, index -&gt;
            if (!(item instanceof Map)) {
                errors &lt;&lt; &quot;items[${index}] 不是对象&quot;
                return
            }

            itemNumberFields.each { field -&gt;
                if (!item.containsKey(field)) {
                    errors &lt;&lt; &quot;items[${index}].${field} 字段不存在&quot;
                    return
                }

                def value = item[field]

                if (value == null || value.toString().trim() == &apos;&apos;) {
                    errors &lt;&lt; &quot;items[${index}].${field} 为空，实际值=${value}&quot;
                    return
                }

                if (!(value instanceof Number)) {
                    errors &lt;&lt; &quot;items[${index}].${field} 不是数字，实际值=${value}&quot;
                    return
                }
            }

            itemStringFields.each { field -&gt;
                if (!item.containsKey(field)) {
                    errors &lt;&lt; &quot;items[${index}].${field} 字段不存在&quot;
                    return
                }

                def value = item[field]

                if (value == null || value.toString().trim() == &apos;&apos;) {
                    errors &lt;&lt; &quot;items[${index}].${field} 为空，实际值=${value}&quot;
                    return
                }
            }

            itemExistOnlyFields.each { field -&gt;
                if (!item.containsKey(field)) {
                    errors &lt;&lt; &quot;items[${index}].${field} 字段不存在&quot;
                    return
                }
            }
        }
    }
}

if (!errors.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(errors.join(&apos;\n&apos;))
}</stringProp>
          </JSR223Assertion>
