              </elementProp>
              <elementProp name="competition_accounts_db_api_default_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_db_api_default_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_accounts_allow_partial_errors" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_allow_partial_errors</stringProp>
                <stringProp name="Argument.value">false</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">false 时 HTTP 200 响应中的 errors 非空仍判失败；无论是否允许，errors[] 每个字段都会做契约校验。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="交易大赛V1账户资金-CSV/API配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="competition_accounts_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API 模式无条件跳过字段；CSV 单元格留空表示不设置期望值，填写 &lt;empty&gt; 或 &lt;null&gt; 才断言为空。</stringProp>
              </elementProp>
              <elementProp name="competition_accounts_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">equity=1,margin=1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_accounts_csv_api_field_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_csv_api_field_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">balance=0.01,equity=0.01,credit=0.01,margin=0.01</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_accounts_csv_api_default_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_csv_api_default_tolerance_percent</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="competition_accounts_csv_api_default_absolute_tolerance" elementType="Argument">
                <stringProp name="Argument.name">competition_accounts_csv_api_default_absolute_tolerance</stringProp>
                <stringProp name="Argument.value">0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化交易大赛V1账户资金参数、请求Body和数据库SQL" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;交易大赛-批量查询账户的余额、净值、信用额、保证金和账户币种等资金信息.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;CSV文件不存在: &apos; + csvFile.getPath())
List&lt;String&gt; rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim() }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List&lt;String&gt; values = []
    StringBuilder cell = new StringBuilder()
    boolean quoted = false
    for (int i = 0; i &lt; line.length(); i++) {
        char ch = line.charAt(i)
        if (ch == (&apos;&quot;&apos; as char)) {
            if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cell.append(&apos;&quot;&apos;); i++
            } else quoted = !quoted
        } else if (ch == (&apos;,&apos; as char) &amp;&amp; !quoted) {
            values &lt;&lt; cell.toString(); cell.setLength(0)
        } else cell.append(ch)
    }
    values &lt;&lt; cell.toString()
    values
}

List&lt;String&gt; headers = parseCsvLine(rawLines[0]).collect { String.valueOf(it).trim() }
if (headers &amp;&amp; headers[0].startsWith(&apos;\uFEFF&apos;)) headers[0] = headers[0].substring(1)
List&lt;Map&gt; csvRows = []
rawLines.drop(1).eachWithIndex { String line, int idx -&gt;
    List&lt;String&gt; values = parseCsvLine(line)
    Map row = new LinkedHashMap()
    headers.eachWithIndex { String h, int c -&gt; row[h] = c &lt; values.size() ? values[c].trim() : &apos;&apos; }
    row.__line_no = idx + 2
    String mode = String.valueOf(row.shujuku ?: &apos;&apos;).trim()
    if (mode in [&apos;0&apos;, &apos;1&apos;]) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;CSV没有有效数据：shujuku 必须为 1(DB/API) 或 0(CSV/API)&apos;)

List&lt;Map&gt; dbRows = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;1&apos; }
List&lt;Map&gt; csvModeRows = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;0&apos; }
List&lt;Map&gt; runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, rows: dbRows, row: dbRows[0]]
csvModeRows.each { Map row -&gt; runCases &lt;&lt; [mode: &apos;CSV&apos;, rows: [row], row: row] }

int caseIndex
try { caseIndex = Integer.parseInt(vars.get(&apos;competition_accounts_case_index&apos;) ?: &apos;0&apos;) } catch (ignored) { caseIndex = 0 }
if (caseIndex &lt; 0 || caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;CSV执行索引越界: &apos; + caseIndex + &apos;/&apos; + runCases.size())
Map runCase = runCases[caseIndex]
Map currentRow = runCase.row as Map
vars.put(&apos;competition_accounts_case_index&apos;, String.valueOf(caseIndex + 1))

def textOf = { Object v -&gt; v == null ? &apos;&apos; : String.valueOf(v).trim() }
def intValue = { Object raw, int defaultValue, int minValue, int maxValue, String field -&gt;
    String s = textOf(raw)
    int n = s ? Integer.parseInt(s) : defaultValue
    if (n &lt; minValue || n &gt; maxValue) throw new AssertionError(field + &apos; 超出范围[&apos; + minValue + &apos;,&apos; + maxValue + &apos;]: &apos; + n)
    n
}
def inferPlatform = { Map row, String instanceId -&gt;
    String p = textOf(row.platform).toLowerCase()
    if (p in [&apos;mt4&apos;, &apos;mt5&apos;]) return p
    String upper = instanceId.toUpperCase()
    upper.contains(&apos;MT4&apos;) ? &apos;mt4&apos; : (upper.contains(&apos;MT5&apos;) ? &apos;mt5&apos; : &apos;&apos;)
}

List&lt;Map&gt; accounts = []
Set&lt;String&gt; seen = new LinkedHashSet&lt;String&gt;()
(runCase.rows as List&lt;Map&gt;).each { Map row -&gt;
    String instanceId = textOf(row.instanceid ?: row.instance_id)
    String loginText = textOf(row.login)
    if (!instanceId) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 instanceid 不能为空&apos;)
    if (!(loginText ==~ /^\d+$/)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 必须为正int64数字: &apos; + loginText)
    BigInteger loginBig = new BigInteger(loginText)
    if (loginBig &lt;= BigInteger.ZERO || loginBig &gt; new BigInteger(&apos;9223372036854775807&apos;)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 超出int64正整数范围: &apos; + loginText)
    String key = instanceId + &apos;|&apos; + loginText
    if (seen.add(key)) accounts &lt;&lt; [instance_id: instanceId, login: loginBig.longValue(), platform: inferPlatform(row, instanceId), __line_no: row.__line_no]
}
if (!accounts) throw new AssertionError(&apos;没有可用 accounts&apos;)

int limit = intValue(currentRow.limit, 1000, 1, 10000, &apos;limit&apos;)
String cursorText = textOf(currentRow.cursor)
Object cursor = (!cursorText || cursorText.equalsIgnoreCase(&apos;null&apos;) || cursorText == &apos;&lt;empty&gt;&apos;) ? null : cursorText
List&lt;Map&gt; requestAccounts = accounts.collect { [instance_id: it.instance_id, login: it.login] }
Map request = [accounts: requestAccounts, limit: limit, cursor: cursor]
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(request))

int configuredDbMaxRows = intValue(currentRow.db_result_max_rows, 50000, 1, 50000, &apos;db_result_max_rows&apos;)
// 账户资金查询每个instance_id+login最多应返回一行；根据请求账户数收敛JDBC结果上限，避免异常执行计划拉取50000行。
int dbMaxRows = Math.min(configuredDbMaxRows, Math.max(100, requestAccounts.size() * 2))
int dbQueryTimeoutSeconds = intValue(vars.get(&apos;competition_accounts_db_query_timeout_seconds&apos;), 120, 1, 1800, &apos;competition_accounts_db_query_timeout_seconds&apos;)
vars.put(&apos;competition_accounts_db_query_timeout_seconds_effective&apos;, String.valueOf(dbQueryTimeoutSeconds))
vars.put(&apos;competition_accounts_db_result_max_rows_effective&apos;, String.valueOf(dbMaxRows))
def sqlQuote = { Object raw -&gt; &quot;&apos;&quot; + textOf(raw).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot; }
def instanceCase = { String loginExpr, Map&lt;String,String&gt; loginInstance -&gt;
    String cases = loginInstance.collect { String login, String instance -&gt; &apos;WHEN &apos; + login + &apos; THEN &apos; + sqlQuote(instance) }.join(&apos; &apos;)
    &apos;CASE &apos; + loginExpr + &apos; &apos; + cases + &quot; ELSE &apos;&lt;unknown-instance&gt;&apos; END&quot;
}

List&lt;String&gt; sqlParts = []
if (runCase.mode == &apos;DB&apos;) {
    Map&lt;String,String&gt; mt4LoginInstance = new LinkedHashMap&lt;String,String&gt;()
    Map&lt;String,String&gt; mt5LoginInstance = new LinkedHashMap&lt;String,String&gt;()
    accounts.each { Map account -&gt;
        if (!(account.platform in [&apos;mt4&apos;, &apos;mt5&apos;])) throw new AssertionError(&apos;DB模式无法识别平台，请在CSV填写 platform=mt4/mt5: &apos; + account.instance_id + &apos;:&apos; + account.login)
        Map&lt;String,String&gt; target = account.platform == &apos;mt4&apos; ? mt4LoginInstance : mt5LoginInstance
        String loginKey = String.valueOf(account.login)
        if (target.containsKey(loginKey) &amp;&amp; target[loginKey] != account.instance_id) throw new AssertionError(&apos;同一平台相同login映射到多个instance，数据库无法消歧: &apos; + loginKey)
        target[loginKey] = String.valueOf(account.instance_id)
    }
    if (mt4LoginInstance) {
        String loginSql = mt4LoginInstance.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;u.LOGIN&apos;, mt4LoginInstance)
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt4&apos; AS platform,
  u.LOGIN AS login,
  u.BALANCE AS balance,
  u.EQUITY AS equity,
  u.CREDIT AS credit,
  u.MARGIN AS margin,
  UPPER(TRIM(NULLIF(u.CURRENCY, &apos;&apos;))) AS account_currency,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale
FROM mt4_report.MT4_USERS u
WHERE u.LOGIN IN (${loginSql})
&quot;&quot;&quot;.trim()
    }
    if (mt5LoginInstance) {
        String loginSql = mt5LoginInstance.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;a.Login&apos;, mt5LoginInstance)
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt5&apos; AS platform,
  a.Login AS login,
  a.Balance AS balance,
  a.Equity AS equity,
  a.Credit AS credit,
  a.Margin AS margin,
  UPPER(TRIM(NULLIF(curr.Currency, &apos;&apos;))) AS account_currency,
  CASE UPPER(TRIM(COALESCE(curr.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale
FROM mt5_report.mt5_accounts a
LEFT JOIN (
  SELECT d1.Login, MAX(NULLIF(TRIM(d1.Currency), &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${loginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) curr ON curr.Login = a.Login
WHERE a.Login IN (${loginSql})
&quot;&quot;&quot;.trim()
    }
}
String detailSql = sqlParts ? (&apos;SELECT * FROM (&apos; + sqlParts.join(&apos; UNION ALL &apos;) + &apos;) competition_accounts ORDER BY instance_id, login LIMIT &apos; + dbMaxRows) : &quot;SELECT &apos;&apos; AS instance_id, &apos;&apos; AS platform, NULL AS login, NULL AS balance, NULL AS equity, NULL AS credit, NULL AS margin, CAST(NULL AS CHAR) AS account_currency, NULL AS money_scale WHERE 1=0&quot;

vars.put(&apos;competition_accounts_mode&apos;, String.valueOf(runCase.mode))
vars.put(&apos;competition_accounts_shujuku&apos;, runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;)
vars.put(&apos;competition_accounts_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;competition_accounts_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;competition_accounts_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;competition_accounts_request_body&apos;, requestBody)
vars.put(&apos;competition_accounts_detail_sql&apos;, detailSql.replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim())
vars.put(&apos;competition_accounts_limit&apos;, String.valueOf(limit))
vars.put(&apos;competition_accounts_cursor&apos;, cursor == null ? &apos;&apos; : String.valueOf(cursor))
vars.putObject(&apos;competition_accounts_current_csv_row&apos;, currentRow)
vars.putObject(&apos;competition_accounts_request_accounts&apos;, requestAccounts)
vars.putObject(&apos;db_competition_accounts_rows&apos;, [])

String report = &apos;交易大赛V1账户资金初始化成功 | mode=&apos; + runCase.mode + &apos; | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | accounts=&apos; + requestAccounts.collect { it.instance_id + &apos;:&apos; + it.login }.join(&apos;,&apos;) + &apos; | limit=&apos; + limit + &apos; | cursor=&apos; + (cursor == null ? &apos;&lt;empty&gt;&apos; : cursor) + &apos; | DB查询超时秒数=&apos; + dbQueryTimeoutSeconds + &apos; | DB最大返回行数=&apos; + dbMaxRows
log.info(report + &apos;\nrequestBody=&apos; + requestBody + (runCase.mode == &apos;DB&apos; ? &apos;\nDB SQL=&apos; + detailSql : &apos;&apos;))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setResponseData(report + &apos;\n\n【请求Body】\n&apos; + requestBody + (runCase.mode == &apos;DB&apos; ? &apos;\n\n【数据库明细SQL】\n&apos; + detailSql : &apos;&apos;), &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当shujuku=1-查询交易大赛V1账户资金数据库明细" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;competition_accounts_shujuku&apos;) == &apos;1&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-交易大赛V1账户资金明细(MT4+MT5)" enabled="true">
              <stringProp name="dataSource">mysqlMT5_competition_accounts</stringProp>
              <stringProp name="query">${competition_accounts_detail_sql}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout">${competition_accounts_db_query_timeout_seconds_effective}</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">${competition_accounts_db_result_max_rows_effective}</stringProp>
              <stringProp name="resultVariable">db_competition_accounts_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="交易大赛-批量查询账户资金-${competition_accounts_mode}-${competition_accounts_case_index_display}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">10000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/contest/accounts/query</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${competition_accounts_request_body}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager-JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json; charset=UTF-8</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言POST /v1/accounts/query HTTP状态码为200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">POST /v1/accounts/query HTTP状态码不是200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="交易大赛V1账户资金-响应每个字段、DB或CSV校验" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode

List&lt;String&gt; okLines = []
List&lt;String&gt; failLines = []
List&lt;String&gt; skipLines = []

def publish = { String text, boolean success -&gt;
    vars.put(&apos;competition_accounts_compare_report&apos;, text ?: &apos;&apos;)
    vars.put(&apos;competition_accounts_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    log.info(&apos;\n&apos; + text)
    def detail = new SampleResult()
    detail.setSampleLabel(&apos;交易大赛V1账户资金逐字段校验结果&apos;)
    detail.setSuccessful(success)
    detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    detail.setResponseData(text ?: &apos;&apos;, &apos;UTF-8&apos;)
    detail.setDataType(SampleResult.TEXT)
    detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    long now = System.currentTimeMillis()
    detail.setStartTime(now); detail.setEndTime(now)
    prev.addSubResult(detail)
    AssertionResult.setFailure(!success)
    AssertionResult.setFailureMessage(success ? &apos;&apos; : text)
}

def blank = { Object v -&gt;
    if (v == null) return true
    if (!(v instanceof CharSequence)) return false
    String s = String.valueOf(v).trim()
    !s || s.equalsIgnoreCase(&apos;&lt;empty&gt;&apos;) || s.equalsIgnoreCase(&apos;&lt;null&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)
}
def number = { Object v -&gt;
    if (v == null || v instanceof Boolean) return null
    try {
        String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
        s ? new BigDecimal(s) : null
    } catch (ignored) { null }
}
def integerNumber = { Object v -&gt;
    BigDecimal n = number(v)
    n != null &amp;&amp; n.stripTrailingZeros().scale() &lt;= 0
}
def numText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n == null) return blank(v) ? &apos;&lt;empty&gt;&apos; : String.valueOf(v)
    BigDecimal x = n.stripTrailingZeros()
    x.scale() &lt; 0 ? x.setScale(0).toPlainString() : x.toPlainString()
}
def idText = { Object v -&gt; integerNumber(v) ? number(v).toBigInteger().toString() : (blank(v) ? &apos;&apos; : String.valueOf(v).trim()) }
def norm = { Object v -&gt; String.valueOf(v ?: &apos;&apos;).trim().toLowerCase().replaceAll(/[^a-z0-9]/, &apos;&apos;) }
def setOf = { String raw -&gt;
    Set&lt;String&gt; out = new LinkedHashSet&lt;String&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String x -&gt; if (x.trim()) out &lt;&lt; norm(x) }
    out
}
def valueMap = { String raw -&gt;
    Map&lt;String,BigDecimal&gt; out = new LinkedHashMap&lt;String,BigDecimal&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String token -&gt;
        int p = token.indexOf(&apos;=&apos;)
        BigDecimal n = p &gt; 0 ? number(token.substring(p + 1)) : null
        if (p &gt; 0 &amp;&amp; n != null &amp;&amp; n &gt;= BigDecimal.ZERO) out[norm(token.substring(0, p))] = n
    }
    out
}
def boolVar = { String name, boolean defaultValue -&gt;
    String raw = vars.get(name)
    raw == null || !raw.trim() ? defaultValue : raw.trim().toLowerCase() in [&apos;1&apos;, &apos;true&apos;, &apos;yes&apos;, &apos;on&apos;]
}

Map&lt;String,List&lt;String&gt;&gt; aliases = [
    instance_id: [&apos;instance_id&apos;, &apos;instanceid&apos;], platform: [&apos;platform&apos;, &apos;source&apos;], login: [&apos;login&apos;],
    balance: [&apos;balance&apos;], equity: [&apos;equity&apos;], credit: [&apos;credit&apos;], margin: [&apos;margin&apos;],
    account_currency: [&apos;account_currency&apos;, &apos;currency&apos;], money_scale: [&apos;money_scale&apos;, &apos;moneyscale&apos;],
