          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="init_history_order_new001" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;history_order_db_check_new001.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;history_order_new001 CSV not found: &apos; + csvFile.getPath())
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) throw new AssertionError(&apos;history_order_new001 CSV has no data rows: &apos; + csvFile.getPath())
String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: vars.get(&apos;Login&apos;) ?: &apos;&apos;).trim()
if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;history_order_new001 shujuku must be 0 or 1, actual=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;history_order_new001 order_instanceid_val is empty&apos;)
