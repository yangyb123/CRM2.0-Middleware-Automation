          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="打印查询多个账户挂单订单对比结果" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String finalReport = vars.get(&apos;pending_orders_compare_report&apos;)
if (finalReport == null || finalReport.trim().length() == 0) {
    finalReport = &apos;未生成查询多个账户挂单订单对比结果，请检查前置接口请求和DB或CSV字段对比断言是否执行。&apos;
}
String status = vars.get(&apos;pending_orders_compare_status&apos;) ?: &apos;UNKNOWN&apos;
boolean success = status == &apos;PASS&apos;
SampleResult.setSuccessful(success)
SampleResult.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(status)
SampleResult.setDataType(SampleResult.TEXT)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(finalReport, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">独立打印上一节点生成的查询多个账户挂单订单字段对比结果，方便在查看结果树直接点击查看。</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="查询多个账户的当前持仓订单--性能测试大数据量测试" enabled="false">
        <stringProp name="TestPlan.comments">list_open_positions：按CSV行数循环；shujuku=1时聚合CSV中全部 shujuku=1 的 accounts 一次请求并DB/API对比；shujuku=0时按当前CSV行做CSV/API对比。只修改本线程组。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="查询多个账户当前持仓CSV循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;查询多个账户的当前持仓订单.csv&apos;); if (!f.exists()) return 0; def lines = f.readLines(&apos;UTF-8&apos;); if (lines.size() &lt;= 1) return 0; boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = -1; for (int j = 0; j &lt; line.length(); j++) { if ((int)line.charAt(j) == 44) { p = j; break } }; String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == (65279 as char)) first = first.drop(1); first = first.trim(); if (first.length() &gt;= 2 &amp;&amp; first.charAt(0) == (&apos;&quot;&apos; as char) &amp;&amp; first.charAt(first.length() - 1) == (&apos;&quot;&apos; as char)) first = first.drop(1).take(first.length() - 2).trim(); if (first == &apos;1&apos;) hasDb = true; else if (first == &apos;0&apos;) csvCount++ } }; return csvCount + (hasDb ? 1 : 0))}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="查询多个账户的当前持仓订单事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户当前持仓" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的当前持仓订单.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_deal_ticket,filter_symbol,order_types,open_time_from_utc_ms,open_time_to_utc_ms,volume_lots_condition,volume_lots_value,floating_pl,sort_by,sort_order,reason,symbol,position_ticket,updated_utc_ms,fee,open_time_utc_ms,price_open,margin_rate,source,price_sl,commission,digits_currency,state,order_type,profit,price_current,volume_lots,side,swap,deal_ticket,price_tp,order_ticket,instance_id,net_profit,comment,digits,contract_size,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户当前持仓DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="open_positions_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">open_positions_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">comment,updated_utc_ms,contract_size</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段跳过配置；同时控制summary和当前页明细；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
              <elementProp name="open_positions_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">open_positions_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,net_profit=50,cent_volume=1,total_volume=0,standard_volume=0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段百分比误差配置；支持 field=20、field:20、field 20、field=20%、field,20 等输入；多个字段可用逗号/分号/空格/换行分隔；未配置字段默认10；0表示必须完全相等。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">跳过字段仍由 open_positions_db_api_disabled_compare_fields 控制；字段误差由 open_positions_db_api_field_tolerance_percent 控制，例如 profit=20,net_profit=50,cent_volume=1；DB/API模式下会继续合并 open_positions_csv_api_field_tolerance_percent，同字段以CSV/API配置覆盖；未配置字段默认10%；total_volume/standard_volume 默认配置0表示完全相等。
comment,（数据库是中文乱码）updated_utc_ms -接口更新时间   deal_ticket 是 eamon 说用到了</stringProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户当前持仓CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="open_positions_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">open_positions_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
              <elementProp name="open_positions_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">open_positions_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=100,net_profit=100,cent_volume=1,total_volume=1,standard_volume=1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段百分比误差配置；支持 field=20、field:20、field 20、field=20%、field,20 等输入；多个字段可用逗号/分号/空格/换行分隔；CSV/API模式直接生效；DB/API模式下也会作为覆盖配置合并，同字段以这里为准；未配置字段默认5；0表示必须完全相等。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户当前持仓参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的当前持仓订单.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户当前持仓CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户当前持仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户当前持仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户当前持仓CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;open_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户当前持仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;open_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String platform = platformOf(instanceId)
    List loginValues = splitList(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;])).collect { cleanInt(it) }.findAll { it }
    if (!loginValues) {
        String singleLogin = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
        if (singleLogin) loginValues &lt;&lt; singleLogin
    }
    loginValues.each { login -&gt;
        if (instanceId &amp;&amp; login &amp;&amp; platform) {
            String key = instanceId + &apos;|&apos; + login
            if (!accountKeys.contains(key)) {
                accountKeys &lt;&lt; key
                accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
            }
            if (platform == &apos;MT4&apos;) {
                mt4Logins &lt;&lt; login
                mt4LoginInstance[login] = instanceId
            } else if (platform == &apos;MT5&apos;) {
                mt5Logins &lt;&lt; login
                mt5LoginInstance[login] = instanceId
            }
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户当前持仓没有可用accounts，CSV需要填写 order_instanceid_val/order_login 或 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;open_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;filter_symbol&apos;, &apos;symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String openFrom = cleanInt(firstValue(currentRow, [&apos;open_time_from_utc_ms&apos;, &apos;open_time_utc_ms__gte&apos;, &apos;open_time_from&apos;]))
String openTo = cleanInt(firstValue(currentRow, [&apos;open_time_to_utc_ms&apos;, &apos;open_time_utc_ms__lte&apos;, &apos;open_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;filter_volume_lots_value&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (openFrom) filters[&apos;open_time_from_utc_ms&apos;] = Long.parseLong(openFrom)
if (openTo) filters[&apos;open_time_to_utc_ms&apos;] = Long.parseLong(openTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;open_positions_shujuku&apos;, shujuku)
vars.put(&apos;open_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;open_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;open_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;open_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;open_positions_request_body&apos;, requestBody)
vars.put(&apos;open_positions_page&apos;, page)
vars.put(&apos;open_positions_page_size&apos;, pageSize)
vars.put(&apos;open_positions_sort_by&apos;, sortBy)
vars.put(&apos;open_positions_sort_order&apos;, sortOrder)
vars.put(&apos;open_positions_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;open_positions_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;open_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_open_positions_summary_rows&apos;, [])
vars.putObject(&apos;db_open_positions_page_rows&apos;, [])

String openMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String updateMsMt4 = &quot;CASE WHEN mt.TIMESTAMP IS NOT NULL AND mt.TIMESTAMP &gt; 0 THEN CAST(mt.TIMESTAMP AS UNSIGNED) * 1000 ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.MODIFY_TIME) / 1000 AS UNSIGNED) END&quot;
String openMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeCreateMsc) / 1000 AS UNSIGNED)&quot;
String updateMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeUpdateMsc) / 1000 AS UNSIGNED)&quot;
String mt5VolumeExpr = &quot;(CASE WHEN mt.VolumeExt &gt; 0 THEN mt.VolumeExt / 100000000.0 ELSE mt.Volume / 10000.0 END)&quot;
String orderTypeSql = orderTypeList ? orderTypeList.join(&apos;,&apos;) : &apos;0,1&apos;
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

String mt4LoginSql = mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;
String mt5LoginSql = mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + mt4LoginSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.VOLUME &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.OPEN_PRICE &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.CLOSE_TIME IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;mt.CLOSE_TIME &lt;= &apos;1970-01-02 00:00:00&apos;&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (filterDealTicket) mt4Where &lt;&lt; (filterDealTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;0 = &apos; + filterDealTicket)
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (openFrom) mt4Where &lt;&lt; openMsMt4 + &apos; &gt;= &apos; + openFrom
if (openTo) mt4Where &lt;&lt; openMsMt4 + &apos; &lt;= &apos; + openTo
if (volumeValue) mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &lt; 0&apos;

List mt5Where = []
mt5Where &lt;&lt; &apos;mt.Login IN (&apos; + mt5LoginSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;mt.Position &gt; 0&apos;
mt5Where &lt;&lt; &apos;mt.Symbol IS NOT NULL&apos;
mt5Where &lt;&lt; &quot;TRIM(mt.Symbol) &lt;&gt; &apos;&apos;&quot;
mt5Where &lt;&lt; &quot;mt.Symbol REGEXP &apos;[A-Za-z]&apos;&quot;
mt5Where &lt;&lt; &apos;mt.Action IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;(mt.VolumeExt &gt; 0 OR mt.Volume &gt; 0)&apos;
mt5Where &lt;&lt; &apos;mt.PriceOpen &gt; 0&apos;
if (filterOrderTicket) mt5Where &lt;&lt; &apos;mt.Position = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; &apos;mt.Position = &apos; + filterPositionTicket
if (filterDealTicket) mt5Where &lt;&lt; &apos;COALESCE(ds.deal_ticket, 0) = &apos; + filterDealTicket
if (symbol) mt5Where &lt;&lt; &apos;mt.Symbol = &apos; + sqlQuote(symbol)
if (openFrom) mt5Where &lt;&lt; openMsMt5 + &apos; &gt;= &apos; + openFrom
if (openTo) mt5Where &lt;&lt; openMsMt5 + &apos; &lt;= &apos; + openTo
if (volumeValue) mt5Where &lt;&lt; mt5VolumeExpr + &apos; &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt5Where &lt;&lt; &apos;mt.Profit &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt5Where &lt;&lt; &apos;mt.Profit &lt; 0&apos;

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;mt.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.TICKET AS position_ticket,
  0 AS deal_ticket,
  mt.SYMBOL AS symbol,
  mt.CMD AS order_type,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.CMD) END AS side,
  0 AS state,
  mt.REASON AS reason,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS price_open,
  mt.CLOSE_PRICE AS price_current,
  mt.SL AS price_sl,
  mt.TP AS price_tp,
  mt.PROFIT AS profit,
  mt.SWAPS AS swap,
  mt.COMMISSION AS commission,
  0 AS fee,
  mt.PROFIT + mt.SWAPS + mt.COMMISSION AS net_profit,
  ${openMsMt4} AS open_time_utc_ms,
  ${updateMsMt4} AS updated_utc_ms,
  mt.DIGITS AS digits,
  2 AS digits_currency,
  100000.0 AS contract_size,
  mt.MARGIN_RATE AS margin_rate,
  mt.COMMENT AS comment,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USC&apos;) THEN 1 ELSE 0 END AS is_cent_account
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  mt.Login AS login,
  &apos;mt5&apos; AS source,
  mt.Position AS order_ticket,
  mt.Position AS position_ticket,
  COALESCE(ds.deal_ticket, 0) AS deal_ticket,
  mt.Symbol AS symbol,
  mt.Action AS order_type,
  CASE mt.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.Action) END AS side,
  0 AS state,
  mt.Reason AS reason,
  ${mt5VolumeExpr} AS volume_lots,
  mt.PriceOpen AS price_open,
  mt.PriceCurrent AS price_current,
  mt.PriceSL AS price_sl,
  mt.PriceTP AS price_tp,
  mt.Profit AS profit,
  mt.Storage AS swap,
  COALESCE(ds.commission, 0) AS commission,
  0 AS fee,
  mt.Profit + mt.Storage + COALESCE(ds.commission, 0) AS net_profit,
  ${openMsMt5} AS open_time_utc_ms,
  ${updateMsMt5} AS updated_utc_ms,
  mt.Digits AS digits,
  mt.DigitsCurrency AS digits_currency,
  mt.ContractSize AS contract_size,
  mt.RateMargin AS margin_rate,
  mt.Comment AS comment,
  CASE WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) IN (&apos;USC&apos;) THEN 1 ELSE 0 END AS is_cent_account
FROM mt5_report.mt5_positions mt
LEFT JOIN (
  SELECT d1.Login, MAX(COALESCE(d1.Currency, &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${mt5LoginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) acct_currency ON acct_currency.Login = mt.Login
LEFT JOIN (
  SELECT
    d.Login,
    d.PositionID,
    d.Symbol,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Deal ORDER BY d.TimeMsc ASC, d.Deal ASC), &apos;,&apos;, 1) + 0 AS deal_ticket,
    SUM(d.Commission) AS commission
  FROM mt5_report.mt5_deals d
  WHERE d.Login IN (${mt5LoginSql})
    AND d.Action IN (0, 1)
    AND d.PositionID &gt; 0
  GROUP BY d.Login, d.PositionID, d.Symbol
) ds
  ON ds.Login = mt.Login
 AND ds.PositionID = mt.Position
 AND ds.Symbol = mt.Symbol
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;open_time_utc_ms&apos;, &apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;, &apos;profit&apos;, &apos;volume_lots&apos;, &apos;login&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;open_time_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String openRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN 0 ELSE volume_lots END), 0) AS standard_volume,
  COALESCE(SUM(COALESCE(commission, 0)), 0) AS total_commission,
  COALESCE(SUM(COALESCE(fee, 0)), 0) AS total_raw_fee,
  COALESCE(SUM(COALESCE(commission, 0) + COALESCE(fee, 0)), 0) AS total_fee,
  COALESCE(SUM(swap), 0) AS total_storage,
  COALESCE(SUM(profit), 0) AS total_profit
FROM (
${openRowsSql}
) open_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  reason,
  symbol,
  position_ticket,
  updated_utc_ms,
  fee,
  COALESCE(commission, 0) + COALESCE(fee, 0) AS row_total_fee,
  open_time_utc_ms,
  price_open,
  margin_rate,
  source,
  login,
  price_sl,
  commission,
  digits_currency,
  state,
  order_type,
  profit,
  price_current,
  volume_lots,
  side,
  swap,
  deal_ticket,
  price_tp,
  order_ticket,
  instance_id,
  net_profit,
  comment,
  digits,
  contract_size
FROM (
${openRowsSql}
) open_rows
ORDER BY ${sortColumn} ${dbOrder}, position_ticket ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
vars.put(&apos;open_positions_summary_sql&apos;, summarySqlExec)
vars.put(&apos;open_positions_page_sql&apos;, pageSqlExec)

String initReport = &apos;list_open_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;open_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;open_positions_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;init passed&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + &apos;\n\n【统计summary SQL（MT4+MT5合并，只查询一次，实际执行SQL）】\n&apos; + summarySqlExec + &apos;\n\n【当前页明细 SQL（MT4+MT5合并，实际执行SQL）】\n&apos; + pageSqlExec, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
