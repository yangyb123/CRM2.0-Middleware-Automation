          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="待处理/历史订单CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="order_ex_csv_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">order_ex_csv_disabled_compare_fields</stringProp>
