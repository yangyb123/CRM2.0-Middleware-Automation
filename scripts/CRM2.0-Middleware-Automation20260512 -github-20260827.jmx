          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化交易大赛V1持仓参数、请求Body和数据库SQL" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;交易大赛-批量查询指定账户的当前未平仓持仓.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim() }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List&lt;String&gt; values = []
    StringBuilder cell = new StringBuilder()
    boolean quoted = false
    for (int i = 0; i &lt; line.length(); i++) {
        char ch = line.charAt(i)
        if (ch == (&apos;&quot;&apos; as char)) {
            if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cell.append(&apos;&quot;&apos;)
                i++
            } else {
                quoted = !quoted
            }
        } else if (ch == (&apos;,&apos; as char) &amp;&amp; !quoted) {
            values &lt;&lt; cell.toString()
            cell.setLength(0)
        } else {
            cell.append(ch)
        }
    }
    values &lt;&lt; cell.toString()
    values
}

List&lt;String&gt; headers = parseCsvLine(rawLines[0]).collect { String.valueOf(it).trim() }
if (headers &amp;&amp; headers[0].startsWith(&apos;\uFEFF&apos;)) headers[0] = headers[0].substring(1)
List&lt;Map&gt; csvRows = []
rawLines.drop(1).eachWithIndex { String line, int idx -&gt;
    List&lt;String&gt; values = parseCsvLine(line)
    Map row = new LinkedHashMap()
    headers.eachWithIndex { String h, int c -&gt; row[h] = c &lt; values.size() ? values[c].trim() : &apos;&apos; }
    row[&apos;__line_no&apos;] = idx + 2
    String mode = String.valueOf(row[&apos;shujuku&apos;] ?: &apos;&apos;).trim()
    if (mode == &apos;0&apos; || mode == &apos;1&apos;) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;CSV没有有效数据：shujuku 必须为 1(DB/API) 或 0(CSV/API)&apos;)

List&lt;Map&gt; dbRows = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;1&apos; }
List&lt;Map&gt; csvModeRows = csvRows.findAll { String.valueOf(it.shujuku).trim() == &apos;0&apos; }
List&lt;Map&gt; runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, rows: dbRows, row: dbRows[0]]
csvModeRows.each { Map row -&gt; runCases &lt;&lt; [mode: &apos;CSV&apos;, rows: [row], row: row] }

int caseIndex = 0
try { caseIndex = Integer.parseInt(vars.get(&apos;competition_positions_case_index&apos;) ?: &apos;0&apos;) } catch (ignored) { caseIndex = 0 }
if (caseIndex &lt; 0 || caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;CSV执行索引越界: &apos; + caseIndex + &apos;/&apos; + runCases.size())
Map runCase = runCases[caseIndex]
vars.put(&apos;competition_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map currentRow = runCase.row as Map

def textOf = { Object v -&gt; v == null ? &apos;&apos; : String.valueOf(v).trim() }
def intValue = { Object raw, int defaultValue, int minValue, int maxValue, String field -&gt;
    String s = textOf(raw)
    int n = s ? Integer.parseInt(s) : defaultValue
    if (n &lt; minValue || n &gt; maxValue) throw new AssertionError(field + &apos; 超出范围[&apos; + minValue + &apos;,&apos; + maxValue + &apos;]: &apos; + n)
    n
}
def inferPlatform = { Map row -&gt;
    String p = textOf(row.platform).toLowerCase()
    if (p in [&apos;mt4&apos;, &apos;mt5&apos;]) return p
    String instance = textOf(row.instance_id).toUpperCase()
    instance.contains(&apos;MT4&apos;) ? &apos;mt4&apos; : (instance.contains(&apos;MT5&apos;) ? &apos;mt5&apos; : &apos;&apos;)
}

List&lt;Map&gt; accounts = []
Set&lt;String&gt; seenAccounts = new LinkedHashSet&lt;String&gt;()
(runCase.rows as List&lt;Map&gt;).each { Map row -&gt;
    String instanceId = textOf(row.instance_id)
    String loginText = textOf(row.login)
    if (!instanceId) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 instance_id 不能为空&apos;)
    if (!(loginText ==~ /^\d+$/)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 必须为int64数字: &apos; + loginText)
    BigInteger loginBig = new BigInteger(loginText)
    if (loginBig &lt; BigInteger.ONE || loginBig &gt; new BigInteger(&apos;9223372036854775807&apos;)) throw new AssertionError(&apos;CSV第&apos; + row.__line_no + &apos;行 login 必须在正int64范围[1,9223372036854775807]: &apos; + loginText)
    String key = instanceId + &apos;|&apos; + loginText
    if (seenAccounts.add(key)) accounts &lt;&lt; [instance_id: instanceId, login: loginBig.longValue(), platform: inferPlatform(row), __line_no: row.__line_no]
}
if (!accounts) throw new AssertionError(&apos;没有可用 accounts&apos;)

int limit = intValue(currentRow.limit, 500, 1, 10000, &apos;limit&apos;)
String cursorText = textOf(currentRow.cursor)
Object cursor = (!cursorText || cursorText.equalsIgnoreCase(&apos;null&apos;) || cursorText == &apos;&lt;empty&gt;&apos;) ? null : cursorText
List&lt;Map&gt; requestAccounts = accounts.collect { [instance_id: it.instance_id, login: it.login] }
Map request = [accounts: requestAccounts, limit: limit, cursor: cursor]
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(request))

int dbMaxRows = intValue(currentRow.db_result_max_rows, 5000, 1, 50000, &apos;db_result_max_rows&apos;)
def sqlQuote = { Object raw -&gt; &quot;&apos;&quot; + textOf(raw).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot; }
def instanceCase = { String loginExpr, Map&lt;String,String&gt; loginInstance -&gt;
    String cases = loginInstance.collect { String login, String instance -&gt; &apos;WHEN &apos; + login + &apos; THEN &apos; + sqlQuote(instance) }.join(&apos; &apos;)
    &apos;CASE &apos; + loginExpr + &apos; &apos; + cases + &quot; ELSE &apos;&lt;unknown-instance&gt;&apos; END&quot;
}
List&lt;String&gt; sqlParts = []
if (runCase.mode == &apos;DB&apos;) {
    Map&lt;String,String&gt; mt4LoginInstance = new LinkedHashMap&lt;String,String&gt;()
    Map&lt;String,String&gt; mt5LoginInstance = new LinkedHashMap&lt;String,String&gt;()
    accounts.each { Map account -&gt;
        if (!(account.platform in [&apos;mt4&apos;, &apos;mt5&apos;])) throw new AssertionError(&apos;DB模式无法从CSV识别平台，请填写 platform=mt4/mt5: &apos; + account.instance_id + &apos;:&apos; + account.login)
        Map&lt;String,String&gt; target = account.platform == &apos;mt4&apos; ? mt4LoginInstance : mt5LoginInstance
        String loginKey = String.valueOf(account.login)
        if (target.containsKey(loginKey) &amp;&amp; target[loginKey] != account.instance_id) throw new AssertionError(&apos;同一平台相同login映射到多个instance，数据库无法消歧: &apos; + loginKey)
        target[loginKey] = String.valueOf(account.instance_id)
    }
    if (mt5LoginInstance) {
        String loginSql = mt5LoginInstance.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;mt.Login&apos;, mt5LoginInstance)
        String volumeExpr = &apos;(CASE WHEN mt.VolumeExt &gt; 0 THEN mt.VolumeExt / 100000000.0 ELSE mt.Volume / 10000.0 END)&apos;
        String openMsExpr = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeCreateMsc) / 1000 AS UNSIGNED)&quot;
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt5&apos; AS platform,
  CONCAT(CAST(mt.Login AS CHAR), &apos;:&apos;, mt.Symbol, &apos;:&apos;, CAST(mt.Position AS CHAR)) AS position_id,
  CONCAT(${instanceExpr}, &apos;:mt5:&apos;, CAST(mt.Login AS CHAR), &apos;:&apos;, mt.Symbol, &apos;:&apos;, CAST(mt.Position AS CHAR), &apos;:0&apos;) AS position_lifecycle_id,
  mt.Position AS order_id,
  mt.Login AS login,
  CASE mt.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.Action) END AS side,
  mt.Symbol AS symbol,
  CAST(NULL AS CHAR) AS symbol_id,
  ${volumeExpr} AS volume_lots,
  mt.PriceOpen AS open_price,
  ${openMsExpr} AS open_time_ms,
  mt.Profit AS profit,
  UPPER(TRIM(NULLIF(acct.Currency, &apos;&apos;))) AS account_currency,
  CAST(NULL AS DECIMAL(65,5)) AS open_notional_value_usd,
  &apos;unresolved&apos; AS notional_status,
  &apos;event_time_usd_mid_price&apos; AS notional_method,
  1 AS notional_calculation_version
FROM mt5_report.mt5_positions mt
LEFT JOIN (
  SELECT d1.Login, MAX(COALESCE(d1.Currency, &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${loginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) acct ON acct.Login = mt.Login
WHERE mt.Login IN (${loginSql})
  AND mt.Position &gt; 0
  AND mt.Action IN (0, 1)
  AND mt.Symbol IS NOT NULL
  AND TRIM(mt.Symbol) &lt;&gt; &apos;&apos;
  AND (mt.VolumeExt &gt; 0 OR mt.Volume &gt; 0)
&quot;&quot;&quot;.trim()
    }
    if (mt4LoginInstance) {
        String loginSql = mt4LoginInstance.keySet().join(&apos;,&apos;)
        String instanceExpr = instanceCase(&apos;mt.LOGIN&apos;, mt4LoginInstance)
        String openMsExpr = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
        sqlParts &lt;&lt; &quot;&quot;&quot;
SELECT
  ${instanceExpr} AS instance_id,
  &apos;mt4&apos; AS platform,
  CONCAT(CAST(mt.LOGIN AS CHAR), &apos;:&apos;, mt.SYMBOL, &apos;:&apos;, CAST(mt.TICKET AS CHAR)) AS position_id,
  CONCAT(${instanceExpr}, &apos;:mt4:&apos;, CAST(mt.LOGIN AS CHAR), &apos;:&apos;, mt.SYMBOL, &apos;:&apos;, CAST(mt.TICKET AS CHAR), &apos;:0&apos;) AS position_lifecycle_id,
  mt.TICKET AS order_id,
  mt.LOGIN AS login,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.CMD) END AS side,
  mt.SYMBOL AS symbol,
  CAST(NULL AS CHAR) AS symbol_id,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS open_price,
  ${openMsExpr} AS open_time_ms,
  mt.PROFIT AS profit,
  UPPER(TRIM(NULLIF(u.CURRENCY, &apos;&apos;))) AS account_currency,
  CAST(NULL AS DECIMAL(65,5)) AS open_notional_value_usd,
  &apos;unresolved&apos; AS notional_status,
  &apos;event_time_usd_mid_price&apos; AS notional_method,
  1 AS notional_calculation_version
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE mt.LOGIN IN (${loginSql})
  AND mt.TICKET &gt; 0
  AND mt.CMD IN (0, 1)
  AND mt.SYMBOL IS NOT NULL
  AND TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;
  AND mt.VOLUME &gt; 0
  /* 兼容 MT4 未平仓 CLOSE_TIME 的两种存储形式：NULL 或 1970 年纪元占位值；
     避免漏查 CLOSE_TIME=NULL 的当前持仓（例如 MT4_1/1131）。 */
  AND (mt.CLOSE_TIME IS NULL
       OR mt.CLOSE_TIME &lt;= &apos;1970-01-02 00:00:00&apos;)
&quot;&quot;&quot;.trim()
    }
}
String detailSql = sqlParts ? (&apos;SELECT * FROM (&apos; + sqlParts.join(&apos; UNION ALL &apos;) + &apos;) competition_positions ORDER BY instance_id, login, symbol, position_id, order_id LIMIT &apos; + dbMaxRows) : &quot;SELECT &apos;&apos; AS instance_id, &apos;&apos; AS platform, CAST(NULL AS CHAR) AS position_id, CAST(NULL AS CHAR) AS position_lifecycle_id, NULL AS order_id, NULL AS login, &apos;&apos; AS side, &apos;&apos; AS symbol, CAST(NULL AS CHAR) AS symbol_id, NULL AS volume_lots, NULL AS open_price, NULL AS open_time_ms, NULL AS profit, CAST(NULL AS CHAR) AS account_currency, CAST(NULL AS DECIMAL(65,5)) AS open_notional_value_usd, &apos;unresolved&apos; AS notional_status, &apos;event_time_usd_mid_price&apos; AS notional_method, 1 AS notional_calculation_version WHERE 1=0&quot;
// JDBC 请求使用单行 SQL；先移除潜在的 SQL 行注释，避免“--”吞掉右括号、ORDER BY 和 LIMIT。
String jdbcSql = detailSql.replaceAll(/(?m)^\s*--.*$/, &apos; &apos;).replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
if (!jdbcSql || !(jdbcSql ==~ /(?is)^SELECT\s+.+/)) throw new AssertionError(&apos;数据库明细 SQL 生成失败或不是 SELECT 语句&apos;)
if (jdbcSql.contains(&apos;--&apos;)) throw new AssertionError(&apos;数据库明细 SQL 仍含不安全的行注释，已阻止执行: &apos; + jdbcSql)

vars.put(&apos;competition_positions_mode&apos;, String.valueOf(runCase.mode))
vars.put(&apos;competition_positions_shujuku&apos;, runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;)
vars.put(&apos;competition_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;competition_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;competition_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;competition_positions_request_body&apos;, requestBody)
vars.put(&apos;competition_positions_detail_sql&apos;, jdbcSql)
vars.put(&apos;competition_positions_limit&apos;, String.valueOf(limit))
vars.put(&apos;competition_positions_cursor&apos;, cursor == null ? &apos;&apos; : String.valueOf(cursor))
vars.put(&apos;competition_positions_db_result_max_rows&apos;, String.valueOf(dbMaxRows))
vars.putObject(&apos;competition_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;competition_positions_request_accounts&apos;, requestAccounts)
vars.putObject(&apos;db_competition_positions_rows&apos;, [])

String initReport = &apos;交易大赛V1持仓初始化成功 | mode=&apos; + runCase.mode + &apos; | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | accounts=&apos; + requestAccounts.collect { it.instance_id + &apos;:&apos; + it.login }.join(&apos;,&apos;) + &apos; | limit=&apos; + limit + &apos; | cursor=&apos; + (cursor == null ? &apos;&lt;empty&gt;&apos; : cursor)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody + (runCase.mode == &apos;DB&apos; ? &apos;\nDB SQL=&apos; + detailSql : &apos;&apos;))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + (runCase.mode == &apos;DB&apos; ? &apos;\n\n【数据库明细SQL】\n&apos; + detailSql : &apos;&apos;), &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">手工读取新CSV并生成只包含 accounts/limit/cursor 的 V1 请求；DB模式按MT4/MT5账号生成当前未平仓SQL。SQL输出OpenAPI 7规定的全部18个data字段；报表库无成交时点USD投影时，名义价值字段按文档安全语义输出NULL/unresolved，禁止用当前行情回填。</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当shujuku=1-查询交易大赛当前未平仓持仓数据库明细" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;competition_positions_shujuku&apos;) == &apos;1&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-交易大赛V1当前未平仓持仓明细(MT4+MT5)" enabled="true">
              <stringProp name="dataSource">mysqlMT5_competition_positions</stringProp>
              <stringProp name="query">${competition_positions_detail_sql}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout">20</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">50000</stringProp>
              <stringProp name="resultVariable">db_competition_positions_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="交易大赛-批量查询指定账户的当前未平仓持仓" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">10000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/contest/positions/query</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${competition_positions_request_body}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager-JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json; charset=UTF-8</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言HTTP状态码为200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">POST /v1/positions/query HTTP状态码不是200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="交易大赛V1当前未平仓持仓-响应字段、DB或CSV及calc_profit校验" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode

String responseText = prev.getResponseDataAsString()
List&lt;String&gt; okLines = []
List&lt;String&gt; failLines = []
List&lt;String&gt; skipLines = []

def publish = { String text, boolean success -&gt;
    vars.put(&apos;competition_positions_compare_report&apos;, text ?: &apos;&apos;)
    vars.put(&apos;competition_positions_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    log.info(&apos;\n&apos; + text)
    def detail = new SampleResult()
    detail.setSampleLabel(&apos;交易大赛V1当前未平仓持仓字段与calc_profit校验结果&apos;)
    detail.setSuccessful(success)
    detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    detail.setResponseData(text ?: &apos;&apos;, &apos;UTF-8&apos;)
    detail.setDataType(SampleResult.TEXT)
    detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    long detailTime = System.currentTimeMillis()
    detail.setStartTime(detailTime)
    detail.setEndTime(detailTime)
    prev.addSubResult(detail)
    AssertionResult.setFailure(!success)
    AssertionResult.setFailureMessage(success ? &apos;&apos; : text)
}

def blank = { Object v -&gt; v == null || (v instanceof CharSequence &amp;&amp; String.valueOf(v).trim().isEmpty()) }
def number = { Object v -&gt;
    if (v == null || v instanceof Boolean) return null
    try { new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)) } catch (ignored) { null }
}
def numText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n == null) return blank(v) ? &apos;&lt;empty&gt;&apos; : String.valueOf(v)
    BigDecimal x = n.stripTrailingZeros()
    x.scale() &lt; 0 ? x.setScale(0).toPlainString() : x.toPlainString()
}
def idText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n != null &amp;&amp; n.stripTrailingZeros().scale() &lt;= 0) return n.toBigInteger().toString()
