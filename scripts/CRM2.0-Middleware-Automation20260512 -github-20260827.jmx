              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname=" 断言 ${login_val} 权限 ${Rights}" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def rights = vars.get(&quot;Rights&quot;)
def rightsVal = vars.get(&quot;rights_val&quot;)
def instanceId = vars.get(&quot;instanceid_val&quot;)

// 转换为整数进行比较（如果变量可能是字符串类型）
def rightsInt = rights?.isInteger() ? rights.toInteger() : 0
def rightsValInt = rightsVal?.isInteger() ? rightsVal.toInteger() : 0

def isValid = false

if (instanceId == &quot;MT4_1&quot;) {
    // MT4特殊映射规则
    if ((rightsValInt == 354 &amp;&amp; rightsInt == 358) || 
        (rightsValInt == 866 &amp;&amp; rightsInt == 870)) {
        isValid = true
    } else if (rightsInt == rightsValInt) {
        // 普通相等也视为正确
        isValid = true
    }
} else {
    // 其他平台（如MT5）直接比较
    if (rightsInt == rightsValInt) {
        isValid = true
    }
}

if (!isValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(
        &quot;权限校验失败！平台: ${instanceId}, &quot; +
        &quot;实际Rights: ${rights}(${rightsInt}), &quot; +
        &quot;预期rights_val: ${rightsVal}(${rightsValInt})&quot;
    )
}
</stringProp>
              </JSR223Assertion>
