              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
              <stringProp name="HTTPSampler.path">/crm20/get_position_ex?instanceid=${order_instanceid_val}&amp;login=${acct_metrics_login}&amp;_limit=200</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取辅助持仓数量-position_count" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

String body = prev.getResponseDataAsString()
vars.put(&apos;acct_metrics_position_response&apos;, body ?: &apos;&apos;)
vars.put(&apos;acct_metrics_position_total&apos;, &apos;&apos;)
vars.put(&apos;acct_metrics_position_swap_total&apos;, &apos;&apos;)
vars.put(&apos;acct_metrics_position_commission_total&apos;, &apos;&apos;)

try {
    def json = new JsonSlurper().parseText(body ?: &apos;{}&apos;)
    def total = json?.meta?.total
    if (total == null &amp;&amp; json?.data instanceof List) total = json.data.size()
    if (total != null) vars.put(&apos;acct_metrics_position_total&apos;, String.valueOf(total))

    if (json?.data instanceof List) {
        List rows = json.data.findAll { it instanceof Map }
        boolean completePage = total == null
        if (total != null) {
            try { completePage = rows.size() &gt;= new BigDecimal(String.valueOf(total)).intValue() } catch (Throwable ignored) {}
        }
        if (completePage) {
            def valueOf = { Map row, List names -&gt;
                def entry = row.entrySet().find { e -&gt; names.any { n -&gt; e.key?.toString()?.equalsIgnoreCase(n) } }
                return entry?.value
            }
            def asNum = { Object value -&gt;
                if (value == null || String.valueOf(value).trim().isEmpty()) return null
                try { return new BigDecimal(String.valueOf(value).replace(&apos;,&apos;, &apos;&apos;).trim()) } catch (Throwable ignored) { return null }
            }
            BigDecimal swapSum = BigDecimal.ZERO
            BigDecimal commissionSum = BigDecimal.ZERO
            boolean swapSeen = rows.isEmpty()
            boolean commissionSeen = rows.isEmpty()
            rows.each { Map row -&gt;
                BigDecimal swap = asNum(valueOf(row, [&apos;swap&apos;, &apos;storage&apos;]))
                BigDecimal commission = asNum(valueOf(row, [&apos;commission&apos;]))
                if (swap != null) { swapSum = swapSum.add(swap); swapSeen = true }
                if (commission != null) { commissionSum = commissionSum.add(commission); commissionSeen = true }
            }
            if (swapSeen) vars.put(&apos;acct_metrics_position_swap_total&apos;, swapSum.stripTrailingZeros().toPlainString())
            if (commissionSeen) vars.put(&apos;acct_metrics_position_commission_total&apos;, commissionSum.stripTrailingZeros().toPlainString())
        } else {
            log.warn(&apos;account metrics helper get_position_ex page incomplete; skip swap/commission sum | returned=&apos; + rows.size() + &apos; | total=&apos; + total)
        }
    }
    log.info(&apos;account metrics helper position_count=&apos; + vars.get(&apos;acct_metrics_position_total&apos;) + &apos; | swap_total=&apos; + vars.get(&apos;acct_metrics_position_swap_total&apos;) + &apos; | commission_total=&apos; + vars.get(&apos;acct_metrics_position_commission_total&apos;) + &apos; | login=&apos; + vars.get(&apos;acct_metrics_login&apos;))
} catch (Throwable e) {
    log.warn(&apos;account metrics helper get_position_ex parse failed: &apos; + e.message)
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="辅助接口-get_user_info账户字段-${acct_metrics_login}-${order_instanceid_val}" enabled="true">
              <intProp name="HTTPSampler.connect_timeout">3000</intProp>
              <intProp name="HTTPSampler.response_timeout">5000</intProp>
              <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
