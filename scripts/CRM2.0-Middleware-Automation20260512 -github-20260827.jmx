                <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def expectedLogin = vars.get(&quot;login_val&quot;)

def allMatch = json.data.every { item -&gt;

    // 忽略字段名大小写
    def actualLogin = item.find { k, v -&gt;
        k.equalsIgnoreCase(&quot;login&quot;)
    }?.value

    actualLogin?.toString() == expectedLogin
}

if (!allMatch) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;存在 login 字段值不等于 ${expectedLogin} 的数据&quot;)
}</stringProp>
