def compare = { String field, Object api, Object expected, String source, Map&lt;String,BigDecimal&gt; percentMap, BigDecimal defaultPercent, Map&lt;String,BigDecimal&gt; absoluteMap, BigDecimal defaultAbsolute -&gt;
    if (blank(api) &amp;&amp; blank(expected)) {
        String note = norm(field) == &apos;storage&apos; &amp;&amp; source == &apos;DB&apos; ? &apos;API=空 和 DB 查询字段数据是空，通过&apos; : &apos;API 和 &apos; + source + &apos; 返回都是为空，通过&apos;
        return [same:true,api:&apos;&lt;empty&gt;&apos;,expected:&apos;&lt;empty&gt;&apos;,diff:&apos;N/A&apos;,percent:&apos;N/A(empty)&apos;,formula:&apos;empty == empty&apos;,note:note]
    }
    BigDecimal an = number(api)
    if (source == &apos;DB&apos; &amp;&amp; an != null &amp;&amp; an == BigDecimal.ZERO &amp;&amp; blank(expected)) return [same:true,api:&apos;0&apos;,expected:&apos;&lt;empty&gt;&apos;,diff:&apos;N/A&apos;,percent:&apos;N/A(API=0,DB=empty)&apos;,formula:&apos;API=0 and DB=&lt;empty&gt;&apos;,note:&apos;API=0 和 DB 查询字段数据是空，通过&apos;]
    if (blank(api) || blank(expected)) {
        String note = blank(api) ? &apos;API为空但&apos; + source + &apos;有值，失败&apos; : source + &apos;为空但API有值，失败&apos;
        return [same:false,api:blank(api)?&apos;&lt;empty&gt;&apos;:String.valueOf(api),expected:blank(expected)?&apos;&lt;empty&gt;&apos;:String.valueOf(expected),diff:&apos;N/A&apos;,percent:&apos;N/A(empty)&apos;,formula:&apos;empty mismatch&apos;,note:note]
    }
    BigDecimal en = number(expected)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactIntegerFields.contains(field)) {
            boolean same = diff == BigDecimal.ZERO &amp;&amp; integerNumber(api) &amp;&amp; integerNumber(expected)
            return [same:same,api:numText(an),expected:numText(en),diff:numText(diff),percent:same?&apos;0%&apos;:&apos;N/A(integer)&apos;,formula:&apos;整数精确比较&apos;,note:same?&apos;整数精确相等，通过&apos;:&apos;整数不相等或不是整数，失败&apos;]
        }
        BigDecimal pct = percentMap.containsKey(norm(field)) ? percentMap[norm(field)] : defaultPercent
        BigDecimal absAllowed = absoluteMap.containsKey(norm(field)) ? absoluteMap[norm(field)] : defaultAbsolute
        BigDecimal relativeAllowed = en.abs().multiply(pct).divide(new BigDecimal(&apos;100&apos;),12,RoundingMode.HALF_UP)
        BigDecimal allowed = relativeAllowed.max(absAllowed)
        boolean same = diff &lt;= allowed
        String relative = en == BigDecimal.ZERO ? (same?&apos;0%&apos;:&apos;N/A(expected=0)&apos;) : diff.multiply(new BigDecimal(&apos;100&apos;)).divide(en.abs(),10,RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()+&apos;%&apos;
        return [same:same,api:numText(an),expected:numText(en),diff:numText(diff),percent:relative,formula:&apos;abs(API-&apos;+source+&apos;)=&apos;+numText(diff)+&apos; &lt;= max(abs=&apos;+numText(absAllowed)+&apos;,relative=&apos;+numText(relativeAllowed)+&apos;)=&apos;+numText(allowed),note:same?&apos;误差在允许范围内，通过&apos;:&apos;误差超限，失败&apos;]
    }
    String a=String.valueOf(api).trim(), e=String.valueOf(expected).trim()
    boolean same=ignoreCaseFields.contains(field)?a.equalsIgnoreCase(e):a==e
    [same:same,api:a,expected:e,diff:&apos;N/A&apos;,percent:&apos;N/A(text)&apos;,formula:ignoreCaseFields.contains(field)?&apos;忽略大小写文本比较&apos;:&apos;文本精确比较&apos;,note:same?&apos;文本相等，通过&apos;:&apos;文本不相等，失败&apos;]
}

