    String accountKey = String.valueOf(row.instance_id ?: &apos;&apos;) + &apos;|&apos; + idText(row.login)
    if (!requestedKeys.contains(accountKey)) failLines &lt;&lt; &apos; - [失败] | row=&apos; + rowNo + &apos; | account=&apos; + accountKey + &apos; | 原因=返回了请求accounts以外的账户&apos;
    String positionKey = String.valueOf(row.instance_id ?: &apos;&apos;) + &apos;|&apos; + String.valueOf(row.position_id ?: &apos;&apos;)
    if (!positionKeys.add(positionKey)) failLines &lt;&lt; &apos; - [失败] | row=&apos; + rowNo + &apos; | key=&apos; + positionKey + &apos; | 原因=(instance_id,position_id)重复&apos;
}

List&lt;String&gt; fields = definitions.collect { String.valueOf(it.n) }
String mode = vars.get(&apos;competition_positions_mode&apos;) ?: &apos;DB&apos;
boolean dbMode = mode == &apos;DB&apos;
Set&lt;String&gt; disabled = setOf(vars.get(dbMode ? &apos;competition_positions_db_api_disabled_compare_fields&apos; : &apos;competition_positions_csv_api_disabled_compare_fields&apos;) ?: &apos;&apos;)
String missingSkipRaw = vars.get(&apos;competition_positions_db_missing_field_skip_fields&apos;) ?: &apos;&apos;
Set&lt;String&gt; missingSkip = setOf(missingSkipRaw)
Map&lt;String,BigDecimal&gt; tolerances = toleranceOf(vars.get(dbMode ? &apos;competition_positions_db_api_field_tolerance_percent&apos; : &apos;competition_positions_csv_api_field_tolerance_percent&apos;) ?: &apos;&apos;)
BigDecimal defaultTolerance = number(vars.get(dbMode ? &apos;competition_positions_db_api_default_tolerance_percent&apos; : &apos;competition_positions_csv_api_default_tolerance_percent&apos;)) ?: BigDecimal.ZERO
def keyParts = { Map row -&gt; [instance:String.valueOf(value(row,&apos;instance_id&apos;) ?: &apos;&apos;).trim(), login:idText(value(row,&apos;login&apos;)), symbol:String.valueOf(value(row,&apos;symbol&apos;) ?: &apos;&apos;).trim(), position:String.valueOf(value(row,&apos;position_id&apos;) ?: &apos;&apos;).trim(), order:idText(value(row,&apos;order_id&apos;))] }
// POSITION_ID_ORDER_FIRST_V2：优先用order_id定位；未匹配时回退position_id/唯一账户品种候选；定位后position_id作为独立业务字段做完整文本精确比较。

if (dbMode) {
    Object dbObject = vars.getObject(&apos;db_competition_positions_rows&apos;)
    List&lt;Map&gt; dbRows = dbObject instanceof List ? ((List)dbObject).findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) } : []
    // JDBC Store as Object 的列名可能由驱动返回为大写；lookup/value 已统一按归一化列名读取。
    // 这里额外保留数据库实际值快照，匹配失败时也能区分“字段为空”和“没有对应账户记录”。
    def dbPositionText = { Map row -&gt; String s = String.valueOf(value(row, &apos;position_id&apos;) ?: &apos;&apos;).trim(); s ?: &apos;&lt;empty&gt;&apos; }
    def dbOrderText = { Map row -&gt; String s = idText(value(row, &apos;order_id&apos;)); s ?: &apos;&lt;empty&gt;&apos; }
    def dbCandidateText = { Map row -&gt;
        Map k = keyParts(row)
        &apos;{instance_id=&apos; + (k.instance ?: &apos;&lt;empty&gt;&apos;) + &apos;, login=&apos; + (k.login ?: &apos;&lt;empty&gt;&apos;) + &apos;, symbol=&apos; + (k.symbol ?: &apos;&lt;empty&gt;&apos;) + &apos;, position_id=&apos; + dbPositionText(row) + &apos;, order_id=&apos; + dbOrderText(row) + &apos;}&apos;
    }
    Set&lt;Integer&gt; usedDb = new LinkedHashSet&lt;Integer&gt;()
    apiRows.eachWithIndex { Map apiRow, int i -&gt;
        Map ak = keyParts(apiRow)
        List&lt;Integer&gt; broad = []
        dbRows.eachWithIndex { Map dbRow, int j -&gt;
            Map dk = keyParts(dbRow)
            if (ak.instance == dk.instance &amp;&amp; ak.login == dk.login &amp;&amp; ak.symbol == dk.symbol) broad &lt;&lt; j
        }
        List&lt;Integer&gt; exactOrder = broad.findAll { int j -&gt; ak.order &amp;&amp; keyParts(dbRows[j]).order == ak.order }
        List&lt;Integer&gt; exactPosition = broad.findAll { int j -&gt; ak.position &amp;&amp; keyParts(dbRows[j]).position == ak.position }
        List&lt;Integer&gt; candidates = []
        String matchBasis
        if (ak.order &amp;&amp; exactOrder) { candidates = exactOrder; matchBasis = &apos;order_id&apos; }
        else if (ak.position &amp;&amp; exactPosition) { candidates = exactPosition; matchBasis = ak.order ? &apos;position_id_fallback(order_id未匹配)&apos; : &apos;position_id_fallback(order_id为空)&apos; }
        else if (broad.size() == 1) { candidates = broad; matchBasis = &apos;unique_instance_login_symbol_fallback&apos; }
        else { candidates = []; matchBasis = &apos;order_id-&gt;position_id-&gt;unique_instance_login_symbol均未取得唯一记录&apos; }
        if (candidates.size() != 1) {
            List&lt;Integer&gt; sameInstanceSymbol = []
            dbRows.eachWithIndex { Map dbRow, int idx -&gt;
                Map dk = keyParts(dbRow)
                if (ak.instance == dk.instance &amp;&amp; ak.symbol == dk.symbol) sameInstanceSymbol &lt;&lt; idx
            }
            List&lt;Integer&gt; diagnosticIndexes = broad ?: sameInstanceSymbol
            List&lt;String&gt; dbPositionCandidates = diagnosticIndexes.collect { int idx -&gt; dbPositionText(dbRows[idx]) }.unique()
            List&lt;String&gt; dbOrderCandidates = diagnosticIndexes.collect { int idx -&gt; dbOrderText(dbRows[idx]) }.unique()
            List&lt;String&gt; dbLoginCandidates = diagnosticIndexes.collect { int idx -&gt; keyParts(dbRows[idx]).login ?: &apos;&lt;empty&gt;&apos; }.unique()
            List&lt;String&gt; diagnosticRows = diagnosticIndexes.take(20).collect { int idx -&gt; dbCandidateText(dbRows[idx]) }
            List&lt;String&gt; dbSample = dbRows.take(10).collect { Map row -&gt; dbCandidateText(row) }
            String candidateScope = broad ? &apos;same_instance_login_symbol&apos; : (sameInstanceSymbol ? &apos;same_instance_symbol_different_login&apos; : &apos;none&apos;)
            String reason = !dbRows ? &apos;JDBC结果集为空，无法取得DB.position_id&apos; : (!broad ? &apos;数据库没有与接口相同的instance_id+login+symbol记录；不是position_id字段为空&apos; : &apos;数据库候选记录无法唯一定位&apos;)
            failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=position_id | API.position_id=&apos; + (ak.position ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.position_id候选=&apos; + (dbPositionCandidates ?: [&apos;&lt;no-corresponding-row&gt;&apos;]) + &apos; | API.order_id=&apos; + (ak.order ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.order_id候选=&apos; + (dbOrderCandidates ?: [&apos;&lt;no-corresponding-row&gt;&apos;]) + &apos; | API.login=&apos; + (ak.login ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.login候选=&apos; + (dbLoginCandidates ?: [&apos;&lt;no-corresponding-row&gt;&apos;]) + &apos; | candidate_scope=&apos; + candidateScope + &apos; | DB相关记录=&apos; + (diagnosticRows ?: [&apos;&lt;none&gt;&apos;]) + &apos; | DB结果集样本=&apos; + (dbSample ?: [&apos;&lt;empty-result-set&gt;&apos;]) + &apos; | match_basis=&apos; + matchBasis + &apos; | 原因=&apos; + reason + &apos;；只有定位到同一数据库订单后才执行API.position_id与DB.position_id完整文本精确比较，禁止跨账户误比 | DB总记录数=&apos; + dbRows.size()
            return
        }
        int j = candidates[0]
        usedDb &lt;&lt; j
        Map dbRow = dbRows[j]
        fields.each { String f -&gt;
            def a = lookup(apiRow, f), d = lookup(dbRow, f)
            if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(f))) { skipLines &lt;&lt; &apos; - [跳过] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | DB=&apos; + (d.exists ? numText(d.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | 备注=DB/API无条件跳过配置&apos;; return }
            if (!a.exists) { failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&lt;field-missing&gt; | 原因=接口缺少必返字段&apos;; return }
            if (!d.exists) {
                if (missingSkip.contains(&apos;*&apos;) || missingSkip.contains(norm(f))) skipLines &lt;&lt; &apos; - [跳过] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + numText(a.value) + &apos; | DB=&lt;field-missing&gt; | 备注=数据库无此字段，已按配置跳过&apos;
                else failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + numText(a.value) + &apos; | DB=&lt;field-missing&gt; | 原因=数据库无此字段；字段不存在不等于字段值为空，可设置跳过&apos;
                return
            }
            def cr
            if (f == &apos;position_id&apos;) {
                String apiPosition = a.value == null ? &apos;&apos; : String.valueOf(a.value).trim()
                String dbPosition = d.value == null ? &apos;&apos; : String.valueOf(d.value).trim()
                boolean samePosition = apiPosition &amp;&amp; dbPosition &amp;&amp; apiPosition == dbPosition
                String positionNote = samePosition ? &apos;API.position_id=&apos; + apiPosition + &apos; 与 DB.position_id=&apos; + dbPosition + &apos; 完整文本精确相等，列入成功字段&apos; : (!apiPosition || !dbPosition ? &apos;API.position_id=&apos; + (apiPosition ?: &apos;&lt;empty&gt;&apos;) + &apos;，DB.position_id=&apos; + (dbPosition ?: &apos;&lt;empty&gt;&apos;) + &apos;，存在空值，列入失败字段&apos; : &apos;API.position_id=&apos; + apiPosition + &apos; 与 DB.position_id=&apos; + dbPosition + &apos; 不相等，列入失败字段&apos;)
                cr = [same:samePosition, api:(apiPosition ?: &apos;&lt;empty&gt;&apos;), expected:(dbPosition ?: &apos;&lt;empty&gt;&apos;), diff:&apos;N/A&apos;, percent:&apos;N/A(text)&apos;, formula:&apos;trim(String(API.position_id)) == trim(String(DB.position_id))；完整文本精确比较&apos;, note:positionNote]
            } else cr = compare(f, a.value, d.value, &apos;DB&apos;, tolerances, defaultTolerance)
            String line = &apos;row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + cr.api + &apos; | DB=&apos; + cr.expected + &apos; | APIField=&apos; + a.key + &apos; | DBField=&apos; + d.key + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        }
    }
    boolean paged = !blank(root.next_cursor) || !blank(vars.get(&apos;competition_positions_cursor&apos;))
    dbRows.eachWithIndex { Map row, int j -&gt;
        if (!usedDb.contains(j)) {
            String line = &apos; | DB键=&apos; + keyParts(row) + &apos; | DB记录=&apos; + row
            if (paged) skipLines &lt;&lt; &apos; - [跳过] | DB未匹配记录&apos; + line + &apos; | 备注=当前请求或响应存在cursor，仅校验本页&apos;
            else failLines &lt;&lt; &apos; - [失败] | 数据库多出未匹配当前持仓&apos; + line
        }
    }
    if (!apiRows &amp;&amp; !dbRows) okLines &lt;&lt; &apos; - [通过] | DB/API记录数均为0 | 备注=账户当前无未平仓持仓&apos;
} else {
    Map csvRow = vars.getObject(&apos;competition_positions_current_csv_row&apos;) instanceof Map ? new LinkedHashMap((Map)vars.getObject(&apos;competition_positions_current_csv_row&apos;)) : [:]
    String wantedPosition = String.valueOf(csvRow.position_id ?: &apos;&apos;).trim(), wantedOrder = idText(csvRow.order_id), wantedSymbol = String.valueOf(csvRow.symbol ?: &apos;&apos;).trim()
    List&lt;Map&gt; candidates = apiRows.findAll { Map row -&gt;
        if (wantedPosition &amp;&amp; wantedPosition != &apos;&lt;empty&gt;&apos;) return String.valueOf(row.position_id ?: &apos;&apos;) == wantedPosition
        if (wantedOrder) return idText(row.order_id) == wantedOrder &amp;&amp; (!wantedSymbol || String.valueOf(row.symbol ?: &apos;&apos;) == wantedSymbol)
        wantedSymbol ? String.valueOf(row.symbol ?: &apos;&apos;) == wantedSymbol : true
    }
    if (candidates.size() != 1) failLines &lt;&lt; &apos; - [失败] | CSV行=&apos; + vars.get(&apos;competition_positions_csv_line_no&apos;) + &apos; | position_id=&apos; + (wantedPosition ?: &apos;&lt;empty&gt;&apos;) + &apos; | order_id=&apos; + (wantedOrder ?: &apos;&lt;empty&gt;&apos;) + &apos; | symbol=&apos; + (wantedSymbol ?: &apos;&lt;empty&gt;&apos;) + &apos; | 原因=接口匹配记录数应为1，实际=&apos; + candidates.size()
    else fields.each { String f -&gt;
        Map apiRow = candidates[0]
        def a = lookup(apiRow, f)
        String raw = csvRow.containsKey(f) ? String.valueOf(csvRow[f] == null ? &apos;&apos; : csvRow[f]).trim() : null
        if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(f))) { skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&apos; + (raw ?: &apos;&lt;empty&gt;&apos;) + &apos; | 备注=CSV/API跳过配置&apos;; return }
        if (!csvRow.containsKey(f)) { failLines &lt;&lt; &apos; - [失败] | field=&apos; + f + &apos; | 原因=CSV表头缺少V1字段&apos;; return }
        if (raw == &apos;&apos;) { skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&lt;empty&gt; | 备注=未填写期望值；断言空值请填写&lt;empty&gt;&apos;; return }
        if (!a.exists) { failLines &lt;&lt; &apos; - [失败] | field=&apos; + f + &apos; | API=&lt;field-missing&gt; | CSV=&apos; + raw; return }
        Object expected = raw in [&apos;&lt;empty&gt;&apos;,&apos;&lt;null&gt;&apos;] ? null : raw
        def cr = compare(f, a.value, expected, &apos;CSV&apos;, tolerances, defaultTolerance)
        String line = &apos;field=&apos; + f + &apos; | API=&apos; + cr.api + &apos; | CSV=&apos; + cr.expected + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

// 辅助接口profit复算：保持线程组20的get_user_info/get_symbol_ex、买bid/卖ask及利润币种换算逻辑。
boolean auxEnabled = boolVar(&apos;competition_positions_aux_profit_calc_enabled&apos;, true)
int auxMax = intVar(&apos;competition_positions_aux_profit_calc_max_rows&apos;, 500, 0, 5000)
int connectTimeout = intVar(&apos;competition_positions_aux_http_connect_timeout_ms&apos;, 1500, 200, 30000)
int readTimeout = intVar(&apos;competition_positions_aux_http_read_timeout_ms&apos;, 5000, 500, 60000)
int retryCount = intVar(&apos;competition_positions_aux_retry_count&apos;, 3, 1, 10)
int retryDelay = intVar(&apos;competition_positions_aux_retry_delay_ms&apos;, 200, 0, 5000)
String auxDisabledRaw = vars.get(&apos;competition_positions_aux_profit_calc_disabled_compare_fields&apos;) ?: &apos;&apos;
Set&lt;String&gt; auxDisabled = setOf(auxDisabledRaw)
String auxToleranceRaw = vars.get(&apos;competition_positions_aux_profit_calc_field_tolerance_percent&apos;) ?: &apos;&apos;
Map&lt;String,BigDecimal&gt; auxTolerances = toleranceOf(auxToleranceRaw)
String host = (vars.get(&apos;middlewareip&apos;) ?: vars.get(&apos;CRM2.0middlewareip&apos;) ?: vars.get(&apos;ip&apos;) ?: &apos;&apos;).trim()
String port = (vars.get(&apos;port&apos;) ?: &apos;8080&apos;).trim()
String baseUrl = &apos;http://&apos; + host + (port ? &apos;:&apos; + port : &apos;&apos;)
Map&lt;String,String&gt; currencyCache = [:]
Map&lt;String,Map&gt; symbolCache = [:]
def enc = { Object v -&gt; java.net.URLEncoder.encode(String.valueOf(v ?: &apos;&apos;), &apos;UTF-8&apos;) }
def rowsOf = { Object json -&gt;
    if (json instanceof Map &amp;&amp; json.data instanceof List) return json.data.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map &amp;&amp; json.data.items instanceof List) return json.data.items.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map) return [new LinkedHashMap((Map)json.data)]
    if (json instanceof Map &amp;&amp; json.items instanceof List) return json.items.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    []
}
def getJson = { String path -&gt;
    if (!host) throw new IllegalStateException(&apos;middlewareip/CRM2.0middlewareip/ip为空&apos;)
    for (int attempt=1; attempt&lt;=retryCount; attempt++) {
        java.net.HttpURLConnection conn = null
        try {
            conn = (java.net.HttpURLConnection)new java.net.URL(baseUrl + path).openConnection()
            conn.setRequestMethod(&apos;GET&apos;); conn.setConnectTimeout(connectTimeout); conn.setReadTimeout(readTimeout); conn.setRequestProperty(&apos;Accept&apos;,&apos;application/json&apos;)
            int http = conn.getResponseCode()
            java.io.InputStream stream = http &gt;= 200 &amp;&amp; http &lt; 300 ? conn.getInputStream() : conn.getErrorStream()
            String text = stream == null ? &apos;&apos; : stream.getText(&apos;UTF-8&apos;)
            Object json = text ? new JsonSlurper().parseText(text) : [:]
            String code = json instanceof Map ? String.valueOf(json.code ?: &apos;&apos;) : &apos;&apos;
            String msg = json instanceof Map ? String.valueOf(json.msg ?: json.message ?: &apos;&apos;) : &apos;&apos;
            if (code == &apos;4002&apos; || msg.toLowerCase().contains(&apos;still in flight&apos;)) {
                if (attempt &lt; retryCount) { if (retryDelay &gt; 0) Thread.sleep(retryDelay); continue }
                throw new IllegalStateException(&apos;连续返回4002/in flight，重试&apos; + retryCount + &apos;次仍失败: &apos; + text)
            }
            if (http &lt; 200 || http &gt;= 300) throw new IllegalStateException(&apos;http=&apos; + http + &apos;, body=&apos; + text)
            return json
        } finally { try { conn?.disconnect() } catch (ignored) {} }
    }
    [:]
}
def accountCurrency = { String instance, Object login -&gt;
    String key = instance + &apos;|&apos; + idText(login)
    if (currencyCache.containsKey(key)) return currencyCache[key]
    List&lt;Map&gt; rows = rowsOf(getJson(&apos;/crm20/get_user_info?instanceid=&apos; + enc(instance) + &apos;&amp;login=&apos; + enc(idText(login))))
    Map row = rows ? rows[0] : [:]
    Object cur = value(row,&apos;currency&apos;)
    if (blank(cur) &amp;&amp; row.Group instanceof Map) cur = row.Group.Currency
    if (blank(cur) &amp;&amp; row.group instanceof Map) cur = row.group.currency ?: row.group.Currency
    String result = blank(cur) ? &apos;&apos; : String.valueOf(cur).trim().toUpperCase()
    currencyCache[key] = result
    result
}
def symbolInfo = { String instance, String symbol -&gt;
    String key = instance + &apos;|&apos; + symbol.toUpperCase()
    if (symbolCache.containsKey(key)) return symbolCache[key]
    Map result = [:]
    try {
        List&lt;Map&gt; rows = rowsOf(getJson(&apos;/crm20/get_symbol_ex?instanceid=&apos; + enc(instance) + &apos;&amp;name=&apos; + enc(symbol) + &apos;&amp;_select=name,currency_profit,currency_margin,currency_base,contract_size,tick_size,tick_value,bid,ask,digits,profit_mode,quote_updated_utc_ms&apos;))
        result = rows ? rows[0] : [:]
    } catch (Throwable e) { result = [__error:e.class.simpleName + &apos;: &apos; + e.message] }
    result.__query_symbol = symbol
    symbolCache[key] = result
    result
}
Set&lt;String&gt; cent = [&apos;USC&apos;] as Set
Set&lt;String&gt; usdLike = [&apos;USD&apos;,&apos;USDT&apos;,&apos;USDC&apos;] as Set
def primaryQuote = { Map info, String from, String to -&gt; String.valueOf(value(info,&apos;currency_base&apos;) ?: &apos;&apos;).toUpperCase() == from &amp;&amp; String.valueOf(value(info,&apos;currency_profit&apos;) ?: &apos;&apos;).toUpperCase() == to ? info : null }
def rate
rate = { String from0, String to0, String instance, BigDecimal rawProfit, Map primary -&gt;
    String from = String.valueOf(from0 ?: &apos;&apos;).toUpperCase(), to = String.valueOf(to0 ?: &apos;&apos;).toUpperCase()
    if (!from || !to) return [rate:null,path:&apos;missing currency&apos;,detail:&apos;rate_quote_source=missing_currency&apos;]
    if (from == to) return [rate:BigDecimal.ONE,path:from+&apos;-&gt;&apos;+to+&apos;=1&apos;,detail:&apos;same_currency&apos;]
    if (from == &apos;USD&apos; &amp;&amp; cent.contains(to)) return [rate:new BigDecimal(&apos;100&apos;),path:&apos;USD-&gt;&apos;+to+&apos;=100&apos;,detail:&apos;fixed_cent_rule&apos;]
    if (cent.contains(from) &amp;&amp; to == &apos;USD&apos;) return [rate:new BigDecimal(&apos;0.01&apos;),path:from+&apos;-&gt;USD=0.01&apos;,detail:&apos;fixed_cent_rule&apos;]
    boolean positive = rawProfit == null || rawProfit &gt;= BigDecimal.ZERO
    Map direct = primaryQuote(primary,from,to); if (!(direct instanceof Map)) direct = symbolInfo(instance,from+to)
    BigDecimal dbid=number(value(direct,&apos;bid&apos;)), dask=number(value(direct,&apos;ask&apos;))
    if (dbid != null &amp;&amp; dask != null) {
        BigDecimal p=positive?dbid:dask; String q=String.valueOf(value(direct,&apos;__query_symbol&apos;) ?: from+to); String f=positive?&apos;bid&apos;:&apos;ask&apos;
        return [rate:p,path:q+&apos; &apos;+from+&apos;-&gt;&apos;+to+&apos;.&apos;+f+&apos;=&apos;+numText(p),detail:&apos;quote=&apos;+q+&apos; | field=&apos;+f+&apos; | bid=&apos;+numText(dbid)+&apos; | ask=&apos;+numText(dask)]
    }
    Map reverse = primaryQuote(primary,to,from); if (!(reverse instanceof Map)) reverse = symbolInfo(instance,to+from)
    BigDecimal rbid=number(value(reverse,&apos;bid&apos;)), rask=number(value(reverse,&apos;ask&apos;))
    if (rbid != null &amp;&amp; rask != null) {
        BigDecimal p=positive?rask:rbid
        if (p != BigDecimal.ZERO) { BigDecimal r=BigDecimal.ONE.divide(p,12,RoundingMode.HALF_UP); String q=String.valueOf(value(reverse,&apos;__query_symbol&apos;) ?: to+from); return [rate:r,path:&apos;1/&apos;+q+&apos;=&apos;+numText(r),detail:&apos;quote=&apos;+q+&apos; | inverse_price=&apos;+numText(p)+&apos; | bid=&apos;+numText(rbid)+&apos; | ask=&apos;+numText(rask)] }
    }
    if (usdLike.contains(from) &amp;&amp; usdLike.contains(to)) return [rate:BigDecimal.ONE,path:from+&apos;-&gt;&apos;+to+&apos;=1(USD-like)&apos;,detail:&apos;usd_like_fallback&apos;]
    if (cent.contains(to) &amp;&amp; from != &apos;USD&apos;) { def a=rate(from,&apos;USD&apos;,instance,rawProfit,primary); if (a.rate!=null) return [rate:a.rate*100,path:&apos;(&apos;+a.path+&apos;)*100&apos;,detail:a.detail+&apos; * cent100&apos;] }
    if (cent.contains(from) &amp;&amp; to != &apos;USD&apos;) { def a=rate(&apos;USD&apos;,to,instance,rawProfit,primary); if (a.rate!=null) return [rate:a.rate*new BigDecimal(&apos;0.01&apos;),path:&apos;0.01*(&apos;+a.path+&apos;)&apos;,detail:&apos;cent0.01 * &apos;+a.detail] }
    if (from!=&apos;USD&apos; &amp;&amp; to!=&apos;USD&apos;) { def a=rate(from,&apos;USD&apos;,instance,rawProfit,primary), b=rate(&apos;USD&apos;,to,instance,rawProfit,primary); if (a.rate!=null &amp;&amp; b.rate!=null) return [rate:a.rate*b.rate,path:&apos;(&apos;+a.path+&apos;)*(&apos;+b.path+&apos;)&apos;,detail:&apos;(&apos;+a.detail+&apos;)*(&apos;+b.detail+&apos;)&apos;] }
    [rate:null,path:&apos;no quote path &apos;+from+&apos;-&gt;&apos;+to,detail:&apos;not_found&apos;]
}

if (!auxEnabled) skipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | 原因=competition_positions_aux_profit_calc_enabled=0&apos;
else if (auxDisabled.contains(&apos;*&apos;) || auxDisabled.contains(&apos;profit&apos;)) skipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | field=profit | 原因=配置跳过 | disabled_config=&apos; + auxDisabledRaw
else {
    List&lt;Map&gt; calcRows = apiRows.take(auxMax)
    if (apiRows.size() &gt; calcRows.size()) skipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | 原因=只复算前&apos; + calcRows.size() + &apos;条，接口返回&apos; + apiRows.size() + &apos;条&apos;
    calcRows.eachWithIndex { Map row, int i -&gt;
        String instance=String.valueOf(row.instance_id ?: &apos;&apos;).trim(), symbol=String.valueOf(row.symbol ?: &apos;&apos;).trim(), side=String.valueOf(row.side ?: &apos;&apos;).toLowerCase()
        Object login=row.login
        BigDecimal open=number(row.open_price), lots=number(row.volume_lots), apiProfit=number(row.profit)
        String prefix=&apos;row=&apos;+(i+1)+&apos; | instance_id=&apos;+(instance?:&apos;&lt;empty&gt;&apos;)+&apos; | login=&apos;+(blank(login)?&apos;&lt;empty&gt;&apos;:idText(login))+&apos; | symbol=&apos;+(symbol?:&apos;&lt;empty&gt;&apos;)+&apos; | position_id=&apos;+String.valueOf(row.position_id ?: &apos;&lt;empty&gt;&apos;)
        try {
            if (!instance || blank(login) || !symbol || !(side in [&apos;buy&apos;,&apos;sell&apos;]) || open==null || lots==null || apiProfit==null) throw new IllegalStateException(&apos;主接口缺少profit复算必需字段&apos;)
            String account=accountCurrency(instance,login)
            Map info=symbolInfo(instance,symbol)
            String profitCurrency=String.valueOf(value(info,&apos;currency_profit&apos;) ?: &apos;&apos;).toUpperCase()
            BigDecimal bid=number(value(info,&apos;bid&apos;)), ask=number(value(info,&apos;ask&apos;)), contract=number(value(info,&apos;contract_size&apos;))
            if (!account || !profitCurrency || bid==null || ask==null || contract==null) throw new IllegalStateException(&apos;辅助字段缺失 | account_currency=&apos;+account+&apos; | currency_profit=&apos;+profitCurrency+&apos; | bid=&apos;+numText(bid)+&apos; | ask=&apos;+numText(ask)+&apos; | contract_size=&apos;+numText(contract)+&apos; | symbol_error=&apos;+String.valueOf(value(info,&apos;__error&apos;) ?: &apos;&apos;))
            BigDecimal current=side==&apos;sell&apos;?ask:bid
            BigDecimal raw=side==&apos;sell&apos;?open.subtract(ask).multiply(contract).multiply(lots):bid.subtract(open).multiply(contract).multiply(lots)
            def rateInfo=rate(profitCurrency,account,instance,raw,info)
            if (rateInfo.rate==null) throw new IllegalStateException(&apos;rate_profit不可计算 | rate_path=&apos;+rateInfo.path+&apos; | detail=&apos;+rateInfo.detail)
            BigDecimal calc=raw.multiply((BigDecimal)rateInfo.rate).setScale(12,RoundingMode.HALF_UP)
            def cr=compare(&apos;profit&apos;,apiProfit,calc,&apos;calc_profit&apos;,auxTolerances,new BigDecimal(&apos;10&apos;))
            String formula=(side==&apos;sell&apos;?&apos;(open_price-ask)&apos;:&apos;(bid-open_price)&apos;)+&apos;*contract_size*volume_lots*rate_profit = &apos;+(side==&apos;sell&apos;?&apos;(&apos;+numText(open)+&apos;-&apos;+numText(ask)+&apos;)&apos;:&apos;(&apos;+numText(bid)+&apos;-&apos;+numText(open)+&apos;)&apos;)+&apos;*&apos;+numText(contract)+&apos;*&apos;+numText(lots)+&apos;*&apos;+numText(rateInfo.rate)+&apos;=&apos;+numText(calc)
            String line=&apos;辅助接口profit计算 | API_profit=&apos;+numText(apiProfit)+&apos; | calc_profit=&apos;+numText(calc)+&apos; | &apos;+prefix+&apos; | raw_profit=&apos;+numText(raw)+&apos; | rate_profit=&apos;+numText(rateInfo.rate)+&apos; | rate_path=&apos;+rateInfo.path+&apos; | rate_quote_detail=&apos;+rateInfo.detail+&apos; | API_account_currency=&apos;+(blank(row.account_currency)?&apos;&lt;empty&gt;&apos;:row.account_currency)+&apos; | aux_account_currency=&apos;+account+&apos; | currency_profit=&apos;+profitCurrency+&apos; | side=&apos;+side+&apos; | open_price=&apos;+numText(open)+&apos; | price_current=&apos;+numText(current)+&apos; | price_basis=&apos;+(side==&apos;sell&apos;?&apos;ask&apos;:&apos;bid&apos;)+&apos; | bid=&apos;+numText(bid)+&apos; | ask=&apos;+numText(ask)+&apos; | contract_size=&apos;+numText(contract)+&apos; | volume_lots=&apos;+numText(lots)+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+formula+&apos; | 备注=&apos;+cr.note
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos;+line else failLines &lt;&lt; &apos; - [失败] | &apos;+line
        } catch (Throwable e) { failLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | API_profit=&apos;+numText(apiProfit)+&apos; | calc_profit=&lt;empty&gt; | &apos;+prefix+&apos; | exception=&apos;+e.class.simpleName+&apos;: &apos;+e.message }
    }
}

// 按V1文档复算open_notional_value_usd：剩余手数*合约大小*开仓价*开仓事件时点USD中间价，换算率和结果均五位小数HALF_UP。
// 当前辅助接口只有查询时点行情，文档明确禁止用当前行情回填历史证据；因此仅对无需浮动历史汇率的USD/固定USC执行数值对比。
def documentedNotionalUsdRate = { String currency0 -&gt;
    String currency = String.valueOf(currency0 ?: &apos;&apos;).trim().toUpperCase()
    if (currency == &apos;USD&apos;) return [rate:new BigDecimal(&apos;1.00000&apos;), path:&apos;USD-&gt;USD=1.00000&apos;, evidence:&apos;document_exact_no_fx_conversion&apos;, timeBasis:&apos;not_required&apos;]
    if (currency == &apos;USC&apos;) return [rate:new BigDecimal(&apos;0.01000&apos;), path:&apos;USC-&gt;USD=0.01000&apos;, evidence:&apos;fixed_cent_conversion&apos;, timeBasis:&apos;fixed_rate&apos;]
    [rate:null, path:currency+&apos;-&gt;USD requires event-time Bid/Ask mid price&apos;, evidence:&apos;event_time_quote_unavailable&apos;, timeBasis:&apos;open_time_ms&apos;]
}

if (!auxEnabled) skipLines &lt;&lt; &apos; - [跳过] | 辅助公式open_notional_value_usd计算 | 原因=competition_positions_aux_profit_calc_enabled=0&apos;
else if (auxDisabled.contains(&apos;*&apos;) || auxDisabled.contains(norm(&apos;open_notional_value_usd&apos;))) skipLines &lt;&lt; &apos; - [跳过] | 辅助公式open_notional_value_usd计算 | field=open_notional_value_usd | 原因=配置跳过 | disabled_config=&apos; + auxDisabledRaw
else {
    List&lt;Map&gt; notionalRows = apiRows.take(auxMax)
    if (apiRows.size() &gt; notionalRows.size()) skipLines &lt;&lt; &apos; - [跳过] | 辅助公式open_notional_value_usd计算 | 原因=只复算前&apos; + notionalRows.size() + &apos;条，接口返回&apos; + apiRows.size() + &apos;条&apos;
    notionalRows.eachWithIndex { Map row, int i -&gt;
        String instance = String.valueOf(row.instance_id ?: &apos;&apos;).trim()
        String symbol = String.valueOf(row.symbol ?: &apos;&apos;).trim()
        Object login = row.login
        BigDecimal open = number(row.open_price), lots = number(row.volume_lots), apiNotional = number(row.open_notional_value_usd)
        String notionalStatus = String.valueOf(row.notional_status ?: &apos;&apos;).trim()
        String prefix = &apos;row=&apos;+(i+1)+&apos; | instance_id=&apos;+(instance?:&apos;&lt;empty&gt;&apos;)+&apos; | login=&apos;+(blank(login)?&apos;&lt;empty&gt;&apos;:idText(login))+&apos; | symbol=&apos;+(symbol?:&apos;&lt;empty&gt;&apos;)+&apos; | position_id=&apos;+String.valueOf(row.position_id ?: &apos;&lt;empty&gt;&apos;)
        if (apiNotional == null) {
            skipLines &lt;&lt; &apos; - [跳过] | 辅助公式open_notional_value_usd计算 | API_open_notional_value_usd=&lt;empty&gt; | calc_open_notional_value_usd=&lt;empty&gt; | &apos;+prefix+&apos; | notional_status=&apos;+(notionalStatus?:&apos;&lt;empty&gt;&apos;)+&apos; | 原因=API名义价值为null，无数值可作辅助公式对比；null不得当作0&apos;
            return
        }
        try {
            if (!instance || blank(login) || !symbol || open == null || open &lt;= BigDecimal.ZERO || lots == null || lots &lt;= BigDecimal.ZERO) throw new IllegalStateException(&apos;主接口缺少名义价值复算必需字段，或open_price/volume_lots不是正数&apos;)
            Map info = symbolInfo(instance, symbol)
            String currencyBase = String.valueOf(value(info,&apos;currency_base&apos;) ?: &apos;&apos;).trim().toUpperCase()
            String profitCurrency = String.valueOf(value(info,&apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
            BigDecimal contract = number(value(info,&apos;contract_size&apos;))
            if (!profitCurrency || contract == null || contract &lt;= BigDecimal.ZERO) throw new IllegalStateException(&apos;辅助品种规格缺失 | currency_base=&apos;+currencyBase+&apos; | currency_profit=&apos;+profitCurrency+&apos; | contract_size=&apos;+numText(contract)+&apos; | symbol_error=&apos;+String.valueOf(value(info,&apos;__error&apos;) ?: &apos;&apos;))
            def usdRateInfo = documentedNotionalUsdRate(profitCurrency)
            if (usdRateInfo.rate == null) {
                skipLines &lt;&lt; &apos; - [跳过] | 辅助公式open_notional_value_usd计算 | API_open_notional_value_usd=&apos;+numText(apiNotional)+&apos; | calc_open_notional_value_usd=&lt;empty&gt; | &apos;+prefix+&apos; | open_time_ms=&apos;+numText(row.open_time_ms)+&apos; | currency_base=&apos;+(currencyBase?:&apos;&lt;empty&gt;&apos;)+&apos; | currency_profit=&apos;+profitCurrency+&apos; | contract_size=&apos;+numText(contract)+&apos; | volume_lots=&apos;+numText(lots)+&apos; | open_price=&apos;+numText(open)+&apos; | rate_path=&apos;+usdRateInfo.path+&apos; | evidence=&apos;+usdRateInfo.evidence+&apos; | 原因=接口文档要求开仓事件时点USD Bid/Ask中间价，当前辅助接口仅有查询时点报价，禁止用当前行情回填&apos;
                return
            }
            BigDecimal rateUsd = ((BigDecimal)usdRateInfo.rate).setScale(5, RoundingMode.HALF_UP)
            BigDecimal rawQuoteNotional = lots.multiply(contract).multiply(open)
            BigDecimal calcNotional = rawQuoteNotional.multiply(rateUsd).setScale(5, RoundingMode.HALF_UP)
            def cr = compare(&apos;open_notional_value_usd&apos;, apiNotional, calcNotional, &apos;calc_open_notional_value_usd&apos;, auxTolerances, new BigDecimal(&apos;5&apos;))
            String formula = &apos;ROUND_HALF_UP(volume_lots*contract_size*open_price*rate_to_USD,5) = ROUND_HALF_UP(&apos;+numText(lots)+&apos;*&apos;+numText(contract)+&apos;*&apos;+numText(open)+&apos;*&apos;+numText(rateUsd)+&apos;,5) = &apos;+numText(calcNotional)
            String line = &apos;辅助公式open_notional_value_usd计算 | API_open_notional_value_usd=&apos;+numText(apiNotional)+&apos; | calc_open_notional_value_usd=&apos;+numText(calcNotional)+&apos; | &apos;+prefix+&apos; | notional_status=&apos;+(notionalStatus?:&apos;&lt;empty&gt;&apos;)+&apos; | notional_method=&apos;+String.valueOf(row.notional_method ?: &apos;&lt;empty&gt;&apos;)+&apos; | notional_calculation_version=&apos;+numText(row.notional_calculation_version)+&apos; | open_time_ms=&apos;+numText(row.open_time_ms)+&apos; | raw_quote_notional=&apos;+numText(rawQuoteNotional)+&apos; | rate_to_USD=&apos;+numText(rateUsd)+&apos; | rate_path=&apos;+usdRateInfo.path+&apos; | rate_time_basis=&apos;+usdRateInfo.timeBasis+&apos; | evidence=&apos;+usdRateInfo.evidence+&apos; | currency_base=&apos;+(currencyBase?:&apos;&lt;empty&gt;&apos;)+&apos; | currency_profit=&apos;+profitCurrency+&apos; | contract_size=&apos;+numText(contract)+&apos; | volume_lots=&apos;+numText(lots)+&apos; | open_price=&apos;+numText(open)+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+formula+&apos; | 备注=&apos;+cr.note+&apos;；当前剩余持仓量口径，未使用查询时点当前行情回填&apos;
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos;+line else failLines &lt;&lt; &apos; - [失败] | &apos;+line
        } catch (Throwable e) {
            failLines &lt;&lt; &apos; - [失败] | 辅助公式open_notional_value_usd计算 | API_open_notional_value_usd=&apos;+numText(apiNotional)+&apos; | calc_open_notional_value_usd=&lt;empty&gt; | &apos;+prefix+&apos; | exception=&apos;+e.class.simpleName+&apos;: &apos;+e.message
        }
    }
}

String status=failLines.isEmpty()?&apos;PASS&apos;:&apos;FAIL&apos;
List&lt;String&gt; report=[]
report &lt;&lt; &apos;Assertion message: 交易大赛-批量查询指定账户的当前未平仓持仓 V1字段/DB或CSV/calc_profit/calc_open_notional_value_usd校验 | status=&apos;+status+&apos; | mode=&apos;+mode+&apos; | case=&apos;+vars.get(&apos;competition_positions_case_index_display&apos;)+&apos;/&apos;+vars.get(&apos;competition_positions_case_total&apos;)+&apos; | CSV行=&apos;+vars.get(&apos;competition_positions_csv_line_no&apos;)+&apos; | shujuku=&apos;+vars.get(&apos;competition_positions_shujuku&apos;)
report &lt;&lt; &apos;接口: POST /v1/positions/query | 文档: mt-hub-openapi 7.html | 版本: MT-Hub API 1.0.1-beta1.60.3&apos;
report &lt;&lt; &apos;已校验data字段(18个): [&apos;+fields.join(&apos;,&apos;)+&apos;]；响应信封字段(4个): [data,errors,next_cursor,as_of_time_ms]&apos;
report &lt;&lt; &apos;响应信封: data=&apos;+apiRows.size()+&apos; | errors=&apos;+errors.size()+&apos; | next_cursor=&apos;+(blank(root.next_cursor)?&apos;&lt;empty&gt;&apos;:root.next_cursor)+&apos; | as_of_time_ms=&apos;+(blank(root.as_of_time_ms)?&apos;&lt;empty&gt;&apos;:root.as_of_time_ms)
report &lt;&lt; &apos;DB新增字段校验(5个): [position_lifecycle_id,open_notional_value_usd,notional_status,notional_method,notional_calculation_version]；MT4/MT5 SQL均已提供这些列并参与逐字段比较。&apos;
report &lt;&lt; &apos;数据库缺失字段跳过配置=[&apos;+missingSkipRaw+&apos;]；字段不存在与字段存在但值为空严格区分&apos;
// 仅增强最终打印：根据row/data.row定位同一条API记录，补充实例、账户、订单、持仓和品种；不改变底层校验结果。
def withAccountContext = { String line -&gt;
    if (!line) return line
    String outputLine = line
        .replace(&apos;API键=[instance:&apos;, &apos;API匹配键(脚本组合，非接口字段)=[instance_id:&apos;)
        .replace(&apos;DB键=[instance:&apos;, &apos;DB匹配键(脚本组合，非接口字段)=[instance_id:&apos;)
        .replace(&apos;, position:&apos;, &apos;, position_id:&apos;)
        .replace(&apos;, order:&apos;, &apos;, order_id:&apos;)
    int apiIndex = -1
    def matcher = outputLine =~ /(?:^|\|\s*)(?:data\.)?row=(\d+)/
    if (matcher.find()) {
        try { apiIndex = Integer.parseInt(matcher.group(1)) - 1 } catch (ignored) { return outputLine }
    } else if (!dbMode &amp;&amp; outputLine.contains(&apos;| CSV=&apos;)) {
        Map csvRow = vars.getObject(&apos;competition_positions_current_csv_row&apos;) instanceof Map ? new LinkedHashMap((Map)vars.getObject(&apos;competition_positions_current_csv_row&apos;)) : [:]
        String wantedPosition = String.valueOf(csvRow.position_id ?: &apos;&apos;).trim()
        String wantedOrder = idText(csvRow.order_id)
        String wantedSymbol = String.valueOf(csvRow.symbol ?: &apos;&apos;).trim()
        List&lt;Integer&gt; matchedIndexes = []
        apiRows.eachWithIndex { Map candidate, int idx -&gt;
            boolean matched
            if (wantedPosition &amp;&amp; wantedPosition != &apos;&lt;empty&gt;&apos;) matched = String.valueOf(candidate.position_id ?: &apos;&apos;) == wantedPosition
            else if (wantedOrder) matched = idText(candidate.order_id) == wantedOrder &amp;&amp; (!wantedSymbol || String.valueOf(candidate.symbol ?: &apos;&apos;) == wantedSymbol)
            else matched = wantedSymbol ? String.valueOf(candidate.symbol ?: &apos;&apos;) == wantedSymbol : true
            if (matched) matchedIndexes &lt;&lt; idx
        }
        if (matchedIndexes.size() == 1) apiIndex = matchedIndexes[0]
    }
    if (apiIndex &lt; 0 || apiIndex &gt;= apiRows.size()) return outputLine
    Map apiRow = apiRows[apiIndex]
    String instanceText = String.valueOf(apiRow.instance_id ?: &apos;&lt;empty&gt;&apos;).trim()
    String loginText = idText(apiRow.login)
    if (!loginText) loginText = &apos;&lt;empty&gt;&apos;
    String orderText = idText(apiRow.order_id)
    if (!orderText) orderText = &apos;&lt;empty&gt;&apos;
    String positionText = String.valueOf(apiRow.position_id ?: &apos;&lt;empty&gt;&apos;).trim()
    String symbolText = String.valueOf(apiRow.symbol ?: &apos;&lt;empty&gt;&apos;).trim()
    List&lt;String&gt; contextParts = []
    if (!(outputLine.contains(&apos;instanceid=&apos;) || outputLine.contains(&apos;instance_id=&apos;))) contextParts &lt;&lt; &apos;instanceid=&apos; + instanceText
    if (!outputLine.contains(&apos;login=&apos;)) contextParts &lt;&lt; &apos;login=&apos; + loginText
    if (!outputLine.contains(&apos;order_id=&apos;)) contextParts &lt;&lt; &apos;order_id=&apos; + orderText
    if (!outputLine.contains(&apos;position_id=&apos;)) contextParts &lt;&lt; &apos;position_id=&apos; + positionText
    if (!outputLine.contains(&apos;symbol=&apos;)) contextParts &lt;&lt; &apos;symbol=&apos; + symbolText
    // OPEN_POSITION_FIELD_FIRST_V1: 将当前对比field移到通过/失败/跳过标记之后，账户、订单、持仓和品种上下文之前。
    String workingLine = outputLine, fieldToken = null
    def fieldMatcher = (workingLine =~ /\s*\|\s*field=([^|]*)/)
    if (fieldMatcher.find()) {
        fieldToken = &apos;field=&apos; + fieldMatcher.group(1).trim()
        String beforeField = workingLine.substring(0, fieldMatcher.start()).replaceFirst(/\s+$/, &apos;&apos;)
        String afterField = workingLine.substring(fieldMatcher.end()).replaceFirst(/^\s*\|\s*/, &apos;&apos;)
        workingLine = beforeField + (afterField ? &apos; | &apos; + afterField : &apos;&apos;)
    }
    List&lt;String&gt; leadingParts = []
    if (fieldToken) leadingParts &lt;&lt; fieldToken
    leadingParts.addAll(contextParts)
    if (!leadingParts) return outputLine
    int firstPipe = workingLine.indexOf(&apos;|&apos;)
    if (firstPipe &lt; 0) return leadingParts.join(&apos; | &apos;) + &apos; | &apos; + workingLine
    String left = workingLine.substring(0, firstPipe).replaceFirst(/\s+$/, &apos;&apos;)
    String right = workingLine.substring(firstPipe + 1).replaceFirst(/^\s+/, &apos;&apos;)
    left + &apos; | &apos; + leadingParts.join(&apos; | &apos;) + (right ? &apos; | &apos; + right : &apos;&apos;)
}
List&lt;String&gt; displayFailLines = failLines.collect { String line -&gt; withAccountContext(line) }
// 只压缩最终成功输出；okLines中的基础校验结果仍由上方逻辑完整产生。
List&lt;String&gt; displayOkLines = okLines.findAll { String line -&gt;
    !((line.contains(&apos;root.field=&apos;) &amp;&amp; line.contains(&apos;备注=必返字段存在&apos;)) ||
      line.contains(&apos;root.field=errors | API=[] | 备注=无账户级部分错误&apos;) ||
      line.contains(&apos;备注=字段存在且类型符合&apos;) ||
      line.contains(&apos;备注=字段键存在且文档允许JSON null&apos;))
}.collect { String line -&gt; withAccountContext(line) }
List&lt;String&gt; displaySkipLines = skipLines.collect { String line -&gt; withAccountContext(line) }
int hiddenBasicPassCount = okLines.size() - displayOkLines.size()
report &lt;&lt; &apos;基础字段成功明细已省略=&apos;+hiddenBasicPassCount+&apos;条；这些字段仍已执行必返、类型、null、枚举及DB/CSV实际值校验，失败始终打印。&apos;
report &lt;&lt; &apos;匹配键说明: API匹配键不是/v1/positions/query的单个响应字段，而是脚本组合的数据库定位条件；instance_id=接口instance_id，login=接口login，symbol=接口symbol，position_id=接口position_id，order_id=接口order_id。先按instance_id+login+symbol找候选，再优先按order_id定位；order_id未匹配时回退position_id，再回退唯一账户品种候选。取得唯一DB订单后，position_id仍作为独立字段按trim后的完整文本精确比较：相等列入成功，不等或任一为空列入失败。&apos;
report &lt;&lt; &apos;辅助计算: enabled=&apos;+auxEnabled+&apos; | fields=[profit,open_notional_value_usd] | max_rows=&apos;+auxMax+&apos; | disabled=[&apos;+auxDisabledRaw+&apos;] | tolerance=[&apos;+auxToleranceRaw+&apos;] | open_notional_value_usd未单独配置时默认5% | 4002重试=&apos;+retryCount+&apos;次/&apos;+retryDelay+&apos;ms&apos;
report &lt;&lt; &apos;名义价值公式: ROUND_HALF_UP(volume_lots*contract_size*open_price*rate_to_USD,5)；按当前剩余持仓量；USD率和结果五位小数HALF_UP；非USD/USC缺少开仓事件时点中间价时只打印跳过诊断，禁止用查询时点当前行情回填。&apos;
report &lt;&lt; &apos;空值规则: API/DB均空通过；API=0且DB空通过；storage均空通过；数据库无字段默认失败，配置后才跳过。&apos;
report &lt;&lt; &apos;统计: 失败=&apos;+failLines.size()+&apos; | 对比/重要通过=&apos;+displayOkLines.size()+&apos; | 基础通过已省略=&apos;+hiddenBasicPassCount+&apos; | 跳过=&apos;+skipLines.size()+&apos; | API记录=&apos;+apiRows.size()
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【失败明细：&apos;+failLines.size()+&apos;条】&apos;; report.addAll(displayFailLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【对比/重要通过明细：&apos;+displayOkLines.size()+&apos;条】&apos;; report.addAll(displayOkLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【跳过明细：&apos;+skipLines.size()+&apos;条】&apos;; report.addAll(displaySkipLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【接口请求Body】&apos; &lt;&lt; (vars.get(&apos;competition_positions_request_body&apos;) ?: &apos;&apos;)
String finalReport=report.join(&apos;\n&apos;)
publish(finalReport,failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">按mt-hub-openapi 7.html校验信封及data[]全部18个字段；字段存在性/类型/null等基础成功项仍校验但不重复打印，失败始终打印；DB/API先按instance_id+login+symbol取候选，再按order_id、position_id、唯一账户品种候选依次定位，取得唯一订单后position_id作为独立字段按trim后的完整文本精确比较，相等列入成功，不等或为空列入失败；未取得唯一DB订单时打印API position_id及DB候选position_id诊断；DB/CSV逐字段对比的成功、失败及带row的跳过明细均打印instanceid、login、order_id、position_id、symbol；API键在最终报告中明确显示为脚本组合的API匹配键而非接口单字段；calc_profit继续完整打印；新增API_open_notional_value_usd与calc_open_notional_value_usd辅助公式对比，使用剩余volume_lots、contract_size、open_price和文档允许的USD换算证据，五位小数HALF_UP，不以查询时点当前行情回填缺失的开仓事件时点汇率。</stringProp>
            </JSR223Assertion>
