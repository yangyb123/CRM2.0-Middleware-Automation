          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化get_position_info数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;获取持仓订单get_position_info-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;get_position_info CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;get_position_info CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instanceid&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: vars.get(&apos;login_val&apos;) ?: vars.get(&apos;Login&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;get_position_info shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;get_position_info order_instanceid_val/instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;get_position_info order_login/login不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;get_position_info order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

def headers = dataLines[0].split(&apos;,&apos;, -1).collect { it.trim().replaceAll(/^&quot;|&quot;$/, &apos;&apos;) }.findAll { it }
vars.putObject(&apos;position_info_csv_headers&apos;, headers)
vars.put(&apos;position_info_shujuku&apos;, shujuku)
vars.put(&apos;position_info_login&apos;, login)
vars.put(&apos;position_info_instanceid&apos;, instanceId)
vars.put(&apos;position_info_db_platform&apos;, platform)
vars.put(&apos;instanceid_val&apos;, instanceId)
vars.put(&apos;login_val&apos;, login)
vars.putObject(&apos;db_position_info_rows&apos;, [])
log.info(&apos;get_position_info init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
