            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;user_info_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;user_info_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4用户信息-${user_info_login}" enabled="true">
