          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="待处理/历史订单CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="order_ex_csv_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">order_ex_csv_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">price_current,time_done_utc_ms</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">price_current</stringProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化待处理/历史订单数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
String csvName = &apos;待处理-历史订单-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;待处理/历史订单CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;待处理/历史订单CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;待处理/历史订单 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;待处理/历史订单 order_instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;待处理/历史订单 order_login/login不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;待处理/历史订单 order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

vars.put(&apos;order_ex_check_shujuku&apos;, shujuku)
vars.put(&apos;order_ex_check_login&apos;, login)
vars.put(&apos;order_ex_check_instanceid&apos;, instanceId)
vars.put(&apos;order_ex_check_db_platform&apos;, platform)
vars.put(&apos;instanceid&apos;, instanceId)
vars.put(&apos;login&apos;, login)
vars.putObject(&apos;db_order_ex_check_rows&apos;, [])
log.info(&apos;order_ex_check init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT4-查询待处理历史订单数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;order_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;order_ex_check_db_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4待处理历史订单-${order_ex_check_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
              <stringProp name="query">SELECT
  CASE
    WHEN mt.CMD IN (2, 3, 4, 5) THEN &apos;pending_order&apos;
    WHEN mt.CMD IN (0, 1) AND (CAST(mt.CLOSE_TIME AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) OR mt.CLOSE_TIME IS NULL) THEN &apos;position&apos;
    WHEN mt.CMD IN (0, 1) THEN &apos;history_order&apos;
    ELSE &apos;other&apos;
  END AS record_type,
  mt.SYMBOL AS symbol,
  NULL AS position_ticket,
  mt.OPEN_PRICE AS price_open,
  mt.VOLUME / 100.0 AS volume_initial,
  NULLIF(mt.TP, 0) AS price_tp,
  &apos;mt4&apos; AS source,
  mt.LOGIN AS login,
  mt.CMD AS type,
  UNIX_TIMESTAMP(mt.OPEN_TIME) * 1000 AS time_setup_utc_ms,
  mt.TICKET AS order_ticket,
  &apos;MT4_1&apos; AS instance_id,
  CASE
    WHEN CAST(mt.CLOSE_TIME AS CHAR) NOT IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) AND mt.CLOSE_TIME IS NOT NULL THEN UNIX_TIMESTAMP(mt.CLOSE_TIME) * 1000
    ELSE 0
  END AS time_done_utc_ms,
  NULLIF(mt.SL, 0) AS price_sl,
  CASE
    WHEN mt.CMD IN (0, 1) AND (CAST(mt.CLOSE_TIME AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) OR mt.CLOSE_TIME IS NULL) THEN mt.VOLUME / 100.0
    WHEN mt.CMD IN (2, 3, 4, 5) THEN mt.VOLUME / 100.0
    ELSE 0
  END AS volume_current,
  mt.DIGITS AS digits,
  CASE
    WHEN mt.CMD IN (0, 1) AND CAST(mt.CLOSE_TIME AS CHAR) NOT IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) AND mt.CLOSE_TIME IS NOT NULL THEN 4
    ELSE 0
  END AS state,
  CASE
    WHEN mt.CLOSE_PRICE &lt;&gt; 0 THEN mt.CLOSE_PRICE
    ELSE mt.OPEN_PRICE
  END AS price_current,
  0 AS account_mode,
  CASE
    WHEN mt.CMD IN (0, 1) THEN CONCAT(mt.LOGIN, &apos;:&apos;, mt.SYMBOL, &apos;:&apos;, mt.TICKET)
    ELSE NULL
  END AS position_id,
  mt.*
FROM MT4_TRADES mt
WHERE mt.LOGIN = ?
ORDER BY mt.OPEN_TIME DESC, mt.TICKET DESC</stringProp>
              <stringProp name="queryArguments">${order_ex_check_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_order_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询待处理历史订单数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;order_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;order_ex_check_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5待处理历史订单-${order_ex_check_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">SELECT
  mt.Symbol AS symbol,
  mt.PositionID AS position_ticket,
  mt.PriceOrder AS price_open,
  mt.VolumeInitial / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Type AS type,
  UNIX_TIMESTAMP(mt.TimeSetupMsc) * 1000 AS time_setup_utc_ms,
  mt.`Order` AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  UNIX_TIMESTAMP(mt.TimeDoneMsc) * 1000 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.VolumeCurrent / 10000.0 AS volume_current,
  mt.Digits AS digits,
  mt.State AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.PositionID) AS position_id,
  &apos;pending_order&apos; AS record_type
FROM mt5_orders mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND TRIM(mt.Symbol) &lt;&gt; &apos;&apos;
  AND mt.Symbol REGEXP &apos;[A-Za-z]&apos;
  AND mt.Type IN (2, 3, 4, 5, 6, 7)
  AND mt.VolumeCurrent &gt; 0

UNION ALL

SELECT
  mt.Symbol AS symbol,
  mt.Position AS position_ticket,
  mt.PriceOpen AS price_open,
  mt.Volume / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Action AS type,
  UNIX_TIMESTAMP(mt.TimeCreateMsc) * 1000 AS time_setup_utc_ms,
  mt.Position AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  0 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.Volume / 10000.0 AS volume_current,
  mt.Digits AS digits,
  0 AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.Position) AS position_id,
  &apos;position&apos; AS record_type
FROM mt5_positions mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND TRIM(mt.Symbol) &lt;&gt; &apos;&apos;
  AND mt.Symbol REGEXP &apos;[A-Za-z]&apos;
  AND mt.Action IN (0, 1)
  AND mt.Volume &gt; 0

UNION ALL

SELECT
  mt.Symbol AS symbol,
  mt.PositionID AS position_ticket,
  mt.PriceOrder AS price_open,
  mt.VolumeInitial / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Type AS type,
  UNIX_TIMESTAMP(mt.TimeSetupMsc) * 1000 AS time_setup_utc_ms,
  mt.`Order` AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  UNIX_TIMESTAMP(mt.TimeDoneMsc) * 1000 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.VolumeCurrent / 10000.0 AS volume_current,
  mt.Digits AS digits,
  mt.State AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.PositionID) AS position_id,
  &apos;history_order&apos; AS record_type
FROM mt5_orders_history mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND TRIM(mt.Symbol) &lt;&gt; &apos;&apos;
  AND mt.Symbol REGEXP &apos;[A-Za-z]&apos;
  AND mt.Type IN (0, 1, 2, 3, 4, 5, 6, 7)
  AND mt.State &lt;&gt; 7

ORDER BY time_setup_utc_ms DESC, order_ticket DESC</stringProp>
              <stringProp name="queryArguments">${order_ex_check_login},${order_ex_check_login},${order_ex_check_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT,BIGINT,BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_order_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取待处理/历史订单-数据库校验-${login}-${instanceid}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_order_ex?instanceid=${instanceid}&amp;login=${login}&amp;_limit=500</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-待处理历史订单" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import groovy.transform.Field
import java.math.BigDecimal
import java.text.SimpleDateFormat

def text = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(text ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + text)
    return
}

List asRows(obj) {
    if (obj == null) return []
    if (obj instanceof List) return obj.findAll { it instanceof Map }
    if (obj instanceof Map) {
        for (k in [&apos;orders&apos;, &apos;data&apos;, &apos;rows&apos;, &apos;records&apos;, &apos;list&apos;, &apos;items&apos;, &apos;result&apos;, &apos;results&apos;]) {
            def v = obj[k]
            if (v instanceof List) return v.findAll { it instanceof Map }
            if (v instanceof Map) {
                def nested = asRows(v)
                if (nested) return nested
            }
        }
        def firstList = obj.values().find { it instanceof List &amp;&amp; it.any { it instanceof Map } }
        if (firstList instanceof List) return firstList.findAll { it instanceof Map }
        return [obj]
    }
    return []
}

Map rowToMap(row) {
    def out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else {
        try {
            row.metaClass.properties.each { p -&gt;
                if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot;
            }
        } catch (ignored) {}
    }
    return out
}

String normKey(String s) {
    return (s ?: &apos;&apos;).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase()
}

@Field def aliases = [
    &apos;order_ticket&apos;      : [&apos;order_ticket&apos;, &apos;orderId&apos;, &apos;order_id&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;position_ticket&apos;   : [&apos;position_ticket&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;Position&apos;, &apos;position&apos;, &apos;TICKET&apos;],
    &apos;symbol&apos;            : [&apos;symbol&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;order_symbol&apos;],
    &apos;price_open&apos;        : [&apos;price_open&apos;, &apos;PriceOrder&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;open_price&apos;         : [&apos;open_price&apos;, &apos;price_open&apos;, &apos;PriceOrder&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;price_close&apos;       : [&apos;price_close&apos;, &apos;close_price&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;close_price&apos;       : [&apos;close_price&apos;, &apos;price_close&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;volume_initial&apos;    : [&apos;volume_initial&apos;, &apos;VolumeInitial&apos;, &apos;VOLUME&apos;],
    &apos;price_tp&apos;          : [&apos;price_tp&apos;, &apos;PriceTP&apos;, &apos;TP&apos;],
    &apos;source&apos;            : [&apos;source&apos;, &apos;platform&apos;],
    &apos;login&apos;             : [&apos;login&apos;, &apos;Login&apos;, &apos;LOGIN&apos;, &apos;order_login&apos;],
    &apos;type&apos;              : [&apos;type&apos;, &apos;Type&apos;, &apos;CMD&apos;],
    &apos;time_setup_utc_ms&apos; : [&apos;time_setup_utc_ms&apos;, &apos;TimeSetupMsc&apos;, &apos;TimeCreateMsc&apos;, &apos;OPEN_TIME&apos;],
    &apos;instance_id&apos;       : [&apos;instance_id&apos;, &apos;instanceid&apos;, &apos;instanceId&apos;, &apos;order_instanceid_val&apos;],
    &apos;time_done_utc_ms&apos;  : [&apos;time_done_utc_ms&apos;, &apos;TimeDoneMsc&apos;, &apos;CLOSE_TIME&apos;],
    &apos;price_sl&apos;          : [&apos;price_sl&apos;, &apos;PriceSL&apos;, &apos;SL&apos;],
    &apos;volume_current&apos;    : [&apos;volume_current&apos;, &apos;VolumeCurrent&apos;, &apos;Volume&apos;, &apos;VOLUME&apos;],
    &apos;digits&apos;            : [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;state&apos;             : [&apos;state&apos;, &apos;State&apos;],
    &apos;price_current&apos;     : [&apos;price_current&apos;, &apos;PriceCurrent&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;account_mode&apos;      : [&apos;account_mode&apos;, &apos;accountMode&apos;],
    &apos;position_id&apos;       : [&apos;position_id&apos;, &apos;positionId&apos;],
    &apos;record_type&apos;       : [&apos;record_type&apos;]
]

def findKey(Map m, String field) {
    if (m.containsKey(field)) return field
    for (a in (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    def want = normKey(field)
    return m.keySet().find { normKey(String.valueOf(it)) == want }
}

def valueOf(Map m, String field) {
    def k = findKey(m, field)
    return k == null ? null : m[k]
}

String cleanNumber(String s) {
    if (s == null) return &apos;&apos;
    def t = s.trim()
    if (t ==~ /^-?\d+\.0+$/) return t.substring(0, t.indexOf(&apos;.&apos;))
    return t
}

String idOf(Map row) {
    for (f in [&apos;order_ticket&apos;, &apos;orderId&apos;, &apos;order_id&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;]) {
        def v = valueOf(row, f)
        if (v != null &amp;&amp; String.valueOf(v).trim()) return cleanNumber(String.valueOf(v))
    }
    return &apos;&apos;
}

boolean blank(v) {
    return v == null || String.valueOf(v).trim() == &apos;&apos; || String.valueOf(v).trim().equalsIgnoreCase(&apos;null&apos;) || String.valueOf(v).trim() == &apos;&lt;EOF&gt;&apos;
}

boolean numeric(v) {
    if (v == null) return false
    return String.valueOf(v).trim() ==~ /^-?\d+(\.\d+)?$/
}

boolean timeField(String f) {
    def n = (f ?: &apos;&apos;).toLowerCase()
    return n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;)
}

Date parseDateLike(v) {
    if (blank(v)) return null
    if (v instanceof java.util.Date) return v
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (fmt in [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            def sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    return null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    def sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    return sdf.format(d)
}

String normalizeApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String displayApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeDbTime(v) {
    def d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    return numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizePlain(v) {
    if (blank(v)) return &apos;&apos;
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        try {
            return new BigDecimal(s).stripTrailingZeros().toPlainString()
        } catch (ignored) {}
    }
    return s
}
BigDecimal decimalValue(v) {
    if (blank(v)) return null
    def s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^[+-]?\d+(\.\d+)?([eE][+-]?\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

String decimalText(BigDecimal n) {
    if (n == null) return &apos;null&apos;
    try {
        return n.setScale(8, java.math.RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()
    } catch (Throwable ignored) {
        return n.toPlainString()
    }
}

String percentText(BigDecimal n) {
    return decimalText(n) + &apos;%&apos;
}

boolean priceCompareField(String field) {
    return [&apos;openprice&apos;, &apos;priceopen&apos;, &apos;closeprice&apos;, &apos;priceclose&apos;].contains(normKey(field))
}

String priceDisplayName(String field) {
    return [&apos;openprice&apos;, &apos;priceopen&apos;].contains(normKey(field)) ? &apos;open_price&apos; : &apos;close_price&apos;
}

boolean sameValue(String field, api, expected, boolean expectedIsDb) {
    if (timeField(field)) {
        return normalizeApiTime(api) == (expectedIsDb ? normalizeDbTime(expected) : normalizeApiTime(expected))
    }
    return normalizePlain(api) == normalizePlain(expected)
}

String rendered(String field, v, boolean apiSide, String sourceName) {
    if (blank(v)) return &apos;&lt;empty&gt;&apos;
    if (timeField(field)) {
        if (apiSide) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
        return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    }
    return String.valueOf(v)
}

String csvDisabledRaw = vars.get(&apos;order_ex_csv_disabled_compare_fields&apos;) ?: &apos;&apos;

String shujuku = vars.get(&apos;order_ex_check_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
String login = vars.get(&apos;order_ex_check_login&apos;) ?: vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;
String instanceId = vars.get(&apos;order_ex_check_instanceid&apos;) ?: vars.get(&apos;order_instanceid_val&apos;) ?: &apos;&apos;
String dbDisabledConfigName = instanceId?.toUpperCase()?.contains(&apos;MT4&apos;) ? &apos;order_ex_mt4_disabled_compare_fields&apos; : (instanceId?.toUpperCase()?.contains(&apos;MT5&apos;) ? &apos;order_ex_mt5_disabled_compare_fields&apos; : &apos;order_ex_unknown_disabled_compare_fields&apos;)
String dbDisabledRaw = vars.get(dbDisabledConfigName) ?: &apos;&apos;
def apiRows = asRows(parsed).collect { rowToMap(it) }
if (!apiRows) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口没有返回可对比的待处理/历史订单记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
    return
}

Map apiRow = null
Map expectedRow = null
boolean expectedIsDb = shujuku == &apos;1&apos;
String sourceName = expectedIsDb ? &apos;DB&apos; : &apos;CSV&apos;
String disabledRaw = expectedIsDb ? dbDisabledRaw : csvDisabledRaw
String disabledConfigName = expectedIsDb ? dbDisabledConfigName + &apos;(DB/API)&apos; : &apos;order_ex_csv_disabled_compare_fields(CSV/API)&apos;
Set disabled = (disabledRaw
    .split(/[，,\s]+/)
    .collect { it.trim() }
    .findAll { it })
    .collect { normKey(it) } as Set
String matchedId = &apos;&apos;
String dbFirstId = &apos;&apos;
String apiFirstId = idOf(apiRows[0])

if (expectedIsDb) {
    def dbObj = vars.getObject(&apos;db_order_ex_check_rows&apos;)
    def dbRows = []
    if (dbObj instanceof List) dbRows = dbObj.collect { rowToMap(it) }
    else if (dbObj != null) dbRows = [rowToMap(dbObj)]
    dbRows = dbRows.findAll { it }
    if (!dbRows) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;数据库未返回待处理/历史订单记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
        return
    }
    dbFirstId = idOf(dbRows[0])
    for (a in apiRows) {
        def aid = idOf(a)
        def d = dbRows.find { idOf(it) == aid }
        if (d) {
            apiRow = a
            expectedRow = d
            matchedId = aid
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;接口和数据库数据记录没有匹配上订单号 | apiFirst=&apos; + apiFirstId + &apos; | dbFirst=&apos; + dbFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;) + &apos; | dbIds=&apos; + dbRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
} else {
    expectedRow = new LinkedHashMap()
    def csvFields = &apos;shujuku,order_instanceid_val,order_login,order_id,order_symbol,symbol,position_ticket,price_open,volume_initial,price_tp,source,login,type,time_setup_utc_ms,order_ticket,instance_id,time_done_utc_ms,price_sl,volume_current,digits,state,price_current,account_mode,position_id&apos;.split(&apos;,&apos;)
    csvFields.each { key -&gt;
        def val = vars.get(key)
        if (!blank(val)) expectedRow[key] = val
    }
    def csvId = idOf(expectedRow)
    for (a in apiRows) {
        if (idOf(a) == csvId) {
            apiRow = a
            matchedId = csvId
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;CSV订单号和接口响应返回订单号没有匹配上 | csvId=&apos; + csvId + &apos; | apiFirst=&apos; + apiFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
}

def apiFields = apiRow.keySet().collect { String.valueOf(it) }
def detailsOk = []
def detailsFail = []
def detailsSkip = []
String orderNoText = matchedId ? &quot;订单号=${matchedId} | &quot; : &apos;&apos;
int comparedTotal = 0
int successCount = 0
int failCount = 0
int skipCount = 0

apiFields.each { field -&gt;
    def apiVal = apiRow[field]
    def expectedKey = findKey(expectedRow, field)
    def expVal = expectedKey == null ? null : expectedRow[expectedKey]
    if (disabled.contains(normKey(field))) {
        skipCount++
        def expectedDisplay = expectedKey == null ? (expectedIsDb ? &apos;&lt;empty&gt; 数据库查询无此字段数据&apos; : &apos;&lt;empty&gt; CSV未配置此字段或值为空&apos;) : rendered(field, expVal, !expectedIsDb, sourceName)
        detailsSkip &lt;&lt; &quot;跳过 | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${expectedDisplay} | ${sourceName}字段=${expectedKey ?: &apos;&lt;not found&gt;&apos;} | 原因=字段在${disabledConfigName}中，未参与${sourceName}/API校验&quot;
        return
    }
    if (expectedKey == null || blank(expVal)) {
        skipCount++
        def marker = expectedKey == null ? (expectedIsDb ? &apos;&lt;empty&gt; 数据库查询无此字段数据&apos; : &apos;&lt;empty&gt; CSV未配置此字段或值为空&apos;) : rendered(field, expVal, !expectedIsDb, sourceName)
        detailsSkip &lt;&lt; &quot;跳过 | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${marker} | ${sourceName}字段=${expectedKey ?: &apos;&lt;not found&gt;&apos;} | 原因=${expectedIsDb ? &apos;数据库查询无此字段数据或值为空，无法对比&apos; : &apos;CSV未配置此字段或值为空，无法对比&apos;}&quot;
        return
    }
    comparedTotal++
    if (priceCompareField(field)) {
        BigDecimal apiNum = decimalValue(apiVal)
        BigDecimal baseNum = decimalValue(expVal)
        if (apiNum != null &amp;&amp; baseNum != null) {
            BigDecimal diff = baseNum.subtract(apiNum).abs()
            String apiPrint = rendered(field, apiVal, true, sourceName)
            String basePrint = rendered(field, expVal, !expectedIsDb, sourceName)
            String priceName = priceDisplayName(field)
            if (baseNum.compareTo(BigDecimal.ZERO) == 0) {
                boolean zeroPass = apiNum.compareTo(BigDecimal.ZERO) == 0
                String zeroNote = zeroPass ? priceName + &apos; 基准&apos; + sourceName + &apos;值为0且API也是0，通过&apos; : priceName + &apos; 基准&apos; + sourceName + &apos;值为0，无法计算百分比且API不为0，失败&apos;
                def zeroLine = &quot;${zeroPass ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=无法计算(${sourceName}基准值为0) | 计算公式=abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 | 备注=${zeroNote}&quot;
                if (zeroPass) { successCount++; detailsOk &lt;&lt; zeroLine } else { failCount++; detailsFail &lt;&lt; zeroLine }
                return
            }
            BigDecimal pct = diff.divide(baseNum.abs(), 10, java.math.RoundingMode.HALF_UP).multiply(new BigDecimal(&apos;100&apos;))
            boolean priceOk = pct.compareTo(new BigDecimal(&apos;2&apos;)) &lt;= 0
            String note = priceOk ? priceName + &apos; 误差小于2%，通过&apos; : priceName + &apos; 误差大于2%，失败&apos;
            String formula = &quot;abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 = ${percentText(pct)}&quot;
            def priceLine = &quot;${priceOk ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=${percentText(pct)} | 计算公式=${formula} | 备注=${note}&quot;
            if (priceOk) { successCount++; detailsOk &lt;&lt; priceLine } else { failCount++; detailsFail &lt;&lt; priceLine }
            return
        }
    }
    boolean ok = sameValue(field, apiVal, expVal, expectedIsDb)
    def line = &quot;${ok ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${rendered(field, expVal, !expectedIsDb, sourceName)} | ${sourceName}字段=${expectedKey}&quot;
    if (ok) {
        successCount++
        detailsOk &lt;&lt; line
    } else {
        failCount++
        detailsFail &lt;&lt; line
    }
}

def status = failCount == 0 ? &apos;PASS&apos; : &apos;FAIL&apos;
def report = []
report &lt;&lt; &apos;╔══════════════════════════════════════════════════════════════╗&apos;
report &lt;&lt; &apos;║  【待处理/历史订单 对比结果】                               ║&apos;
report &lt;&lt; &apos;╚══════════════════════════════════════════════════════════════╝&apos;
report &lt;&lt; &quot;状态: ${status}&quot;
report &lt;&lt; &quot;数据来源: API vs ${sourceName}&quot;
report &lt;&lt; &quot;当前跳过字段配置: ${disabledConfigName}=[${disabledRaw}]&quot;
report &lt;&lt; &quot;instanceid=${instanceId} | login=${login} | 匹配订单号=${matchedId}&quot;
report &lt;&lt; &quot;接口返回记录数: ${apiRows.size()} | 接口首条订单号: ${apiFirstId}&quot; + (expectedIsDb ? &quot; | DB首条订单号: ${dbFirstId}&quot; : &apos;&apos;)
report &lt;&lt; &quot;接口对比字段总数量: ${apiFields.size()}&quot;
report &lt;&lt; &quot;实际参与对比字段数量: ${comparedTotal}&quot;
report &lt;&lt; &quot;成功字段数量: ${successCount}&quot;
report &lt;&lt; &quot;失败字段数量: ${failCount}&quot;
report &lt;&lt; &quot;跳过字段（未参与校验）数量: ${skipCount}&quot;
report &lt;&lt; &apos;时间字段规则: API/CSV秒或毫秒时间戳先按Asia/Shanghai展示，再减8小时取UTC格式后与DB时间比较&apos;
report &lt;&lt; &apos;价格字段规则: open_price/price_open、close_price/price_close 按DB或CSV为基准计算差值百分比；误差大于2%计入失败字段，否则计入成功字段；字段跳过配置仍优先。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败字段明细】&apos;
report.addAll(detailsFail ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细】&apos;
report.addAll(detailsOk ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细（含跳过原因）】&apos;
report.addAll(detailsSkip ?: [&apos;无&apos;])

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)

def detail = new SampleResult()
detail.setSampleLabel(&apos;待处理/历史订单字段对比结果&apos;)
detail.setSuccessful(failCount == 0)
detail.setResponseCode(failCount == 0 ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(status)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
prev.addSubResult(detail)

if (failCount &gt; 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="查询多个账户的历史平仓仓位/已平仓订单事务001-4-back-002--品种进行区分美分账号" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户历史平仓" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的历史平仓仓位-数据库校验.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_deal_ticket,symbol,order_types,close_time_from_utc_ms,close_time_to_utc_ms,volume_lots_condition,volume_lots_value,floating_pl,sort_by,sort_order,reason,price_close,position_ticket,updated_utc_ms,fee,open_time_utc_ms,price_open,source,price_sl,commission,digits_currency,order_type,profit,volume_lots,side,swap,deal_ticket,price_tp,order_ticket,close_time_utc_ms,instance_id,net_profit,comment,digits,contract_size,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">order_type,side</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段跳过配置；同时控制summary和当前页明细；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户历史平仓参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的历史平仓仓位-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户历史平仓CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户历史平仓CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;history_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户历史平仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;history_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String login = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
    String platform = platformOf(instanceId)
    if (instanceId &amp;&amp; login &amp;&amp; platform) {
        String key = instanceId + &apos;|&apos; + login
        if (!accountKeys.contains(key)) {
            accountKeys &lt;&lt; key
            accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
        }
        if (platform == &apos;MT4&apos;) {
            mt4Logins &lt;&lt; login
            mt4LoginInstance[login] = instanceId
        } else if (platform == &apos;MT5&apos;) {
            mt5Logins &lt;&lt; login
            mt5LoginInstance[login] = instanceId
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户历史平仓没有可用accounts，CSV需要填写 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;close_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;symbol&apos;, &apos;filter_symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String closeFrom = cleanInt(firstValue(currentRow, [&apos;close_time_from_utc_ms&apos;, &apos;close_time_utc_ms__gte&apos;, &apos;close_time_from&apos;]))
String closeTo = cleanInt(firstValue(currentRow, [&apos;close_time_to_utc_ms&apos;, &apos;close_time_utc_ms__lte&apos;, &apos;close_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;volume_lots&apos;, &apos;volume&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (closeFrom) filters[&apos;close_time_from_utc_ms&apos;] = Long.parseLong(closeFrom)
if (closeTo) filters[&apos;close_time_to_utc_ms&apos;] = Long.parseLong(closeTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;history_positions_shujuku&apos;, shujuku)
vars.put(&apos;history_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;history_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;history_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;history_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;history_positions_request_body&apos;, requestBody)
vars.put(&apos;history_positions_page&apos;, page)
vars.put(&apos;history_positions_page_size&apos;, pageSize)
vars.put(&apos;history_positions_sort_by&apos;, sortBy)
vars.put(&apos;history_positions_sort_order&apos;, sortOrder)
vars.put(&apos;history_positions_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;history_positions_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;history_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_history_positions_summary_rows&apos;, [])
vars.putObject(&apos;db_history_positions_page_rows&apos;, [])

String closeMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.CLOSE_TIME) / 1000 AS UNSIGNED)&quot;
String openMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String closeMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, d.TimeMsc) / 1000 AS UNSIGNED)&quot;
String openMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, COALESCE(in_d.open_time_msc, d.TimeMsc)) / 1000 AS UNSIGNED)&quot;
String orderTypeSql = orderTypeList ? orderTypeList.join(&apos;,&apos;) : &apos;0,1&apos;
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + (mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;) + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.VOLUME &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.CLOSE_TIME IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;mt.CLOSE_TIME &lt;&gt; &apos;1970-01-01 00:00:00&apos;&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (filterDealTicket) mt4Where &lt;&lt; (filterDealTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;0 = &apos; + filterDealTicket)
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (closeFrom) mt4Where &lt;&lt; closeMsMt4 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt4Where &lt;&lt; closeMsMt4 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &lt; 0&apos;

List mt5Where = []
mt5Where &lt;&lt; &apos;d.Login IN (&apos; + (mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;) + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Action IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Entry IN (1, 3)&apos;
mt5Where &lt;&lt; &apos;d.VolumeExt &gt; 0&apos;
if (filterOrderTicket) mt5Where &lt;&lt; &apos;d.`Order` = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; &apos;d.PositionID = &apos; + filterPositionTicket
if (filterDealTicket) mt5Where &lt;&lt; &apos;d.Deal = &apos; + filterDealTicket
if (symbol) mt5Where &lt;&lt; &apos;d.Symbol = &apos; + sqlQuote(symbol)
if (closeFrom) mt5Where &lt;&lt; closeMsMt5 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt5Where &lt;&lt; closeMsMt5 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt5Where &lt;&lt; &apos;(d.VolumeExt / 100000000.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt5Where &lt;&lt; &apos;d.Profit &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt5Where &lt;&lt; &apos;d.Profit &lt; 0&apos;

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;d.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.TICKET AS position_ticket,
  0 AS deal_ticket,
  mt.SYMBOL AS symbol,
  mt.CMD AS order_type,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(mt.CMD AS CHAR) END AS side,
  mt.REASON AS reason,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS price_open,
  mt.CLOSE_PRICE AS price_close,
  mt.SL AS price_sl,
  mt.TP AS price_tp,
  mt.PROFIT AS profit,
  mt.SWAPS AS swap,
  mt.COMMISSION AS commission,
  0 AS fee,
  mt.PROFIT + mt.SWAPS + mt.COMMISSION AS net_profit,
  ${openMsMt4} AS open_time_utc_ms,
  ${closeMsMt4} AS close_time_utc_ms,
  ${closeMsMt4} AS updated_utc_ms,
  mt.DIGITS AS digits,
  mt.DIGITS AS digits_currency,
  0 AS contract_size,
  mt.COMMENT AS comment,
  CASE WHEN LOWER(TRIM(COALESCE(mt.SYMBOL, &apos;&apos;))) LIKE &apos;%cent%&apos; THEN 1 ELSE 0 END AS is_cent_account
FROM mt4_report.MT4_TRADES mt
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  d.Login AS login,
  &apos;mt5&apos; AS source,
  d.`Order` AS order_ticket,
  d.PositionID AS position_ticket,
  d.Deal AS deal_ticket,
  d.Symbol AS symbol,
  d.Action AS order_type,
  CASE d.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(d.Action AS CHAR) END AS side,
  d.Reason AS reason,
  d.VolumeExt / 100000000.0 AS volume_lots,
  COALESCE(in_d.open_price, d.PricePosition) AS price_open,
  d.Price AS price_close,
  d.PriceSL AS price_sl,
  d.PriceTP AS price_tp,
  d.Profit AS profit,
  d.Storage AS swap,
  d.Commission AS commission,
  d.Fee AS fee,
  d.Profit + d.Storage + d.Commission + d.Fee AS net_profit,
  ${openMsMt5} AS open_time_utc_ms,
  ${closeMsMt5} AS close_time_utc_ms,
  ${closeMsMt5} AS updated_utc_ms,
  d.Digits AS digits,
  d.DigitsCurrency AS digits_currency,
  d.ContractSize AS contract_size,
  d.Comment AS comment,
  CASE WHEN LOWER(TRIM(COALESCE(d.Symbol, &apos;&apos;))) LIKE &apos;%cent%&apos; THEN 1 ELSE 0 END AS is_cent_account
FROM mt5_report.mt5_deals d
LEFT JOIN (
  SELECT
    Login,
    PositionID,
    Symbol,
    MIN(TimeMsc) AS open_time_msc,
    SUBSTRING_INDEX(GROUP_CONCAT(Price ORDER BY TimeMsc ASC, Deal ASC), &apos;,&apos;, 1) + 0 AS open_price
  FROM mt5_report.mt5_deals
  WHERE Entry = 0
    AND Action IN (0, 1)
  GROUP BY Login, PositionID, Symbol
) in_d
  ON in_d.Login = d.Login
 AND in_d.PositionID = d.PositionID
 AND in_d.Symbol = d.Symbol
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;close_time_utc_ms&apos;, &apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;close_time_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String historyRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN 0 ELSE volume_lots END), 0) AS standard_volume,
  COALESCE(SUM(commission + fee), 0) AS total_fee,
  COALESCE(SUM(swap), 0) AS total_storage,
  COALESCE(SUM(profit), 0) AS total_profit
FROM (
${historyRowsSql}
) history_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  instance_id,
  login,
  source,
  order_ticket,
  position_ticket,
  deal_ticket,
  symbol,
  order_type,
  side,
  reason,
  volume_lots,
  price_open,
  price_close,
  price_sl,
  price_tp,
  profit,
  swap,
  commission,
  fee,
  net_profit,
  open_time_utc_ms,
  close_time_utc_ms,
  updated_utc_ms,
  digits,
  digits_currency,
  contract_size,
  comment
FROM (
${historyRowsSql}
) history_rows
ORDER BY ${sortColumn} ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\\r&apos;, &apos; &apos;).replace(&apos;\\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
vars.put(&apos;history_positions_summary_sql&apos;, summarySqlExec)
vars.put(&apos;history_positions_page_sql&apos;, pageSqlExec)

String initReport = &apos;list_history_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;init passed&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + &apos;\n\n【统计summary SQL（MT4+MT5合并，只查询一次，实际执行SQL）】\n&apos; + summarySqlExec + &apos;\n\n【当前页明细 SQL（MT4+MT5合并，实际执行SQL）】\n&apos; + pageSqlExec, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
