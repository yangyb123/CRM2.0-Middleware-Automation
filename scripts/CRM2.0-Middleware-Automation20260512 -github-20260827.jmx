          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT4-查询账户级财务指标数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;acct_metrics_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;acct_metrics_db_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4账户级财务指标-${acct_metrics_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
              <stringProp name="query">SELECT
  mt.*,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS platform,
  &apos;MT4_1&apos; AS instance_id,
  &apos;live&apos; AS server_type,
  mt.`GROUP` AS `group`,
  mt.CURRENCY AS currency,
  mt.LEVERAGE AS leverage,
  mt.BALANCE AS balance,
  mt.CREDIT AS credit,
  mt.EQUITY AS equity,
  mt.MARGIN AS margin,
  (mt.EQUITY - mt.MARGIN) AS margin_free,
  (mt.EQUITY - mt.BALANCE - mt.CREDIT) AS profit,
  CASE WHEN mt.MARGIN &gt; 0 THEN mt.EQUITY / mt.MARGIN * 100 ELSE 0 END AS margin_level,
  IFNULL(pos.position_count, 0) AS position_count,
  IFNULL(pos.swap_total, 0) AS swap_total,
  IFNULL(pos.commission_total, 0) AS commission_total,
  UNIX_TIMESTAMP(mt.MODIFY_TIME) * 1000 AS metrics_updated_utc_ms,
  false AS metrics_degraded
FROM MT4_USERS mt
LEFT JOIN (
  SELECT
    t.LOGIN,
    COUNT(*) AS position_count
  FROM MT4_TRADES t
  WHERE t.TICKET &gt; 0
    AND t.SYMBOL IS NOT NULL
    AND TRIM(t.SYMBOL) &lt;&gt; &apos;&apos;
    AND t.SYMBOL REGEXP &apos;[A-Za-z]&apos;
    AND t.CMD IN (0, 1)
    AND t.VOLUME &gt; 0
    AND t.CONV_RATE1 = 0
  GROUP BY t.LOGIN
) pos ON pos.LOGIN = mt.LOGIN
WHERE mt.LOGIN = ?</stringProp>
              <stringProp name="queryArguments">${acct_metrics_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_acct_metrics_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
