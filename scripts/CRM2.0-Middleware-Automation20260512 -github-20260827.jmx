      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="17-1优化脚本获取用户信息-数据校验✅✅">
        <stringProp name="TestPlan.comments">get_user_info：可迁移自包含版。默认从JMX所在目录读取 获取用户信息-数据校验.csv，也可通过 -Juser_info_csv_path=&lt;CSV绝对路径&gt; 指定；CSV到EOF时自动停止线程。初始化、对比和打印Groovy逻辑均已内嵌到本线程组，换机器/换目录时不依赖外部jmeter_scripts。shujuku=1时按MT4/MT5查询对应数据库并按接口返回字段逐字段DB/API对比；shujuku=0时按当前CSV行做CSV/API对比。只修改本线程组。

（profit  是动态数值，在CSV 设置跳过了）</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="获取用户信息CSV循环">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="17获取用户信息-数据校验事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-获取用户信息数据校验" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">${__groovy(def configured = String.valueOf(props.get(&apos;user_info_csv_path&apos;) ?: &apos;&apos;).trim(); if (configured) return new File(configured).canonicalPath; def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(); return new File(base + File.separator + &apos;获取用户信息-数据校验.csv&apos;).canonicalPath)}</stringProp>
            <boolProp name="ignoreFirstLine">false</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames"></stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="获取用户信息MT4-DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="user_info_mt4_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">user_info_mt4_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">last_access,name,prevequity,prevequity_reporting,prevmonthequity,prevmonthequity_reporting,timestamp</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT4 DB/API跳过字段；英文逗号分隔，*跳过全部。所有API返回字段均支持跳过；未配置的字段继续比较。</stringProp>
              </elementProp>
              <elementProp name="user_info_mt4_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">user_info_mt4_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">margin=10,margin_reporting=10,profit=10,profit_reporting=10,equity=10,equity_reporting=10,margin_free=10,margin_free_reporting=10,margin_level=10</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT4逐字段百分比误差，格式field=percent并用逗号分隔；以DB绝对值为基准，未配置数值字段默认0%。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="获取用户信息MT5-DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="user_info_mt5_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">user_info_mt5_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">taxes_reporting</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT5 DB/API跳过字段；英文逗号分隔，*跳过全部。所有API返回字段均支持跳过；未配置的字段继续比较。</stringProp>
              </elementProp>
              <elementProp name="user_info_mt5_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">user_info_mt5_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">margin=10,margin_reporting=10,profit=10,profit_reporting=10,equity=10,MarginFree=10,MarginLevel=10,equity_reporting=10,margin_free_reporting=10</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT5逐字段百分比误差，格式field=percent并用逗号分隔；以DB绝对值为基准，未配置数值字段默认0%。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="获取用户信息CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="user_info_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">user_info_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">LastIP,MQID,Balance,profit,name,prevequity,prevequity_reporting,prevmonthequity,prevmonthequity_reporting,timestamp,balance_reporting,equity,equity_reporting,margin_free,margin_free_reporting,margin_level,prevbalance,prevbalance_reporting,prevmonthbalance,prevmonthbalance_reporting</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API跳过字段；英文逗号分隔，*跳过全部。所有API返回字段均支持跳过；未配置的字段继续比较。</stringProp>
              </elementProp>
              <elementProp name="user_info_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">user_info_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=10,profit_reporting=10</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV逐字段百分比误差，格式field=percent并用逗号分隔；以CSV绝对值为基准，未配置数值字段默认0%。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化获取用户信息数据校验参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;获取用户信息-数据校验.csv&apos;
String configuredCsvPath = String.valueOf(props.get(&apos;user_info_csv_path&apos;) ?: &apos;&apos;).trim()
File csvFile = configuredCsvPath ? new File(configuredCsvPath) : new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.isFile()) {
    throw new AssertionError(&apos;获取用户信息CSV文件不存在: &apos; + csvFile.canonicalPath + &apos;；默认请将CSV与JMX放在同一目录，或使用 -Juser_info_csv_path=&lt;CSV绝对路径&gt;&apos;)
}

List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) {
    throw new AssertionError(&apos;获取用户信息CSV没有数据行: &apos; + csvFile.getPath())
}

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
int caseIndex = ((vars.get(&apos;user_info_case_index&apos;) ?: &apos;0&apos;) as int)
int dataCount = rawLines.size() - 1
if (caseIndex &gt;= dataCount) {
    throw new AssertionError(&apos;获取用户信息CSV循环次数超出数据行数 | caseIndex=&apos; + caseIndex + &apos; | dataCount=&apos; + dataCount)
}
vars.put(&apos;user_info_case_index&apos;, String.valueOf(caseIndex + 1))

List values = parseCsvLine(rawLines[caseIndex + 1])
Map currentRow = new LinkedHashMap()
headers.eachWithIndex { h, idx -&gt;
    if (h) {
        String v = idx &lt; values.size() ? (values[idx] ?: &apos;&apos;) : &apos;&apos;
        currentRow[h] = v
        vars.put(h, v)
    }
}
currentRow[&apos;__line_no&apos;] = caseIndex + 2

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        if (row.containsKey(n)) {
            String v = row[n] == null ? &apos;&apos; : row[n].toString().trim()
            if (v &amp;&amp; !v.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return v
        }
    }
    &apos;&apos;
}

String shujuku = firstValue(currentRow, [&apos;shujuku&apos;])
if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) {
    throw new AssertionError(&apos;获取用户信息 shujuku 只能是0或1，当前=&apos; + shujuku + &apos; | CSV行=&apos; + currentRow[&apos;__line_no&apos;])
}

String instanceId = firstValue(currentRow, [&apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;, &apos;instanceid&apos;])
String login = firstValue(currentRow, [&apos;order_login&apos;, &apos;login_val&apos;, &apos;Login&apos;, &apos;login&apos;])
if (!instanceId) throw new AssertionError(&apos;获取用户信息 order_instanceid_val/instanceid 不能为空 | CSV行=&apos; + currentRow[&apos;__line_no&apos;])
if (!login) throw new AssertionError(&apos;获取用户信息 order_login/login 不能为空 | CSV行=&apos; + currentRow[&apos;__line_no&apos;])

String upperInstance = instanceId.toUpperCase()
String platform = upperInstance.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (upperInstance.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;获取用户信息只支持 MT4_*/MT5_* instanceid，当前=&apos; + instanceId + &apos; | CSV行=&apos; + currentRow[&apos;__line_no&apos;])
if (!(login ==~ /^\d+$/)) throw new AssertionError(&apos;获取用户信息 login 必须是数字，当前=&apos; + login + &apos; | CSV行=&apos; + currentRow[&apos;__line_no&apos;])

vars.put(&apos;user_info_shujuku&apos;, shujuku)
vars.put(&apos;user_info_instanceid&apos;, instanceId)
vars.put(&apos;user_info_login&apos;, login)
vars.put(&apos;user_info_platform&apos;, platform)
vars.put(&apos;user_info_csv_line_no&apos;, String.valueOf(currentRow[&apos;__line_no&apos;]))
vars.put(&apos;user_info_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;user_info_case_total&apos;, String.valueOf(dataCount))
vars.put(&apos;order_instanceid_val&apos;, instanceId)
vars.put(&apos;order_login&apos;, login)
vars.put(&apos;instanceid_val&apos;, instanceId)
vars.put(&apos;login_val&apos;, login)
vars.put(&apos;instanceid&apos;, instanceId)
vars.put(&apos;login&apos;, login)
vars.putObject(&apos;user_info_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_user_info_rows&apos;, [])
vars.put(&apos;user_info_compare_report&apos;, &apos;&apos;)
vars.put(&apos;user_info_compare_status&apos;, &apos;INIT&apos;)

vars.put(&apos;user_info_mt4_sql&apos;, &apos;&apos;&apos;
WITH mt AS (
  SELECT
    u.*,
    (
      352
      | CASE WHEN u.ENABLE &lt;&gt; 0 THEN 1 ELSE 0 END
      | CASE WHEN u.ENABLE_CHANGE_PASS &lt;&gt; 0 THEN 2 ELSE 0 END
      | CASE WHEN u.ENABLE = 0 THEN 4 ELSE 0 END
      | CASE WHEN u.ENABLE_READONLY &lt;&gt; 0 THEN 516 ELSE 0 END
      | CASE WHEN u.ENABLE_OTP &lt;&gt; 0 THEN 2048 ELSE 0 END
    ) AS rights_calc
  FROM mt4_report.MT4_USERS u
  WHERE u.LOGIN = ?
)
SELECT
  CASE WHEN mt.LASTDATE IS NULL OR CAST(mt.LASTDATE AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(mt.LASTDATE) END AS last_access,
  mt.COUNTRY AS country,
  30.0 AS margin_stopout,
  CAST(ROUND(mt.PREVMONTHBALANCE, 2) AS DECIMAL(30,2)) AS prevmonthbalance,
  CAST(ROUND(mt.MARGIN_FREE, 2) AS DECIMAL(30,2)) AS margin_free,
  CAST(ROUND(mt.TAXES, 2) AS DECIMAL(30,2)) AS taxes,
  &apos;false&apos; AS enable_api_trading,
  CAST(ROUND(mt.EQUITY, 2) AS DECIMAL(30,2)) AS equity,
  CAST(ROUND(mt.BALANCE, 2) AS DECIMAL(30,2)) AS balance,
  IF((mt.rights_calc &amp; 1) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable,
  mt.SEND_REPORTS AS send_reports,
  IF((mt.rights_calc &amp; 2) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_change_password,
  IF((mt.rights_calc &amp; 524) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS disable_trading,
  mt.ID AS id,
  mt.STATE AS state,
  CAST(ROUND(mt.CREDIT, 2) AS DECIMAL(30,2)) AS credit,
  50.0 AS margin_call,
  CAST(ROUND(mt.PREVBALANCE, 2) AS DECIMAL(30,2)) AS prevbalance,
  mt.`GROUP` AS `group`,
  CAST(ROUND(mt.MARGIN, 2) AS DECIMAL(30,2)) AS margin,
  IF((mt.rights_calc &amp; 2048) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_otp,
  mt.PHONE AS phone,
  mt.NAME AS name,
  CASE WHEN mt.REGDATE IS NULL OR CAST(mt.REGDATE AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(mt.REGDATE) END AS registration,
  &apos;false&apos; AS enable_push_notification,
  CAST(ROUND(mt.MARGIN_LEVEL, 2) AS DECIMAL(30,2)) AS margin_level,
  mt.AGENT_ACCOUNT AS agent_account,
  &apos;false&apos; AS sponsored_hosting,
  mt.STATUS AS status,
  mt.LEVERAGE AS leverage,
  IF((mt.rights_calc &amp; 64) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_expert_advisor,
  mt.CITY AS city,
  mt.LOGIN AS login,
  IF((mt.rights_calc &amp; 16) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS confirmed,
  mt.INTERESTRATE AS interestrate,
  mt.rights_calc AS rights,
  mt.CURRENCY AS currency,
  &apos;false&apos; AS exclude_from_reports,
  CAST(ROUND(mt.EQUITY - mt.BALANCE - mt.CREDIT, 2) AS DECIMAL(30,2)) AS profit,
  mt.EMAIL AS email,
  IF((mt.rights_calc &amp; 1) &lt;&gt; 0 AND (mt.rights_calc &amp; 524) = 0, &apos;true&apos;, &apos;false&apos;) AS can_trade,
  mt.TIMESTAMP AS `timestamp`,
  CAST(ROUND(mt.PREVBALANCE, 2) AS DECIMAL(30,2)) AS prevequity,
  &apos;false&apos; AS technical_account,
  mt.ADDRESS AS address,
  mt.ENABLE_READONLY AS enable_read_only,
  IF((mt.rights_calc &amp; 32) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_trailing_stops,
  IF((mt.rights_calc &amp; 1024) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS force_reset_password,
  IF((mt.rights_calc &amp; 512) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS readonly_account,
  IF((mt.rights_calc &amp; 256) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_statement_reports,
  IF((mt.rights_calc &amp; 8) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS investor,
  mt.COMMENT AS comment,
  &apos;broker_live&apos; AS _data_source,
  JSON_OBJECT(&apos;shm_invariant_ok&apos;, true) AS _meta,
  NULL AS storage_recompute,
  NULL AS swap_total,
  0 AS broker_error_code,
  NULL AS margin_level_recompute,
  &apos;&apos; AS broker_recompute_probe_symbol,
  &apos;&apos; AS broker_error_platform,
  &apos;true&apos; AS broker_recompute_failed,
  5000 AS broker_acquire_timeout_ms,
  &apos;true&apos; AS broker_recompute_unsupported_platform,
  NULL AS commission_total,
  &apos;true&apos; AS broker_attempted,
  NULL AS margin_recompute,
  NULL AS margin_free_recompute,
  NULL AS storage,
  &apos;false&apos; AS broker_failed_other,
  NULL AS floating_recompute,
  NULL AS floating,
  NULL AS profit_recompute,
  &apos;false&apos; AS broker_timed_out,
  0 AS broker_recompute_retcode,
  2000 AS broker_timeout_ms,
  NULL AS equity_recompute,
  &apos;&apos; AS broker_error_message
FROM mt
&apos;&apos;&apos;.trim())

vars.put(&apos;user_info_mt5_sql&apos;, &apos;&apos;&apos;
SELECT
  NULL AS FloatingRecompute,
  &apos;&apos; AS BrokerRecomputeProbeSymbol,
  mt.Address AS Address,
  mt.ZipCode AS ZIPCode,
  JSON_OBJECT(&apos;shm_invariant_ok&apos;, true) AS _meta,
  IF((mt.Rights &amp; 16384) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_api_trading,
  CAST(ROUND(COALESCE(acc.Floating, 0.0), 2) AS DECIMAL(30,2)) AS Floating,
  mt.Name AS Name,
  mt.Rights AS Rights,
  CAST(ROUND(COALESCE(acc.MarginFree, 0.0), 2) AS DECIMAL(30,2)) AS MarginFree,
  &apos;false&apos; AS BrokerTimedOut,
  CASE WHEN mt.Registration IS NULL OR CAST(mt.Registration AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(mt.Registration) END AS Registration,
  IF((mt.Rights &amp; 1) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable,
  mt.Leverage AS Leverage,
  CAST(ROUND(COALESCE(acc.Profit, COALESCE(acc.Equity, mt.Balance + mt.Credit) - COALESCE(acc.Balance, mt.Balance) - COALESCE(acc.Credit, mt.Credit)), 2) AS DECIMAL(30,2)) AS Profit,
  IF((mt.Rights &amp; 2) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_change_password,
  mt.ID AS ID,
  mt.MQID AS MQID,
  IF((mt.Rights &amp; 524) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS disable_trading,
  mt.Status AS Status,
  mt.Agent AS Agent,
  &apos;&apos; AS BrokerErrorPlatform,
  mt.Color AS Color,
  mt.City AS City,
  mt.Login AS Login,
  &apos;true&apos; AS BrokerAttempted,
  13 AS BrokerRecomputeRetcode,
  IF((mt.Rights &amp; 2048) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_otp,
  CAST(ROUND(COALESCE(acc.Storage, 0.0), 2) AS DECIMAL(30,2)) AS Storage,
  NULL AS EquityRecompute,
  mt.State AS State,
  &apos;true&apos; AS BrokerRecomputeFailed,
  2000 AS BrokerTimeoutMs,
  mt.Country AS Country,
  NULL AS CommissionTotal,
  IF((mt.Rights &amp; 32768) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_push_notification,
  CAST(ROUND(COALESCE(acc.Balance, mt.Balance), 2) AS DECIMAL(30,2)) AS Balance,
  CAST(ROUND(COALESCE(acc.Margin, 0.0), 2) AS DECIMAL(30,2)) AS Margin,
  IF((mt.Rights &amp; 8192) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS sponsored_hosting,
  5000 AS BrokerAcquireTimeoutMs,
  &apos;false&apos; AS BrokerFailedOther,
  mt.`Group` AS `Group`,
  g.Currency AS GroupCurrency,
  g.MarginStopOut AS MarginStopOut,
  g.MarginCall AS MarginCall,
  IF((mt.Rights &amp; 64) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_expert_advisor,
  &apos;false&apos; AS BrokerRecomputeUnsupportedPlatform,
  CAST(ROUND(COALESCE(acc.Equity, mt.Balance + mt.Credit), 2) AS DECIMAL(30,2)) AS Equity,
  NULL AS ProfitRecompute,
  IF((mt.Rights &amp; 16) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS confirmed,
  CAST(ROUND(COALESCE(acc.Credit, mt.Credit), 2) AS DECIMAL(30,2)) AS Credit,
  NULL AS MarginRecompute,
  mt.Phone AS Phone,
  NULL AS MarginFreeRecompute,
  CAST(ROUND(COALESCE(acc.Storage, 0.0), 2) AS DECIMAL(30,2)) AS SwapTotal,
  &apos;false&apos; AS exclude_from_reports,
  NULL AS MarginLevelRecompute,
  IF((mt.Rights &amp; 1) &lt;&gt; 0 AND (mt.Rights &amp; 524) = 0, &apos;true&apos;, &apos;false&apos;) AS can_trade,
  mt.LastIP AS LastIP,
  mt.Comment AS Comment,
  &apos;false&apos; AS technical_account,
  CAST(ROUND(COALESCE(acc.MarginLevel, CASE WHEN COALESCE(acc.Margin, 0) &gt; 0 THEN acc.Equity / acc.Margin * 100 ELSE 0 END), 2) AS DECIMAL(30,2)) AS MarginLevel,
  &apos;&apos; AS BrokerErrorMessage,
  mt.Email AS EMail,
  IF((mt.Rights &amp; 32) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_trailing_stops,
  IF((mt.Rights &amp; 1024) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS force_reset_password,
  IF((mt.Rights &amp; 512) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS readonly_account,
  IF((mt.Rights &amp; 256) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_statement_reports,
  IF((mt.Rights &amp; 8) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS investor,
  CASE WHEN mt.LastAccess IS NULL OR CAST(mt.LastAccess AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(mt.LastAccess) END AS LastAccess,
  NULL AS StorageRecompute,
  &apos;broker_live&apos; AS _data_source,
  0 AS BrokerErrorCode,
  CAST(ROUND(mt.BalancePrevMonth, 2) AS DECIMAL(30,2)) AS prevmonthbalance,
  CAST(ROUND(mt.BalancePrevDay, 2) AS DECIMAL(30,2)) AS prevbalance,
  mt.InterestRate AS interestrate,
  mt.Timestamp AS `timestamp`,
  CAST(ROUND(mt.EquityPrevDay, 2) AS DECIMAL(30,2)) AS prevequity,
  CAST(ROUND(mt.EquityPrevMonth, 2) AS DECIMAL(30,2)) AS prevmonthequity,
  CASE UPPER(TRIM(COALESCE(g.Currency, &apos;&apos;)))
    WHEN &apos;USD&apos; THEN CAST(ROUND(mt.EquityPrevMonth, 2) AS DECIMAL(30,2))
    WHEN &apos;USC&apos; THEN CAST(ROUND(mt.EquityPrevMonth, 2) / 100.0 AS DECIMAL(30,4))
    ELSE NULL
  END AS prevmonthequity_reporting
FROM mt5_report.mt5_users mt
LEFT JOIN mt5_report.mt5_accounts acc ON acc.Login = mt.Login
LEFT JOIN mt5_report.mt5_groups g ON g.`Group` = mt.`Group`
WHERE mt.Login = ?
&apos;&apos;&apos;.trim())

log.info(&apos;get_user_info init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + dataCount + &apos; | CSV行=&apos; + currentRow[&apos;__line_no&apos;] + &apos; | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login)

// 以下为目标线程组 live_equity=0 的附加初始化
// 本线程组固定调用 get_user_info?live_equity=0。保存该语义，供比较脚本区分
// Broker 运行状态字段、SHM-only 空字段以及真正能够从数据库对账的字段。
vars.put(&apos;user_info_live_equity&apos;, &apos;0&apos;)

// MT4：仅扫描当前登录号；当前持仓的价格盈亏、swap、commission 一次聚合。
// SHM profit 的 OpenAPI 定义为 consolidated floating + swap + commission，
// 因而不再用可能滞后的 MT4_USERS.EQUITY-BALANCE-CREDIT 作为 profit。
vars.put(&apos;user_info_mt4_sql&apos;, &apos;&apos;&apos;
WITH mt AS (
  SELECT
    u.*,
    (
      352
      | CASE WHEN u.ENABLE &lt;&gt; 0 THEN 1 ELSE 0 END
      | CASE WHEN u.ENABLE_CHANGE_PASS &lt;&gt; 0 THEN 2 ELSE 0 END
      | CASE WHEN u.ENABLE = 0 THEN 4 ELSE 0 END
      | CASE WHEN u.ENABLE_READONLY &lt;&gt; 0 THEN 516 ELSE 0 END
      | CASE WHEN u.ENABLE_OTP &lt;&gt; 0 THEN 2048 ELSE 0 END
    ) AS rights_calc
  FROM mt4_report.MT4_USERS u
  WHERE u.LOGIN = ?
),
pos AS (
  SELECT
    t.LOGIN,
    COUNT(*) AS position_count,
    SUM(COALESCE(t.PROFIT, 0)) AS price_profit_total,
    SUM(COALESCE(t.SWAPS, 0)) AS swap_total,
    SUM(COALESCE(t.COMMISSION, 0)) AS commission_total,
    SUM(COALESCE(t.PROFIT, 0) + COALESCE(t.SWAPS, 0) + COALESCE(t.COMMISSION, 0)) AS consolidated_profit
  FROM mt4_report.MT4_TRADES t
  INNER JOIN mt ON mt.LOGIN = t.LOGIN
  WHERE t.TICKET &gt; 0
    AND t.CMD IN (0, 1)
    AND t.SYMBOL IS NOT NULL
    AND TRIM(t.SYMBOL) &lt;&gt; &apos;&apos;
    AND t.SYMBOL REGEXP &apos;[A-Za-z]&apos;
    AND CAST(t.CLOSE_TIME AS CHAR) IN (&apos;1970-01-01 00:00:00&apos;, &apos;0000-00-00 00:00:00&apos;)
  GROUP BY t.LOGIN
),
calc AS (
  SELECT
    mt.*,
    pos.position_count,
    pos.price_profit_total,
    pos.swap_total,
    pos.commission_total,
    COALESCE(pos.consolidated_profit, 0) AS consolidated_profit,
    (mt.BALANCE + mt.CREDIT + COALESCE(pos.consolidated_profit, 0)) AS calculated_equity
  FROM mt
  LEFT JOIN pos ON pos.LOGIN = mt.LOGIN
)
SELECT
  calc.LOGIN AS login,
  calc.`GROUP` AS `group`,
  calc.NAME AS name,
  calc.LEVERAGE AS leverage,
  calc.CITY AS city,
  calc.STATE AS state,
  calc.COUNTRY AS country,
  calc.ADDRESS AS address,
  calc.PHONE AS phone,
  calc.EMAIL AS email,
  calc.COMMENT AS comment,
  calc.ID AS id,
  calc.STATUS AS status,
  CASE WHEN calc.REGDATE IS NULL OR CAST(calc.REGDATE AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(calc.REGDATE) END AS registration,
  CASE WHEN calc.LASTDATE IS NULL OR CAST(calc.LASTDATE AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(calc.LASTDATE) END AS last_access,
  calc.`TIMESTAMP` AS `timestamp`,
  UPPER(TRIM(NULLIF(calc.CURRENCY, &apos;&apos;))) AS currency,
  CAST(ROUND(calc.BALANCE, 2) AS DECIMAL(30,2)) AS balance,
  CAST(ROUND(calc.CREDIT, 2) AS DECIMAL(30,2)) AS credit,
  CAST(ROUND(calc.calculated_equity, 2) AS DECIMAL(30,2)) AS equity,
  CAST(ROUND(calc.MARGIN, 2) AS DECIMAL(30,2)) AS margin,
  CAST(ROUND(calc.calculated_equity - calc.MARGIN, 2) AS DECIMAL(30,2)) AS margin_free,
  CASE WHEN calc.MARGIN &gt; 0 THEN CAST(ROUND(calc.calculated_equity / calc.MARGIN * 100, 6) AS DECIMAL(30,6)) ELSE NULL END AS margin_level,
  CAST(ROUND(calc.consolidated_profit, 2) AS DECIMAL(30,2)) AS profit,
  CAST(ROUND(calc.swap_total, 2) AS DECIMAL(30,2)) AS swap_total,
  CAST(ROUND(calc.commission_total, 2) AS DECIMAL(30,2)) AS commission_total,
  calc.position_count AS position_count,
  CAST(ROUND(calc.PREVMONTHBALANCE, 2) AS DECIMAL(30,2)) AS prevmonthbalance,
  CAST(ROUND(calc.PREVBALANCE, 2) AS DECIMAL(30,2)) AS prevbalance,
  calc.INTERESTRATE AS interestrate,
  CAST(ROUND(calc.TAXES, 2) AS DECIMAL(30,2)) AS taxes,
  calc.AGENT_ACCOUNT AS agent_account,
  calc.SEND_REPORTS AS send_reports,
  calc.rights_calc AS rights,
  IF((calc.rights_calc &amp; 1) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable,
  IF((calc.rights_calc &amp; 2) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_change_password,
  IF((calc.rights_calc &amp; 524) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS disable_trading,
  IF((calc.rights_calc &amp; 8) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS investor,
  IF((calc.rights_calc &amp; 16) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS confirmed,
  IF((calc.rights_calc &amp; 32) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_trailing_stops,
  IF((calc.rights_calc &amp; 64) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_expert_advisor,
  IF((calc.rights_calc &amp; 256) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_statement_reports,
  IF((calc.rights_calc &amp; 512) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS readonly_account,
  IF((calc.rights_calc &amp; 1024) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS force_reset_password,
  IF((calc.rights_calc &amp; 2048) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_otp,
  &apos;false&apos; AS sponsored_hosting,
  &apos;false&apos; AS enable_api_trading,
  &apos;false&apos; AS enable_push_notification,
  &apos;false&apos; AS technical_account,
  &apos;false&apos; AS exclude_from_reports,
  IF((calc.rights_calc &amp; 1) &lt;&gt; 0 AND (calc.rights_calc &amp; 524) = 0, &apos;true&apos;, &apos;false&apos;) AS can_trade,
  calc.ENABLE_READONLY AS enable_read_only,
  50.0 AS margin_call,
  30.0 AS margin_stopout
FROM calc
&apos;&apos;&apos;.trim())

// MT5：位置表提供价格浮盈和 Storage，成交表对仍处于活动状态的位置聚合 Commission。
// Profit/Equity/MarginFree/MarginLevel 使用同一份聚合结果，避免混用不同更新时间的账户快照。
vars.put(&apos;user_info_mt5_sql&apos;, &apos;&apos;&apos;
WITH usr AS (
  SELECT
    u.*,
    g.Currency AS GroupCurrency,
    g.MarginStopOut AS GroupMarginStopOut,
    g.MarginCall AS GroupMarginCall
  FROM mt5_report.mt5_users u
  LEFT JOIN mt5_report.mt5_groups g ON g.`Group` = u.`Group`
  WHERE u.Login = ?
),
pos AS (
  SELECT
    p.Login,
    COUNT(*) AS position_count,
    SUM(COALESCE(p.Profit, 0)) AS price_profit_total,
    SUM(COALESCE(p.Storage, 0)) AS swap_total
  FROM mt5_report.mt5_positions p
  INNER JOIN usr ON usr.Login = p.Login
  WHERE p.Position &gt; 0
    AND p.Action IN (0, 1)
    AND p.Volume &gt; 0
    AND p.PriceOpen &gt; 0
    AND p.Symbol IS NOT NULL
    AND TRIM(p.Symbol) &lt;&gt; &apos;&apos;
    AND p.Symbol REGEXP &apos;[A-Za-z]&apos;
  GROUP BY p.Login
),
fees AS (
  SELECT
    d.Login,
    SUM(COALESCE(d.Commission, 0)) AS commission_total
  FROM mt5_report.mt5_deals d
  INNER JOIN mt5_report.mt5_positions active_pos
    ON active_pos.Login = d.Login
   AND active_pos.Position = d.PositionID
  INNER JOIN usr ON usr.Login = d.Login
  WHERE d.Action IN (0, 1)
    AND active_pos.Position &gt; 0
    AND active_pos.Volume &gt; 0
  GROUP BY d.Login
),
base AS (
  SELECT
    usr.*,
    acc.Balance AS AccountBalance,
    acc.Credit AS AccountCredit,
    acc.Margin AS AccountMargin,
    acc.Floating AS AccountFloating,
    acc.Storage AS AccountStorage,
    pos.position_count,
    pos.price_profit_total,
    pos.swap_total,
    fees.commission_total,
    (COALESCE(pos.price_profit_total, 0) + COALESCE(pos.swap_total, 0) + COALESCE(fees.commission_total, 0)) AS consolidated_profit
  FROM usr
  LEFT JOIN mt5_report.mt5_accounts acc ON acc.Login = usr.Login
  LEFT JOIN pos ON pos.Login = usr.Login
  LEFT JOIN fees ON fees.Login = usr.Login
),
calc AS (
  SELECT
    base.*,
    COALESCE(base.AccountBalance, base.Balance) AS calculated_balance,
    COALESCE(base.AccountCredit, base.Credit) AS calculated_credit,
    COALESCE(base.AccountMargin, 0) AS calculated_margin,
    (COALESCE(base.AccountBalance, base.Balance) + COALESCE(base.AccountCredit, base.Credit) + base.consolidated_profit) AS calculated_equity
  FROM base
)
SELECT
  calc.Login AS Login,
  calc.Name AS Name,
  calc.`Group` AS `Group`,
  calc.GroupCurrency AS GroupCurrency,
  calc.GroupMarginStopOut AS MarginStopOut,
  calc.GroupMarginCall AS MarginCall,
  UPPER(TRIM(NULLIF(calc.GroupCurrency, &apos;&apos;))) AS currency,
  CAST(ROUND(calc.calculated_balance, 2) AS DECIMAL(30,2)) AS Balance,
  CAST(ROUND(calc.calculated_credit, 2) AS DECIMAL(30,2)) AS Credit,
  CAST(ROUND(calc.calculated_equity, 2) AS DECIMAL(30,2)) AS Equity,
  CAST(ROUND(calc.calculated_margin, 2) AS DECIMAL(30,2)) AS Margin,
  CAST(ROUND(calc.calculated_equity - calc.calculated_margin, 2) AS DECIMAL(30,2)) AS MarginFree,
  CASE WHEN calc.calculated_margin &gt; 0 THEN CAST(ROUND(calc.calculated_equity / calc.calculated_margin * 100, 6) AS DECIMAL(30,6)) ELSE NULL END AS MarginLevel,
  CAST(ROUND(calc.consolidated_profit, 2) AS DECIMAL(30,2)) AS Profit,
  CAST(ROUND(calc.AccountFloating, 2) AS DECIMAL(30,2)) AS Floating,
  CAST(ROUND(calc.AccountStorage, 2) AS DECIMAL(30,2)) AS Storage,
  CAST(ROUND(calc.swap_total, 2) AS DECIMAL(30,2)) AS SwapTotal,
  CAST(ROUND(calc.commission_total, 2) AS DECIMAL(30,2)) AS CommissionTotal,
  calc.position_count AS position_count,
  calc.Leverage AS Leverage,
  calc.Rights AS Rights,
  IF((calc.Rights &amp; 1) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable,
  IF((calc.Rights &amp; 2) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_change_password,
  IF((calc.Rights &amp; 524) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS disable_trading,
  IF((calc.Rights &amp; 8) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS investor,
  IF((calc.Rights &amp; 16) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS confirmed,
  IF((calc.Rights &amp; 32) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_trailing_stops,
  IF((calc.Rights &amp; 64) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_expert_advisor,
  IF((calc.Rights &amp; 256) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_statement_reports,
  IF((calc.Rights &amp; 512) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS readonly_account,
  IF((calc.Rights &amp; 1024) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS force_reset_password,
  IF((calc.Rights &amp; 2048) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_otp,
  IF((calc.Rights &amp; 8192) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS sponsored_hosting,
  IF((calc.Rights &amp; 16384) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_api_trading,
  IF((calc.Rights &amp; 32768) &lt;&gt; 0, &apos;true&apos;, &apos;false&apos;) AS enable_push_notification,
  &apos;false&apos; AS technical_account,
  &apos;false&apos; AS exclude_from_reports,
  IF((calc.Rights &amp; 1) &lt;&gt; 0 AND (calc.Rights &amp; 524) = 0, &apos;true&apos;, &apos;false&apos;) AS can_trade,
  CASE WHEN calc.Registration IS NULL OR CAST(calc.Registration AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(calc.Registration) END AS Registration,
  CASE WHEN calc.LastAccess IS NULL OR CAST(calc.LastAccess AS CHAR) = &apos;0000-00-00 00:00:00&apos; THEN 0 ELSE UNIX_TIMESTAMP(calc.LastAccess) END AS LastAccess,
  calc.Country AS Country,
  calc.City AS City,
  calc.State AS State,
  calc.ZipCode AS ZIPCode,
  calc.Address AS Address,
  calc.Phone AS Phone,
  calc.Email AS EMail,
  calc.Comment AS Comment,
  calc.ID AS ID,
  calc.Status AS Status,
  calc.LastIP AS LastIP,
  calc.MQID AS MQID,
  calc.Color AS Color,
  calc.Agent AS Agent,
  CAST(ROUND(calc.BalancePrevMonth, 2) AS DECIMAL(30,2)) AS prevmonthbalance,
  CAST(ROUND(calc.BalancePrevDay, 2) AS DECIMAL(30,2)) AS prevbalance,
  calc.InterestRate AS interestrate,
  calc.`Timestamp` AS `timestamp`,
  CAST(ROUND(calc.EquityPrevDay, 2) AS DECIMAL(30,2)) AS prevequity,
  CAST(ROUND(calc.EquityPrevMonth, 2) AS DECIMAL(30,2)) AS prevmonthequity
FROM calc
&apos;&apos;&apos;.trim())

log.info(&apos;get_user_info target init override | live_equity=0 | optimized MT4/MT5 position aggregates enabled&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
