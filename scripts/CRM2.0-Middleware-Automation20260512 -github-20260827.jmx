          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询多个账户历史平仓仓位/已平仓订单-${history_positions_mode}-${history_positions_case_index_display}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">10000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
