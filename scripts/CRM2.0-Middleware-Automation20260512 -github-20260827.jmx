def lookup = { Map row, String field -&gt;
    if (!(row instanceof Map)) return [exists:false,value:null,key:null]
    Set&lt;String&gt; names = new LinkedHashSet&lt;String&gt;(); names &lt;&lt; norm(field); (aliases[field] ?: [field]).each { names &lt;&lt; norm(it) }
    for (Object entryObj : row.entrySet()) {
        Map.Entry entry = (Map.Entry)entryObj
        if (names.contains(norm(entry.key))) return [exists:true,value:entry.value,key:String.valueOf(entry.key)]
    }
    [exists:false,value:null,key:null]
}

