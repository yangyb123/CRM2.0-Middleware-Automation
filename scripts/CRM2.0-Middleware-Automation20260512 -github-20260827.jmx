                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="比对金额" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

def respBalance = vars.get(&quot;resp_balance&quot;)
def getBalance  = vars.get(&quot;balance&quot;)
def respCredit  = vars.get(&quot;resp_credit&quot;)
def getCredit   = vars.get(&quot;credit&quot;)
def dealType    = vars.get(&quot;deal_type&quot;)
def money       = vars.get(&quot;money&quot;)
def login       = vars.get(&quot;login&quot;)

log.info(&quot;&gt;&gt;&gt; 金额比对：登录账号=&quot; + login + &quot; deal_type=&quot; + dealType + &quot; money=&quot; + money)
log.info(&quot;&gt;&gt;&gt; modify_balance返回: balance=&quot; + respBalance + &quot; credit=&quot; + respCredit)
log.info(&quot;&gt;&gt;&gt; get_user_info返回:  balance=&quot; + getBalance  + &quot; credit=&quot; + getCredit)

// ===== 校验提取的值不为空/NOT_FOUND =====
def notFoundMsg = []
if (respBalance == null || respBalance == &quot;&quot; || respBalance == &quot;NOT_FOUND&quot;) {
    notFoundMsg.add(&quot;resp_balance为空或NOT_FOUND: &quot; + respBalance)
}
if (getBalance == null || getBalance == &quot;&quot; || getBalance == &quot;NOT_FOUND&quot;) {
    notFoundMsg.add(&quot;balance为空或NOT_FOUND: &quot; + getBalance)
}
if (respCredit == null || respCredit == &quot;&quot; || respCredit == &quot;NOT_FOUND&quot;) {
    notFoundMsg.add(&quot;resp_credit为空或NOT_FOUND: &quot; + respCredit)
}
if (getCredit == null || getCredit == &quot;&quot; || getCredit == &quot;NOT_FOUND&quot;) {
    notFoundMsg.add(&quot;credit为空或NOT_FOUND: &quot; + getCredit)
}
if (notFoundMsg) {
    def result = new AssertionResult(&quot;字段提取校验&quot;)
    result.setFailure(true)
    result.setFailureMessage(notFoundMsg.join(&quot;; &quot;))
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
}

// ===== 比对 balance：modify_balance 返回的 balance 应等于 get_user_info 返回的 balance =====
if (respBalance &amp;&amp; respBalance != &quot;NOT_FOUND&quot; &amp;&amp; getBalance &amp;&amp; getBalance != &quot;NOT_FOUND&quot;) {
    try {
        def rBal = respBalance.toDouble()
        def gBal = getBalance.toDouble()
        if (Math.abs(rBal - gBal) &gt; 0.001) {
            def result = new AssertionResult(&quot;balance不一致&quot;)
            result.setFailure(true)
            result.setFailureMessage(&quot;balance不一致：modify_balance=&quot; + respBalance + &quot; get_user_info=&quot; + getBalance + &quot; 差值=&quot; + String.format(&quot;%.2f&quot;, Math.abs(rBal - gBal)))
            prev.setSuccessful(false)
            prev.addAssertionResult(result)
        } else {
            log.info(&quot;&gt;&gt;&gt; balance比对通过: &quot; + rBal)
        }
    } catch (Exception e) {
        def result = new AssertionResult(&quot;balance比对异常&quot;)
        result.setFailure(true)
        result.setFailureMessage(&quot;balance数值比对异常: &quot; + e.message)
        prev.setSuccessful(false)
        prev.addAssertionResult(result)
    }
}

// ===== 比对 credit：modify_balance 返回的 credit 应等于 get_user_info 返回的 credit =====
if (respCredit &amp;&amp; respCredit != &quot;NOT_FOUND&quot; &amp;&amp; getCredit &amp;&amp; getCredit != &quot;NOT_FOUND&quot;) {
    try {
        def rCrd = respCredit.toDouble()
        def gCrd = getCredit.toDouble()
        if (Math.abs(rCrd - gCrd) &gt; 0.001) {
            def result = new AssertionResult(&quot;credit不一致&quot;)
            result.setFailure(true)
            result.setFailureMessage(&quot;credit不一致：modify_balance=&quot; + respCredit + &quot; get_user_info=&quot; + getCredit + &quot; 差值=&quot; + String.format(&quot;%.2f&quot;, Math.abs(rCrd - gCrd)))
            prev.setSuccessful(false)
            prev.addAssertionResult(result)
        } else {
            log.info(&quot;&gt;&gt;&gt; credit比对通过: &quot; + rCrd)
        }
    } catch (Exception e) {
        def result = new AssertionResult(&quot;credit比对异常&quot;)
        result.setFailure(true)
        result.setFailureMessage(&quot;credit数值比对异常: &quot; + e.message)
        prev.setSuccessful(false)
        prev.addAssertionResult(result)
    }
}

// ===== 根据 deal_type 判断本次修改的字段并记录 =====
String primaryField = &quot;&quot;
if (&quot;2&quot;.equals(dealType) || &quot;6&quot;.equals(dealType)) {
    primaryField = &quot;balance&quot;
} else if (&quot;3&quot;.equals(dealType) || &quot;7&quot;.equals(dealType)) {
    primaryField = &quot;credit&quot;
}
if (primaryField) {
    def modifiedValue = primaryField == &quot;balance&quot; ? getBalance : getCredit
    log.info(&quot;&gt;&gt;&gt; 本次修改字段: &quot; + primaryField + &quot;, 修改后值: &quot; + modifiedValue + &quot;, 操作金额: &quot; + money)
}</stringProp>
                </JSR223Assertion>
