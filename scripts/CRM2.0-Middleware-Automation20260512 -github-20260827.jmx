          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="步骤1获取用户信息修改之前-${instanceid}-${login}-查询-生产-${login}-${__time(yyyy-MM-dd-HH:mm:ss.SSS)}" enabled="false">
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
