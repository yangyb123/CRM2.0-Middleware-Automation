            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Query MT4 history new001-${history_new001_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
              <stringProp name="query">SELECT
  CASE
    WHEN mt.CMD IN (0, 1) AND mt.CLOSE_TIME &lt;= &apos;1970-01-02 00:00:00&apos; THEN &apos;position&apos;
    WHEN mt.CMD IN (2, 3, 4, 5) AND mt.CONV_RATE1 = 0 THEN &apos;pending_order&apos;
    WHEN mt.CMD IN (0, 1) AND mt.CLOSE_TIME &gt; &apos;1970-01-02 00:00:00&apos; THEN &apos;closed_history&apos;
    WHEN mt.CMD IN (2, 3, 4, 5) AND mt.CONV_RATE1 &lt;&gt; 0 THEN &apos;history_pending_cancel_expire&apos;
    ELSE &apos;other_order&apos;
  END AS order_type_name,
  &apos;MT4_TRADES&apos; AS source_table,
  mt.*
FROM mt4_report.MT4_TRADES mt
WHERE mt.LOGIN = ?
  AND mt.OPEN_PRICE &lt;&gt; 0
ORDER BY mt.MODIFY_TIME DESC, mt.OPEN_TIME DESC, mt.TICKET DESC</stringProp>
              <stringProp name="queryArguments">${history_new001_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT</stringProp>
              <stringProp name="queryTimeout">10</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
