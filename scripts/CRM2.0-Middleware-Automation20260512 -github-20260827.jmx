              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">本生产线程组不包含任何JDBC/数据库查询；字段值辅助接口误差使用 production_open_positions_aux_field_tolerance_percent；profit公式复算只使用 open_positions_aux_profit_calc_field_tolerance_percent。</stringProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化生产环境查询多个账户当前持仓参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import groovy.json.JsonOutput

String csvName = &apos;生产环境-查询多个账户的挂单订单.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;生产环境查询多个账户当前持仓CSV文件不存在: &apos; + csvFile.getPath())

List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;生产环境查询多个账户当前持仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

def resolveVars = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s) return &apos;&apos;
    def matcher = s =~ /\$\{([^}]+)\}/
    StringBuffer out = new StringBuffer()
    while (matcher.find()) {
        String varName = matcher.group(1)
        String repl = vars.get(varName)
        if (repl == null) repl = props.getProperty(varName)
        if (repl == null) repl = matcher.group(0)
        matcher.appendReplacement(out, java.util.regex.Matcher.quoteReplacement(repl))
    }
    matcher.appendTail(out)
    out.toString().trim()
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt;
        if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos;
    }
    boolean hasData = row.any { k, v -&gt; k != &apos;__line_no&apos; &amp;&amp; (v ?: &apos;&apos;).toString().trim().length() &gt; 0 }
    if (hasData) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;生产环境查询多个账户当前持仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = resolveVars(v)
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = resolveVars(raw)
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = resolveVars(raw)
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def splitList = { Object raw -&gt;
    String s = resolveVars(raw)
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def platformOf = { Object raw -&gt;
    String s = resolveVars(raw).toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

List runCases = [[mode: &apos;AUX_API&apos;, row: csvRows[0], rows: csvRows]]

int caseIndex = ((vars.get(&apos;production_open_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) {
    throw new AssertionError(&apos;生产环境查询多个账户当前持仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
}
vars.put(&apos;production_open_positions_case_index&apos;, String.valueOf(caseIndex + 1))

Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
List sourceRows = runCase.rows as List

headers.each { h -&gt; vars.put(h, firstValue(currentRow, [h])) }

List accounts = []
Set accountKeys = [] as Set
sourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String platform = platformOf(instanceId)
    List loginValues = splitList(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;])).collect { cleanInt(it) }.findAll { it }
    if (!loginValues) {
        String loginSingle = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
        if (loginSingle) loginValues &lt;&lt; loginSingle
    }
    loginValues.each { login -&gt;
        if (instanceId &amp;&amp; login &amp;&amp; platform) {
            String key = instanceId + &apos;|&apos; + login
            if (!accountKeys.contains(key)) {
                accountKeys &lt;&lt; key
                accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
            }
        }
    }
}
if (!accounts) throw new AssertionError(&apos;生产环境查询多个账户当前持仓没有可用accounts，CSV需要填写 instanceid/login，且变量占位符必须能解析&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;open_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;filter_symbol&apos;, &apos;symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String openFrom = cleanInt(firstValue(currentRow, [&apos;open_time_from_utc_ms&apos;, &apos;open_time_utc_ms__gte&apos;, &apos;open_time_from&apos;]))
String openTo = cleanInt(firstValue(currentRow, [&apos;open_time_to_utc_ms&apos;, &apos;open_time_utc_ms__lte&apos;, &apos;open_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;filter_volume_lots_value&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()
String netPl = (firstValue(currentRow, [&apos;net_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (openFrom) filters[&apos;open_time_from_utc_ms&apos;] = Long.parseLong(openFrom)
if (openTo) filters[&apos;open_time_to_utc_ms&apos;] = Long.parseLong(openTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: (volumeCondition ?: &apos;gte&apos;), value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl
if (netPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;net_pl&apos;] = netPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder

String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))
String accountsText = accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;)

vars.put(&apos;production_open_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;production_open_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;production_open_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;production_open_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;production_open_positions_request_body&apos;, requestBody)
vars.put(&apos;production_open_positions_page&apos;, page)
vars.put(&apos;production_open_positions_page_size&apos;, pageSize)
vars.put(&apos;production_open_positions_sort_by&apos;, sortBy)
vars.put(&apos;production_open_positions_sort_order&apos;, sortOrder)
vars.put(&apos;production_open_positions_accounts_text&apos;, accountsText)
vars.putObject(&apos;production_open_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;production_open_positions_current_rows&apos;, sourceRows)

String initReport = &apos;production list_open_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode +
    &apos; | CSV行=&apos; + currentRow.__line_no +
    &apos; | accounts=&apos; + accountsText +
    &apos; | page=&apos; + page +
    &apos; | page_size=&apos; + pageSize +
    &apos; | sort_by=&apos; + sortBy +
    &apos; | sort_order=&apos; + sortOrder +
    &apos;\n请求Body:\n&apos; + requestBody

SampleResult.setDataType(SampleResult.TEXT)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
SampleResult.setResponseData(initReport, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">读取生产环境CSV，支持${变量名}占位符；所有有效CSV行聚合为一次多账户 /crm20/list_open_positions 请求；生产环境只做辅助接口校验，不做数据库查询。</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="生产环境-查询多个账户当前持仓订单-list_open_positions" enabled="true">
            <stringProp name="TestPlan.comments">生产环境list_open_positions主接口；请求Body由初始化JSR223Sampler根据CSV生成。</stringProp>
            <stringProp name="HTTPSampler.domain">${free production environment}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/list_open_positions</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${production_open_positions_request_body}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="生产环境-list_open_positions字段与辅助接口校验" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
import groovy.json.JsonSlurper
import java.math.RoundingMode

List failLines = []
List okLines = []
List skipLines = []
List auxProfitFailLines = []
List auxProfitOkLines = []
List auxProfitSkipLines = []

def blank = { Object v -&gt;
    v == null || (v instanceof CharSequence &amp;&amp; v.toString().trim().length() == 0)
}

def normKey = { Object raw -&gt;
    raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase().replaceAll(/[^a-z0-9_]/, &apos;&apos;)
}

def rowToMap = { Object row -&gt;
    Map out = new LinkedHashMap()
    if (row instanceof Map) row.each { k, v -&gt; out[String.valueOf(k)] = v }
    out
}

def valueOf = { Map row, String field -&gt;
    if (!(row instanceof Map)) return null
    if (row.containsKey(field)) return row[field]
    String nf = normKey(field)
    def hit = row.find { k, v -&gt; normKey(k) == nf }
    hit == null ? null : hit.value
}

def asNum = { Object raw -&gt;
    if (raw == null) return null
    if (raw instanceof BigDecimal) return raw
    if (raw instanceof Number) return new BigDecimal(raw.toString())
    String s = raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return null
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    new BigDecimal(s)
}

def fmtNum = { Object raw -&gt;
    BigDecimal n = asNum(raw)
    if (n == null) return raw == null ? &apos;&lt;empty&gt;&apos; : String.valueOf(raw)
    n.stripTrailingZeros().toPlainString()
}

def cleanNumText = { Object raw -&gt;
    if (blank(raw)) return &apos;&apos;
    String s = raw.toString().trim()
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s
}

def render = { Object v -&gt;
    blank(v) ? &apos;&lt;empty&gt;&apos; : String.valueOf(v)
}

def pctText = { BigDecimal n -&gt;
    n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() + &apos;%&apos;
}

def intVar = { String name, int defaultValue, int minValue, int maxValue -&gt;
    try {
        int v = Integer.parseInt(String.valueOf(vars.get(name) ?: defaultValue).trim())
        return Math.max(minValue, Math.min(maxValue, v))
    } catch (Throwable ignored) {
        return defaultValue
    }
}

def boolVar = { String name, boolean defaultValue -&gt;
    String s = String.valueOf(vars.get(name) ?: defaultValue).trim().toLowerCase()
    !(s in [&apos;0&apos;, &apos;false&apos;, &apos;no&apos;, &apos;off&apos;])
}

def disabledSet = { String raw -&gt;
    String text = raw ?: &apos;&apos;
    text.split(/[，,;|\s]+/).collect { normKey(it) }.findAll { it } as Set
}

def parseToleranceMap = { String raw -&gt;
    Map out = [:]
    String text = raw ?: &apos;&apos;
    text.split(/[;\n]+/).each { part -&gt;
        String p = part.trim()
        if (!p) return
        p.split(/,/).each { token -&gt;
            String t = token.trim()
            if (!t) return
            def m = t =~ /^([^:=\s]+)\s*[:=\s]\s*(-?\d+(?:\.\d+)?)%?$/
            if (m.matches()) out[normKey(m.group(1))] = new BigDecimal(m.group(2))
        }
    }
    out
}

Map fieldToleranceMap = parseToleranceMap(vars.get(&apos;production_open_positions_aux_field_tolerance_percent&apos;) ?: &apos;&apos;)
Map auxProfitToleranceMap = parseToleranceMap(vars.get(&apos;open_positions_aux_profit_calc_field_tolerance_percent&apos;) ?: &apos;&apos;)
Set disabledFields = disabledSet(vars.get(&apos;production_open_positions_aux_disabled_compare_fields&apos;) ?: &apos;&apos;)
Set auxProfitDisabledFields = disabledSet(vars.get(&apos;open_positions_aux_profit_calc_disabled_compare_fields&apos;) ?: &apos;&apos;)
boolean disabledAll = disabledFields.contains(&apos;*&apos;)
boolean auxProfitDisabledAll = auxProfitDisabledFields.contains(&apos;*&apos;)
int timeToleranceMs = intVar(&apos;production_open_positions_aux_time_tolerance_ms&apos;, 60000, 0, 3600000)
int auxMaxRows = intVar(&apos;open_positions_aux_profit_calc_max_rows&apos;, 500, 0, 5000)
int httpConnectTimeoutMs = intVar(&apos;open_positions_aux_http_connect_timeout_ms&apos;, 1000, 200, 30000)
int httpReadTimeoutMs = intVar(&apos;open_positions_aux_http_read_timeout_ms&apos;, 3000, 500, 60000)
boolean validateSummary = boolVar(&apos;production_open_positions_aux_validate_summary_enabled&apos;, true)
boolean auxProfitEnabled = boolVar(&apos;open_positions_aux_profit_calc_enabled&apos;, true)

def toleranceForField = { String field, BigDecimal defaultValue -&gt;
    BigDecimal v = fieldToleranceMap[normKey(field)]
    v == null ? defaultValue : v
}

def auxProfitToleranceForField = { String field -&gt;
    BigDecimal v = auxProfitToleranceMap[normKey(field)]
    v == null ? new BigDecimal(&apos;10&apos;) : v
}

Set exactNumberFields = [&apos;login&apos;,&apos;order_ticket&apos;,&apos;position_ticket&apos;,&apos;deal_ticket&apos;,&apos;state&apos;,&apos;order_type&apos;,&apos;reason&apos;,&apos;digits&apos;,&apos;digits_currency&apos;,&apos;total&apos;,&apos;total_orders&apos;] as Set
Set timeFields = [&apos;open_time_utc_ms&apos;,&apos;updated_utc_ms&apos;] as Set

def compareValues = { String field, Object apiVal, Object expectedVal, String expectedSource -&gt;
    if (blank(apiVal) &amp;&amp; blank(expectedVal)) {
        return [same: true, diff: &apos;N/A&apos;, percent: &apos;N/A(empty)&apos;, formula: &apos;API and &apos; + expectedSource + &apos; are both empty&apos;]
    }
    if (blank(apiVal) || blank(expectedVal)) {
        return [same: false, diff: &apos;N/A&apos;, percent: &apos;N/A(empty)&apos;, formula: &apos;empty compare&apos;]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactNumberFields.contains(normKey(field))) {
            boolean same = an.compareTo(en) == 0
            return [same: same, diff: fmtNum(diff), percent: same ? &apos;0%&apos; : &apos;N/A(exact)&apos;, formula: &apos;exact numeric compare&apos;]
        }
        if (timeFields.contains(normKey(field))) {
            boolean same = diff.compareTo(new BigDecimal(timeToleranceMs)) &lt;= 0
            return [same: same, diff: fmtNum(diff), percent: &apos;N/A(time)&apos;, formula: &apos;abs(API-&apos; + expectedSource + &apos;) &lt;= &apos; + timeToleranceMs + &apos;ms&apos;]
        }
        BigDecimal tolerancePercent = toleranceForField(field, new BigDecimal(&apos;5&apos;))
        BigDecimal base = en.abs()
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            boolean same = diff.compareTo(BigDecimal.ZERO) == 0
            return [same: same, diff: fmtNum(diff), percent: same ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0)&apos;, formula: expectedSource + &apos;=0, require API also equals 0&apos;]
        }
        BigDecimal allowed = base.multiply(tolerancePercent).divide(new BigDecimal(&apos;100&apos;), 12, RoundingMode.HALF_UP)
        BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 12, RoundingMode.HALF_UP)
        boolean same = diff.compareTo(allowed) &lt;= 0
        return [same: same, diff: fmtNum(diff), percent: pctText(percent), formula: &apos;abs(API-&apos; + expectedSource + &apos;) / abs(&apos; + expectedSource + &apos;) * 100 &lt;= &apos; + pctText(tolerancePercent) + &apos; (allowed_diff=&apos; + fmtNum(allowed) + &apos;)&apos;]
    }
    boolean same = String.valueOf(apiVal).trim().equalsIgnoreCase(String.valueOf(expectedVal).trim())
    [same: same, diff: &apos;N/A&apos;, percent: &apos;N/A(string)&apos;, formula: &apos;case-insensitive string compare&apos;]
}

def compareAndRecord = { String area, String field, Object apiVal, Object expectedVal, String expectedSource, String rowText -&gt;
    if (disabledAll || disabledFields.contains(normKey(field))) {
        skipLines &lt;&lt; &quot; - [跳过] | ${area} | ${rowText} | field=${field} | API=${render(apiVal)} | ${expectedSource}=${render(expectedVal)} | reason=字段在 production_open_positions_aux_disabled_compare_fields 跳过配置中&quot;
        return
    }
    if (expectedVal == null) {
        skipLines &lt;&lt; &quot; - [跳过] | ${area} | ${rowText} | field=${field} | API=${render(apiVal)} | ${expectedSource}=&lt;empty&gt; | reason=辅助接口无可对比字段&quot;
        return
    }
    def cr = compareValues(field, apiVal, expectedVal, expectedSource)
    String line = &quot;${area} | ${rowText} | field=${field} | API=${render(apiVal)} | ${expectedSource}=${render(expectedVal)} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}&quot;
    if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
}

String auxHost = (vars.get(&apos;middlewareip&apos;) ?: vars.get(&apos;CRM2.0middlewareip&apos;) ?: vars.get(&apos;ip&apos;) ?: &apos;&apos;).trim()
String auxPort = (vars.get(&apos;port&apos;) ?: &apos;8080&apos;).trim()
String auxBaseUrl = &apos;http://&apos; + auxHost + (auxPort ? &apos;:&apos; + auxPort : &apos;&apos;)

def urlenc = { Object v -&gt; java.net.URLEncoder.encode(String.valueOf(v ?: &apos;&apos;), &apos;UTF-8&apos;) }

def jsonRows = { Object json -&gt;
    if (json instanceof Map &amp;&amp; json.data instanceof List) return json.data.collect { rowToMap(it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map &amp;&amp; json.data.items instanceof List) return json.data.items.collect { rowToMap(it) }
    // 部分生产版本的 get_user_info/get_symbol_ex 直接将单条记录放在 data 对象中。
    // 不能把它当成空数组，否则币种、合约规格和报价都会丢失，profit 无法复算。
    if (json instanceof Map &amp;&amp; json.data instanceof Map) return [rowToMap(json.data)]
    if (json instanceof Map &amp;&amp; json.items instanceof List) return json.items.collect { rowToMap(it) }
    if (json instanceof List) return json.collect { rowToMap(it) }
    []
}

def getJson = { String path -&gt;
    if (!auxHost) throw new IllegalStateException(&apos;middlewareip/CRM2.0middlewareip is empty&apos;)
    java.net.HttpURLConnection conn = null
    try {
        conn = (java.net.HttpURLConnection) new java.net.URL(auxBaseUrl + path).openConnection()
        conn.setRequestMethod(&apos;GET&apos;)
        conn.setConnectTimeout(httpConnectTimeoutMs)
        conn.setReadTimeout(httpReadTimeoutMs)
        conn.setRequestProperty(&apos;Accept&apos;, &apos;application/json&apos;)
        String text
        try {
            text = conn.getInputStream().getText(&apos;UTF-8&apos;)
        } catch (Throwable io) {
            text = conn.getErrorStream() == null ? &apos;&apos; : conn.getErrorStream().getText(&apos;UTF-8&apos;)
            throw new IllegalStateException(&apos;GET &apos; + path + &apos; failed, http=&apos; + conn.getResponseCode() + &apos;, body=&apos; + text, io)
        }
        new JsonSlurper().parseText(text ?: &apos;{}&apos;)
    } finally {
        try { conn?.disconnect() } catch (ignored) {}
    }
}

Map userCurrencyCache = [:]
Map symbolCache = [:]
Map positionExCache = [:]
Map positionInfoCache = [:]

def accountCurrency = { String instanceId, Object loginRaw -&gt;
    String loginText = cleanNumText(loginRaw)
    String key = instanceId + &apos;|&apos; + loginText
    if (userCurrencyCache.containsKey(key)) return userCurrencyCache[key]
    def json = getJson(&apos;/crm20/get_user_info?instanceid=&apos; + urlenc(instanceId) + &apos;&amp;login=&apos; + urlenc(loginText))
    List rows = jsonRows(json)
    Map row = rows ? rows[0] : [:]
    Object cur = valueOf(row, &apos;currency&apos;)
    if (blank(cur) &amp;&amp; row.Group instanceof Map) cur = row.Group.Currency
    if (blank(cur) &amp;&amp; row.group instanceof Map) cur = row.group.currency ?: row.group.Currency
    String out = blank(cur) ? &apos;&apos; : String.valueOf(cur).trim().toUpperCase()
    userCurrencyCache[key] = out
    out
}

def symbolInfo = { String instanceId, String symbolRaw -&gt;
    String symbolText = String.valueOf(symbolRaw ?: &apos;&apos;).trim()
    String key = instanceId + &apos;|&apos; + symbolText.toUpperCase()
    if (symbolCache.containsKey(key)) return symbolCache[key]
    Map out = [:]
    try {
        def json = getJson(&apos;/crm20/get_symbol_ex?instanceid=&apos; + urlenc(instanceId) + &apos;&amp;name=&apos; + urlenc(symbolText) + &apos;&amp;_select=name,currency_profit,currency_margin,currency_base,contract_size,tick_size,tick_value,bid,ask,digits,profit_mode,quote_updated_utc_ms&apos;)
        List rows = jsonRows(json)
        out = rows ? rows[0] : [:]
        // 兼容报价嵌套在 quote 对象内的返回格式，统一为 bid/ask 供 profit 复算使用。
        Map quote = valueOf(out, &apos;quote&apos;) instanceof Map ? (valueOf(out, &apos;quote&apos;) as Map) : [:]
        if (valueOf(out, &apos;bid&apos;) == null &amp;&amp; valueOf(quote, &apos;bid&apos;) != null) out[&apos;bid&apos;] = valueOf(quote, &apos;bid&apos;)
        if (valueOf(out, &apos;ask&apos;) == null &amp;&amp; valueOf(quote, &apos;ask&apos;) != null) out[&apos;ask&apos;] = valueOf(quote, &apos;ask&apos;)
        if (valueOf(out, &apos;quote_updated_utc_ms&apos;) == null &amp;&amp; valueOf(quote, &apos;updated_utc_ms&apos;) != null) out[&apos;quote_updated_utc_ms&apos;] = valueOf(quote, &apos;updated_utc_ms&apos;)
    } catch (Throwable e) {
        out = [__error: e.class.simpleName + &apos;: &apos; + e.message]
    }
    out[&apos;__query_symbol&apos;] = symbolText
    symbolCache[key] = out
    out
}

def positionEx = { String instanceId, Object loginRaw, Object orderTicketRaw, Object positionTicketRaw -&gt;
    String loginText = cleanNumText(loginRaw)
    String orderTicket = cleanNumText(orderTicketRaw)
    String positionTicket = cleanNumText(positionTicketRaw)
    String cacheKey = instanceId + &apos;|&apos; + loginText + &apos;|&apos; + orderTicket + &apos;|&apos; + positionTicket
    if (positionExCache.containsKey(cacheKey)) return positionExCache[cacheKey]
    List queryParts = []
    if (orderTicket) queryParts &lt;&lt; (&apos;order_ticket=&apos; + urlenc(orderTicket))
    if (positionTicket &amp;&amp; positionTicket != &apos;0&apos; &amp;&amp; positionTicket != orderTicket) queryParts &lt;&lt; (&apos;position_ticket=&apos; + urlenc(positionTicket))
    if (!queryParts) queryParts &lt;&lt; &apos;&apos;
    Map found = [:]
    String err = &apos;&apos;
    for (String ticketQuery : queryParts) {
        try {
            String path = &apos;/crm20/get_position_ex?instanceid=&apos; + urlenc(instanceId) + &apos;&amp;login=&apos; + urlenc(loginText) + (ticketQuery ? &apos;&amp;&apos; + ticketQuery : &apos;&apos;) + &apos;&amp;_limit=20&apos;
            List rows = jsonRows(getJson(path))
            if (rows) {
                found = rows.find { r -&gt;
                    String ot = cleanNumText(valueOf(r, &apos;order_ticket&apos;))
                    String pt = cleanNumText(valueOf(r, &apos;position_ticket&apos;))
                    (orderTicket &amp;&amp; ot == orderTicket) || (positionTicket &amp;&amp; positionTicket != &apos;0&apos; &amp;&amp; pt == positionTicket)
                } ?: rows[0]
                break
            }
        } catch (Throwable e) {
            err = e.class.simpleName + &apos;: &apos; + e.message
        }
    }
    if (err &amp;&amp; !found) found = [__error: err]
    positionExCache[cacheKey] = found
    found
}

def positionInfo = { String instanceId, Object loginRaw, Object orderTicketRaw, Object positionTicketRaw -&gt;
    String loginText = cleanNumText(loginRaw)
    String orderTicket = cleanNumText(orderTicketRaw)
    String positionTicket = cleanNumText(positionTicketRaw)
    String ticket = positionTicket &amp;&amp; positionTicket != &apos;0&apos; ? positionTicket : orderTicket
    String cacheKey = instanceId + &apos;|&apos; + loginText + &apos;|&apos; + ticket
    if (positionInfoCache.containsKey(cacheKey)) return positionInfoCache[cacheKey]
    Map out = [:]
    try {
        String path = &apos;/crm20/get_position_info?instanceid=&apos; + urlenc(instanceId) + &apos;&amp;login=&apos; + urlenc(loginText) + (ticket ? &apos;&amp;ticket=&apos; + urlenc(ticket) : &apos;&apos;)
        List rows = jsonRows(getJson(path))
        out = rows ? rows[0] : [:]
    } catch (Throwable e) {
        out = [__error: e.class.simpleName + &apos;: &apos; + e.message]
    }
    positionInfoCache[cacheKey] = out
    out
}

def legacy = { Map row, List names -&gt;
    for (String n : names) {
        Object v = valueOf(row, n)
        if (v != null) return v
    }
    null
}

def coalesce = { Object... vals -&gt;
    for (Object v : vals) {
        if (v != null) return v
    }
    null
}

def msFromSeconds = { Object seconds -&gt;
    BigDecimal n = asNum(seconds)
    n == null ? null : n.multiply(new BigDecimal(&apos;1000&apos;)).setScale(0, RoundingMode.HALF_UP)
}

def currencyDigits = { String currency -&gt;
    String c = String.valueOf(currency ?: &apos;&apos;).toUpperCase()
    (c in [&apos;JPY&apos;,&apos;KRW&apos;,&apos;VND&apos;,&apos;IDR&apos;,&apos;CLP&apos;,&apos;ISK&apos;,&apos;HUF&apos;]) ? 0 : 2
}

Set centCurrencies = [&apos;USC&apos;] as Set
Set usdLikeCurrencies = [&apos;USD&apos;,&apos;USDT&apos;,&apos;USDC&apos;] as Set

def primaryQuote = { Map info, String fromRaw, String toRaw -&gt;
    if (!(info instanceof Map)) return null
    String baseCur = String.valueOf(valueOf(info, &apos;currency_base&apos;) ?: &apos;&apos;).trim().toUpperCase()
    String profitCur = String.valueOf(valueOf(info, &apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
    String from = String.valueOf(fromRaw ?: &apos;&apos;).trim().toUpperCase()
    String to = String.valueOf(toRaw ?: &apos;&apos;).trim().toUpperCase()
    (baseCur == from &amp;&amp; profitCur == to) ? info : null
}

def currencyRate
currencyRate = { String fromRaw, String toRaw, String instanceId, BigDecimal rawProfit, Map primarySymbolInfo -&gt;
    String from = String.valueOf(fromRaw ?: &apos;&apos;).trim().toUpperCase()
    String to = String.valueOf(toRaw ?: &apos;&apos;).trim().toUpperCase()
    if (!from || !to) return [rate: null, path: &apos;missing currency&apos;, quote_detail: &apos;rate_quote_source=missing_currency&apos;]
    if (from == to) return [rate: BigDecimal.ONE, path: from + &apos;-&gt;&apos; + to + &apos;=1&apos;, quote_detail: &apos;rate_quote_source=same_currency | rate_quote_calc=&apos; + from + &apos;-&gt;&apos; + to + &apos;=1&apos;]
    if (from == &apos;USD&apos; &amp;&amp; centCurrencies.contains(to)) return [rate: new BigDecimal(&apos;100&apos;), path: &apos;USD-&gt;&apos; + to + &apos;=100(cent account)&apos;, quote_detail: &apos;rate_quote_source=fixed_cent_rule | rate_quote_calc=USD-&gt;&apos; + to + &apos;=100&apos;]
    if (centCurrencies.contains(from) &amp;&amp; to == &apos;USD&apos;) return [rate: new BigDecimal(&apos;0.01&apos;), path: from + &apos;-&gt;USD=0.01(cent account)&apos;, quote_detail: &apos;rate_quote_source=fixed_cent_rule | rate_quote_calc=&apos; + from + &apos;-&gt;USD=0.01&apos;]
    boolean positive = rawProfit == null || rawProfit.compareTo(BigDecimal.ZERO) &gt;= 0
    Map direct = primaryQuote(primarySymbolInfo, from, to)
    if (!(direct instanceof Map)) direct = symbolInfo(instanceId, from + to)
    BigDecimal directBid = asNum(valueOf(direct, &apos;bid&apos;))
    BigDecimal directAsk = asNum(valueOf(direct, &apos;ask&apos;))
    if (directBid != null &amp;&amp; directAsk != null) {
        BigDecimal price = positive ? directBid : directAsk
        String quoteName = valueOf(direct, &apos;__query_symbol&apos;) ?: (from + to)
        String quoteField = positive ? &apos;bid&apos; : &apos;ask&apos;
        String quoteDetail = &apos;rate_quote_symbol=&apos; + quoteName + &apos; | rate_quote_field=&apos; + quoteField + &apos; | rate_quote_value=&apos; + fmtNum(price) + &apos; | rate_quote_bid=&apos; + fmtNum(directBid) + &apos; | rate_quote_ask=&apos; + fmtNum(directAsk) + &apos; | rate_quote_source=get_symbol_ex(instanceid=&apos; + instanceId + &apos;,name=&apos; + quoteName + &apos;) | rate_quote_calc=rate_profit=rate_quote_value=&apos; + fmtNum(price)
        return [rate: price, path: quoteName + &apos; &apos; + from + &apos;-&gt;&apos; + to + &apos;.&apos; + quoteField + &apos;=&apos; + fmtNum(price), quote_detail: quoteDetail]
    }
    Map reverse = primaryQuote(primarySymbolInfo, to, from)
    if (!(reverse instanceof Map)) reverse = symbolInfo(instanceId, to + from)
    BigDecimal reverseBid = asNum(valueOf(reverse, &apos;bid&apos;))
    BigDecimal reverseAsk = asNum(valueOf(reverse, &apos;ask&apos;))
    if (reverseBid != null &amp;&amp; reverseAsk != null) {
        BigDecimal price = positive ? reverseAsk : reverseBid
        if (price.compareTo(BigDecimal.ZERO) != 0) {
            BigDecimal rate = BigDecimal.ONE.divide(price, 12, RoundingMode.HALF_UP)
            String quoteName = valueOf(reverse, &apos;__query_symbol&apos;) ?: (to + from)
            String quoteField = positive ? &apos;ask&apos; : &apos;bid&apos;
            String quoteDetail = &apos;rate_quote_symbol=&apos; + quoteName + &apos; | rate_quote_field=&apos; + quoteField + &apos; | rate_quote_value=&apos; + fmtNum(price) + &apos; | rate_quote_bid=&apos; + fmtNum(reverseBid) + &apos; | rate_quote_ask=&apos; + fmtNum(reverseAsk) + &apos; | rate_quote_source=get_symbol_ex(instanceid=&apos; + instanceId + &apos;,name=&apos; + quoteName + &apos;) | rate_quote_calc=rate_profit=1 / rate_quote_value = 1 / &apos; + fmtNum(price) + &apos; = &apos; + fmtNum(rate)
            return [rate: rate, path: &apos;1/&apos; + quoteName + &apos; &apos; + from + &apos;-&gt;&apos; + to + &apos;.&apos; + quoteField + &apos;=1/&apos; + fmtNum(price), quote_detail: quoteDetail]
        }
    }
    if (usdLikeCurrencies.contains(from) &amp;&amp; usdLikeCurrencies.contains(to)) {
        return [rate: BigDecimal.ONE, path: from + &apos;-&gt;&apos; + to + &apos;=1(USD-like fallback; no quote found)&apos;, quote_detail: &apos;rate_quote_source=usd_like_fallback | rate_quote_calc=&apos; + from + &apos;-&gt;&apos; + to + &apos;=1&apos;]
    }
    if (centCurrencies.contains(to) &amp;&amp; from != &apos;USD&apos;) {
        def left = currencyRate(from, &apos;USD&apos;, instanceId, rawProfit, primarySymbolInfo)
        if (left.rate != null) return [rate: left.rate.multiply(new BigDecimal(&apos;100&apos;)), path: &apos;(&apos; + left.path + &apos;) * (USD-&gt;&apos; + to + &apos;=100)&apos;, quote_detail: &apos;rate_quote_chain=(&apos; + (left.quote_detail ?: left.path) + &apos;) * (rate_quote_source=fixed_cent_rule | rate_quote_calc=USD-&gt;&apos; + to + &apos;=100)&apos;]
    }
    if (centCurrencies.contains(from) &amp;&amp; to != &apos;USD&apos;) {
        def right = currencyRate(&apos;USD&apos;, to, instanceId, rawProfit, primarySymbolInfo)
        if (right.rate != null) return [rate: new BigDecimal(&apos;0.01&apos;).multiply(right.rate), path: &apos;(&apos; + from + &apos;-&gt;USD=0.01) * (&apos; + right.path + &apos;)&apos;, quote_detail: &apos;rate_quote_chain=(rate_quote_source=fixed_cent_rule | rate_quote_calc=&apos; + from + &apos;-&gt;USD=0.01) * (&apos; + (right.quote_detail ?: right.path) + &apos;)&apos;]
    }
    if (from != &apos;USD&apos; &amp;&amp; to != &apos;USD&apos;) {
        def left = currencyRate(from, &apos;USD&apos;, instanceId, rawProfit, primarySymbolInfo)
        def right = currencyRate(&apos;USD&apos;, to, instanceId, rawProfit, primarySymbolInfo)
        if (left.rate != null &amp;&amp; right.rate != null) {
            BigDecimal rate = left.rate.multiply(right.rate)
            return [rate: rate, path: &apos;(&apos; + left.path + &apos;) * (&apos; + right.path + &apos;)&apos;, quote_detail: &apos;rate_quote_chain=(&apos; + (left.quote_detail ?: left.path) + &apos;) * (&apos; + (right.quote_detail ?: right.path) + &apos;)&apos;]
        }
    }
    [rate: null, path: &apos;no quote path for &apos; + from + &apos;-&gt;&apos; + to, quote_detail: &apos;rate_quote_source=not_found | rate_quote_calc=no quote path for &apos; + from + &apos;-&gt;&apos; + to]
}

def compareAuxProfit = { Map apiRow, int rowNo -&gt;
    String rowId = cleanNumText(valueOf(apiRow, &apos;position_ticket&apos;)) ?: cleanNumText(valueOf(apiRow, &apos;order_ticket&apos;))
    String instanceId = String.valueOf(valueOf(apiRow, &apos;instance_id&apos;) ?: &apos;&apos;).trim()
    Object loginVal = valueOf(apiRow, &apos;login&apos;)
    String symbolText = String.valueOf(valueOf(apiRow, &apos;symbol&apos;) ?: &apos;&apos;).trim()
    String sideText = String.valueOf(valueOf(apiRow, &apos;side&apos;) ?: &apos;&apos;).trim().toLowerCase()
    BigDecimal priceOpen = asNum(valueOf(apiRow, &apos;price_open&apos;))
    BigDecimal priceCurrent = asNum(valueOf(apiRow, &apos;price_current&apos;))
    BigDecimal volumeLots = asNum(valueOf(apiRow, &apos;volume_lots&apos;))
    BigDecimal apiProfit = asNum(valueOf(apiRow, &apos;profit&apos;))
    String detailPrefix = &apos;row=&apos; + rowNo + &apos; | apiId=&apos; + rowId + &apos; | instance_id=&apos; + (instanceId ?: &apos;&lt;empty&gt;&apos;) + &apos; | login=&apos; + render(loginVal) + &apos; | symbol=&apos; + symbolText + &apos; | 辅助接口变量来源=list_open_positions.items[] | get_user_info参数=instance_id+login | get_symbol_ex参数=instance_id+symbol&apos;
    if (auxProfitDisabledAll || auxProfitDisabledFields.contains(&apos;profit&apos;)) {
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | field=profit | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=字段在 open_positions_aux_profit_calc_disabled_compare_fields 跳过配置中&apos;
        auxProfitSkipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | &apos; + line
        return
    }
    try {
        if (!instanceId || blank(loginVal) || !symbolText || !(sideText in [&apos;buy&apos;,&apos;sell&apos;]) || priceOpen == null || volumeLots == null || apiProfit == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=缺少主接口字段(instance_id/login/symbol/side/price_open/volume_lots/profit)&apos;
            auxProfitFailLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            return
        }
        String acctCurrency = accountCurrency(instanceId, loginVal)
        Map sym = symbolInfo(instanceId, symbolText)
        String currencyProfit = String.valueOf(valueOf(sym, &apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
        BigDecimal bid = asNum(valueOf(sym, &apos;bid&apos;))
        BigDecimal ask = asNum(valueOf(sym, &apos;ask&apos;))
        BigDecimal contractSize = asNum(valueOf(sym, &apos;contract_size&apos;)) ?: asNum(valueOf(apiRow, &apos;contract_size&apos;))
        String symbolError = String.valueOf(valueOf(sym, &apos;__error&apos;) ?: &apos;&apos;).trim()
        // list_open_positions 的 price_current 已按买单 bid / 卖单 ask 返回；辅助报价缺失时可作为同口径回退。
        // 只需要当前方向的一个报价，不能因为另一侧报价为空而放弃整笔复算。
        BigDecimal profitPrice = sideText == &apos;sell&apos; ? ask : bid
        String priceSource = sideText == &apos;sell&apos; ? &apos;get_symbol_ex.ask&apos; : &apos;get_symbol_ex.bid&apos;
        String basis = sideText == &apos;sell&apos; ? &apos;ask&apos; : &apos;bid&apos;
        if (profitPrice == null &amp;&amp; priceCurrent != null) {
            profitPrice = priceCurrent
            priceSource = &apos;list_open_positions.price_current&apos;
            basis = &apos;price_current&apos;
        }
        String symbolFields = sym ? sym.keySet().collect { String.valueOf(it) }.sort().join(&apos;,&apos;) : &apos;&lt;empty&gt;&apos;
        if (!acctCurrency || !currencyProfit || profitPrice == null || contractSize == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | account_currency=&apos; + (acctCurrency ?: &apos;&lt;empty&gt;&apos;) + &apos; | currency_profit=&apos; + (currencyProfit ?: &apos;&lt;empty&gt;&apos;) + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | profit_price=&apos; + fmtNum(profitPrice) + &apos; | price_source=&apos; + priceSource + &apos; | bid=&apos; + fmtNum(bid) + &apos; | ask=&apos; + fmtNum(ask) + &apos; | contract_size=&apos; + fmtNum(contractSize) + &apos; | symbol_response_fields=&apos; + symbolFields + (symbolError ? &apos; | symbol_error=&apos; + symbolError : &apos;&apos;) + &apos; | reason=复算依赖字段缺失(account_currency/currency_profit/current_side_price/contract_size)&apos;
            auxProfitFailLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            return
        }
        BigDecimal rawProfit
        String formulaLeft
        if (sideText == &apos;sell&apos;) {
            rawProfit = priceOpen.subtract(profitPrice).multiply(contractSize).multiply(volumeLots)
            formulaLeft = &apos;(price_open - &apos; + basis + &apos;)&apos;
        } else {
            rawProfit = profitPrice.subtract(priceOpen).multiply(contractSize).multiply(volumeLots)
            formulaLeft = &apos;(&apos; + basis + &apos; - price_open)&apos;
        }
        def rateInfo = currencyRate(currencyProfit, acctCurrency, instanceId, rawProfit, sym)
        if (rateInfo.rate == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | raw_profit=&apos; + fmtNum(rawProfit) + &apos; | account_currency=&apos; + acctCurrency + &apos; | currency_profit=&apos; + currencyProfit + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=rate_profit不可计算 | rate_path=&apos; + rateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(rateInfo.quote_detail ?: &apos;&apos;)
            auxProfitFailLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            return
        }
        BigDecimal calcProfit = rawProfit.multiply(rateInfo.rate).setScale(8, RoundingMode.HALF_UP)
        BigDecimal diff = apiProfit.subtract(calcProfit).abs()
        BigDecimal base = calcProfit.abs()
        BigDecimal tolerancePercent = auxProfitToleranceForField(&apos;profit&apos;)
        BigDecimal allowed = base.compareTo(BigDecimal.ZERO) == 0 ? BigDecimal.ZERO : base.multiply(tolerancePercent).divide(new BigDecimal(&apos;100&apos;), 12, RoundingMode.HALF_UP)
        boolean same = base.compareTo(BigDecimal.ZERO) == 0 ? diff.compareTo(BigDecimal.ZERO) == 0 : diff.compareTo(allowed) &lt;= 0
        String percent = base.compareTo(BigDecimal.ZERO) == 0 ? (same ? &apos;0%&apos; : &apos;N/A(辅助接口计算=0)&apos;) : pctText(diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 12, RoundingMode.HALF_UP))
        String formula = formulaLeft + &apos; * contract_size * volume_lots * rate_profit = &apos; + fmtNum(calcProfit)
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&apos; + fmtNum(calcProfit) + &apos; | &apos; + detailPrefix + &apos; | raw_profit=&apos; + fmtNum(rawProfit) + &apos; | rate_profit=&apos; + fmtNum(rateInfo.rate) + &apos; | rate_path=&apos; + rateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(rateInfo.quote_detail ?: &apos;&apos;) + &apos; | account_currency=&apos; + acctCurrency + &apos; | currency_profit=&apos; + currencyProfit + &apos; | side=&apos; + sideText + &apos; | price_open=&apos; + fmtNum(priceOpen) + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | profit_price=&apos; + fmtNum(profitPrice) + &apos; | price_source=&apos; + priceSource + &apos; | price_basis=&apos; + basis + &apos; | bid=&apos; + fmtNum(bid) + &apos; | ask=&apos; + fmtNum(ask) + &apos; | contract_size=&apos; + fmtNum(contractSize) + &apos; | volume_lots=&apos; + fmtNum(volumeLots) + &apos; | 差值=&apos; + fmtNum(diff) + &apos; | 相差百分比=&apos; + percent + &apos; | 允许误差=&apos; + pctText(tolerancePercent) + &apos; | 计算过程=&apos; + formula
        if (same) auxProfitOkLines &lt;&lt; &apos; - [通过] | 辅助接口profit计算 | &apos; + line else auxProfitFailLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
    } catch (Throwable e) {
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | exception=&apos; + e.class.simpleName + &apos;: &apos; + e.message
        auxProfitFailLines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
    }
}

def publishReport = { String finalReport, boolean success -&gt;
    vars.put(&apos;production_open_positions_compare_report&apos;, finalReport)
    vars.put(&apos;production_open_positions_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    try {
        SampleResult detail = new SampleResult()
        detail.setSampleLabel(&apos;生产环境-list_open_positions字段与辅助接口对比结果&apos;)
        detail.setDataType(SampleResult.TEXT)
        detail.sampleStart()
        detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
        detail.setResponseMessage(success ? &apos;production list_open_positions compare passed&apos; : &apos;production list_open_positions compare failed&apos;)
        detail.setSuccessful(success)
        detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
        detail.setResponseData(finalReport, &apos;UTF-8&apos;)
        detail.sampleEnd()
        prev.addSubResult(detail)
    } catch (Throwable e) {
        log.warn(&apos;Add production list_open_positions compare detail failed: &apos; + e.message, e)
    }
    AssertionResult.setFailure(!success)
    if (!success) AssertionResult.setFailureMessage(finalReport)
}

String responseText = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;)
} catch (Throwable e) {
    String report = &apos;Assertion message: 生产环境-list_open_positions 响应不是合法JSON | status=FAIL | exception=&apos; + e.message + &apos;\n响应原文:\n&apos; + responseText
    publishReport(report, false)
    return
}

Map json = parsed instanceof Map ? parsed : [:]
if (json.code != 0) {
    String report = &apos;Assertion message: 生产环境-list_open_positions code不是0 | status=FAIL | code=&apos; + render(json.code) + &apos; | msg=&apos; + render(json.msg) + &apos;\n响应原文:\n&apos; + responseText
    publishReport(report, false)
    return
}

Map data = json.data instanceof Map ? rowToMap(json.data) : [:]
Map summary = data.summary instanceof Map ? rowToMap(data.summary) : [:]
List items = data.items instanceof List ? data.items.collect { rowToMap(it) } : []
Object apiTotal = valueOf(data, &apos;total&apos;)
int page = Integer.parseInt(vars.get(&apos;production_open_positions_page&apos;) ?: &apos;1&apos;)
int pageSize = Integer.parseInt(vars.get(&apos;production_open_positions_page_size&apos;) ?: &apos;50&apos;)
int offset = Math.max(page - 1, 0) * pageSize

List summaryFields = [&apos;standard_volume&apos;,&apos;total_volume&apos;,&apos;cent_volume&apos;,&apos;total_fee&apos;,&apos;total_storage&apos;,&apos;total_profit&apos;,&apos;total_orders&apos;]
summaryFields.each { field -&gt;
    Object v = valueOf(summary, field)
    if (!summary.containsKey(field)) {
        failLines &lt;&lt; &quot; - [失败] | summary字段完整性 | field=${field} | reason=字段不存在&quot;
    } else if (blank(v)) {
        failLines &lt;&lt; &quot; - [失败] | summary字段完整性 | field=${field} | API=&lt;empty&gt; | reason=字段为空&quot;
    } else if (!(v instanceof Number)) {
        failLines &lt;&lt; &quot; - [失败] | summary字段完整性 | field=${field} | API=${render(v)} | reason=字段不是数字&quot;
    } else {
        okLines &lt;&lt; &quot; - [通过] | summary字段完整性 | field=${field} | API=${render(v)}&quot;
    }
}
if (apiTotal == null) failLines &lt;&lt; &apos; - [失败] | data字段完整性 | field=total | reason=字段不存在&apos; else okLines &lt;&lt; &apos; - [通过] | data字段完整性 | field=total | API=&apos; + render(apiTotal)
if (!(data.items instanceof List)) failLines &lt;&lt; &apos; - [失败] | data字段完整性 | field=items | reason=data.items不是数组或不存在&apos;
if (items.isEmpty()) failLines &lt;&lt; &apos; - [失败] | data.items | reason=接口没有返回任何持仓明细，无法校验每笔持仓字段&apos;

List requiredNumberFields = [&apos;reason&apos;,&apos;position_ticket&apos;,&apos;updated_utc_ms&apos;,&apos;fee&apos;,&apos;open_time_utc_ms&apos;,&apos;price_open&apos;,&apos;margin_rate&apos;,&apos;login&apos;,&apos;price_sl&apos;,&apos;commission&apos;,&apos;digits_currency&apos;,&apos;state&apos;,&apos;order_type&apos;,&apos;profit&apos;,&apos;price_current&apos;,&apos;volume_lots&apos;,&apos;swap&apos;,&apos;deal_ticket&apos;,&apos;price_tp&apos;,&apos;order_ticket&apos;,&apos;net_profit&apos;,&apos;digits&apos;,&apos;contract_size&apos;]
List requiredStringFields = [&apos;symbol&apos;,&apos;source&apos;,&apos;side&apos;,&apos;instance_id&apos;]
List existOnlyFields = [&apos;comment&apos;]
List allItemFields = []
allItemFields.addAll(requiredNumberFields)
allItemFields.addAll(requiredStringFields)
allItemFields.addAll(existOnlyFields)

items.eachWithIndex { Map item, int idx -&gt;
    int rowNo = offset + idx + 1
    String rowId = cleanNumText(valueOf(item, &apos;position_ticket&apos;)) ?: cleanNumText(valueOf(item, &apos;order_ticket&apos;))
    String rowText = &apos;row=&apos; + rowNo + &apos; | apiId=&apos; + (rowId ?: &apos;&lt;empty&gt;&apos;) + &apos; | instance_id=&apos; + render(valueOf(item, &apos;instance_id&apos;)) + &apos; | login=&apos; + render(valueOf(item, &apos;login&apos;)) + &apos; | symbol=&apos; + render(valueOf(item, &apos;symbol&apos;))
    requiredNumberFields.each { field -&gt;
        if (!item.containsKey(field)) {
            failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | reason=字段不存在&quot;
            return
        }
        Object v = item[field]
        if (blank(v)) {
            failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | API=&lt;empty&gt; | reason=字段为空&quot;
        } else if (!(v instanceof Number)) {
            failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | API=${render(v)} | reason=字段不是数字&quot;
        } else {
            okLines &lt;&lt; &quot; - [通过] | item字段完整性 | ${rowText} | field=${field} | API=${render(v)}&quot;
        }
    }
    requiredStringFields.each { field -&gt;
        if (!item.containsKey(field)) {
            failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | reason=字段不存在&quot;
            return
        }
        Object v = item[field]
        if (blank(v)) failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | API=&lt;empty&gt; | reason=字段为空&quot; else okLines &lt;&lt; &quot; - [通过] | item字段完整性 | ${rowText} | field=${field} | API=${render(v)}&quot;
    }
    existOnlyFields.each { field -&gt;
        if (!item.containsKey(field)) failLines &lt;&lt; &quot; - [失败] | item字段完整性 | ${rowText} | field=${field} | reason=字段不存在&quot; else okLines &lt;&lt; &quot; - [通过] | item字段完整性 | ${rowText} | field=${field} | API=${render(item[field])} | 备注=允许空字符串&quot;
    }

    String instanceId = String.valueOf(valueOf(item, &apos;instance_id&apos;) ?: &apos;&apos;).trim()
    Object loginVal = valueOf(item, &apos;login&apos;)
    Object orderTicket = valueOf(item, &apos;order_ticket&apos;)
    Object positionTicket = valueOf(item, &apos;position_ticket&apos;)
    Map auxPos = [:]
    Map auxLegacy = [:]
    Map sym = [:]
    String acctCur = &apos;&apos;
    try {
        auxPos = positionEx(instanceId, loginVal, orderTicket, positionTicket)
        auxLegacy = positionInfo(instanceId, loginVal, orderTicket, positionTicket)
        sym = symbolInfo(instanceId, String.valueOf(valueOf(item, &apos;symbol&apos;) ?: &apos;&apos;))
        acctCur = accountCurrency(instanceId, loginVal)
        if (!auxPos || valueOf(auxPos, &apos;__error&apos;)) {
            failLines &lt;&lt; &quot; - [失败] | 辅助接口get_position_ex | ${rowText} | reason=未查到对应持仓或请求失败 | error=${render(valueOf(auxPos, &apos;__error&apos;))}&quot;
        } else {
            okLines &lt;&lt; &quot; - [通过] | 辅助接口get_position_ex | ${rowText} | matched_order_ticket=${render(valueOf(auxPos, &apos;order_ticket&apos;))} | matched_position_ticket=${render(valueOf(auxPos, &apos;position_ticket&apos;))}&quot;
        }
        if (valueOf(sym, &apos;__error&apos;)) failLines &lt;&lt; &quot; - [失败] | 辅助接口get_symbol_ex | ${rowText} | error=${render(valueOf(sym, &apos;__error&apos;))}&quot;
        if (valueOf(auxLegacy, &apos;__error&apos;)) skipLines &lt;&lt; &quot; - [跳过] | 辅助接口get_position_info | ${rowText} | error=${render(valueOf(auxLegacy, &apos;__error&apos;))}&quot;
        if (!acctCur) failLines &lt;&lt; &quot; - [失败] | 辅助接口get_user_info | ${rowText} | reason=账户币种为空，无法支撑profit汇率和cent/standard校验&quot;
    } catch (Throwable e) {
        failLines &lt;&lt; &quot; - [失败] | 辅助接口请求 | ${rowText} | exception=${e.class.simpleName}: ${e.message}&quot;
    }

    def expectedValue = { String field -&gt;
        String side = String.valueOf(valueOf(item, &apos;side&apos;) ?: valueOf(auxPos, &apos;side&apos;) ?: &apos;&apos;).toLowerCase()
        switch (field) {
            case &apos;instance_id&apos;: return valueOf(auxPos, &apos;instance_id&apos;)
            case &apos;login&apos;: return coalesce(valueOf(auxPos, &apos;login&apos;), legacy(auxLegacy, [&apos;Login&apos;,&apos;login&apos;]))
            case &apos;source&apos;: return valueOf(auxPos, &apos;source&apos;)
            case &apos;order_ticket&apos;: return coalesce(valueOf(auxPos, &apos;order_ticket&apos;), legacy(auxLegacy, [&apos;Position&apos;,&apos;order&apos;]))
            case &apos;position_ticket&apos;:
                if (String.valueOf(valueOf(item, &apos;source&apos;) ?: &apos;&apos;).equalsIgnoreCase(&apos;mt4&apos;) &amp;&amp; cleanNumText(valueOf(item, &apos;position_ticket&apos;)) == &apos;0&apos;) return 0
                return coalesce(valueOf(auxPos, &apos;position_ticket&apos;), legacy(auxLegacy, [&apos;Position&apos;,&apos;order&apos;]))
            case &apos;deal_ticket&apos;: return valueOf(auxPos, &apos;deal_ticket&apos;) ?: 0
            case &apos;symbol&apos;: return coalesce(valueOf(auxPos, &apos;symbol&apos;), legacy(auxLegacy, [&apos;Symbol&apos;,&apos;symbol&apos;]))
            case &apos;side&apos;: return valueOf(auxPos, &apos;side&apos;) ?: (legacy(auxLegacy, [&apos;Action&apos;,&apos;cmd&apos;]) == 1 ? &apos;sell&apos; : (legacy(auxLegacy, [&apos;Action&apos;,&apos;cmd&apos;]) == 0 ? &apos;buy&apos; : null))
            case &apos;order_type&apos;: return side == &apos;buy&apos; ? 0 : (side == &apos;sell&apos; ? 1 : legacy(auxLegacy, [&apos;Action&apos;,&apos;cmd&apos;]))
            case &apos;state&apos;: return coalesce(valueOf(auxPos, &apos;state&apos;), legacy(auxLegacy, [&apos;state&apos;]))
            case &apos;reason&apos;: return coalesce(valueOf(auxPos, &apos;reason&apos;), legacy(auxLegacy, [&apos;Reason&apos;,&apos;reason&apos;]))
            case &apos;volume_lots&apos;: return valueOf(auxPos, &apos;volume_lots&apos;)
            case &apos;price_open&apos;: return coalesce(valueOf(auxPos, &apos;price_open&apos;), legacy(auxLegacy, [&apos;PriceOpen&apos;,&apos;open_price&apos;]))
            case &apos;price_current&apos;: return coalesce(valueOf(auxPos, &apos;price_current&apos;), legacy(auxLegacy, [&apos;PriceCurrent&apos;,&apos;current_price&apos;]))
            case &apos;price_sl&apos;: return coalesce(valueOf(auxPos, &apos;sl&apos;), legacy(auxLegacy, [&apos;PriceSL&apos;,&apos;sl&apos;]))
            case &apos;price_tp&apos;: return coalesce(valueOf(auxPos, &apos;tp&apos;), legacy(auxLegacy, [&apos;PriceTP&apos;,&apos;tp&apos;]))
            case &apos;profit&apos;: return coalesce(valueOf(auxPos, &apos;profit&apos;), legacy(auxLegacy, [&apos;Profit&apos;,&apos;profit&apos;]))
            case &apos;swap&apos;: return coalesce(valueOf(auxPos, &apos;swap&apos;), legacy(auxLegacy, [&apos;Storage&apos;,&apos;storage&apos;]))
            case &apos;commission&apos;: return coalesce(valueOf(auxPos, &apos;commission&apos;), legacy(auxLegacy, [&apos;Commission&apos;,&apos;commission&apos;]))
            case &apos;fee&apos;: return 0
            case &apos;net_profit&apos;:
                BigDecimal p = asNum(coalesce(valueOf(auxPos, &apos;profit&apos;), legacy(auxLegacy, [&apos;Profit&apos;,&apos;profit&apos;])))
                BigDecimal sw = asNum(coalesce(valueOf(auxPos, &apos;swap&apos;), legacy(auxLegacy, [&apos;Storage&apos;,&apos;storage&apos;])))
                BigDecimal cm = asNum(coalesce(valueOf(auxPos, &apos;commission&apos;), legacy(auxLegacy, [&apos;Commission&apos;,&apos;commission&apos;])))
                BigDecimal fee = asNum(valueOf(item, &apos;fee&apos;)) ?: BigDecimal.ZERO
                return (p == null || sw == null || cm == null) ? null : p.add(sw).add(cm).add(fee)
            case &apos;open_time_utc_ms&apos;: return coalesce(valueOf(auxPos, &apos;open_time_utc_ms&apos;), msFromSeconds(legacy(auxLegacy, [&apos;TimeCreate&apos;,&apos;open_time&apos;])))
            case &apos;updated_utc_ms&apos;: return coalesce(valueOf(auxPos, &apos;updated_utc_ms&apos;), msFromSeconds(legacy(auxLegacy, [&apos;TimeUpdate&apos;,&apos;time_update&apos;,&apos;timestamp&apos;])))
            case &apos;digits&apos;: return coalesce(valueOf(sym, &apos;digits&apos;), valueOf(auxPos, &apos;digits&apos;), legacy(auxLegacy, [&apos;Digits&apos;,&apos;digits&apos;]))
            case &apos;digits_currency&apos;: return coalesce(legacy(auxLegacy, [&apos;DigitsCurrency&apos;,&apos;digits_currency&apos;]), currencyDigits(acctCur))
            case &apos;contract_size&apos;: return coalesce(valueOf(sym, &apos;contract_size&apos;), legacy(auxLegacy, [&apos;ContractSize&apos;,&apos;contract_size&apos;]))
            case &apos;margin_rate&apos;: return coalesce(valueOf(auxPos, &apos;margin_rate&apos;), legacy(auxLegacy, [&apos;RateMargin&apos;,&apos;margin_rate&apos;]))
            case &apos;comment&apos;: return coalesce(valueOf(auxPos, &apos;comment&apos;), legacy(auxLegacy, [&apos;Comment&apos;,&apos;comment&apos;]), &apos;&apos;)
            default: return null
        }
    }

    allItemFields.each { field -&gt;
        compareAndRecord(&apos;辅助接口字段值对比&apos;, field, valueOf(item, field), expectedValue(field), &apos;辅助接口&apos;, rowText)
    }
}

if (validateSummary &amp;&amp; summary) {
    compareAndRecord(&apos;summary字段值对比&apos;, &apos;total_orders&apos;, valueOf(summary, &apos;total_orders&apos;), apiTotal, &apos;data.total&apos;, &apos;summary&apos;)
    BigDecimal totalNum = asNum(apiTotal)
    boolean fullPage = totalNum != null &amp;&amp; new BigDecimal(items.size()).compareTo(totalNum) == 0
    if (fullPage) {
        BigDecimal totalVolume = BigDecimal.ZERO
        BigDecimal centVolume = BigDecimal.ZERO
        BigDecimal standardVolume = BigDecimal.ZERO
        BigDecimal totalFee = BigDecimal.ZERO
        BigDecimal totalStorage = BigDecimal.ZERO
        BigDecimal totalProfit = BigDecimal.ZERO
        items.each { Map item -&gt;
            BigDecimal vol = asNum(valueOf(item, &apos;volume_lots&apos;)) ?: BigDecimal.ZERO
            totalVolume = totalVolume.add(vol)
            totalFee = totalFee.add(asNum(valueOf(item, &apos;commission&apos;)) ?: BigDecimal.ZERO).add(asNum(valueOf(item, &apos;fee&apos;)) ?: BigDecimal.ZERO)
            totalStorage = totalStorage.add(asNum(valueOf(item, &apos;swap&apos;)) ?: BigDecimal.ZERO)
            totalProfit = totalProfit.add(asNum(valueOf(item, &apos;profit&apos;)) ?: BigDecimal.ZERO)
            String cur = &apos;&apos;
            try { cur = accountCurrency(String.valueOf(valueOf(item, &apos;instance_id&apos;) ?: &apos;&apos;), valueOf(item, &apos;login&apos;)) } catch (Throwable ignored) {}
            if (centCurrencies.contains(cur)) centVolume = centVolume.add(vol) else standardVolume = standardVolume.add(vol)
        }
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;total_volume&apos;, valueOf(summary, &apos;total_volume&apos;), totalVolume, &apos;items全量聚合&apos;, &apos;summary&apos;)
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;cent_volume&apos;, valueOf(summary, &apos;cent_volume&apos;), centVolume, &apos;items全量聚合+get_user_info币种&apos;, &apos;summary&apos;)
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;standard_volume&apos;, valueOf(summary, &apos;standard_volume&apos;), standardVolume, &apos;items全量聚合+get_user_info币种&apos;, &apos;summary&apos;)
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;total_fee&apos;, valueOf(summary, &apos;total_fee&apos;), totalFee, &apos;items全量聚合(commission+fee)&apos;, &apos;summary&apos;)
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;total_storage&apos;, valueOf(summary, &apos;total_storage&apos;), totalStorage, &apos;items全量聚合(swap)&apos;, &apos;summary&apos;)
        compareAndRecord(&apos;summary字段值对比&apos;, &apos;total_profit&apos;, valueOf(summary, &apos;total_profit&apos;), totalProfit, &apos;items全量聚合(profit)&apos;, &apos;summary&apos;)
    } else {
        skipLines &lt;&lt; &apos; - [跳过] | summary字段值对比 | summary | reason=当前请求不是全量页，total=&apos; + render(apiTotal) + &apos; | 当前页items=&apos; + items.size() + &apos;；只校验summary字段存在和total_orders=data.total&apos;
    }
}

if (!auxProfitEnabled) {
    auxProfitSkipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | reason=open_positions_aux_profit_calc_enabled=0&apos;
} else {
    List calcItems = items.take(auxMaxRows)
    if (items.size() &gt; calcItems.size()) {
        auxProfitSkipLines &lt;&lt; &apos; - [跳过] | 辅助接口profit计算 | reason=只复算前&apos; + calcItems.size() + &apos;条，接口返回&apos; + items.size() + &apos;条；可调大 open_positions_aux_profit_calc_max_rows&apos;
    }
    calcItems.eachWithIndex { Map item, int idx -&gt; compareAuxProfit(item, offset + idx + 1) }
}
failLines.addAll(auxProfitFailLines)
okLines.addAll(auxProfitOkLines)
skipLines.addAll(auxProfitSkipLines)

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List report = []
report &lt;&lt; &apos;Assertion message: 生产环境-查询多个账户当前持仓订单 list_open_positions 辅助接口校验结果 | status=&apos; + status + &apos; | case=&apos; + vars.get(&apos;production_open_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;production_open_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;production_open_positions_csv_line_no&apos;) + &apos; | mode=&apos; + vars.get(&apos;production_open_positions_mode&apos;)
report &lt;&lt; &apos;接口: POST /crm20/list_open_positions&apos;
report &lt;&lt; &apos;请求accounts: &apos; + (vars.get(&apos;production_open_positions_accounts_text&apos;) ?: &apos;&apos;)
report &lt;&lt; &apos;分页排序: page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort_by=&apos; + (vars.get(&apos;production_open_positions_sort_by&apos;) ?: &apos;&apos;) + &apos; | sort_order=&apos; + (vars.get(&apos;production_open_positions_sort_order&apos;) ?: &apos;&apos;)
report &lt;&lt; &apos;辅助接口字段跳过配置: production_open_positions_aux_disabled_compare_fields=[&apos; + (vars.get(&apos;production_open_positions_aux_disabled_compare_fields&apos;) ?: &apos;&apos;) + &apos;]&apos;
report &lt;&lt; &apos;辅助接口字段误差配置: production_open_positions_aux_field_tolerance_percent=[&apos; + (vars.get(&apos;production_open_positions_aux_field_tolerance_percent&apos;) ?: &apos;&apos;) + &apos;]；未配置字段默认5%；时间字段允许差值&lt;=&apos; + timeToleranceMs + &apos;ms&apos;
report &lt;&lt; &apos;辅助接口profit计算跳过字段配置: open_positions_aux_profit_calc_disabled_compare_fields=[&apos; + (vars.get(&apos;open_positions_aux_profit_calc_disabled_compare_fields&apos;) ?: &apos;&apos;) + &apos;]&apos;
report &lt;&lt; &apos;辅助接口profit计算误差配置: open_positions_aux_profit_calc_field_tolerance_percent=[&apos; + (vars.get(&apos;open_positions_aux_profit_calc_field_tolerance_percent&apos;) ?: &apos;&apos;) + &apos;]；未配置profit默认10%；不读取字段辅助接口误差配置&apos;
report &lt;&lt; &apos;辅助接口来源: get_position_ex校验持仓明细主字段；get_position_info补充DigitsCurrency/legacy字段；get_symbol_ex校验contract_size/digits并提供bid/ask/currency_profit；get_user_info提供账户币种和cent/standard口径&apos;
report &lt;&lt; &apos;Field source map: get_position_ex -&gt; instance_id,login,source,order_ticket,position_ticket,deal_ticket,symbol,side,state,reason,volume_lots,price_open,price_current,price_sl(sl),price_tp(tp),profit,swap,commission,open_time_utc_ms,updated_utc_ms,digits,margin_rate,comment&apos;
report &lt;&lt; &apos;Field source map: get_position_info -&gt; digits_currency/DigitsCurrency plus legacy price/time/profit fields; get_symbol_ex -&gt; contract_size,digits,bid,ask,currency_profit; get_user_info -&gt; account currency; derived -&gt; order_type(side),fee=0,net_profit=profit+swap+commission+fee&apos;
report &lt;&lt; &apos;接口summary: total=&apos; + render(apiTotal) + &apos; | summary=&apos; + summary
report &lt;&lt; &apos;对比结果统计: 失败数量=&apos; + failLines.size() + &apos; | 成功数量=&apos; + okLines.size() + &apos; | 跳过数量=&apos; + skipLines.size() + &apos; | items数量=&apos; + items.size()
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【辅助接口profit计算失败明细：&apos; + auxProfitFailLines.size() + &apos;条】&apos;
report.addAll(auxProfitFailLines ? auxProfitFailLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【辅助接口profit计算通过明细：&apos; + auxProfitOkLines.size() + &apos;条】&apos;
report.addAll(auxProfitOkLines ? auxProfitOkLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【字段失败明细：&apos; + (failLines.size() - auxProfitFailLines.size()) + &apos;条】&apos;
report.addAll(failLines.findAll { !it.contains(&apos;辅助接口profit计算&apos;) } ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【字段成功明细：&apos; + (okLines.size() - auxProfitOkLines.size()) + &apos;条】&apos;
report.addAll(okLines.findAll { !it.contains(&apos;辅助接口profit计算&apos;) } ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过明细：&apos; + skipLines.size() + &apos;条】&apos;
report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【接口请求Body】&apos;
report &lt;&lt; (vars.get(&apos;production_open_positions_request_body&apos;) ?: &apos;&apos;)

publishReport(report.join(&apos;\n&apos;), failLines.isEmpty())</stringProp>
              <stringProp name="TestPlan.comments">校验list_open_positions字段完整性；通过get_position_ex/get_position_info/get_symbol_ex/get_user_info校验字段值；profit公式复算单独使用open_positions_aux_profit_calc_field_tolerance_percent。</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="生产环境-提取list_open_positions首条辅助接口参数" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.net.URLEncoder

[
    &apos;production_open_positions_aux_has_item&apos;,
    &apos;production_open_positions_aux_extract_error&apos;,
    &apos;production_open_positions_aux_instanceid&apos;,
    &apos;production_open_positions_aux_login&apos;,
    &apos;production_open_positions_aux_symbol&apos;,
    &apos;production_open_positions_aux_order_ticket&apos;,
    &apos;production_open_positions_aux_position_ticket&apos;,
    &apos;production_open_positions_aux_deal_ticket&apos;,
    &apos;production_open_positions_aux_instanceid_enc&apos;,
    &apos;production_open_positions_aux_login_enc&apos;,
    &apos;production_open_positions_aux_symbol_enc&apos;,
    &apos;production_open_positions_aux_ticket_query&apos;,
    &apos;production_open_positions_aux_legacy_ticket_query&apos;
].each { vars.put(it, &apos;&apos;) }
vars.put(&apos;production_open_positions_aux_has_item&apos;, &apos;false&apos;)

def enc = { Object v -&gt; URLEncoder.encode(String.valueOf(v ?: &apos;&apos;), &apos;UTF-8&apos;) }
def val = { Map row, String field -&gt;
    if (!(row instanceof Map)) return &apos;&apos;
    if (row.containsKey(field) &amp;&amp; row[field] != null) return String.valueOf(row[field]).trim()
    def hit = row.find { k, v -&gt; String.valueOf(k).equalsIgnoreCase(field) }
    hit == null || hit.value == null ? &apos;&apos; : String.valueOf(hit.value).trim()
}

try {
    String responseText = prev == null ? &apos;&apos; : (prev.getResponseDataAsString() ?: &apos;&apos;)
    def json = responseText ? new JsonSlurper().parseText(responseText) : [:]
    def data = json instanceof Map ? json.data : null
    def items = data instanceof Map ? data.items : []
    if (items instanceof List &amp;&amp; !items.isEmpty() &amp;&amp; items[0] instanceof Map) {
        Map item = items[0] as Map
        String instanceId = val(item, &apos;instance_id&apos;) ?: val(item, &apos;instanceid&apos;)
        String login = val(item, &apos;login&apos;)
        String symbol = val(item, &apos;symbol&apos;)
        String orderTicket = val(item, &apos;order_ticket&apos;)
        String positionTicket = val(item, &apos;position_ticket&apos;)
        String dealTicket = val(item, &apos;deal_ticket&apos;)

        vars.put(&apos;production_open_positions_aux_instanceid&apos;, instanceId)
        vars.put(&apos;production_open_positions_aux_login&apos;, login)
        vars.put(&apos;production_open_positions_aux_symbol&apos;, symbol)
        vars.put(&apos;production_open_positions_aux_order_ticket&apos;, orderTicket)
        vars.put(&apos;production_open_positions_aux_position_ticket&apos;, positionTicket)
        vars.put(&apos;production_open_positions_aux_deal_ticket&apos;, dealTicket)
        vars.put(&apos;production_open_positions_aux_instanceid_enc&apos;, enc(instanceId))
        vars.put(&apos;production_open_positions_aux_login_enc&apos;, enc(login))
        vars.put(&apos;production_open_positions_aux_symbol_enc&apos;, enc(symbol))
        vars.put(&apos;production_open_positions_aux_ticket_query&apos;, orderTicket ? &apos;&amp;order_ticket=&apos; + enc(orderTicket) : (positionTicket ? &apos;&amp;position_ticket=&apos; + enc(positionTicket) : &apos;&apos;))
        vars.put(&apos;production_open_positions_aux_legacy_ticket_query&apos;, orderTicket ? &apos;&amp;ticket=&apos; + enc(orderTicket) : (positionTicket ? &apos;&amp;ticket=&apos; + enc(positionTicket) : &apos;&apos;))

        boolean canQuery = instanceId.length() &gt; 0
        if (canQuery) canQuery = login.length() &gt; 0
        vars.put(&apos;production_open_positions_aux_has_item&apos;, canQuery ? &apos;true&apos; : &apos;false&apos;)
        if (!canQuery) vars.put(&apos;production_open_positions_aux_extract_error&apos;, &apos;items[0]缺少instance_id/login，跳过可见辅助接口HTTP请求&apos;)
    } else {
        vars.put(&apos;production_open_positions_aux_extract_error&apos;, &apos;list_open_positions响应data.items为空，跳过可见辅助接口HTTP请求&apos;)
    }
} catch (Throwable e) {
    vars.put(&apos;production_open_positions_aux_extract_error&apos;, e.class.simpleName + &apos;: &apos; + e.message)
}</stringProp>
              <stringProp name="TestPlan.comments">从 /crm20/list_open_positions 响应 items[0] 提取 instance_id/login/symbol/ticket，供后续可见辅助接口HTTP Sampler使用；完整逐条校验仍由字段校验断言完成。</stringProp>
