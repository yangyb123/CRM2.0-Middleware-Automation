            <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode
import java.text.SimpleDateFormat

String responseText = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + responseText)
    return
}

def rowToMap
rowToMap = { row -&gt;
    Map out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else if (row != null) {
        try {
            row.metaClass.properties.each { p -&gt; if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot; }
        } catch (ignored) {}
    }
    out
}

def rowsFromObject = { obj -&gt;
    if (obj == null) return []
    if (obj instanceof List) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Object[]) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Map) return [rowToMap(obj)]
    []
}

def blank = { v -&gt; v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) }
def normKey = { Object v -&gt; (v == null ? &apos;&apos; : v.toString()).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase() }
def numeric = { v -&gt; !blank(v) &amp;&amp; String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;) ==~ /^-?\d+(\.\d+)?$/ }
def cleanNumText = { v -&gt;
    if (blank(v)) return &apos;&apos;
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+\.0+$/) return s.substring(0, s.indexOf(&apos;.&apos;))
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        try { return new BigDecimal(s).stripTrailingZeros().toPlainString() } catch (ignored) {}
    }
    s
}

Map aliases = [
    &apos;position_ticket&apos;: [&apos;position_ticket&apos;, &apos;position&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;order_ticket&apos;: [&apos;order_ticket&apos;, &apos;order&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;deal_ticket&apos;: [&apos;deal_ticket&apos;, &apos;deal&apos;, &apos;Deal&apos;, &apos;DEAL&apos;],
    &apos;instance_id&apos;: [&apos;instance_id&apos;, &apos;instanceid&apos;, &apos;instanceId&apos;, &apos;order_instanceid_val&apos;],
    &apos;login&apos;: [&apos;login&apos;, &apos;Login&apos;, &apos;LOGIN&apos;, &apos;order_login&apos;],
    &apos;source&apos;: [&apos;source&apos;, &apos;platform&apos;],
    &apos;symbol&apos;: [&apos;symbol&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;],
    &apos;order_type&apos;: [&apos;order_type&apos;, &apos;action&apos;, &apos;Action&apos;, &apos;CMD&apos;, &apos;cmd&apos;],
    &apos;side&apos;: [&apos;side&apos;],
    &apos;reason&apos;: [&apos;reason&apos;, &apos;Reason&apos;, &apos;REASON&apos;],
    &apos;volume_lots&apos;: [&apos;volume_lots&apos;, &apos;volume&apos;, &apos;Volume&apos;, &apos;VOLUME&apos;],
    &apos;price_open&apos;: [&apos;price_open&apos;, &apos;open_price&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;price_close&apos;: [&apos;price_close&apos;, &apos;close_price&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;price_sl&apos;: [&apos;price_sl&apos;, &apos;sl&apos;, &apos;SL&apos;, &apos;PriceSL&apos;],
    &apos;price_tp&apos;: [&apos;price_tp&apos;, &apos;tp&apos;, &apos;TP&apos;, &apos;PriceTP&apos;],
    &apos;profit&apos;: [&apos;profit&apos;, &apos;Profit&apos;, &apos;PROFIT&apos;],
    &apos;swap&apos;: [&apos;swap&apos;, &apos;Storage&apos;, &apos;SWAPS&apos;],
    &apos;commission&apos;: [&apos;commission&apos;, &apos;Commission&apos;, &apos;COMMISSION&apos;],
    &apos;fee&apos;: [&apos;fee&apos;, &apos;Fee&apos;],
    &apos;net_profit&apos;: [&apos;net_profit&apos;],
    &apos;open_time_utc_ms&apos;: [&apos;open_time_utc_ms&apos;, &apos;open_time&apos;, &apos;OPEN_TIME&apos;, &apos;TimeCreate&apos;, &apos;TimeMsc&apos;],
    &apos;close_time_utc_ms&apos;: [&apos;close_time_utc_ms&apos;, &apos;close_time&apos;, &apos;CLOSE_TIME&apos;, &apos;TimeMsc&apos;, &apos;Time&apos;],
    &apos;updated_utc_ms&apos;: [&apos;updated_utc_ms&apos;, &apos;time_update_utc_ms&apos;, &apos;MODIFY_TIME&apos;, &apos;TimeMsc&apos;],
    &apos;digits&apos;: [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;digits_currency&apos;: [&apos;digits_currency&apos;, &apos;DigitsCurrency&apos;],
    &apos;contract_size&apos;: [&apos;contract_size&apos;, &apos;ContractSize&apos;],
    &apos;comment&apos;: [&apos;comment&apos;, &apos;Comment&apos;, &apos;COMMENT&apos;]
]

def findKey
findKey = { Map m, String field -&gt;
    if (m == null) return null
    if (m.containsKey(field)) return field
    for (String a : (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    String want = normKey(field)
    m.keySet().find { normKey(it) == want }
}

def valueOf
valueOf = { Map m, String field -&gt;
    def k = findKey(m, field)
    k == null ? null : m[k]
}

def idOf = { Map row -&gt;
    for (String f : [&apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;deal_ticket&apos;]) {
        def v = valueOf(row, f)
        if (!blank(v)) return cleanNumText(v)
    }
    &apos;&apos;
}

def timeField = { String f -&gt;
    String n = (f ?: &apos;&apos;).toLowerCase()
    n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;) || n.contains(&apos;updated&apos;)
}

Date parseDateLike(v) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return null
    if (v instanceof java.util.Date) return v
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (String fmt : [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    sdf.format(d)
}

String normalizeApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String normalizeDbTime(v) {
    Date d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeCsvTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String displayApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

long secondDiff(String a, String b) {
    try {
        SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
        return Math.abs((sdf.parse(a).time - sdf.parse(b).time) / 1000L)
    } catch (ignored) { return Long.MAX_VALUE }
}

String renderValue(String field, Object v, String side, boolean dbMode) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&lt;empty&gt;&apos;
    if (!timeField(field)) return String.valueOf(v)
    if (side == &apos;API&apos; &amp;&amp; dbMode) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
    if (side == &apos;API&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值=&apos; + normalizeCsvTime(v)
    if (side == &apos;DB&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    return String.valueOf(v) + &apos; -&gt; &apos; + normalizeCsvTime(v)
}

def asNum = { Object v -&gt;
    if (blank(v)) return null
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

def fmtNum = { BigDecimal n -&gt; n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() }
def pctText = { BigDecimal p -&gt; p == null ? &apos;N/A&apos; : p.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos; }
Set exactNumericFields = [&apos;login&apos;, &apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;deal_ticket&apos;, &apos;reason&apos;, &apos;order_type&apos;, &apos;digits&apos;, &apos;digits_currency&apos;, &apos;total&apos;, &apos;total_orders&apos;] as Set

def compareValue = { String field, Object apiVal, Object expectedVal, String expectedSource, boolean dbMode -&gt;
    if (timeField(field)) {
        String aCmp = dbMode ? normalizeApiTime(apiVal) : normalizeCsvTime(apiVal)
        String eCmp = dbMode ? normalizeDbTime(expectedVal) : normalizeCsvTime(expectedVal)
        long diffSec = secondDiff(aCmp, eCmp)
        return [same: (aCmp == eCmp || diffSec &lt;= 60L), apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: diffSec + &apos;秒&apos;, percent: &apos;N/A(时间字段)&apos;, formula: &apos;时间字段按yyyy-MM-dd HH:mm:ss比较，允许相差&lt;=60秒&apos;]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactNumericFields.contains(field)) {
            return [same: cleanNumText(apiVal) == cleanNumText(expectedVal), apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: &apos;N/A(编号类字段精确比较)&apos;, formula: &apos;编号类字段不使用5%误差，按数值精确比较&apos;]
        }
        BigDecimal base = en.abs()
        BigDecimal allowed = base.multiply(new BigDecimal(&apos;0.05&apos;))
        if (allowed.compareTo(new BigDecimal(&apos;0.000001&apos;)) &lt; 0) allowed = new BigDecimal(&apos;0.000001&apos;)
        boolean same = diff.compareTo(allowed) &lt;= 0
        String pct
        String formula
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            pct = diff.compareTo(BigDecimal.ZERO) == 0 ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0无法作分母)&apos;
            formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;))=&apos; + fmtNum(diff) + &apos;，&apos; + expectedSource + &apos;=0，使用最小允许差值0.000001&apos;
        } else {
            BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
            pct = pctText(percent)
            formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) / abs(&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
        }
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: pct, formula: formula + &apos; | 允许误差&lt;=5%(允许差值=&apos; + fmtNum(allowed) + &apos;)&apos;]
    }
    boolean same = String.valueOf(apiVal ?: &apos;&apos;).trim() == String.valueOf(expectedVal ?: &apos;&apos;).trim()
    [same: same, apiPrint: String.valueOf(apiVal ?: &apos;&apos;), expPrint: String.valueOf(expectedVal ?: &apos;&apos;), diff: &apos;N/A&apos;, percent: &apos;N/A(非数值字段)&apos;, formula: &apos;非数值字段按字符串精确比较&apos;]
}

def compareComparable = { Object v -&gt;
    if (numeric(v)) return new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;))
    String.valueOf(v ?: &apos;&apos;)
}

def sumField = { List rows, String field -&gt;
    BigDecimal total = BigDecimal.ZERO
    rows.each { r -&gt;
        BigDecimal n = asNum(valueOf(r, field))
        if (n != null) total = total.add(n)
    }
    total
}

def disabledRaw = { boolean dbMode -&gt; dbMode ? (vars.get(&apos;history_positions_db_api_disabled_compare_fields&apos;) ?: &apos;&apos;) : (vars.get(&apos;history_positions_csv_api_disabled_compare_fields&apos;) ?: &apos;&apos;) }
def disabledSet = { String raw -&gt; raw.split(/[，,;|\s]+/).collect { normKey(it) }.findAll { it }.toSet() }

String shujuku = vars.get(&apos;history_positions_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
String sourceName = dbMode ? &apos;DB&apos; : &apos;CSV&apos;
String modeText = dbMode ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String sortBy = vars.get(&apos;history_positions_sort_by&apos;) ?: &apos;close_time_utc_ms&apos;
boolean desc = (vars.get(&apos;history_positions_sort_order&apos;) ?: &apos;desc&apos;).toLowerCase() != &apos;asc&apos;
int page = ((vars.get(&apos;history_positions_page&apos;) ?: &apos;1&apos;) as int)
int pageSize = ((vars.get(&apos;history_positions_page_size&apos;) ?: &apos;50&apos;) as int)
int offset = Math.max(page - 1, 0) * pageSize
Set disabled = disabledSet(disabledRaw(dbMode))
boolean skipAll = disabled.contains(&apos;*&apos;)

def data = parsed instanceof Map ? parsed.data : null
List apiItems = []
if (data instanceof Map &amp;&amp; data.items instanceof List) apiItems = data.items.collect { rowToMap(it) }
else if (data instanceof List) apiItems = data.collect { rowToMap(it) }
else if (parsed instanceof Map &amp;&amp; parsed.items instanceof List) apiItems = parsed.items.collect { rowToMap(it) }
if (!apiItems) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口没有返回data.items可对比记录 | response=&apos; + responseText)
    return
}
Map apiSummary = data instanceof Map &amp;&amp; data.summary instanceof Map ? rowToMap(data.summary) : [:]
Object apiTotal = data instanceof Map ? data.total : parsed.total

List okLines = []
List failLines = []
List skipLines = []
int apiFieldTotal = 0

List expectedRows = []
List allDbRows = []
Object dbTotalForReport = null
if (dbMode) {
    List summaryRows = rowsFromObject(vars.getObject(&apos;db_history_positions_summary_rows&apos;))
    List pageRows = rowsFromObject(vars.getObject(&apos;db_history_positions_page_rows&apos;))
    if (!summaryRows) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;数据库summary统计SQL未返回记录 | MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;))
        return
    }
    Map dbSummary = summaryRows[0]
    dbTotalForReport = valueOf(dbSummary, &apos;total&apos;)
    expectedRows = pageRows
    allDbRows = pageRows
    Map summaryExpected = [total: valueOf(dbSummary, &apos;total&apos;), total_orders: valueOf(dbSummary, &apos;total_orders&apos;), total_volume: valueOf(dbSummary, &apos;total_volume&apos;), cent_volume: valueOf(dbSummary, &apos;cent_volume&apos;), standard_volume: valueOf(dbSummary, &apos;standard_volume&apos;), total_fee: valueOf(dbSummary, &apos;total_fee&apos;), total_storage: valueOf(dbSummary, &apos;total_storage&apos;), total_profit: valueOf(dbSummary, &apos;total_profit&apos;)]
    Set strictSummaryVolumeFields = [&apos;total_volume&apos;, &apos;cent_volume&apos;, &apos;standard_volume&apos;] as Set
    Map summaryActual = [total: apiTotal, total_orders: apiSummary.total_orders, total_volume: apiSummary.total_volume, total_fee: apiSummary.total_fee, total_storage: apiSummary.total_storage, total_profit: apiSummary.total_profit]
    summaryExpected.each { f, expVal -&gt;
        def apiVal = summaryActual[f]
        def cr = compareValue(f.toString(), apiVal, expVal, &apos;DB&apos;, true)
        String line = &quot;summary | field=${f} | API=${cr.apiPrint} | DB=${cr.expPrint} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
} else {
    Map currentCsv = vars.getObject(&apos;history_positions_current_csv_row&apos;) instanceof Map ? vars.getObject(&apos;history_positions_current_csv_row&apos;) : [:]
    String csvId = idOf(currentCsv)
    Map apiRow = csvId ? apiItems.find { idOf(it) == csvId } : apiItems[0]
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;CSV订单号/仓位号和接口响应没有匹配上 | csvId=&apos; + csvId + &apos; | apiIds=&apos; + apiItems.collect { idOf(it) }.join(&apos;,&apos;))
        return
    }
    apiItems = [apiRow]
    expectedRows = [currentCsv]
}

if (dbMode) {
    if (apiItems.size() != expectedRows.size()) {
        failLines &lt;&lt; &quot; - [失败] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    } else {
        okLines &lt;&lt; &quot; - [通过] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    }
}

apiItems.eachWithIndex { Map apiRow, int idx -&gt;
    Map expectedRow = idx &lt; expectedRows.size() ? expectedRows[idx] : [:]
    String apiId = idOf(apiRow)
    String expectedId = idOf(expectedRow)
    String rowText = &apos;row=&apos; + (idx + 1 + offset) + &apos; | apiId=&apos; + apiId + &apos; | expectedId=&apos; + expectedId
    if (dbMode &amp;&amp; apiId &amp;&amp; expectedId &amp;&amp; apiId != expectedId) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | 接口和数据库数据记录没有匹配上&quot;
    }
    apiFieldTotal += apiRow.keySet().size()
    apiRow.keySet().each { rawField -&gt;
        String field = String.valueOf(rawField)
        Object apiVal = apiRow[rawField]
        if (skipAll || disabled.contains(normKey(field))) {
            def srcKey = findKey(expectedRow, field)
            Object srcVal = srcKey == null ? null : expectedRow[srcKey]
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=${srcKey == null ? &apos;&lt;empty&gt; &apos; + (dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段&apos;) : renderValue(field, srcVal, sourceName, dbMode)} | ${sourceName}Field=${srcKey ?: field} | reason=字段在跳过配置中&quot;
            return
        }
        def expKey = findKey(expectedRow, field)
        if (expKey == null || blank(expectedRow[expKey])) {
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=&lt;empty&gt; ${dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段或值为空&apos;} | ${sourceName}Field=${expKey ?: field}&quot;
            return
        }
        Object expVal = expectedRow[expKey]
        def cr = compareValue(field, apiVal, expVal, sourceName, dbMode)
        String line = &quot;${rowText} | field=${field} | API=${cr.apiPrint} | ${sourceName}=${cr.expPrint} | ${sourceName}Field=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

if (dbMode &amp;&amp; expectedRows.size() &gt; apiItems.size()) {
    expectedRows.drop(apiItems.size()).eachWithIndex { Map dbRow, int extraIdx -&gt;
        int rowNo = offset + apiItems.size() + extraIdx + 1
        failLines &lt;&lt; &quot; - [失败] | row=${rowNo} | API=&lt;empty&gt; 接口返回缺少该明细记录 | DB订单/仓位号=${idOf(dbRow)} | DB记录=${dbRow}&quot;
    }
}

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List report = []
report &lt;&lt; &apos;Assertion message: 查询多个账户的历史平仓仓位/已平仓订单 &apos; + modeText + &apos; 对比结果 | status=&apos; + status + &apos; | case=&apos; + vars.get(&apos;history_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;history_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;history_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku
report &lt;&lt; &apos;接口: POST /crm20/list_history_positions&apos;
report &lt;&lt; &apos;请求accounts: MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;)
report &lt;&lt; &apos;分页排序: page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort_by=&apos; + sortBy + &apos; | sort_order=&apos; + (desc ? &apos;desc&apos; : &apos;asc&apos;)
report &lt;&lt; &apos;跳过字段配置: &apos; + (dbMode ? &apos;history_positions_db_api_disabled_compare_fields&apos; : &apos;history_positions_csv_api_disabled_compare_fields&apos;) + &apos;=[&apos; + disabledRaw(dbMode) + &apos;]&apos;
report &lt;&lt; &apos;接口summary: total=&apos; + apiTotal + &apos; | summary=&apos; + apiSummary
if (dbMode) report &lt;&lt; &apos;DB汇总: total_orders=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | DB总记录数(summary SQL)=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | 当前页DB记录数(page SQL)=&apos; + expectedRows.size()
report &lt;&lt; &apos;接口字段总数=&apos; + apiFieldTotal + &apos; | 成功字段数量=&apos; + okLines.size() + &apos; | 失败字段数量=&apos; + failLines.size() + &apos; | 跳过字段数量=&apos; + skipLines.size()
report &lt;&lt; &apos;数值规则: 编号类字段精确比较；普通数值字段允许误差&lt;=5%；时间字段API按Asia/Shanghai展示后减8小时与DB比较，允许相差&lt;=60秒。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败明细】&apos;
report.addAll(failLines ? failLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细】&apos;
report.addAll(okLines ? okLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细（含DB/CSV数值）】&apos;
report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【接口请求Body】&apos;
report &lt;&lt; (vars.get(&apos;history_positions_request_body&apos;) ?: &apos;&apos;)

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)

def detail = new SampleResult()
detail.setSampleLabel(&apos;查询多个账户历史平仓字段对比结果&apos;)
detail.setSuccessful(failLines.isEmpty())
detail.setResponseCode(failLines.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(status)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
prev.addSubResult(detail)

if (!failLines.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">按API返回字段为基准；打印成功、失败、跳过字段明细；跳过字段同时打印API与DB/CSV值。</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="查询多个账户的历史平仓仓位/已平仓订单事务-手工验证" enabled="false">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户历史平仓" enabled="false">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的历史平仓仓位-数据库校验.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_deal_ticket,symbol,order_types,close_time_from_utc_ms,close_time_to_utc_ms,volume_lots_condition,volume_lots_value,floating_pl,sort_by,sort_order,reason,price_close,position_ticket,updated_utc_ms,fee,open_time_utc_ms,price_open,source,price_sl,commission,digits_currency,order_type,profit,volume_lots,side,swap,deal_ticket,price_tp,order_ticket,close_time_utc_ms,instance_id,net_profit,comment,digits,contract_size,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓DB/API字段对比配置" enabled="false">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓CSV/API字段对比配置" enabled="false">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户历史平仓参数" enabled="false">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的历史平仓仓位-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户历史平仓CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户历史平仓CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;history_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户历史平仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;history_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String login = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
    String platform = platformOf(instanceId)
    if (instanceId &amp;&amp; login &amp;&amp; platform) {
        String key = instanceId + &apos;|&apos; + login
        if (!accountKeys.contains(key)) {
            accountKeys &lt;&lt; key
            accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
        }
        if (platform == &apos;MT4&apos;) {
            mt4Logins &lt;&lt; login
            mt4LoginInstance[login] = instanceId
        } else if (platform == &apos;MT5&apos;) {
            mt5Logins &lt;&lt; login
            mt5LoginInstance[login] = instanceId
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户历史平仓没有可用accounts，CSV需要填写 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;close_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;symbol&apos;, &apos;filter_symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String closeFrom = cleanInt(firstValue(currentRow, [&apos;close_time_from_utc_ms&apos;, &apos;close_time_utc_ms__gte&apos;, &apos;close_time_from&apos;]))
String closeTo = cleanInt(firstValue(currentRow, [&apos;close_time_to_utc_ms&apos;, &apos;close_time_utc_ms__lte&apos;, &apos;close_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;volume_lots&apos;, &apos;volume&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (closeFrom) filters[&apos;close_time_from_utc_ms&apos;] = Long.parseLong(closeFrom)
if (closeTo) filters[&apos;close_time_to_utc_ms&apos;] = Long.parseLong(closeTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;history_positions_shujuku&apos;, shujuku)
vars.put(&apos;history_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;history_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;history_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;history_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;history_positions_request_body&apos;, requestBody)
vars.put(&apos;history_positions_page&apos;, page)
vars.put(&apos;history_positions_page_size&apos;, pageSize)
vars.put(&apos;history_positions_sort_by&apos;, sortBy)
vars.put(&apos;history_positions_sort_order&apos;, sortOrder)
vars.put(&apos;history_positions_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;history_positions_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;history_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_history_positions_summary_rows&apos;, [])
vars.putObject(&apos;db_history_positions_page_rows&apos;, [])

String closeMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.CLOSE_TIME) / 1000 AS UNSIGNED)&quot;
String openMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String closeMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, d.TimeMsc) / 1000 AS UNSIGNED)&quot;
String openMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, COALESCE(in_d.open_time_msc, d.TimeMsc)) / 1000 AS UNSIGNED)&quot;
String orderTypeSql = orderTypeList ? orderTypeList.join(&apos;,&apos;) : &apos;0,1&apos;
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + (mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;) + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.VOLUME &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.CLOSE_TIME IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;mt.CLOSE_TIME &lt;&gt; &apos;1970-01-01 00:00:00&apos;&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (filterDealTicket) mt4Where &lt;&lt; (filterDealTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;0 = &apos; + filterDealTicket)
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (closeFrom) mt4Where &lt;&lt; closeMsMt4 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt4Where &lt;&lt; closeMsMt4 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &lt; 0&apos;

List mt5Where = []
mt5Where &lt;&lt; &apos;d.Login IN (&apos; + (mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;) + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Action IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Entry IN (1, 3)&apos;
mt5Where &lt;&lt; &apos;d.VolumeExt &gt; 0&apos;
if (filterOrderTicket) mt5Where &lt;&lt; &apos;d.`Order` = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; &apos;d.PositionID = &apos; + filterPositionTicket
if (filterDealTicket) mt5Where &lt;&lt; &apos;d.Deal = &apos; + filterDealTicket
if (symbol) mt5Where &lt;&lt; &apos;d.Symbol = &apos; + sqlQuote(symbol)
if (closeFrom) mt5Where &lt;&lt; closeMsMt5 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt5Where &lt;&lt; closeMsMt5 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt5Where &lt;&lt; &apos;(d.VolumeExt / 100000000.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt5Where &lt;&lt; &apos;d.Profit &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt5Where &lt;&lt; &apos;d.Profit &lt; 0&apos;

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;d.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.TICKET AS position_ticket,
  0 AS deal_ticket,
  mt.SYMBOL AS symbol,
  mt.CMD AS order_type,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(mt.CMD AS CHAR) END AS side,
  mt.REASON AS reason,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS price_open,
  mt.CLOSE_PRICE AS price_close,
  mt.SL AS price_sl,
  mt.TP AS price_tp,
  mt.PROFIT AS profit,
  mt.SWAPS AS swap,
  mt.COMMISSION AS commission,
  0 AS fee,
  mt.PROFIT + mt.SWAPS + mt.COMMISSION AS net_profit,
  ${openMsMt4} AS open_time_utc_ms,
  ${closeMsMt4} AS close_time_utc_ms,
  ${closeMsMt4} AS updated_utc_ms,
  mt.DIGITS AS digits,
  mt.DIGITS AS digits_currency,
  0 AS contract_size,
  mt.COMMENT AS comment
FROM mt4_report.MT4_TRADES mt
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  d.Login AS login,
  &apos;mt5&apos; AS source,
  d.`Order` AS order_ticket,
  d.PositionID AS position_ticket,
  d.Deal AS deal_ticket,
  d.Symbol AS symbol,
  d.Action AS order_type,
  CASE d.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(d.Action AS CHAR) END AS side,
  d.Reason AS reason,
  d.VolumeExt / 100000000.0 AS volume_lots,
  COALESCE(in_d.open_price, d.PricePosition) AS price_open,
  d.Price AS price_close,
  d.PriceSL AS price_sl,
  d.PriceTP AS price_tp,
  d.Profit AS profit,
  d.Storage AS swap,
  d.Commission AS commission,
  d.Fee AS fee,
  d.Profit + d.Storage + d.Commission + d.Fee AS net_profit,
  ${openMsMt5} AS open_time_utc_ms,
  ${closeMsMt5} AS close_time_utc_ms,
  ${closeMsMt5} AS updated_utc_ms,
  d.Digits AS digits,
  d.DigitsCurrency AS digits_currency,
  d.ContractSize AS contract_size,
  d.Comment AS comment
FROM mt5_report.mt5_deals d
LEFT JOIN (
  SELECT
    Login,
    PositionID,
    Symbol,
    MIN(TimeMsc) AS open_time_msc,
    SUBSTRING_INDEX(GROUP_CONCAT(Price ORDER BY TimeMsc ASC, Deal ASC), &apos;,&apos;, 1) + 0 AS open_price
  FROM mt5_report.mt5_deals
  WHERE Entry = 0
    AND Action IN (0, 1)
  GROUP BY Login, PositionID, Symbol
) in_d
  ON in_d.Login = d.Login
 AND in_d.PositionID = d.PositionID
 AND in_d.Symbol = d.Symbol
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;close_time_utc_ms&apos;, &apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;close_time_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String historyRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(commission + fee), 0) AS total_fee,
  COALESCE(SUM(swap), 0) AS total_storage,
  COALESCE(SUM(profit), 0) AS total_profit
FROM (
${historyRowsSql}
) history_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  instance_id,
  login,
  source,
  order_ticket,
  position_ticket,
  deal_ticket,
  symbol,
  order_type,
  side,
  reason,
  volume_lots,
  price_open,
  price_close,
  price_sl,
  price_tp,
  profit,
  swap,
  commission,
  fee,
  net_profit,
  open_time_utc_ms,
  close_time_utc_ms,
  updated_utc_ms,
  digits,
  digits_currency,
  contract_size,
  comment
FROM (
${historyRowsSql}
) history_rows
ORDER BY ${sortColumn} ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\\r&apos;, &apos; &apos;).replace(&apos;\\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
vars.put(&apos;history_positions_summary_sql&apos;, summarySqlExec)
vars.put(&apos;history_positions_page_sql&apos;, pageSqlExec)

String initReport = &apos;list_history_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;init passed&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + &apos;\n\n【统计summary SQL（MT4+MT5合并，只查询一次，实际执行SQL）】\n&apos; + summarySqlExec + &apos;\n\n【当前页明细 SQL（MT4+MT5合并，实际执行SQL）】\n&apos; + pageSqlExec, &apos;UTF-8&apos;)</stringProp>
