              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode
import java.text.SimpleDateFormat

String responseText = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + responseText)
    return
}

def rowToMap
rowToMap = { row -&gt;
    Map out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else if (row != null) {
        try {
            row.metaClass.properties.each { p -&gt; if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot; }
        } catch (ignored) {}
    }
    out
}

def rowsFromObject = { obj -&gt;
    if (obj == null) return []
    if (obj instanceof List) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Object[]) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Map) return [rowToMap(obj)]
    []
}

def blank = { v -&gt; v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) }
def normKey = { Object v -&gt; (v == null ? &apos;&apos; : v.toString()).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase() }
def numeric = { v -&gt; !blank(v) &amp;&amp; String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;) ==~ /^-?\d+(\.\d+)?$/ }
def cleanNumText = { v -&gt;
    if (blank(v)) return &apos;&apos;
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+\.0+$/) return s.substring(0, s.indexOf(&apos;.&apos;))
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        try { return new BigDecimal(s).stripTrailingZeros().toPlainString() } catch (ignored) {}
    }
    s
}

Map aliases = [
    &apos;position_ticket&apos;: [&apos;position_ticket&apos;, &apos;position&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;order_ticket&apos;: [&apos;order_ticket&apos;, &apos;order&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;deal_ticket&apos;: [&apos;deal_ticket&apos;, &apos;deal&apos;, &apos;Deal&apos;, &apos;DEAL&apos;],
    &apos;instance_id&apos;: [&apos;instance_id&apos;, &apos;instanceid&apos;, &apos;instanceId&apos;, &apos;order_instanceid_val&apos;],
    &apos;login&apos;: [&apos;login&apos;, &apos;Login&apos;, &apos;LOGIN&apos;, &apos;order_login&apos;],
    &apos;source&apos;: [&apos;source&apos;, &apos;platform&apos;],
    &apos;symbol&apos;: [&apos;symbol&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;],
    &apos;order_type&apos;: [&apos;order_type&apos;, &apos;action&apos;, &apos;Action&apos;, &apos;CMD&apos;, &apos;cmd&apos;],
    &apos;side&apos;: [&apos;side&apos;],
    &apos;reason&apos;: [&apos;reason&apos;, &apos;Reason&apos;, &apos;REASON&apos;],
    &apos;volume_lots&apos;: [&apos;volume_lots&apos;, &apos;volume&apos;, &apos;Volume&apos;, &apos;VOLUME&apos;],
    &apos;price_open&apos;: [&apos;price_open&apos;, &apos;open_price&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;price_close&apos;: [&apos;price_close&apos;, &apos;close_price&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;price_sl&apos;: [&apos;price_sl&apos;, &apos;sl&apos;, &apos;SL&apos;, &apos;PriceSL&apos;],
    &apos;price_tp&apos;: [&apos;price_tp&apos;, &apos;tp&apos;, &apos;TP&apos;, &apos;PriceTP&apos;],
    &apos;profit&apos;: [&apos;profit&apos;, &apos;Profit&apos;, &apos;PROFIT&apos;],
    &apos;swap&apos;: [&apos;swap&apos;, &apos;Storage&apos;, &apos;SWAPS&apos;],
    &apos;commission&apos;: [&apos;commission&apos;, &apos;Commission&apos;, &apos;COMMISSION&apos;],
    &apos;fee&apos;: [&apos;fee&apos;, &apos;Fee&apos;],
    &apos;net_profit&apos;: [&apos;net_profit&apos;],
    &apos;open_time_utc_ms&apos;: [&apos;open_time_utc_ms&apos;, &apos;open_time&apos;, &apos;OPEN_TIME&apos;, &apos;TimeCreate&apos;, &apos;TimeMsc&apos;],
    &apos;close_time_utc_ms&apos;: [&apos;close_time_utc_ms&apos;, &apos;close_time&apos;, &apos;CLOSE_TIME&apos;, &apos;TimeMsc&apos;, &apos;Time&apos;],
    &apos;updated_utc_ms&apos;: [&apos;updated_utc_ms&apos;, &apos;time_update_utc_ms&apos;, &apos;MODIFY_TIME&apos;, &apos;TimeMsc&apos;],
    &apos;digits&apos;: [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;digits_currency&apos;: [&apos;digits_currency&apos;, &apos;DigitsCurrency&apos;],
    &apos;contract_size&apos;: [&apos;contract_size&apos;, &apos;ContractSize&apos;],
    &apos;comment&apos;: [&apos;comment&apos;, &apos;Comment&apos;, &apos;COMMENT&apos;]
]

def findKey
findKey = { Map m, String field -&gt;
    if (m == null) return null
    if (m.containsKey(field)) return field
    for (String a : (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    String want = normKey(field)
    m.keySet().find { normKey(it) == want }
}

def valueOf
valueOf = { Map m, String field -&gt;
    def k = findKey(m, field)
    k == null ? null : m[k]
}

def idOf = { Map row -&gt;
    for (String f : [&apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;deal_ticket&apos;]) {
        def v = valueOf(row, f)
        if (!blank(v)) return cleanNumText(v)
    }
    &apos;&apos;
}

def timeField = { String f -&gt;
    String n = (f ?: &apos;&apos;).toLowerCase()
    n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;) || n.contains(&apos;updated&apos;)
}

Date parseDateLike(v) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return null
    if (v instanceof java.util.Date) return v
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (String fmt : [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    sdf.format(d)
}

String normalizeApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String normalizeDbTime(v) {
    Date d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeCsvTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String displayApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

long secondDiff(String a, String b) {
    try {
        SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
        return Math.abs((sdf.parse(a).time - sdf.parse(b).time) / 1000L)
    } catch (ignored) { return Long.MAX_VALUE }
}

String renderValue(String field, Object v, String side, boolean dbMode) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&lt;empty&gt;&apos;
    if (!timeField(field)) return String.valueOf(v)
    if (side == &apos;API&apos; &amp;&amp; dbMode) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
    if (side == &apos;API&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值=&apos; + normalizeCsvTime(v)
    if (side == &apos;DB&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    return String.valueOf(v) + &apos; -&gt; &apos; + normalizeCsvTime(v)
}

def asNum = { Object v -&gt;
    if (blank(v)) return null
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

def fmtNum = { BigDecimal n -&gt; n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() }
def pctText = { BigDecimal p -&gt; p == null ? &apos;N/A&apos; : p.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos; }
Set exactNumericFields = [&apos;login&apos;, &apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;deal_ticket&apos;, &apos;reason&apos;, &apos;order_type&apos;, &apos;digits&apos;, &apos;digits_currency&apos;, &apos;total&apos;, &apos;total_orders&apos;] as Set

def compareValue = { String field, Object apiVal, Object expectedVal, String expectedSource, boolean dbMode -&gt;
    if (timeField(field)) {
        String aCmp = dbMode ? normalizeApiTime(apiVal) : normalizeCsvTime(apiVal)
        String eCmp = dbMode ? normalizeDbTime(expectedVal) : normalizeCsvTime(expectedVal)
        long diffSec = secondDiff(aCmp, eCmp)
        return [same: (aCmp == eCmp || diffSec &lt;= 60L), apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: diffSec + &apos;秒&apos;, percent: &apos;N/A(时间字段)&apos;, formula: &apos;时间字段按yyyy-MM-dd HH:mm:ss比较，允许相差&lt;=60秒&apos;]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactNumericFields.contains(field)) {
            return [same: cleanNumText(apiVal) == cleanNumText(expectedVal), apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: &apos;N/A(编号类字段精确比较)&apos;, formula: &apos;编号类字段不使用5%误差，按数值精确比较&apos;]
        }
        BigDecimal base = en.abs()
        BigDecimal allowed = base.multiply(new BigDecimal(&apos;0.05&apos;))
        if (allowed.compareTo(new BigDecimal(&apos;0.000001&apos;)) &lt; 0) allowed = new BigDecimal(&apos;0.000001&apos;)
        boolean same = diff.compareTo(allowed) &lt;= 0
        String pct
        String formula
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            pct = diff.compareTo(BigDecimal.ZERO) == 0 ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0无法作分母)&apos;
            formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;))=&apos; + fmtNum(diff) + &apos;，&apos; + expectedSource + &apos;=0，使用最小允许差值0.000001&apos;
        } else {
            BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
            pct = pctText(percent)
            formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) / abs(&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
        }
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: pct, formula: formula + &apos; | 允许误差&lt;=5%(允许差值=&apos; + fmtNum(allowed) + &apos;)&apos;]
    }
    boolean same = String.valueOf(apiVal ?: &apos;&apos;).trim() == String.valueOf(expectedVal ?: &apos;&apos;).trim()
    [same: same, apiPrint: String.valueOf(apiVal ?: &apos;&apos;), expPrint: String.valueOf(expectedVal ?: &apos;&apos;), diff: &apos;N/A&apos;, percent: &apos;N/A(非数值字段)&apos;, formula: &apos;非数值字段按字符串精确比较&apos;]
}

def compareComparable = { Object v -&gt;
    if (numeric(v)) return new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;))
    String.valueOf(v ?: &apos;&apos;)
}

def sumField = { List rows, String field -&gt;
    BigDecimal total = BigDecimal.ZERO
    rows.each { r -&gt;
        BigDecimal n = asNum(valueOf(r, field))
        if (n != null) total = total.add(n)
    }
    total
}

def disabledRaw = { boolean dbMode -&gt; dbMode ? (vars.get(&apos;history_positions_db_api_disabled_compare_fields&apos;) ?: &apos;&apos;) : (vars.get(&apos;history_positions_csv_api_disabled_compare_fields&apos;) ?: &apos;&apos;) }
def disabledSet = { String raw -&gt; raw.split(/[，,;|\s]+/).collect { normKey(it) }.findAll { it }.toSet() }

String shujuku = vars.get(&apos;history_positions_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
String sourceName = dbMode ? &apos;DB&apos; : &apos;CSV&apos;
String modeText = dbMode ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String sortBy = vars.get(&apos;history_positions_sort_by&apos;) ?: &apos;close_time_utc_ms&apos;
boolean desc = (vars.get(&apos;history_positions_sort_order&apos;) ?: &apos;desc&apos;).toLowerCase() != &apos;asc&apos;
int page = ((vars.get(&apos;history_positions_page&apos;) ?: &apos;1&apos;) as int)
int pageSize = ((vars.get(&apos;history_positions_page_size&apos;) ?: &apos;50&apos;) as int)
int offset = Math.max(page - 1, 0) * pageSize
Set disabled = disabledSet(disabledRaw(dbMode))
boolean skipAll = disabled.contains(&apos;*&apos;)

def data = parsed instanceof Map ? parsed.data : null
List apiItems = []
if (data instanceof Map &amp;&amp; data.items instanceof List) apiItems = data.items.collect { rowToMap(it) }
else if (data instanceof List) apiItems = data.collect { rowToMap(it) }
else if (parsed instanceof Map &amp;&amp; parsed.items instanceof List) apiItems = parsed.items.collect { rowToMap(it) }
if (!apiItems) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口没有返回data.items可对比记录 | response=&apos; + responseText)
    return
}
Map apiSummary = data instanceof Map &amp;&amp; data.summary instanceof Map ? rowToMap(data.summary) : [:]
Object apiTotal = data instanceof Map ? data.total : parsed.total

List okLines = []
List failLines = []
List skipLines = []
int apiFieldTotal = 0

List expectedRows = []
List allDbRows = []
Object dbTotalForReport = null
if (dbMode) {
    List summaryRows = rowsFromObject(vars.getObject(&apos;db_history_positions_summary_rows&apos;))
    List pageRows = rowsFromObject(vars.getObject(&apos;db_history_positions_page_rows&apos;))
    if (!summaryRows) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;数据库summary统计SQL未返回记录 | MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;))
        return
    }
    Map dbSummary = summaryRows[0]
    dbTotalForReport = valueOf(dbSummary, &apos;total&apos;)
    expectedRows = pageRows
    allDbRows = pageRows
    Map summaryExpected = [total: valueOf(dbSummary, &apos;total&apos;), total_orders: valueOf(dbSummary, &apos;total_orders&apos;), total_volume: valueOf(dbSummary, &apos;total_volume&apos;), total_fee: valueOf(dbSummary, &apos;total_fee&apos;), total_storage: valueOf(dbSummary, &apos;total_storage&apos;), total_profit: valueOf(dbSummary, &apos;total_profit&apos;)]
    Map summaryActual = [total: apiTotal, total_orders: apiSummary.total_orders, total_volume: apiSummary.total_volume, total_fee: apiSummary.total_fee, total_storage: apiSummary.total_storage, total_profit: apiSummary.total_profit]
    summaryExpected.each { f, expVal -&gt;
        def apiVal = summaryActual[f]
        def cr = compareValue(f.toString(), apiVal, expVal, &apos;DB&apos;, true)
        String line = &quot;summary | field=${f} | API=${cr.apiPrint} | DB=${cr.expPrint} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
} else {
    Map currentCsv = vars.getObject(&apos;history_positions_current_csv_row&apos;) instanceof Map ? vars.getObject(&apos;history_positions_current_csv_row&apos;) : [:]
    String csvId = idOf(currentCsv)
    Map apiRow = csvId ? apiItems.find { idOf(it) == csvId } : apiItems[0]
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;CSV订单号/仓位号和接口响应没有匹配上 | csvId=&apos; + csvId + &apos; | apiIds=&apos; + apiItems.collect { idOf(it) }.join(&apos;,&apos;))
        return
    }
    apiItems = [apiRow]
    expectedRows = [currentCsv]
}

if (dbMode) {
    if (apiItems.size() != expectedRows.size()) {
        failLines &lt;&lt; &quot; - [失败] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    } else {
        okLines &lt;&lt; &quot; - [通过] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    }
}

apiItems.eachWithIndex { Map apiRow, int idx -&gt;
    Map expectedRow = idx &lt; expectedRows.size() ? expectedRows[idx] : [:]
    String apiId = idOf(apiRow)
    String expectedId = idOf(expectedRow)
    String rowText = &apos;row=&apos; + (idx + 1 + offset) + &apos; | apiId=&apos; + apiId + &apos; | expectedId=&apos; + expectedId
    if (dbMode &amp;&amp; apiId &amp;&amp; expectedId &amp;&amp; apiId != expectedId) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | 接口和数据库数据记录没有匹配上&quot;
    }
    apiFieldTotal += apiRow.keySet().size()
    apiRow.keySet().each { rawField -&gt;
        String field = String.valueOf(rawField)
        Object apiVal = apiRow[rawField]
        if (skipAll || disabled.contains(normKey(field))) {
            def srcKey = findKey(expectedRow, field)
            Object srcVal = srcKey == null ? null : expectedRow[srcKey]
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=${srcKey == null ? &apos;&lt;empty&gt; &apos; + (dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段&apos;) : renderValue(field, srcVal, sourceName, dbMode)} | ${sourceName}Field=${srcKey ?: field} | reason=字段在跳过配置中&quot;
            return
        }
        def expKey = findKey(expectedRow, field)
        if (expKey == null || blank(expectedRow[expKey])) {
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=&lt;empty&gt; ${dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段或值为空&apos;} | ${sourceName}Field=${expKey ?: field}&quot;
            return
        }
        Object expVal = expectedRow[expKey]
        def cr = compareValue(field, apiVal, expVal, sourceName, dbMode)
        String line = &quot;${rowText} | field=${field} | API=${cr.apiPrint} | ${sourceName}=${cr.expPrint} | ${sourceName}Field=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

if (dbMode &amp;&amp; expectedRows.size() &gt; apiItems.size()) {
    expectedRows.drop(apiItems.size()).eachWithIndex { Map dbRow, int extraIdx -&gt;
        int rowNo = offset + apiItems.size() + extraIdx + 1
        failLines &lt;&lt; &quot; - [失败] | row=${rowNo} | API=&lt;empty&gt; 接口返回缺少该明细记录 | DB订单/仓位号=${idOf(dbRow)} | DB记录=${dbRow}&quot;
    }
}

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List report = []
report &lt;&lt; &apos;Assertion message: 查询多个账户的历史平仓仓位/已平仓订单 &apos; + modeText + &apos; 对比结果 | status=&apos; + status + &apos; | case=&apos; + vars.get(&apos;history_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;history_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;history_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku
report &lt;&lt; &apos;接口: POST /crm20/list_history_positions&apos;
report &lt;&lt; &apos;请求accounts: MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;)
report &lt;&lt; &apos;分页排序: page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort_by=&apos; + sortBy + &apos; | sort_order=&apos; + (desc ? &apos;desc&apos; : &apos;asc&apos;)
report &lt;&lt; &apos;跳过字段配置: &apos; + (dbMode ? &apos;history_positions_db_api_disabled_compare_fields&apos; : &apos;history_positions_csv_api_disabled_compare_fields&apos;) + &apos;=[&apos; + disabledRaw(dbMode) + &apos;]&apos;
report &lt;&lt; &apos;接口summary: total=&apos; + apiTotal + &apos; | summary=&apos; + apiSummary
if (dbMode) report &lt;&lt; &apos;DB汇总: total_orders=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | DB总记录数(summary SQL)=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | 当前页DB记录数(page SQL)=&apos; + expectedRows.size()
report &lt;&lt; &apos;接口字段总数=&apos; + apiFieldTotal + &apos; | 成功字段数量=&apos; + okLines.size() + &apos; | 失败字段数量=&apos; + failLines.size() + &apos; | 跳过字段数量=&apos; + skipLines.size()
report &lt;&lt; &apos;数值规则: 编号类字段精确比较；普通数值字段允许误差&lt;=5%；时间字段API按Asia/Shanghai展示后减8小时与DB比较，允许相差&lt;=60秒。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败明细】&apos;
report.addAll(failLines ? failLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细】&apos;
report.addAll(okLines ? okLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细（含DB/CSV数值）】&apos;
report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【接口请求Body】&apos;
report &lt;&lt; (vars.get(&apos;history_positions_request_body&apos;) ?: &apos;&apos;)

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)

def detail = new SampleResult()
detail.setSampleLabel(&apos;查询多个账户历史平仓字段对比结果&apos;)
detail.setSuccessful(failLines.isEmpty())
detail.setResponseCode(failLines.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(status)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
prev.addSubResult(detail)

if (!failLines.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">按API返回字段为基准；打印成功、失败、跳过字段明细；跳过字段同时打印API与DB/CSV值。</stringProp>
            </JSR223Assertion>
