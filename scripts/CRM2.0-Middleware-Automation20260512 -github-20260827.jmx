      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1获取挂单订单-数据库校验✅✅" enabled="true">
        <stringProp name="TestPlan.comments">新增挂单订单数据库校验：shujuku=1时DB/API对比，shujuku=0时CSV/API对比。

-备注重要：20260618
1. DB/API跳过字段使用 pending_order_db_api_disabled_compare_fields；CSV/API跳过字段使用 pending_order_csv_api_disabled_compare_fields。
2. DB/API对比 currentPrice 时打印误差百分比，误差5%以内计入成功字段。
3. 挂单 closePrice、closeTime、profit、swap 的API值为0时计入成功字段，并打印DB值和原因。
4. 报告最上面和每条明细都会打印订单类型。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="挂单订单数据库校验循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;获取挂单订单-数据库校验.csv&apos;); if (!f.exists()) { return 0 }; def rows = f.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }; rows.size() &lt;= 1 ? 0 : rows.size() - 1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="1获取挂单订单-数据库校验事务-${__P(CRM2.0middlewareip_file_version,)}" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-获取挂单订单数据库校验" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./获取挂单订单-数据库校验.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,order_instanceid_val,order_login,orderId,orderType,symbol,swap,currentPrice,openPrice,login,volume,closeTime,sl,closePrice,position,openTime,tp,profit</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="挂单订单DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="pending_order_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">pending_order_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制DB/API对比的跳过字段，多个字段用逗号分隔；例如填写 volume_current,currentPrice 后DB/API不校验这些字段；填 * 表示只校验订单号匹配。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="挂单订单CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="pending_order_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">pending_order_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">currentPrice</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制CSV/API对比的跳过字段，多个字段用逗号分隔；例如填写 volume_current,currentPrice 后CSV/API不校验这些字段；填 * 表示只校验订单号匹配。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化挂单订单数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;获取挂单订单-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;挂单订单CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;挂单订单CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;挂单订单 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;挂单订单 order_instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;挂单订单 order_login/login不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;挂单订单 order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

vars.put(&apos;pending_check_shujuku&apos;, shujuku)
vars.put(&apos;pending_check_login&apos;, login)
vars.put(&apos;pending_check_instanceid&apos;, instanceId)
vars.put(&apos;pending_check_db_platform&apos;, platform)
vars.put(&apos;order_login&apos;, login)
vars.put(&apos;order_instanceid_val&apos;, instanceId)
vars.putObject(&apos;db_pending_check_rows&apos;, [])
log.info(&apos;pending order init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT4-查询挂单数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;pending_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;pending_check_db_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4挂单-${pending_check_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
