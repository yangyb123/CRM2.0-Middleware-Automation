              <stringProp name="query">SELECT * FROM (
SELECT &apos;position&apos; AS order_type_name, &apos;mt5_positions&apos; AS source_table, mt.Position AS `Order`, mt.Position AS `Position`, mt.Position_ID AS `Position_ID`, mt.Login, mt.Symbol, mt.Action AS `Type`, NULL AS TypeFill, NULL AS TypeTime, NULL AS State, mt.Reason, mt.TimeCreate AS TimeSetup, mt.TimeUpdate AS TimeDone, NULL AS TimeExpiration, mt.TimeCreateMsc AS TimeSetupMsc, mt.TimeUpdateMsc AS TimeDoneMsc, mt.Digits, mt.DigitsCurrency, mt.ContractSize, mt.PriceOpen AS PriceOrder, NULL AS PriceTrigger, mt.PriceCurrent, mt.PriceSL, mt.PriceTP, mt.Volume AS VolumeInitial, mt.Volume AS VolumeCurrent, mt.VolumeExt AS VolumeInitialExt, mt.VolumeExt AS VolumeCurrentExt, mt.ExpertID, mt.Position AS PositionID, NULL AS PositionByID, mt.RateMargin, mt.Comment, mt.ActivationMode, mt.ActivationTime, mt.ActivationPrice, mt.ActivationFlags, mt.Profit, mt.Storage, mt.RateProfit, mt.ExternalID, mt.Dealer, mt.ApiData, mt.Timestamp, mt.TimeUpdateMsc AS sort_time FROM mt5_report.mt5_positions mt WHERE mt.Login = ?
UNION ALL
SELECT CASE WHEN mt.Type IN (2,3,4,5,6,7) THEN &apos;pending_order&apos; ELSE &apos;current_order&apos; END AS order_type_name, &apos;mt5_orders&apos; AS source_table, mt.`Order`, NULL AS `Position`, NULL AS `Position_ID`, mt.Login, mt.Symbol, mt.Type, mt.TypeFill, mt.TypeTime, mt.State, mt.Reason, mt.TimeSetup, mt.TimeDone, mt.TimeExpiration, mt.TimeSetupMsc, mt.TimeDoneMsc, mt.Digits, mt.DigitsCurrency, mt.ContractSize, mt.PriceOrder, mt.PriceTrigger, mt.PriceCurrent, mt.PriceSL, mt.PriceTP, mt.VolumeInitial, mt.VolumeCurrent, mt.VolumeInitialExt, mt.VolumeCurrentExt, mt.ExpertID, mt.PositionID, mt.PositionByID, mt.RateMargin, mt.Comment, mt.ActivationMode, mt.ActivationTime, mt.ActivationPrice, mt.ActivationFlags, NULL AS Profit, NULL AS Storage, NULL AS RateProfit, mt.ExternalID, mt.Dealer, mt.ApiData, mt.Timestamp, mt.TimeSetupMsc AS sort_time FROM mt5_report.mt5_orders mt WHERE mt.Login = ?
UNION ALL
SELECT CASE WHEN mt.TimeDone &gt; &apos;1970-01-02 00:00:00&apos; THEN &apos;closed_history&apos; ELSE &apos;history_order&apos; END AS order_type_name, &apos;mt5_orders_history&apos; AS source_table, mt.`Order`, NULL AS `Position`, NULL AS `Position_ID`, mt.Login, mt.Symbol, mt.Type, mt.TypeFill, mt.TypeTime, mt.State, mt.Reason, mt.TimeSetup, mt.TimeDone, mt.TimeExpiration, mt.TimeSetupMsc, mt.TimeDoneMsc, mt.Digits, mt.DigitsCurrency, mt.ContractSize, mt.PriceOrder, mt.PriceTrigger, mt.PriceCurrent, mt.PriceSL, mt.PriceTP, mt.VolumeInitial, mt.VolumeCurrent, mt.VolumeInitialExt, mt.VolumeCurrentExt, mt.ExpertID, mt.PositionID, mt.PositionByID, mt.RateMargin, mt.Comment, mt.ActivationMode, mt.ActivationTime, mt.ActivationPrice, mt.ActivationFlags, NULL AS Profit, NULL AS Storage, NULL AS RateProfit, mt.ExternalID, mt.Dealer, mt.ApiData, mt.Timestamp, mt.TimeSetupMsc AS sort_time FROM mt5_report.mt5_orders_history mt WHERE mt.Login = ?
) all_orders ORDER BY sort_time DESC, `Order` DESC</stringProp>
