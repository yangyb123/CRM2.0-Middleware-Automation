                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

// ===== 根据 deal_type 自判定比较字段（不依赖预处理器，避免BeanShell !=问题） =====
String dealType = vars.get(&quot;deal_type&quot;)
String assertField = &quot;&quot;
if (&quot;2&quot;.equals(dealType) || &quot;6&quot;.equals(dealType)) {
    assertField = &quot;balance&quot;
} else if (&quot;3&quot;.equals(dealType) || &quot;7&quot;.equals(dealType)) {
    assertField = &quot;credit&quot;
}

String apiValue = vars.get(&quot;resp_&quot; + assertField)
String dbValue  = vars.get(&quot;db_&quot; + assertField + &quot;_1&quot;)

log.info(&quot;&gt;&gt;&gt; 余额比对：deal_type=[&quot; + dealType + &quot;] 字段=[&quot; + assertField + &quot;] API=[&quot; + apiValue + &quot;] DB=[&quot; + dbValue + &quot;]&quot;)

// ===== 检查数据库变量是否存在 =====
if (dbValue == null) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;数据库变量 [db_&quot; + assertField + &quot;_1] 不存在，查询可能无结果&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

// ===== 数值比对 =====
def EPSILON = 1e-9
try {
    def apiNum = apiValue.toDouble()
    def dbNum  = dbValue.toDouble()
    if (Math.abs(apiNum - dbNum) &gt; EPSILON) {
        def result = new AssertionResult()
        result.setFailure(true)
        result.setFailureMessage(&quot;字段 [&quot; + assertField + &quot;] 不一致：API=[&quot; + apiValue + &quot;] DB=[&quot; + dbValue + &quot;] 差值=[&quot; + String.format(&quot;%.2f&quot;, Math.abs(apiNum - dbNum)) + &quot;]&quot;)
        prev.setSuccessful(false)
        prev.addAssertionResult(result)
    } else {
        log.info(&quot;&gt;&gt;&gt; 余额比对通过：&quot; + assertField + &quot; API=[&quot; + apiValue + &quot;] = DB=[&quot; + dbValue + &quot;]&quot;)
    }
} catch (Exception e) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;字段 [&quot; + assertField + &quot;] 数值转换失败：API=[&quot; + apiValue + &quot;] DB=[&quot; + dbValue + &quot;] 错误=&quot; + e.message)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
}
</stringProp>
