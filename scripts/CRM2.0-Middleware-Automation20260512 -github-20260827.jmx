        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-创建账户重置密码-充值-查询账号-获取持仓订单-历史订单" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./创建账户重置密码-充值-查询账号-获取持仓订单-历史订单-列格式.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">备注,user_name,group,login,instanceid,deal_type,email,leverage</stringProp>
          </CSVDataSet>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化CSV账号参数-创建账户重置密码充值查询账号持仓历史订单" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.nio.ByteBuffer
import java.nio.charset.Charset
import java.nio.charset.CharsetDecoder
import java.nio.charset.CodingErrorAction
import java.nio.charset.StandardCharsets

String csvName = &apos;\u521b\u5efa\u8d26\u6237\u91cd\u7f6e\u5bc6\u7801-\u5145\u503c-\u67e5\u8be2\u8d26\u53f7-\u83b7\u53d6\u6301\u4ed3\u8ba2\u5355-\u5386\u53f2\u8ba2\u5355-\u5217\u683c\u5f0f.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)

String decodeCsv(byte[] bytes) {
    CharsetDecoder decoder = StandardCharsets.UTF_8.newDecoder()
    decoder.onMalformedInput(CodingErrorAction.REPORT)
    decoder.onUnmappableCharacter(CodingErrorAction.REPORT)
    try {
        return decoder.decode(ByteBuffer.wrap(bytes)).toString()
    } catch (Exception ignored) {
        return new String(bytes, Charset.forName(&apos;GBK&apos;))
    }
}

List parseCsvLine(String line) {
    List values = []
    StringBuilder sb = new StringBuilder()
    boolean quoted = false
    for (int i = 0; i &lt; line.length(); i++) {
        char ch = line.charAt(i)
        if (ch == &apos;&quot;&apos;) {
            if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == &apos;&quot;&apos;) {
                sb.append(&apos;&quot;&apos;)
                i++
            } else {
                quoted = !quoted
            }
        } else if (ch == &apos;,&apos; &amp;&amp; !quoted) {
            values.add(sb.toString())
            sb.setLength(0)
        } else {
            sb.append(ch)
        }
    }
    values.add(sb.toString())
    return values
}

if (csvFile.exists()) {
    String csvText = decodeCsv(java.nio.file.Files.readAllBytes(csvFile.toPath()))
    List rows = csvText.readLines().findAll { it?.trim() }
    int rowIndex = (vars.get(&apos;create_user_csv_row_index&apos;) ?: &apos;0&apos;) as int
    if (rows.size() &gt; 1) {
        List headers = parseCsvLine(rows[0])
        List values = parseCsvLine(rows[Math.min(rowIndex + 1, rows.size() - 1)])
        headers.eachWithIndex { header, i -&gt;
            vars.put(header, i &lt; values.size() ? values[i] : &apos;&apos;)
        }
        vars.put(&apos;create_user_csv_row_index&apos;, String.valueOf(rowIndex + 1))
    }
}

String marker = &apos;$&apos; + &apos;{__time(yyyy-MM-dd-HH:mm:ss.SSS)}&apos;
String userName = vars.get(&apos;user_name&apos;) ?: &apos;&apos;
if (userName.contains(marker)) {
    String now = new java.text.SimpleDateFormat(&apos;yyyy-MM-dd-HH:mm:ss.SSS&apos;).format(new Date())
    userName = userName.replace(marker, now)
}
vars.put(&apos;user_name&apos;, userName)
vars.put(&apos;create_user_comment&apos;, &apos;comment-&apos; + userName)
log.info(&apos;create user csv params: remark=&apos; + vars.get(&apos;\u5907\u6ce8&apos;) + &apos; | user_name=&apos; + userName + &apos; | instanceid=&apos; + vars.get(&apos;instanceid&apos;) + &apos; | login=&apos; + vars.get(&apos;login&apos;) + &apos; | group=&apos; + vars.get(&apos;group&apos;))</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
