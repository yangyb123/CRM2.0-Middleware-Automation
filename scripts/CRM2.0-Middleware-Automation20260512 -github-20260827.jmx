          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="校验equity差值与历史平仓profit合计" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.math.BigDecimal
import org.apache.jmeter.samplers.SampleResult

def parseDecimal = { Object value, String label -&gt;
    String raw = value == null ? &apos;&apos; : String.valueOf(value).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!raw || !(raw ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) throw new AssertionError(label + &apos;不是有效数值，实际=[&apos; + raw + &apos;]&apos;)
    new BigDecimal(raw)
}
String responseText = prev.getResponseDataAsString()
def responseJson
try { responseJson = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;) } catch (Throwable ex) { throw new AssertionError(&apos;list_history_positions响应不是合法JSON: &apos; + ex.message) }
if (!(responseJson instanceof Map) || parseDecimal(responseJson.code, &apos;code&apos;).compareTo(BigDecimal.ZERO) != 0 || String.valueOf(responseJson.msg ?: &apos;&apos;) != &apos;ok&apos;) throw new AssertionError(&apos;list_history_positions业务失败: code=&apos; + responseJson.code + &apos;, msg=&apos; + responseJson.msg)
List items = responseJson.data instanceof Map &amp;&amp; responseJson.data.items instanceof List ? responseJson.data.items : []
if (items.isEmpty()) throw new AssertionError(&apos;list_history_positions响应data.items[]为空，不允许cale_user_info_profit=0与history_positions_profit=0产生假通过&apos;)
BigDecimal historyPositionsProfit = BigDecimal.ZERO
List&lt;String&gt; itemLines = []
items.eachWithIndex { Object rawItem, int index -&gt;
    if (!(rawItem instanceof Map)) throw new AssertionError(&apos;data.items[&apos; + index + &apos;]不是对象&apos;)
    Map item = (Map) rawItem
    BigDecimal itemProfit = parseDecimal(item.profit, &apos;data.items[&apos; + index + &apos;].profit&apos;)
    historyPositionsProfit = historyPositionsProfit.add(itemProfit)
    itemLines &lt;&lt; &apos;item[&apos; + index + &apos;] | order_ticket=&apos; + item.order_ticket + &apos; | position_ticket=&apos; + item.position_ticket + &apos; | symbol=&apos; + item.symbol + &apos; | currency=&apos; + item.currency + &apos; | profit=&apos; + itemProfit.toPlainString()
}
BigDecimal calculatedUserInfoProfit = parseDecimal(vars.get(&apos;cale_user_info_profit&apos;), &apos;cale_user_info_profit&apos;)
vars.put(&apos;history_positions_profit&apos;, historyPositionsProfit.stripTrailingZeros().toPlainString())
boolean same = calculatedUserInfoProfit.compareTo(historyPositionsProfit) == 0
String sumExpression = items ? items.collect { String.valueOf(((Map)it).profit) }.join(&apos; + &apos;) : &apos;0&apos;
List&lt;String&gt; report = []
report &lt;&lt; &apos;Assertion message: cale_user_info_profit 与 history_positions_profit 对比 | status=&apos; + (same ? &apos;PASS&apos; : &apos;FAIL&apos;)
report &lt;&lt; &apos;接口: POST /crm20/list_history_positions | 文档: mt-hub-openapi 7.html&apos;
report &lt;&lt; &apos;账户: instanceid=&apos; + vars.get(&apos;instanceid&apos;) + &apos; | login=&apos; + vars.get(&apos;login&apos;) + &apos; | close_time_from_utc_ms=&apos; + vars.get(&apos;close_time_from_utc_ms&apos;) + &apos; | close_time_to_utc_ms=&apos; + vars.get(&apos;close_time_to_utc_ms&apos;)
report &lt;&lt; &apos;权益差公式: cale_user_info_profit = equityBB - equityAA = &apos; + vars.get(&apos;equityBB&apos;) + &apos; - &apos; + vars.get(&apos;equityAA&apos;) + &apos; = &apos; + calculatedUserInfoProfit.toPlainString()
report &lt;&lt; &apos;历史盈亏公式: history_positions_profit = SUM(data.items[].profit) = &apos; + sumExpression + &apos; = &apos; + historyPositionsProfit.toPlainString() + &apos; | items数量=&apos; + items.size()
report &lt;&lt; &apos;比较公式: cale_user_info_profit(&apos; + calculatedUserInfoProfit.toPlainString() + &apos;) == history_positions_profit(&apos; + historyPositionsProfit.toPlainString() + &apos;) =&gt; &apos; + (same ? &apos;相等，通过&apos; : &apos;不相等，失败&apos;)
report &lt;&lt; &apos;金额口径: equity和items[].profit均为账户原生币种；不使用USD口径profit_reporting。&apos;
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【订单profit明细】&apos;;report.addAll(itemLines ?: [&apos; - 无匹配历史平仓订单&apos;])
String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)
vars.put(&apos;user_info_profit_compare_report&apos;, finalReport)
vars.put(&apos;user_info_profit_compare_status&apos;, same ? &apos;PASS&apos; : &apos;FAIL&apos;)
def detail = new SampleResult();detail.setSampleLabel(&apos;02-equity差值与history_positions_profit比较结果&apos;);detail.setSuccessful(same);detail.setResponseCode(same ? &apos;200&apos; : &apos;500&apos;);detail.setResponseMessage(same ? &apos;PASS&apos; : &apos;FAIL&apos;);detail.setResponseData(finalReport, &apos;UTF-8&apos;);detail.setDataType(SampleResult.TEXT);detail.setContentType(&apos;text/plain; charset=UTF-8&apos;);long now=System.currentTimeMillis();detail.setStartTime(now);detail.setEndTime(now);prev.addSubResult(detail)
AssertionResult.setFailure(!same);AssertionResult.setFailureMessage(finalReport)</stringProp>
