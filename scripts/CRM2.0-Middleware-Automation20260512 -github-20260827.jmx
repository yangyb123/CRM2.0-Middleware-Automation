          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="根据MT类型获取对应的MT账号 原版" enabled="false">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">String countStr = vars.get(&quot;loop_count_用户信息&quot;);
int count = (countStr == null) ? 0 : Integer.parseInt(countStr);

// 判断当前使用 MT4 还是 MT5
if (count % 2 == 0) {
    // 偶数轮 -&gt; MT5（0/2=0→51, 2/2=1→52）
    int mt5Idx = count / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;userSearchValue5&quot; + (mt5Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    // 奇数轮 -&gt; MT4（1-1/2=0→41, 3-1/2=1→42）
    int mt4Idx = (count - 1) / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;userSearchValue4&quot; + (mt4Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

// 更新循环计数器
vars.put(&quot;loop_count_用户信息&quot;, String.valueOf(count + 1));
</stringProp>
          </BeanShellPreProcessor>
          <hashTree/>
          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="根据MT类型获取对应的MT账号" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">String countStr = vars.get(&quot;loop_count_用户信息&quot;);
int count = (countStr == null) ? 0 : Integer.parseInt(countStr);

// 首次迭代时从CSV读取账号并去重
String csvLoaded = vars.get(&quot;user_csv_logins_loaded&quot;);
if (csvLoaded == null || !csvLoaded.equals(&quot;true&quot;)) {
    String baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir();

    // 读取MT5账号（Login列去重）
    java.util.Set mt5Logins = new java.util.LinkedHashSet();
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(baseDir + &quot;/MT5_get_user_info.csv&quot;), &quot;UTF-8&quot;));
        String header = br.readLine();
        if (header != null &amp;&amp; header.startsWith(&quot;\uFEFF&quot;)) header = header.substring(1);
        String[] headers = header.split(&quot;,&quot;);
        int loginIdx = -1;
        for (int i = 0; i &lt; headers.length; i++) {
            if (headers[i].trim().equalsIgnoreCase(&quot;Login&quot;)) { loginIdx = i; break; }
        }
        if (loginIdx &gt;= 0) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] parts = line.split(&quot;,&quot;, -1);
                if (loginIdx &lt; parts.length &amp;&amp; !parts[loginIdx].trim().isEmpty()) {
                    mt5Logins.add(parts[loginIdx].trim());
                }
            }
        }
        br.close();
    } catch (Exception e) {
        log.warn(&quot;读取MT5用户信息CSV失败: &quot; + e.getMessage());
    }

    // 读取MT4账号（login列去重）
    java.util.Set mt4Logins = new java.util.LinkedHashSet();
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(baseDir + &quot;/MT4_get_user_info.csv&quot;), &quot;UTF-8&quot;));
        String header = br.readLine();
        if (header != null &amp;&amp; header.startsWith(&quot;\uFEFF&quot;)) header = header.substring(1);
        String[] headers = header.split(&quot;,&quot;);
        int loginIdx = -1;
        for (int i = 0; i &lt; headers.length; i++) {
            if (headers[i].trim().equalsIgnoreCase(&quot;login&quot;)) { loginIdx = i; break; }
        }
        if (loginIdx &gt;= 0) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] parts = line.split(&quot;,&quot;, -1);
                if (loginIdx &lt; parts.length &amp;&amp; !parts[loginIdx].trim().isEmpty()) {
                    mt4Logins.add(parts[loginIdx].trim());
                }
            }
        }
        br.close();
    } catch (Exception e) {
        log.warn(&quot;读取MT4用户信息CSV失败: &quot; + e.getMessage());
    }

    java.util.List mt5List = new java.util.ArrayList(mt5Logins);
    java.util.List mt4List = new java.util.ArrayList(mt4Logins);

    vars.put(&quot;login51&quot;, mt5List.size() &gt; 0 ? mt5List.get(0) : &quot;&quot;);
    vars.put(&quot;login52&quot;, mt5List.size() &gt; 1 ? mt5List.get(1) : &quot;&quot;);
    vars.put(&quot;login41&quot;, mt4List.size() &gt; 0 ? mt4List.get(0) : &quot;&quot;);
    vars.put(&quot;login42&quot;, mt4List.size() &gt; 1 ? mt4List.get(1) : &quot;&quot;);

    vars.put(&quot;user_csv_logins_loaded&quot;, &quot;true&quot;);
}

// 判断当前使用 MT4 还是 MT5
if (count % 2 == 0) {
    // 偶数轮 -&gt; MT5（0/2=0→51, 2/2=1→52）
    int mt5Idx = count / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;login5&quot; + (mt5Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    // 奇数轮 -&gt; MT4（1-1/2=0→41, 3-1/2=1→42）
    int mt4Idx = (count - 1) / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;login4&quot; + (mt4Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

// 更新循环计数器
vars.put(&quot;loop_count_用户信息&quot;, String.valueOf(count + 1));
</stringProp>
          </BeanShellPreProcessor>
