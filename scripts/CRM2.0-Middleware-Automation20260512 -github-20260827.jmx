            <hashTree>
              <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="根据MT类型获取对应的MT账号" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">String countStr = vars.get(&quot;loop_count_获取历史&quot;);
int count = (countStr == null) ? 0 : Integer.parseInt(countStr);

// 首次迭代时从CSV读取账号并去重
String csvLoaded = vars.get(&quot;history_csv_logins_loaded&quot;);
if (csvLoaded == null || !csvLoaded.equals(&quot;true&quot;)) {
    String baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir();

    // 读取MT5账号（Login列去重）
    java.util.Set mt5Logins = new java.util.LinkedHashSet();
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(baseDir + &quot;/MT5_get_history_position.csv&quot;), &quot;UTF-8&quot;));
        String header = br.readLine();
        if (header != null &amp;&amp; header.startsWith(&quot;\uFEFF&quot;)) header = header.substring(1);
        String[] headers = header.split(&quot;,&quot;);
        int loginIdx = -1;
        for (int i = 0; i &lt; headers.length; i++) {
            if (headers[i].trim().equalsIgnoreCase(&quot;Login&quot;)) { loginIdx = i; break; }
        }
        if (loginIdx &gt;= 0) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] parts = line.split(&quot;,&quot;, -1);
                if (loginIdx &lt; parts.length &amp;&amp; !parts[loginIdx].trim().isEmpty()) {
                    mt5Logins.add(parts[loginIdx].trim());
                }
            }
        }
        br.close();
    } catch (Exception e) {
        log.warn(&quot;读取MT5历史订单CSV失败: &quot; + e.getMessage());
    }

    // 读取MT4账号（login列去重）
    java.util.Set mt4Logins = new java.util.LinkedHashSet();
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(baseDir + &quot;/MT4_get_history_position.csv&quot;), &quot;UTF-8&quot;));
        String header = br.readLine();
        if (header != null &amp;&amp; header.startsWith(&quot;\uFEFF&quot;)) header = header.substring(1);
        String[] headers = header.split(&quot;,&quot;);
        int loginIdx = -1;
        for (int i = 0; i &lt; headers.length; i++) {
            if (headers[i].trim().equalsIgnoreCase(&quot;login&quot;)) { loginIdx = i; break; }
        }
        if (loginIdx &gt;= 0) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] parts = line.split(&quot;,&quot;, -1);
                if (loginIdx &lt; parts.length &amp;&amp; !parts[loginIdx].trim().isEmpty()) {
                    mt4Logins.add(parts[loginIdx].trim());
                }
            }
        }
        br.close();
    } catch (Exception e) {
        log.warn(&quot;读取MT4历史订单CSV失败: &quot; + e.getMessage());
    }

    java.util.List mt5List = new java.util.ArrayList(mt5Logins);
    java.util.List mt4List = new java.util.ArrayList(mt4Logins);

    vars.put(&quot;login51&quot;, mt5List.size() &gt; 0 ? mt5List.get(0) : &quot;&quot;);
    vars.put(&quot;login52&quot;, mt5List.size() &gt; 1 ? mt5List.get(1) : &quot;&quot;);
    vars.put(&quot;login41&quot;, mt4List.size() &gt; 0 ? mt4List.get(0) : &quot;&quot;);
    vars.put(&quot;login42&quot;, mt4List.size() &gt; 1 ? mt4List.get(1) : &quot;&quot;);

    vars.put(&quot;history_csv_logins_loaded&quot;, &quot;true&quot;);
}

// 判断当前使用 MT4 还是 MT5
if (count % 2 == 0) {
    // 偶数轮 -&gt; MT5（0/2=0→51, 2/2=1→52）
    int mt5Idx = count / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;login5&quot; + (mt5Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    // 奇数轮 -&gt; MT4（1-1/2=0→41, 3-1/2=1→42）
    int mt4Idx = (count - 1) / 2;
    vars.put(&quot;login_val&quot;, vars.get(&quot;login4&quot; + (mt4Idx + 1)));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

// 更新循环计数器
vars.put(&quot;loop_count_获取历史&quot;, String.valueOf(count + 1));
</stringProp>
              </BeanShellPreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言 ${login_val} 不区分大小写" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def expectedLogin = vars.get(&quot;login_val&quot;)

def allMatch = json.data.every { item -&gt;

    // 忽略字段名大小写
    def actualLogin = item.find { k, v -&gt;
        k.equalsIgnoreCase(&quot;login&quot;)
    }?.value

    actualLogin?.toString() == expectedLogin
}

if (!allMatch) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;存在 login 字段值不等于 ${expectedLogin} 的数据&quot;)
}</stringProp>
              </JSR223Assertion>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取data中第一个订单" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.threads.JMeterVariables

// ========== 配置区 ==========
// 变量名前缀，设为 &quot;&quot; 则不加前缀；设为 &quot;data_&quot; 则变量名为 data_Action、data_Symbol 等
def prefix = &quot;&quot;
// =============================

try {
    // 1. 获取响应数据
    def response = prev.getResponseDataAsString()
    if (response == null || response.trim().isEmpty()) {
        log.error(&quot;响应数据为空，无法解析 JSON&quot;)
        return
    }

    // ★ 保存完整API响应到JMeter变量，供后续断定（CSV匹配等）使用
    // 断定在JDBCSampler下，无法通过prev读取HTTP响应，必须在此处保存
    vars.put(&quot;history_api_response&quot;, response)
    log.info(&quot;已保存完整API响应到变量 history_api_response，长度: {}&quot;, response.length())

    // 2. 解析 JSON
    def json = new JsonSlurper().parseText(response)

    // 3. 判断 data 是否存在且为非空数组
    if (json.data == null) {
        log.error(&quot;JSON 中不存在 data 字段&quot;)
        return
    }

    if (!(json.data instanceof List)) {
        log.error(&quot;data 不是数组类型，实际类型：&quot; + json.data.getClass().getSimpleName())
        return
    }

    if (json.data.size() == 0) {
        log.warn(&quot;data 数组为空，无数据可提取&quot;)
        return
    }

    // 4. 取 data[0]
    def firstData = json.data[0]
    if (firstData == null) {
        log.error(&quot;data[0] 为 null&quot;)
        return
    }

    // 5. 遍历所有字段，写入 JMeter 变量
    firstData.each { key, value -&gt;
        def varName = prefix + key
        def varValue = value?.toString() ?: &quot;&quot;
        vars.put(varName, varValue)
        log.info(&quot;提取变量：{} = {}&quot;, varName, varValue)
    }

    log.info(&quot;成功提取 data[0] 共 {} 个字段&quot;, firstData.size())

    // 记录所有提取的字段名，供断言中检测未比对字段
    def extractedNames = firstData.keySet().collect { it.toString() }
    vars.put(&quot;extracted_history_fields&quot;, extractedNames.join(&quot;,&quot;))
    log.info(&quot;提取的字段列表：{}&quot;, extractedNames)

} catch (groovy.json.JsonException e) {
    log.error(&quot;JSON 解析失败：&quot; + e.getMessage())
} catch (Exception e) {
    log.error(&quot;提取过程发生异常：&quot; + e.getMessage(), e)
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If - MT4_1" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get(&apos;instanceid_val&apos;)?.trim() == &apos;MT4_1&apos;)}
//vars.get(&quot;instanceid_val&quot;) == &quot;MT4_1&quot;</stringProp>
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">false</boolProp>
            </IfController>
            <hashTree>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="获取历史订单:mt4 ${login_val}:crm20/get_history_position?instanceid=${instanceid_val}&amp;login=${login_val}" enabled="true">
                <stringProp name="dataSource">MySQL</stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="query">SELECT MAGIC, REASON, SYMBOL, GW_VOLUME, MARGIN_RATE, OPEN_TIME, TAXES,
       LOGIN, COMMISSION_AGENT, GW_CLOSE_PRICE, CLOSE_PRICE, SL, COMMISSION,
       OPEN_PRICE, PROFIT, TICKET, TIMESTAMP, CLOSE_TIME, VOLUME, GW_OPEN_PRICE,
       COMMENT, DIGITS, EXPIRATION, CMD, TP
FROM mt4_report.MT4_TRADES
WHERE LOGIN = ${login_val} AND TICKET = ${order};</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="variableNames">MAGIC,REASON,SYMBOL,GW_VOLUME,MARGIN_RATE,OPEN_TIME,TAXES,LOGIN,COMMISSION_AGENT,GW_CLOSE_PRICE,CLOSE_PRICE,SL,COMMISSION,OPEN_PRICE,PROFIT,TICKET,TIMESTAMP,CLOSE_TIME,VOLUME,GW_OPEN_PRICE,COMMENT,DIGITS,EXPIRATION,CMD,TP</stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
              </JDBCSampler>
              <hashTree>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="false">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

// ========== 字段映射：API变量名（小写）-&gt; 数据库变量名（大写_1） ==========
def fieldMapping = [
    &quot;magic&quot;:           &quot;MAGIC_1&quot;,
    &quot;reason&quot;:          &quot;REASON_1&quot;,
    &quot;symbol&quot;:          &quot;SYMBOL_1&quot;,
    &quot;gw_volume&quot;:       &quot;GW_VOLUME_1&quot;,
    &quot;margin_rate&quot;:     &quot;MARGIN_RATE_1&quot;,
    &quot;open_time&quot;:       &quot;OPEN_TIME_1&quot;,
    &quot;taxes&quot;:           &quot;TAXES_1&quot;,
    &quot;login&quot;:           &quot;LOGIN_1&quot;,
    &quot;commission_agent&quot;:&quot;COMMISSION_AGENT_1&quot;,
    &quot;gw_close_price&quot;:  &quot;GW_CLOSE_PRICE_1&quot;,
    &quot;close_price&quot;:     &quot;CLOSE_PRICE_1&quot;,
    &quot;sl&quot;:              &quot;SL_1&quot;,
    &quot;commission&quot;:      &quot;COMMISSION_1&quot;,
    &quot;open_price&quot;:      &quot;OPEN_PRICE_1&quot;,
    &quot;profit&quot;:          &quot;PROFIT_1&quot;,
    &quot;order&quot;:           &quot;TICKET_1&quot;,
    &quot;timestamp&quot;:       &quot;TIMESTAMP_1&quot;,
    &quot;close_time&quot;:      &quot;CLOSE_TIME_1&quot;,
    &quot;volume&quot;:          &quot;VOLUME_1&quot;,
    &quot;gw_open_price&quot;:   &quot;GW_OPEN_PRICE_1&quot;,
    &quot;comment&quot;:         &quot;COMMENT_1&quot;,
    &quot;digits&quot;:          &quot;DIGITS_1&quot;,
    &quot;expiration&quot;:      &quot;EXPIRATION_1&quot;,
    &quot;cmd&quot;:             &quot;CMD_1&quot;,
    &quot;tp&quot;:              &quot;TP_1&quot;
]

// 浮点数比较精度
def EPSILON = 1e-9
// ====================================================================

def failures = []

fieldMapping.each { apiVarName, dbVarName -&gt;
    def apiValue = vars.get(apiVarName)
    def dbValue  = vars.get(dbVarName)

    // 检查数据库变量是否存在
    if (dbValue == null) {
        failures &lt;&lt; &quot;字段 [${apiVarName}]：数据库变量 ${dbVarName} 不存在（查询可能无结果或字段名不匹配）&quot;
        return
    }

    // API 值为 null 的处理
    if (apiValue == null) {
        failures &lt;&lt; &quot;字段 [${apiVarName}]：API 返回值为 null，数据库值为 [${dbValue}]&quot;
        return
    }

    // 尝试数值比较（double 类型，允许精度误差）
    try {
        def apiNum = apiValue.toDouble()
        def dbNum  = dbValue.toDouble()
        if (Math.abs(apiNum - dbNum) &gt; EPSILON) {
            failures &lt;&lt; &quot;字段 [${apiVarName}] 数值不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
        }
        return
    } catch (Exception ignore) {
        // 非数值，转字符串比较
    }

    // 字符串比较（统一去空格后比较）
    def apiStr = apiValue.toString().trim()
    def dbStr  = dbValue.toString().trim()
    if (apiStr != dbStr) {
        failures &lt;&lt; &quot;字段 [${apiVarName}] 字符串不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
    }
}

// ====== 检测API有但未参与DB比对的字段 ======
def extractedStr = vars.get(&quot;extracted_history_fields&quot;) ?: &quot;&quot;
def extractedFields = extractedStr ? extractedStr.split(&quot;,&quot;) as List : []
def mappedFields = fieldMapping.keySet()
def unmatchedFields = extractedFields.findAll { !mappedFields.contains(it) }
if (unmatchedFields) {
    failures &lt;&lt; &quot;【未参与DB比对的新增字段(共${unmatchedFields.size()}个)】：${unmatchedFields.join(&apos;, &apos;)}&quot;
}

// 断言结果处理
if (failures.isEmpty()) {
    return
} else {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;MT4 API与数据库对比失败，共 ${failures.size()} 处不一致：\n&quot; + failures.join(&quot;\n&quot;))
    
    // 让采样器本身标红
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;MT4 API与数据库对比失败，共 ${failures.size()} 处不一致&quot;)
    
    vars.put(&quot;assert_details&quot;, failures.join(&quot;; &quot;))
    prev.addAssertionResult(result)
}
</stringProp>
                </JSR223Assertion>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言 修改时间戳版本" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult
import java.text.SimpleDateFormat
import java.util.TimeZone

// ========== 字段映射：API变量名（小写）-&gt; 数据库变量名（大写_1） ==========
def fieldMapping = [
    &quot;magic&quot;:           &quot;MAGIC_1&quot;,
    &quot;reason&quot;:          &quot;REASON_1&quot;,
    &quot;symbol&quot;:          &quot;SYMBOL_1&quot;,
    &quot;gw_volume&quot;:       &quot;GW_VOLUME_1&quot;,
    &quot;margin_rate&quot;:     &quot;MARGIN_RATE_1&quot;,
    &quot;open_time&quot;:       &quot;OPEN_TIME_1&quot;,
    &quot;taxes&quot;:           &quot;TAXES_1&quot;,
    &quot;login&quot;:           &quot;LOGIN_1&quot;,
    &quot;commission_agent&quot;:&quot;COMMISSION_AGENT_1&quot;,
    &quot;gw_close_price&quot;:  &quot;GW_CLOSE_PRICE_1&quot;,
    &quot;close_price&quot;:     &quot;CLOSE_PRICE_1&quot;,
    &quot;sl&quot;:              &quot;SL_1&quot;,
    &quot;commission&quot;:      &quot;COMMISSION_1&quot;,
    &quot;open_price&quot;:      &quot;OPEN_PRICE_1&quot;,
    &quot;profit&quot;:          &quot;PROFIT_1&quot;,
    &quot;order&quot;:           &quot;TICKET_1&quot;,
    &quot;timestamp&quot;:       &quot;TIMESTAMP_1&quot;,
    &quot;close_time&quot;:      &quot;CLOSE_TIME_1&quot;,
    &quot;volume&quot;:          &quot;VOLUME_1&quot;,
    &quot;gw_open_price&quot;:   &quot;GW_OPEN_PRICE_1&quot;,
    &quot;comment&quot;:         &quot;COMMENT_1&quot;,
    &quot;digits&quot;:          &quot;DIGITS_1&quot;,
    &quot;expiration&quot;:      &quot;EXPIRATION_1&quot;,
    &quot;cmd&quot;:             &quot;CMD_1&quot;,
    &quot;tp&quot;:              &quot;TP_1&quot;
]

// 需要做时间戳转换的字段（API返回Integer→转成日期字符串再对比）
def timestampFields = [&quot;open_time&quot;, &quot;timestamp&quot;, &quot;close_time&quot;]

// 时间戳转日期字符串工具
def unixToDatetime(seconds) {
    def sdf = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;)
    sdf.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))
    return sdf.format(new Date(seconds * 1000L))
}

// 浮点数比较精度
def EPSILON = 1e-9
// ====================================================================

def failures = []
def successFields = []

// ====== 读取跳过比对的字段列表 ======
def skipFieldsStr = vars.get(&quot;skip_history_fields&quot;) ?: &quot;&quot;
def skipFields = skipFieldsStr ? skipFieldsStr.split(&quot;,&quot;)*.trim().findAll { it }*.replaceAll(&quot;^\\uFEFF&quot;, &quot;&quot;) : []
if (skipFields) {
    log.info(&quot;跳过比对的历史订单字段：{}&quot;, skipFields)
}

fieldMapping.each { apiVarName, dbVarName -&gt;
    // 跳过用户指定不参与比对的字段
    if (skipFields.contains(apiVarName)) {
        return
    }

    def apiValue = vars.get(apiVarName)
    def dbValue  = vars.get(dbVarName)

    // 检查数据库变量是否存在
    if (dbValue == null) {
        failures &lt;&lt; &quot;字段 [${apiVarName}]：数据库变量 ${dbVarName} 不存在（查询可能无结果或字段名不匹配）&quot;
        return
    }

    // API 值为 null 的处理
    if (apiValue == null) {
        failures &lt;&lt; &quot;字段 [${apiVarName}]：API 返回值为 null，数据库值为 [${dbValue}]&quot;
        return
    }

    // ====== 特殊处理：时间戳字段（API是秒级时间戳，DB是日期字符串） ======
    if (timestampFields.contains(apiVarName)) {
        try {
            def apiSeconds = apiValue.toLong()
            def apiFormatted = unixToDatetime(apiSeconds)
            // 数据库值：将 T 替换为空格，统一格式
            def dbFormatted = dbValue.toString().trim().replace(&quot;T&quot;, &quot; &quot;)
            if (apiFormatted != dbFormatted) {
                failures &lt;&lt; &quot;字段 [${apiVarName}] 时间戳不一致：API=[${apiValue}] → [${apiFormatted}]，DB=[${dbValue}] → [${dbFormatted}]&quot;
            } else {
                successFields &lt;&lt; &quot;${apiVarName} | API=${apiFormatted} DB=${dbFormatted} | 时间戳一致&quot;
            }
            return
        } catch (Exception e) {
            failures &lt;&lt; &quot;字段 [${apiVarName}]：时间戳转换失败，API=[${apiValue}]，DB=[${dbValue}]，错误=${e.message}&quot;
            return
        }
    }
    // ==================================================================

    // 尝试数值比较（double 类型，允许精度误差）
    try {
        def apiNum = apiValue.toDouble()
        def dbNum  = dbValue.toDouble()
        if (Math.abs(apiNum - dbNum) &gt; EPSILON) {
            failures &lt;&lt; &quot;字段 [${apiVarName}] 数值不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
        } else {
            successFields &lt;&lt; &quot;${apiVarName} | API=${apiValue} DB=${dbValue} | 数值一致&quot;
        }
        return
    } catch (Exception ignore) {
        // 非数值，转字符串比较
    }

    // 字符串比较（统一去空格后比较）
    def apiStr = apiValue.toString().trim()
    def dbStr  = dbValue.toString().trim()
    if (apiStr != dbStr) {
        failures &lt;&lt; &quot;字段 [${apiVarName}] 字符串不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
    } else {
        successFields &lt;&lt; &quot;${apiVarName} | API=${apiValue} DB=${dbValue} | 字符串一致&quot;
    }
}

// ====== 跳过/未比对字段的补充信息（不计入异常） ======
def infoMsgs = []

if (skipFields) {
    infoMsgs &lt;&lt; &quot;【DB设置已跳过比对字段(共${skipFields.size()}个)】：${skipFields.join(&apos;, &apos;)}&quot;
}

def extractedStr2 = vars.get(&quot;extracted_history_fields&quot;) ?: &quot;&quot;
def extractedFields2 = extractedStr2 ? extractedStr2.split(&quot;,&quot;) as List : []
def mappedFields2 = fieldMapping.keySet()
def unmatchedFields2 = extractedFields2.findAll { !mappedFields2.contains(it) &amp;&amp; !skipFields.contains(it) }
if (unmatchedFields2) {
    infoMsgs &lt;&lt; &quot;\n【未参与DB比对的新增字段(共${unmatchedFields2.size()}个)】：${unmatchedFields2.join(&apos;, &apos;)}&quot;
}

if (successFields) {
    infoMsgs &lt;&lt; &quot;【DB比对成功字段(共${successFields.size()}个)】：\n  &quot; + successFields.join(&quot;\n  &quot;)
}

// ====== DB比对失败时，自动降级到CSV断言 ======
if (!failures.isEmpty()) {
    log.warn(&quot;MT4 数据库比对失败(${failures.size()}处不一致)，降级使用CSV文件进行断言...\n  &quot;)
    infoMsgs &lt;&lt; &quot;\n【数据库比对失败(${failures.size()}处不一致)，已降级使用CSV文件断言】\n  &quot;

    // 读取CSV跳过字段（skip_csv）
    def skipCsvStr = vars.get(&quot;skip_csv&quot;) ?: &quot;&quot;
    def skipCsvFields = skipCsvStr ? skipCsvStr.split(&quot;,&quot;)*.trim().findAll { it }*.replaceAll(&quot;^\\uFEFF&quot;, &quot;&quot;) : []
    if (skipCsvFields) {
        infoMsgs &lt;&lt; &quot;【CSV设置已跳过比对字段(共${skipCsvFields.size()}个)】：${skipCsvFields.join(&apos;, &apos;)}&quot;
        log.info(&quot;CSV跳过比对字段：{}&quot;, skipCsvFields)
    }

    // 根据instanceid_val显式判断读取哪个CSV（相对路径）
    def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
    def instanceIdForCsv = vars.get(&quot;instanceid_val&quot;)
    def csvFileName = instanceIdForCsv?.contains(&quot;MT4&quot;) ? &quot;MT4_get_history_position.csv&quot; : &quot;MT5_get_history_position.csv&quot;
    def csvFile = new File(baseDir, csvFileName)
    if (!csvFile.exists()) {
        failures &lt;&lt; &quot;CSV文件不存在：${csvFile.absolutePath}&quot;
    } else {
        def csvLines = csvFile.readLines(&quot;UTF-8&quot;)
        if (csvLines.size() &lt; 2) {
            failures &lt;&lt; &quot;CSV文件数据不足（需要表头+至少1行数据）&quot;
        } else {
            // 解析CSV表头（处理可能的BOM字符）
            def firstLine = csvLines[0]
            // 移除UTF-8 BOM字符（如果存在）
            if (firstLine.startsWith(&quot;\uFEFF&quot;)) {
                firstLine = firstLine.substring(1)
            }
            def csvHeaders = firstLine.split(&quot;,&quot;)*.trim()
            def loginIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(&quot;login&quot;) }
            if (loginIdx &lt; 0) {
                failures &lt;&lt; &quot;CSV文件中未找到 login 列&quot;
            } else {
                def loginVal = vars.get(&quot;login_val&quot;) ?: &quot;&quot;
                def orderIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(&quot;order&quot;) }
                def matchedApiOrder = null
                def matchedCsvRow = null
                
                // 【修改】解析接口返回的所有订单对象（而非仅订单号列表）
                // ★ 使用PostProcessor保存的history_api_response变量（断言在JDBCSampler下，prev指向的是JDBC结果）
                def allApiOrders = []
                try {
                    def response = vars.get(&quot;history_api_response&quot;)
                    if (response) {
                        def json = new groovy.json.JsonSlurper().parseText(response)
                        if (json.data instanceof List) {
                            allApiOrders = json.data
                            log.info(&quot;解析到接口返回的订单数量：{}&quot;, allApiOrders.size())
                            // 调试：打印所有订单的order字段
                            allApiOrders.eachWithIndex { order, idx -&gt;
                                log.info(&quot;订单[{}]: order={}, login={}&quot;, idx, order?.order, order?.login)
                            }
                        } else {
                            log.warn(&quot;接口返回的data不是数组类型：{}&quot;, json.data?.getClass())
                        }
                    } else {
                        log.warn(&quot;接口响应变量 history_api_response 为空&quot;)
                    }
                } catch (Exception e) {
                    log.warn(&quot;解析响应获取所有订单失败：{}&quot;, e.message)
                }
                
                // 在CSV中找到接口中存在的订单（遍历CSV，找第一个在接口中存在的）
                for (int i = 1; i &lt; csvLines.size(); i++) {
                    if (csvLines[i].trim().isEmpty()) continue
                    def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                    if (cols.size() &lt;= loginIdx) continue
                    def rowLogin = cols[loginIdx]
                    if (rowLogin == loginVal) {
                        if (orderIdx &gt;= 0 &amp;&amp; cols.size() &gt; orderIdx) {
                            def csvOrder = cols[orderIdx]
                            log.info(&quot;检查CSV行[{}]: login={}, order={}&quot;, i, rowLogin, csvOrder)
                            // 在接口订单中查找匹配的order
                            def foundOrder = allApiOrders.find { 
                                def apiOrder = it?.order?.toString()
                                def result = apiOrder == csvOrder
                                if (!result) {
                                    log.debug(&quot;订单不匹配: API订单={} (类型: {}), CSV订单={} (类型: {})&quot;, apiOrder, it?.order?.getClass(), csvOrder, csvOrder.getClass())
                                }
                                return result
                            }
                            if (foundOrder) {
                                matchedApiOrder = foundOrder
                                matchedCsvRow = cols
                                log.info(&quot;CSV匹配到接口订单：login=${loginVal}, order=${csvOrder}&quot;)
                                break
                            } else {
                                log.info(&quot;CSV订单{}在接口返回的{}个订单中未找到匹配&quot;, csvOrder, allApiOrders.size())
                            }
                        }
                    }
                }
                
                // 如果未找到匹配的接口订单，退回到使用data[0]（兼容旧逻辑）
                if (matchedApiOrder == null) {
                    def fallbackOrderVal = vars.get(&quot;order&quot;) ?: &quot;&quot;
                    if (fallbackOrderVal) {
                        for (int i = 1; i &lt; csvLines.size(); i++) {
                            if (csvLines[i].trim().isEmpty()) continue
                            def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                            if (cols.size() &lt;= loginIdx) continue
                            def rowLogin = cols[loginIdx]
                            if (rowLogin == loginVal) {
                                if (orderIdx &gt;= 0 &amp;&amp; cols.size() &gt; orderIdx &amp;&amp; cols[orderIdx] == fallbackOrderVal) {
                                    matchedCsvRow = cols
                                    log.info(&quot;CSV使用data[0]订单回退匹配：login=${loginVal}, order=${fallbackOrderVal}&quot;)
                                    break
                                }
                            }
                        }
                    }
                }

                if (matchedCsvRow == null) {
                    log.info(&quot;CSV匹配失败，开始检查原因...&quot;)
                    def allOrderNumbers = allApiOrders.collect { it?.order?.toString() }.findAll { it }
                    log.info(&quot;接口返回的订单号列表：{}&quot;, allOrderNumbers)
                    // 检查CSV中是否存在相同login的数据行
                    def csvOrdersForLogin = []
                    for (int i = 1; i &lt; csvLines.size(); i++) {
                        if (csvLines[i].trim().isEmpty()) continue
                        def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                        if (cols.size() &lt;= loginIdx) continue
                        def rowLogin = cols[loginIdx]
                        if (rowLogin == loginVal &amp;&amp; orderIdx &gt;= 0 &amp;&amp; cols.size() &gt; orderIdx) {
                            csvOrdersForLogin &lt;&lt; cols[orderIdx]
                        }
                    }
                    if (csvOrdersForLogin) {
                        if (allOrderNumbers) {
                            failures &lt;&lt; &quot;CSV文件中存在 login=${loginVal} 的数据，但订单号不匹配：接口订单号=[${allOrderNumbers.join(&apos;, &apos;)}]，CSV中该login的订单号=[${csvOrdersForLogin.join(&apos;, &apos;)}]&quot;
                        } else {
                            failures &lt;&lt; &quot;CSV文件中存在 login=${loginVal} 的数据(订单号=[${csvOrdersForLogin.join(&apos;, &apos;)}])，但接口未返回有效订单号&quot;
                        }
                    } else {
                        if (allOrderNumbers) {
                            failures &lt;&lt; &quot;CSV文件中未找到 login=${loginVal} 且订单号属于 [${allOrderNumbers.join(&apos;, &apos;)}] 的数据行&quot;
                        } else {
                            failures &lt;&lt; &quot;CSV文件中未找到 login=${loginVal} 的匹配数据&quot;
                        }
                    }
                } else {
                    log.info(&quot;CSV匹配到 login=${loginVal} 的订单数据行&quot;)
                    // CSV比对
                    def csvFailures = []
                    def csvSuccessFields = []
                    csvHeaders.eachWithIndex { header, idx -&gt;
                        if (idx &gt;= matchedCsvRow.size()) return
                        def fieldName = header.toLowerCase()
                        // 清理fieldName中的BOM字符
                        def cleanFieldNameForCheck = fieldName.startsWith(&quot;\uFEFF&quot;) ? fieldName.substring(1) : fieldName
                        // 跳过login/order本身和skip_csv字段
                        if (cleanFieldNameForCheck.equalsIgnoreCase(&quot;login&quot;) || cleanFieldNameForCheck.equalsIgnoreCase(&quot;order&quot;) || cleanFieldNameForCheck.equalsIgnoreCase(&quot;gw_order&quot;)) return
                        if (skipCsvFields.any { it.equalsIgnoreCase(cleanFieldNameForCheck) }) return
                        // 跳过DB比对时也跳过的字段（清理BOM后比较）
                        if (skipFields.contains(cleanFieldNameForCheck)) return

                        // 【修改】优先从匹配的API订单对象获取值
                        def apiValue = null
                        if (matchedApiOrder != null) {
                            apiValue = matchedApiOrder[cleanFieldNameForCheck]
                            if (apiValue == null) {
                                apiValue = matchedApiOrder[fieldName]
                            }
                        }
                        // 未匹配到API订单时，回退到vars（兼容旧逻辑）
                        if (apiValue == null) {
                            apiValue = vars.get(cleanFieldNameForCheck)
                            if (apiValue == null) {
                                apiValue = vars.get(fieldName)
                            }
                        }
                        def csvValue = matchedCsvRow[idx]

                        if (apiValue == null) {
                            csvFailures &lt;&lt; &quot;字段 [${cleanFieldNameForCheck}]：API返回null，CSV=[${csvValue}]&quot;
                            return
                        }

                        // 时间戳字段：CSV中也是时间戳数字，直接数值比对
                        if (timestampFields.contains(cleanFieldNameForCheck)) {
                            try {
                                def apiNum = apiValue.toDouble()
                                def csvNum = csvValue.toDouble()
                                if (Math.abs(apiNum - csvNum) &gt; EPSILON) {
                                    csvFailures &lt;&lt; &quot;字段 [${cleanFieldNameForCheck}] 时间戳不一致：API=[${apiValue}]，CSV=[${csvValue}]&quot;
                                } else {
                                    csvSuccessFields &lt;&lt; &quot;${cleanFieldNameForCheck} | API=${apiValue} CSV=${csvValue} | 一致&quot;
                                }
                            } catch (Exception e) {
                                csvFailures &lt;&lt; &quot;字段 [${cleanFieldNameForCheck}]：时间戳比对异常，API=[${apiValue}]，CSV=[${csvValue}]&quot;
                            }
                            return
                        }

                        // 数值比较
                        try {
                            def apiNum = apiValue.toDouble()
                            def csvNum = csvValue.toDouble()
                            if (Math.abs(apiNum - csvNum) &gt; EPSILON) {
                                csvFailures &lt;&lt; &quot;字段 [${cleanFieldNameForCheck}] 数值不一致：API=[${apiValue}]，CSV=[${csvValue}]&quot;
                            } else {
                                csvSuccessFields &lt;&lt; &quot;${cleanFieldNameForCheck} | API=${apiValue} CSV=${csvValue} | 数值一致&quot;
                            }
                            return
                        } catch (Exception ignore) {}

                        // 字符串比较
                        def apiStr = apiValue.toString().trim()
                        def csvStr = csvValue.toString().trim()
                        if (apiStr != csvStr) {
                            csvFailures &lt;&lt; &quot;字段 [${cleanFieldNameForCheck}] 字符串不一致：API=[${apiValue}]，CSV=[${csvValue}]&quot;
                        } else {
                            csvSuccessFields &lt;&lt; &quot;${cleanFieldNameForCheck} | API=${apiValue} CSV=${csvValue} | 字符串一致&quot;
                        }
                    }

                    if (csvFailures.isEmpty()) {
                        // CSV断言全部通过，覆盖DB失败结果
                        failures.clear()
                        infoMsgs &lt;&lt; &quot;【CSV断言全部通过(共${csvSuccessFields.size()}个字段)】：\n  &quot; + csvSuccessFields.join(&quot;\n  &quot;)
                        log.info(&quot;MT4 CSV断言全部通过，共${csvSuccessFields.size()}个字段一致&quot;)
                    } else {
                        // CSV断言也失败，展示详细信息（与DB比对格式一致）
                        def csvInfoDetail = []
                        csvInfoDetail &lt;&lt; &quot;\n【CSV断言失败(共${csvFailures.size()}处不一致)】\n  &quot; + csvFailures.join(&quot;\n  &quot;)
                        if (csvSuccessFields) {
                            csvInfoDetail &lt;&lt; &quot;\n【CSV比对成功字段(共${csvSuccessFields.size()}个)】：\n  &quot; + csvSuccessFields.join(&quot;\n  &quot;)
                        }
                        infoMsgs &lt;&lt; csvInfoDetail.join(&quot;\n\n&quot;)
                        failures.clear()
                        failures.addAll(csvFailures)
                    }
                }
            }
        }
    }
}
// ====== CSV降级断言结束 ======

// 断言结果处理
if (failures.isEmpty()) {
    if (infoMsgs) {
        prev.setResponseMessage(&quot;比对成功 —— ${infoMsgs.join(&apos;; &apos;)}&quot;)
        log.info(&quot;MT4 历史订单补充信息：\n{}&quot;, infoMsgs.join(&quot;\n&quot;))
    } else {
        prev.setResponseMessage(&quot;比对成功&quot;)
    }
    return
} else {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;\n 【MT4 API对比失败，共 ${failures.size()} 处不一致】\n&quot; + failures.join(&quot;\n&quot;) + (infoMsgs ? &quot;\n\n---\n&quot; + infoMsgs.join(&quot;\n&quot;) : &quot;&quot;))
    // 让采样器本身标红
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;MT4 API对比失败，共 ${failures.size()} 处不一致&quot;)

    vars.put(&quot;assert_details&quot;, failures.join(&quot;; &quot;))
    prev.addAssertionResult(result)
}
</stringProp>
                </JSR223Assertion>
                <hashTree/>
              </hashTree>
            </hashTree>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If - MT5_1" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get(&apos;instanceid_val&apos;)?.trim() == &apos;MT5_1&apos;)}
//vars.get(&quot;instanceid_val&quot;) == &quot;MT5_1&quot;</stringProp>
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">false</boolProp>
            </IfController>
            <hashTree>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="获取历史订单:mt5 ${login_val} :crm20/get_history_position?instanceid=${instanceid_val}&amp;login=${login_val}" enabled="true">
                <stringProp name="dataSource">MySQL</stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="query">SELECT Symbol, Digits ,Reason ,PriceTP ,ActivationFlags ,ActivationMode ,ExpertID ,PositionID,ContractSize,login,DigitsCurrency,PriceSL,VolumeInitial,PriceCurrent,Dealer
FROM mt5_orders_history
WHERE Login = ${login_val} AND `Order`  = ${Position};</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="variableNames">Symbol,Digits,Reason,PriceTP,ActivationFlags,ActivationMode,ExpertID,PositionID,ContractSize,login,DigitsCurrency,PriceSL,VolumeInitial,PriceCurrent,Dealer</stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
              </JDBCSampler>
              <hashTree>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

// ========== 字段映射：API变量名 -&gt; 数据库变量名（_1后缀） ==========
def fieldMapping = [
    &quot;Symbol&quot;:         &quot;Symbol_1&quot;,
    &quot;Digits&quot;:         &quot;Digits_1&quot;,
    &quot;Reason&quot;:         &quot;Reason_1&quot;,
    &quot;PriceTP&quot;:        &quot;PriceTP_1&quot;,
    &quot;ActivationFlags&quot;:&quot;ActivationFlags_1&quot;,
    &quot;ActivationMode&quot;: &quot;ActivationMode_1&quot;,
    &quot;ExpertID&quot;:       &quot;ExpertID_1&quot;,
    &quot;Position&quot;:       &quot;PositionID_1&quot;,
    &quot;ContractSize&quot;:   &quot;ContractSize_1&quot;,
    &quot;Login&quot;:          &quot;login_1&quot;,
    &quot;DigitsCurrency&quot;: &quot;DigitsCurrency_1&quot;,
    &quot;PriceSL&quot;:        &quot;PriceSL_1&quot;,
    &quot;Volume&quot;:         &quot;VolumeInitial_1&quot;,
    &quot;PriceCurrent&quot;:   &quot;PriceCurrent_1&quot;,
    &quot;Dealer&quot;:         &quot;Dealer_1&quot;
]

// 浮点数比较精度
def EPSILON = 1e-9
// ====================================================================

def failures = []
def successFieldsM = []

// ====== 读取跳过比对的字段列表 ======
def skipFieldsStrM = vars.get(&quot;skip_history_fields&quot;) ?: &quot;&quot;
def skipFieldsM = skipFieldsStrM ? skipFieldsStrM.split(&quot;,&quot;)*.trim().findAll { it }*.replaceAll(&quot;^\\uFEFF&quot;, &quot;&quot;) : []
if (skipFieldsM) {
    log.info(&quot;DB跳过比对的MT5历史订单字段：{}&quot;, skipFieldsM)
}

fieldMapping.each { apiVarName, dbVarName -&gt;
    // 跳过用户指定不参与比对的字段
    if (skipFieldsM.contains(apiVarName)) {
        return
    }

    def apiValue = vars.get(apiVarName)
    def dbValue  = vars.get(dbVarName)

    // 检查数据库变量是否存在
    if (dbValue == null) {
        failures &lt;&lt; &quot;\n字段 [${apiVarName}]：数据库变量 ${dbVarName} 不存在（查询可能无结果或字段名不匹配）&quot;
        return
    }

    // API 值为 null 的处理
    if (apiValue == null) {
        failures &lt;&lt; &quot;\n字段 [${apiVarName}]：API 返回值为 null，数据库值为 [${dbValue}]&quot;
        return
    }

    // 尝试数值比较（double 类型，允许精度误差）
    try {
        def apiNum = apiValue.toDouble()
        def dbNum  = dbValue.toDouble()
        if (Math.abs(apiNum - dbNum) &gt; EPSILON) {
            failures &lt;&lt; &quot;字段 [${apiVarName}] 数值不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
        } else {
            successFieldsM &lt;&lt; &quot;${apiVarName} | API=${apiValue} DB=${dbValue} | 数值一致&quot;
        }
        return
    } catch (Exception ignore) {
        // 非数值，转字符串比较
    }

    // 字符串比较（统一去空格后比较）
    def apiStr = apiValue.toString().trim()
    def dbStr  = dbValue.toString().trim()
    if (apiStr != dbStr) {
        failures &lt;&lt; &quot;字段 [${apiVarName}] 字符串不一致：API=[${apiValue}]，DB=[${dbValue}]&quot;
    } else {
        successFieldsM &lt;&lt; &quot;${apiVarName} | API=${apiValue} DB=${dbValue} | 字符串一致&quot;
    }
}

// ====== 跳过/未比对字段的补充信息（不计入异常） ======
def infoMsgsM = []

if (skipFieldsM) {
    infoMsgsM &lt;&lt; &quot;【DB已设置跳过比对字段(共${skipFieldsM.size()}个)】：${skipFieldsM.join(&apos;, &apos;)}&quot;
}

def extractedStrM = vars.get(&quot;extracted_history_fields&quot;) ?: &quot;&quot;
def extractedFieldsM = extractedStrM ? extractedStrM.split(&quot;,&quot;) as List : []
def mappedFieldsM = fieldMapping.keySet()
def unmatchedFieldsM = extractedFieldsM.findAll { !mappedFieldsM.contains(it) &amp;&amp; !skipFieldsM.contains(it) }
if (unmatchedFieldsM) {
    infoMsgsM &lt;&lt; &quot;\n【未参与DB比对的新增字段(共${unmatchedFieldsM.size()}个)】：${unmatchedFieldsM.join(&apos;, &apos;)}\n&quot;
}

if (successFieldsM) {
    infoMsgsM &lt;&lt; &quot;\n【DB比对成功字段(共${successFieldsM.size()}个)】：\n  &quot; + successFieldsM.join(&quot;\n  &quot;)
}

// ====== DB比对失败时，自动降级到CSV断言 ======
if (!failures.isEmpty()) {
    log.warn(&quot;MT5 数据库比对失败(${failures.size()}处不一致)，降级使用CSV文件进行断言...\n  &quot;)
    infoMsgsM &lt;&lt; &quot;【数据库比对失败(${failures.size()}处不一致)，已降级使用CSV文件断言】\n  &quot;

    // 读取CSV跳过字段（skip_csv）
    def skipCsvStr = vars.get(&quot;skip_csv&quot;) ?: &quot;&quot;
    def skipCsvFields = skipCsvStr ? skipCsvStr.split(&quot;,&quot;)*.trim().findAll { it }*.replaceAll(&quot;^\\uFEFF&quot;, &quot;&quot;) : []
    if (skipCsvFields) {
        infoMsgsM &lt;&lt; &quot;\n【CSV已设置跳过比对字段(共${skipCsvFields.size()}个)】：${skipCsvFields.join(&apos;, &apos;)}&quot;
        log.info(&quot;\nCSV跳过比对字段：{}&quot;, skipCsvFields)
    }

    // 根据instanceid_val显式判断读取哪个CSV（相对路径）
    def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
    def instanceIdForCsv = vars.get(&quot;instanceid_val&quot;)
    def csvFileName = instanceIdForCsv?.contains(&quot;MT5&quot;) ? &quot;MT5_get_history_position.csv&quot; : &quot;MT4_get_history_position.csv&quot;
    def csvFile = new File(baseDir, csvFileName)
    if (!csvFile.exists()) {
        failures &lt;&lt; &quot;CSV文件不存在：${csvFile.absolutePath}&quot;
    } else {
        def csvLines = csvFile.readLines(&quot;UTF-8&quot;)
        if (csvLines.size() &lt; 2) {
            failures &lt;&lt; &quot;CSV文件数据不足（需要表头+至少1行数据）&quot;
        } else {
            // 解析CSV表头（处理可能的BOM字符）
            def firstLine = csvLines[0]
            // 移除UTF-8 BOM字符（如果存在）
            if (firstLine.startsWith(&quot;\uFEFF&quot;)) {
                firstLine = firstLine.substring(1)
            }
            def csvHeaders = firstLine.split(&quot;,&quot;)*.trim()
            def loginIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(&quot;login&quot;) }
            if (loginIdx &lt; 0) {
                failures &lt;&lt; &quot;CSV文件中未找到 login 列&quot;
            } else {
                def loginVal = vars.get(&quot;login_val&quot;) ?: &quot;&quot;
                def positionIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(&quot;Position&quot;) }
                def matchedApiOrder = null
                def matchedCsvRow = null

                // 【修改】解析接口返回的所有订单对象（而非仅Position号列表）
                // ★ 使用PostProcessor保存的history_api_response变量（断言在JDBCSampler下，prev指向的是JDBC结果）
                def allApiOrders = []
                try {
                    def response = vars.get(&quot;history_api_response&quot;)
                    if (response) {
                        def json = new groovy.json.JsonSlurper().parseText(response)
                        if (json.data instanceof List) {
                            allApiOrders = json.data
                            log.info(&quot;MT5解析到接口返回的订单数量：{}&quot;, allApiOrders.size())
                            // 调试：打印所有订单的Position字段
                            allApiOrders.eachWithIndex { order, idx -&gt;
                                log.info(&quot;MT5订单[{}]: Position={}, Login={}&quot;, idx, order?.Position, order?.Login)
                            }
                        } else {
                            log.warn(&quot;MT5接口返回的data不是数组类型：{}&quot;, json.data?.getClass())
                        }
                    } else {
                        log.warn(&quot;MT5接口响应变量 history_api_response 为空&quot;)
                    }
                } catch (Exception e) {
                    log.warn(&quot;MT5解析响应获取所有订单失败：{}&quot;, e.message)
                }
                
                // 在CSV中找到接口中存在的订单（遍历CSV，找第一个在接口中存在的）
                for (int i = 1; i &lt; csvLines.size(); i++) {
                    if (csvLines[i].trim().isEmpty()) continue
                    def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                    if (cols.size() &lt;= loginIdx) continue
                    def rowLogin = cols[loginIdx]
                    if (rowLogin == loginVal) {
                        if (positionIdx &gt;= 0 &amp;&amp; cols.size() &gt; positionIdx) {
                            def csvPosition = cols[positionIdx]
                            log.info(&quot;MT5检查CSV行[{}]: login={}, Position={}&quot;, i, rowLogin, csvPosition)
                            // 在接口订单中查找匹配的Position
                            def foundOrder = allApiOrders.find { 
                                def apiPosition = it?.Position?.toString()
                                def result = apiPosition == csvPosition
                                if (!result) {
                                    log.debug(&quot;MT5 Position不匹配: API Position={} (类型: {}), CSV Position={} (类型: {})&quot;, apiPosition, it?.Position?.getClass(), csvPosition, csvPosition.getClass())
                                }
                                return result
                            }
                            if (foundOrder) {
                                matchedApiOrder = foundOrder
                                matchedCsvRow = cols
                                log.info(&quot;CSV匹配到接口订单：login=${loginVal}, Position=${csvPosition}&quot;)
                                break
                            } else {
                                log.info(&quot;MT5 CSV Position{}在接口返回的{}个订单中未找到匹配&quot;, csvPosition, allApiOrders.size())
                            }
                        }
                    }
                }
                
                // 如果未找到匹配的接口订单，退回到使用data[0]（兼容旧逻辑）
                if (matchedApiOrder == null) {
                    def fallbackPositionVal = vars.get(&quot;Position&quot;) ?: &quot;&quot;
                    if (fallbackPositionVal) {
                        for (int i = 1; i &lt; csvLines.size(); i++) {
                            if (csvLines[i].trim().isEmpty()) continue
                            def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                            if (cols.size() &lt;= loginIdx) continue
                            def rowLogin = cols[loginIdx]
                            if (rowLogin == loginVal) {
                                if (positionIdx &gt;= 0 &amp;&amp; cols.size() &gt; positionIdx &amp;&amp; cols[positionIdx] == fallbackPositionVal) {
                                    matchedCsvRow = cols
                                    log.info(&quot;CSV使用data[0]订单回退匹配：login=${loginVal}, Position=${fallbackPositionVal}&quot;)
                                    break
                                }
                            }
                        }
                    }
                }

                if (matchedCsvRow == null) {
                    log.info(&quot;MT5 CSV匹配失败，开始检查原因...&quot;)
                    def allPositionNumbers = allApiOrders.collect { it?.Position?.toString() }.findAll { it }
                    log.info(&quot;MT5接口返回的Position号列表：{}&quot;, allPositionNumbers)
                    // 检查CSV中是否存在相同login的数据行
                    def csvPositionsForLogin = []
                    for (int i = 1; i &lt; csvLines.size(); i++) {
                        if (csvLines[i].trim().isEmpty()) continue
                        def cols = csvLines[i].split(&quot;,&quot;)*.trim()
                        if (cols.size() &lt;= loginIdx) continue
                        def rowLogin = cols[loginIdx]
                        if (rowLogin == loginVal &amp;&amp; positionIdx &gt;= 0 &amp;&amp; cols.size() &gt; positionIdx) {
                            csvPositionsForLogin &lt;&lt; cols[positionIdx]
                        }
                    }
                    if (csvPositionsForLogin) {
                        if (allPositionNumbers) {
                            failures &lt;&lt; &quot;CSV文件中存在 login=${loginVal} 的数据，但Position号不匹配：接口Position号=[${allPositionNumbers.join(&apos;, &apos;)}]，CSV中该login的Position号=[${csvPositionsForLogin.join(&apos;, &apos;)}]\n  &quot;
                        } else {
                            failures &lt;&lt; &quot;CSV文件中存在 login=${loginVal} 的数据(Position号=[${csvPositionsForLogin.join(&apos;, &apos;)}])，但接口未返回有效Position号\n  &quot;
                        }
                    } else {
                        if (allPositionNumbers) {
                            failures &lt;&lt; &quot;CSV文件中未找到 login=${loginVal} 且Position号属于 [${allPositionNumbers.join(&apos;, &apos;)}] 的数据行\n  &quot;
                        } else {
                            failures &lt;&lt; &quot;CSV文件中未找到 login=${loginVal} 的匹配数据\n  &quot;
                        }
                    }
                } else {
                    log.info(&quot;CSV匹配到 login=${loginVal} 的订单数据行\n  &quot;)
                    // CSV比对（MT5字段名大小写敏感，保留原始大小写）
                    def csvFailures = []
                    def csvSuccessFields = []
                    csvHeaders.eachWithIndex { header, idx -&gt;
                        if (idx &gt;= matchedCsvRow.size()) return
                        // 清理header中的BOM字符
                        def cleanHeaderForCheck = header.startsWith(&quot;\uFEFF&quot;) ? header.substring(1) : header
                        // 跳过匹配字段本身
                        if (cleanHeaderForCheck.equalsIgnoreCase(&quot;login&quot;) || cleanHeaderForCheck.equalsIgnoreCase(&quot;Position&quot;)) return
                        // 跳过skip_csv字段（忽略大小写）
                        if (skipCsvFields.any { it.equalsIgnoreCase(cleanHeaderForCheck) }) return
                        // 跳过DB比对时也跳过的字段（清理BOM后比较）
                        if (skipFieldsM.contains(cleanHeaderForCheck)) return

                        // 【修改】优先从匹配的API订单对象获取值
                        def apiValue = null
                        if (matchedApiOrder != null) {
                            apiValue = matchedApiOrder[cleanHeaderForCheck]
                            if (apiValue == null) {
                                apiValue = matchedApiOrder[header]
                            }
                        }
                        // 未匹配到API订单时，回退到vars（兼容旧逻辑）
                        if (apiValue == null) {
                            apiValue = vars.get(cleanHeaderForCheck)
                            if (apiValue == null) {
                                apiValue = vars.get(header)
                            }
                        }
                        def csvValue = matchedCsvRow[idx]

                        if (apiValue == null) {
                            csvFailures &lt;&lt; &quot;字段 [${cleanHeaderForCheck}]：API返回null，CSV=[${csvValue}]&quot;
                            return
                        }

                        // 数值比较
                        try {
                            def apiNum = apiValue.toDouble()
                            def csvNum = csvValue.toDouble()
                            if (Math.abs(apiNum - csvNum) &gt; EPSILON) {
                                csvFailures &lt;&lt; &quot;字段 [${cleanHeaderForCheck}] 数值不一致：API=[${apiValue}]，CSV=[${csvValue}]&quot;
                            } else {
                                csvSuccessFields &lt;&lt; &quot;${cleanHeaderForCheck} | API=${apiValue} CSV=${csvValue} | 数值一致&quot;
                            }
                            return
                        } catch (Exception ignore) {}

                        // 字符串比较
                        def apiStr = apiValue.toString().trim()
                        def csvStr = csvValue.toString().trim()
                        if (apiStr != csvStr) {
                            csvFailures &lt;&lt; &quot;字段 [${cleanHeaderForCheck}] 字符串不一致：API=[${apiValue}]，CSV=[${csvValue}]&quot;
                        } else {
                            csvSuccessFields &lt;&lt; &quot;${cleanHeaderForCheck} | API=${apiValue} CSV=${csvValue} | 字符串一致&quot;
                        }
                    }

                    if (csvFailures.isEmpty()) {
                        // CSV断言全部通过，覆盖DB失败结果
                        failures.clear()
                        infoMsgsM &lt;&lt; &quot;【CSV断言全部通过(共${csvSuccessFields.size()}个字段)】：\n  &quot; + csvSuccessFields.join(&quot;\n  &quot;)
                        log.info(&quot;MT5 CSV断言全部通过，共${csvSuccessFields.size()}个字段一致&quot;)
                    } else {
                        // CSV断言也失败，展示详细信息（与DB比对格式一致）
                        def csvInfoDetail = []
                        csvInfoDetail &lt;&lt; &quot;\n【CSV断言失败(共${csvFailures.size()}处不一致)】\n  &quot; + csvFailures.join(&quot;\n  &quot;)
                        if (csvSuccessFields) {
                            csvInfoDetail &lt;&lt; &quot;\n【CSV比对成功字段(共${csvSuccessFields.size()}个)】：\n  &quot; + csvSuccessFields.join(&quot;\n  &quot;)
                        }
                        infoMsgsM &lt;&lt; csvInfoDetail.join(&quot;\n\n&quot;)
                        failures.clear()
                        failures.addAll(csvFailures)
                    }
                }
            }
        }
    }
}
// ====== CSV降级断言结束 ======

// 断言结果处理
if (failures.isEmpty()) {
    if (infoMsgsM) {
        prev.setResponseMessage(&quot;比对成功 —— ${infoMsgsM.join(&apos;; &apos;)}&quot;)
        log.info(&quot;MT5 历史订单补充信息：\n{}&quot;, infoMsgsM.join(&quot;\n&quot;))
    } else {
        prev.setResponseMessage(&quot;比对成功&quot;)
    }
    return
} else {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;\n 【MT5 API对比失败，共 ${failures.size()} 处不一致】\n&quot; + failures.join(&quot;\n&quot;) + (infoMsgsM ? &quot;\n\n---\n&quot; + infoMsgsM.join(&quot;\n&quot;) : &quot;&quot;))
    
    // 让采样器本身也标记为失败（标红）
    prev.setSuccessful(false)
  
    prev.setResponseMessage(&quot;API对比失败，共 ${failures.size()} 处不一致&quot;)
    vars.put(&quot;assert_details&quot;, failures.join(&quot;; &quot;) + (infoMsgsM ? &quot;;; &quot; + infoMsgsM.join(&quot;; &quot;) : &quot;&quot;))
    prev.addAssertionResult(result)
}</stringProp>
                </JSR223Assertion>
