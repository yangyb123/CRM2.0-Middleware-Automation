            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

// 1. 解析响应
def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// 2. 基础接口校验
if (json.code != 0 || json.msg != &quot;ok&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;接口失败：code=${json.code}，msg=${json.msg}&quot;)
    return
}

// 3. data 必须存在
if (json.data == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;data 为空&quot;)
    return
}

// 4. 必须包含 by_instance 和 overall 两块数据
if (json.data.by_instance == null || json.data.overall == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;缺少 by_instance 或 overall 节点&quot;)
    return
}

// 5. by_instance 数组至少有1条数据
def instances = json.data.by_instance
if (instances.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;by_instance 数组为空&quot;)
    return
}

// 6. 校验每个 instance 必备字段（核心统计字段必须存在）
def instanceValid = instances.every { item -&gt;
    item.instance_id != null &amp;&amp;
    item.platform != null &amp;&amp;
    item.server_type != null &amp;&amp;
    item.total_accounts != null &amp;&amp;
    item.accounts_with_positions != null &amp;&amp;
    item.total_balance != null &amp;&amp;
    item.total_equity != null &amp;&amp;
    item.total_profit != null
}

if (!instanceValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;某个 instance 缺失关键字段&quot;)
    return
}

// 7. 校验 overall 必备字段
def overall = json.data.overall
def overallValid = 
    overall.total_accounts != null &amp;&amp;
    overall.accounts_with_positions != null &amp;&amp;
    overall.total_balance != null &amp;&amp;
    overall.total_equity != null &amp;&amp;
    overall.total_profit != null

if (!overallValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;overall 缺失关键字段&quot;)
    return
}

// 8. 数值必须是数字（防止返回字符串）
def numberValid = instances.every { item -&gt;
    item.total_accounts instanceof Number &amp;&amp;
    item.total_balance instanceof Number &amp;&amp;
    item.total_equity instanceof Number
}

if (!numberValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;统计字段不是有效数字&quot;)
    return
}

// 9. meta 校验
if (json.meta.matched_accounts == null || json.meta.matched_accounts &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;meta 匹配账户数异常&quot;)
    return
}

// 成功日志
log.info(&quot;✅ 统计接口断言全部通过！instance 数量=${instances.size()}&quot;)</stringProp>
            </JSR223Assertion>
