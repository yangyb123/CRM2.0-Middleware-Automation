          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化符号规格和实时报价数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;符号规格和实时报价-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;符号规格和实时报价CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;符号规格和实时报价CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String symbol = (vars.get(&apos;symbol_val&apos;) ?: vars.get(&apos;name&apos;) ?: vars.get(&apos;order_symbol&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;符号规格和实时报价 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;符号规格和实时报价 order_instanceid_val/instanceid_val不能为空&apos;)
if (!symbol) throw new AssertionError(&apos;符号规格和实时报价 symbol_val/name不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;符号规格和实时报价 instanceid只支持MT4_*/MT5_*，当前=&apos; + instanceId)

vars.put(&apos;symbol_ex_check_shujuku&apos;, shujuku)
vars.put(&apos;symbol_ex_check_instanceid&apos;, instanceId)
vars.put(&apos;symbol_ex_check_symbol&apos;, symbol)
vars.put(&apos;symbol_ex_check_db_platform&apos;, platform)
vars.put(&apos;instanceid_val&apos;, instanceId)
vars.put(&apos;symbol_val&apos;, symbol)
vars.putObject(&apos;db_symbol_ex_check_rows&apos;, [])
log.info(&apos;symbol_ex_check init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | symbol=&apos; + symbol)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT4-查询符号规格实时报价数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;symbol_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;symbol_ex_check_db_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4符号规格实时报价-${symbol_ex_check_symbol}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
              <stringProp name="query">SELECT
  mt.*,
  UNIX_TIMESTAMP(mt.MODIFY_TIME) * 1000 AS updated_utc_ms,
  UNIX_TIMESTAMP(mt.TIME) * 1000 AS quote_updated_utc_ms,
  NULL AS currency_base,
  NULL AS currency_margin,
  NULL AS profit_mode,
  0.0 AS tick_size,
  NULL AS currency_profit,
  NULL AS trade_mode,
  mt.ASK AS ask,
  mt.SYMBOL AS name,
  mt.DIGITS AS digits,
  NULL AS contract_size,
  mt.BID AS bid,
  0.0 AS tick_value
FROM MT4_PRICES mt
WHERE mt.SYMBOL = ?</stringProp>
              <stringProp name="queryArguments">${symbol_ex_check_symbol}</stringProp>
              <stringProp name="queryArgumentsTypes">VARCHAR</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">10</stringProp>
              <stringProp name="resultVariable">db_symbol_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询符号规格实时报价数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;symbol_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;symbol_ex_check_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5符号规格实时报价-${symbol_ex_check_symbol}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">SELECT
  s.*,
  p.*,
  CASE WHEN s.Timestamp &gt; 100000000000 THEN s.Timestamp ELSE s.Timestamp * 1000 END AS updated_utc_ms,
  UNIX_TIMESTAMP(p.Time) * 1000 AS quote_updated_utc_ms,
  s.CurrencyBase AS currency_base,
  s.CurrencyMargin AS currency_margin,
  s.CalcMode AS profit_mode,
  s.TickSize AS tick_size,
  s.CurrencyProfit AS currency_profit,
  CASE s.TradeMode
    WHEN 0 THEN &apos;disabled&apos;
    WHEN 1 THEN &apos;long_only&apos;
    WHEN 2 THEN &apos;short_only&apos;
    WHEN 3 THEN &apos;close_only&apos;
    WHEN 4 THEN &apos;full&apos;
    ELSE CONCAT(&apos;unknown_&apos;, s.TradeMode)
  END AS trade_mode,
  p.AskLast AS ask,
  s.Symbol AS name,
  s.Digits AS digits,
  s.ContractSize AS contract_size,
  p.BidLast AS bid,
  s.TickValue AS tick_value
FROM mt5_symbols s
LEFT JOIN mt5_prices p ON p.Symbol = s.Symbol
WHERE s.Symbol = ?</stringProp>
              <stringProp name="queryArguments">${symbol_ex_check_symbol}</stringProp>
              <stringProp name="queryArgumentsTypes">VARCHAR</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">10</stringProp>
              <stringProp name="resultVariable">db_symbol_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="符号规格和实时报价-数据库校验-${instanceid_val}-${symbol_val}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_symbol_ex?instanceid=${instanceid_val}&amp;name=${symbol_val}</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-符号规格和实时报价" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode
import java.text.SimpleDateFormat

def text = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(text ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + text)
    return
}

List asRows(obj) {
    if (obj == null) return []
    if (obj instanceof List) return obj.findAll { it instanceof Map }
    if (obj instanceof Map) {
        for (k in [&apos;symbols&apos;, &apos;symbol&apos;, &apos;data&apos;, &apos;rows&apos;, &apos;records&apos;, &apos;list&apos;, &apos;items&apos;, &apos;result&apos;, &apos;results&apos;]) {
            def v = obj[k]
            if (v instanceof List) return v.findAll { it instanceof Map }
            if (v instanceof Map) {
                def nested = asRows(v)
                if (nested) return nested
            }
        }
        def firstList = obj.values().find { it instanceof List &amp;&amp; it.any { it instanceof Map } }
        if (firstList instanceof List) return firstList.findAll { it instanceof Map }
        return [obj]
    }
    return []
}

Map rowToMap(row) {
    def out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else {
        try {
            row.metaClass.properties.each { p -&gt;
                if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot;
            }
        } catch (ignored) {}
    }
    return out
}

String normKey(String s) {
    return (s ?: &apos;&apos;).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase()
}

boolean isBlankValue(Object value) {
    if (value == null) return true
    String s = value.toString().trim()
    return s.length() == 0 || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)
}

Map locateByAliases(Map row, List aliases) {
    if (row == null) return [present: false, key: null, value: null]
    for (String alias : aliases) {
        def directKey = row.keySet().find { k -&gt; k?.toString()?.equalsIgnoreCase(alias) }
        if (directKey != null) return [present: true, key: String.valueOf(directKey), value: row[directKey]]
    }
    def wanted = aliases.collect { normKey(it) } as Set
    def normalizedKey = row.keySet().find { k -&gt; wanted.contains(normKey(k?.toString())) }
    return normalizedKey == null
        ? [present: false, key: null, value: null]
        : [present: true, key: String.valueOf(normalizedKey), value: row[normalizedKey]]
}

Map locateField(Map row, String apiField, Map aliases) {
    def names = [apiField]
    if (aliases[apiField]) names.addAll(aliases[apiField])
    return locateByAliases(row, names.unique())
}

Object readByAliases(Map row, List aliases) {
    Map located = locateByAliases(row, aliases)
    return located.present ? located.value : null
}

Object readField(Map row, String apiField, Map aliases) {
    Map located = locateField(row, apiField, aliases)
    return located.present ? located.value : null
}

boolean isTimeField(String field) {
    String k = normKey(field)
    return k.contains(&apos;time&apos;) || k.contains(&apos;utcms&apos;) || k.contains(&apos;updatedutcms&apos;)
}

Long epochMillis(Object value) {
    if (value == null) return null
    if (value instanceof Date) return value.time
    String s = value.toString().trim()
    if (!s) return null
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        // MT5 Symbols.Timestamp在部分库中是Windows FILETIME（1601起算的100ns tick）。
        // 最新OpenAPI规定所有*_utc_ms对外均为Unix epoch毫秒，因此先转换再比较/展示。
        BigDecimal filetimeOffset = new BigDecimal(&apos;116444736000000000&apos;)
        BigDecimal filetimeUpper = new BigDecimal(&apos;265046774400000000&apos;)
        if (n.compareTo(filetimeOffset) &gt;= 0 &amp;&amp; n.compareTo(filetimeUpper) &lt;= 0) {
            return n.subtract(filetimeOffset).divide(new BigDecimal(&apos;10000&apos;), 0, RoundingMode.DOWN).longValue()
        }
        if (n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &lt; 0) n = n.multiply(new BigDecimal(&apos;1000&apos;))
        else if (n.abs().compareTo(new BigDecimal(&apos;1000000000000000&apos;)) &gt;= 0) {
            int digits = s.replace(&apos;-&apos;, &apos;&apos;).replaceAll(/\.\d+$/, &apos;&apos;).length()
            if (digits == 16) n = n.divide(new BigDecimal(&apos;1000&apos;), 0, RoundingMode.DOWN)
            else if (digits == 17) n = n.divide(new BigDecimal(&apos;10000&apos;), 0, RoundingMode.DOWN)
        }
        return n.longValue()
    }
    return null
}

String fmtDate(Date date, String tzId) {
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tzId))
    return sdf.format(date)
}

Map apiTimeView(Object value) {
    if (isBlankValue(value)) return [raw: &apos;&lt;empty&gt;&apos;, display: &apos;&lt;empty&gt;&apos;, compare: &apos;&lt;empty&gt;&apos;]
    Long ms = epochMillis(value)
    if (ms == null) return [raw: String.valueOf(value), display: String.valueOf(value), compare: String.valueOf(value)]
    Date d = new Date(ms)
    return [raw: String.valueOf(value), display: fmtDate(d, &apos;Asia/Shanghai&apos;), compare: fmtDate(d, &apos;UTC&apos;)]
}

Map dbTimeView(Object value) {
    if (isBlankValue(value)) return [raw: &apos;&lt;empty&gt;&apos;, display: &apos;&lt;empty&gt;&apos;, compare: &apos;&lt;empty&gt;&apos;]
    Long ms = epochMillis(value)
    if (ms != null) {
        Date d = new Date(ms)
        String utc = fmtDate(d, &apos;UTC&apos;)
        return [raw: String.valueOf(value), display: utc, compare: utc]
    }
    if (value instanceof Date) {
        String out = fmtDate(value, &apos;UTC&apos;)
        return [raw: String.valueOf(value), display: out, compare: out]
    }
    String s = value == null ? &apos;&apos; : value.toString().trim()
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    s = s.replaceAll(/\.\d+$/, &apos;&apos;)
    if (s.length() &gt;= 19) s = s.substring(0, 19)
    return [raw: String.valueOf(value), display: s, compare: s]
}

BigDecimal decimalOrNull(Object value) {
    if (value == null) return null
    String s = value.toString().trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!s || s.equalsIgnoreCase(&apos;null&apos;)) return null
    if (!(s ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

String decimalText(BigDecimal number) {
    return number == null ? &apos;&lt;empty&gt;&apos; : number.stripTrailingZeros().toPlainString()
}

String percentText(BigDecimal percent) {
    return percent == null ? &apos;N/A&apos; : percent.setScale(8, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos;
}

Map compareValues(Object apiValue, Object expectedValue, String field, String sourceLabel, BigDecimal tolerance) {
    if (isTimeField(field)) {
        def apiT = apiTimeView(apiValue)
        def sourceT = dbTimeView(expectedValue)
        boolean same = apiT.compare == sourceT.compare
        return [same: same, diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: same ? &apos;0%&apos; : &apos;N/A&apos;,
                formula: &quot;API对比UTC(${apiT.compare}) 与 ${sourceLabel}(${sourceT.compare}) 精确比较&quot;,
                note: same ? &apos;时间一致，通过&apos; : &apos;时间不一致，失败&apos;]
    }

    if (isBlankValue(apiValue) &amp;&amp; isBlankValue(expectedValue)) {
        return [same: true, diff: &apos;0&apos;, percent: &apos;0%&apos;, formula: &quot;API与${sourceLabel}均为空&quot;,
                note: &quot;API 和 ${sourceLabel} 返回都是为空，通过&quot;]
    }
    if (isBlankValue(apiValue) || isBlankValue(expectedValue)) {
        return [same: false, diff: &apos;N/A&apos;, percent: &apos;N/A&apos;, formula: &quot;API或${sourceLabel}单边为空&quot;,
                note: &apos;字段值单边为空，失败&apos;]
    }

    BigDecimal apiNumber = decimalOrNull(apiValue)
    BigDecimal sourceNumber = decimalOrNull(expectedValue)
    if (apiNumber != null &amp;&amp; sourceNumber != null) {
        BigDecimal difference = sourceNumber.subtract(apiNumber).abs()
        BigDecimal base = sourceNumber.abs()
        BigDecimal allowed = tolerance ?: BigDecimal.ZERO
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            boolean same = difference.compareTo(BigDecimal.ZERO) == 0
            return [same: same, diff: decimalText(difference), percent: same ? &apos;0%&apos; : &quot;无法计算(${sourceLabel}基准值为0)&quot;,
                    formula: &quot;abs((${sourceLabel}=0) - API=${decimalText(apiNumber)}) = ${decimalText(difference)}；基准值为0时要求绝对差值为0&quot;,
                    note: same ? &apos;基准值为0且数值一致，通过&apos; : &apos;基准值为0但绝对差值不为0，失败&apos;]
        }
        BigDecimal percent = difference.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 12, RoundingMode.HALF_UP)
        boolean same = percent.compareTo(allowed) &lt;= 0
        String allowedText = decimalText(allowed) + &apos;%&apos;
        String pct = percentText(percent)
        return [same: same, diff: decimalText(difference), percent: pct,
                formula: &quot;abs((${sourceLabel}=${decimalText(sourceNumber)}) - API=${decimalText(apiNumber)}) / abs(${sourceLabel}=${decimalText(sourceNumber)}) * 100 = ${pct}&quot;,
                note: same ? &quot;误差小于等于${allowedText}，通过&quot; : &quot;误差大于${allowedText}，失败&quot;]
    }

    boolean same = apiValue.toString().trim() == expectedValue.toString().trim()
    return [same: same, diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: same ? &apos;0%&apos; : &apos;N/A&apos;,
            formula: &quot;API与${sourceLabel}按字符串精确比较&quot;,
            note: same ? &apos;字符串一致，通过&apos; : &apos;字符串不一致，失败&apos;]
}

String printableValue(Object value) {
    if (isBlankValue(value)) return &apos;&lt;empty&gt;&apos;
    BigDecimal number = decimalOrNull(value)
    return number == null ? value.toString().trim() : decimalText(number)
}

String valueLine(String field, Object apiValue, Object expectedValue, String sourceLabel, String sourceField, boolean missingSource, String transformNote = null) {
    String missingText = sourceLabel == &apos;DB&apos; ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段&apos;
    if (isTimeField(field)) {
        def apiT = apiTimeView(apiValue)
        if (missingSource) return &quot;${field}: API=${apiT.raw} (${apiT.display}; 对比UTC=${apiT.compare}) | ${sourceLabel}=&lt;empty&gt; ${missingText} | ${sourceLabel}字段=${sourceField}&quot;
        def dbT = dbTimeView(expectedValue)
        String transformText = transformNote ? &quot; | ${transformNote}&quot; : &apos;&apos;
        return &quot;${field}: API=${apiT.raw} (${apiT.display}; 对比UTC=${apiT.compare}) | ${sourceLabel}=${dbT.raw} (${dbT.display}) | ${sourceLabel}字段=${sourceField}${transformText}&quot;
    }
    if (missingSource) return &quot;${field}: API=${printableValue(apiValue)} | ${sourceLabel}=&lt;empty&gt; ${missingText} | ${sourceLabel}字段=${sourceField}&quot;
    String transformText = transformNote ? &quot; | ${transformNote}&quot; : &apos;&apos;
    return &quot;${field}: API=${printableValue(apiValue)} | ${sourceLabel}=${printableValue(expectedValue)} | ${sourceLabel}字段=${sourceField}${transformText}&quot;
}

Set disabledSet(String raw) {
    return ((raw ?: &apos;&apos;).split(/[，,;；|\s]+/).findAll { it?.trim() }.collect {
        it.trim() == &apos;*&apos; ? &apos;*&apos; : normKey(it.trim())
    }) as Set
}

Map parseTolerance(String raw) {
    Map out = [:]
    (raw ?: &apos;&apos;).split(/[,，;；\n\r]+/).each { token -&gt;
        String entry = (token ?: &apos;&apos;).trim()
        if (!entry) return
        def matcher = entry =~ /^\s*([^:=\s]+)\s*(?:=|:|\s)\s*([0-9]+(?:\.[0-9]+)?)\s*%?\s*$/
        if (matcher.matches()) out[normKey(matcher.group(1))] = new BigDecimal(matcher.group(2))
    }
    return out
}

BigDecimal toleranceFor(String field, Map toleranceMap) {
    def configured = toleranceMap[normKey(field)]
    return configured instanceof BigDecimal ? configured : BigDecimal.ZERO
}

Map comparisonSourceValue(String field, Map located, String shujuku, String platform) {
    if (!located.present) return [value: null, transform: null]
    Object rawValue = located.value
    String fieldKey = normKey(field)
    boolean mt5VolumeField = shujuku == &apos;1&apos; &amp;&amp; platform == &apos;MT5&apos; &amp;&amp;
        fieldKey in [&apos;volumemax&apos;, &apos;volumemin&apos;, &apos;volumestep&apos;]
    if (!mt5VolumeField || isBlankValue(rawValue)) return [value: rawValue, transform: null]

    BigDecimal rawNumber = decimalOrNull(rawValue)
    if (rawNumber == null) {
        return [value: rawValue, transform: &quot;MT5 DB原值=${printableValue(rawValue)}不是数值，无法除以10000&quot;]
    }
    BigDecimal scaled = rawNumber.divide(new BigDecimal(&apos;10000&apos;), 12, RoundingMode.HALF_UP).stripTrailingZeros()
    return [value: scaled,
            transform: &quot;MT5 DB原值=${decimalText(rawNumber)}，原值/10000=${decimalText(scaled)}&quot;]
}

def aliases = [
    &apos;updated_utc_ms&apos;       : [&apos;updated_utc_ms&apos;, &apos;Timestamp&apos;, &apos;MODIFY_TIME&apos;],
    &apos;quote_updated_utc_ms&apos; : [&apos;quote_updated_utc_ms&apos;, &apos;Time&apos;, &apos;TIME&apos;],
    &apos;currency_base&apos;        : [&apos;currency_base&apos;, &apos;CurrencyBase&apos;],
    &apos;currency_margin&apos;      : [&apos;currency_margin&apos;, &apos;CurrencyMargin&apos;],
    &apos;profit_mode&apos;          : [&apos;profit_mode&apos;, &apos;CalcMode&apos;],
    &apos;tick_size&apos;            : [&apos;tick_size&apos;, &apos;TickSize&apos;],
    &apos;currency_profit&apos;      : [&apos;currency_profit&apos;, &apos;CurrencyProfit&apos;],
    &apos;trade_mode&apos;           : [&apos;trade_mode&apos;, &apos;TradeMode&apos;],
    &apos;ask&apos;                  : [&apos;ask&apos;, &apos;AskLast&apos;, &apos;ASK&apos;],
    &apos;name&apos;                 : [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;symbol_val&apos;, &apos;order_symbol&apos;],
    &apos;digits&apos;               : [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;contract_size&apos;        : [&apos;contract_size&apos;, &apos;ContractSize&apos;],
    &apos;bid&apos;                  : [&apos;bid&apos;, &apos;BidLast&apos;, &apos;BID&apos;],
    &apos;tick_value&apos;           : [&apos;tick_value&apos;, &apos;TickValue&apos;],
    &apos;volume_max&apos;           : [&apos;volume_max&apos;, &apos;VolumeMax&apos;, &apos;VOLUME_MAX&apos;],
    &apos;volume_min&apos;           : [&apos;volume_min&apos;, &apos;VolumeMin&apos;, &apos;VOLUME_MIN&apos;],
    &apos;volume_step&apos;          : [&apos;volume_step&apos;, &apos;VolumeStep&apos;, &apos;VOLUME_STEP&apos;]
]

String shujuku = vars.get(&apos;symbol_ex_check_shujuku&apos;) ?: (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = vars.get(&apos;symbol_ex_check_instanceid&apos;) ?: (vars.get(&apos;instanceid_val&apos;) ?: &apos;&apos;).trim()
String platform = vars.get(&apos;symbol_ex_check_db_platform&apos;) ?: &apos;&apos;
String expectedSymbol = vars.get(&apos;symbol_ex_check_symbol&apos;) ?: (vars.get(&apos;symbol_val&apos;) ?: vars.get(&apos;name&apos;) ?: &apos;&apos;).trim()
String compareSource = shujuku == &apos;1&apos; ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String disabledConfigName
String disabledRaw
if (shujuku == &apos;1&apos;) {
    if (platform == &apos;MT4&apos;) {
        disabledConfigName = &apos;symbol_ex_mt4_disabled_compare_fields&apos;
        disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
    } else if (platform == &apos;MT5&apos;) {
        disabledConfigName = &apos;symbol_ex_mt5_disabled_compare_fields&apos;
        disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
    } else {
        disabledConfigName = &apos;symbol_ex_unknown_disabled_compare_fields&apos;
        disabledRaw = &apos;&apos;
    }
} else {
    disabledConfigName = &apos;symbol_ex_csv_disabled_compare_fields&apos;
    disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
}
Set disabled = disabledSet(disabledRaw)

String toleranceConfigName
if (shujuku == &apos;1&apos;) {
    toleranceConfigName = platform == &apos;MT4&apos;
        ? &apos;symbol_ex_mt4_db_api_field_tolerance_percent&apos;
        : (platform == &apos;MT5&apos; ? &apos;symbol_ex_mt5_db_api_field_tolerance_percent&apos; : &apos;symbol_ex_unknown_db_api_field_tolerance_percent&apos;)
} else {
    toleranceConfigName = &apos;symbol_ex_csv_api_field_tolerance_percent&apos;
}
String toleranceRaw = vars.get(toleranceConfigName) ?: &apos;&apos;
Map toleranceMap = parseTolerance(toleranceRaw)

def apiRows = asRows(parsed).collect { rowToMap(it) }
def apiRow = apiRows.find {
    String.valueOf(readByAliases(it, [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;symbol_val&apos;])).equalsIgnoreCase(expectedSymbol)
}
if (apiRow == null &amp;&amp; apiRows.size() == 1) apiRow = apiRows[0]

if (apiRow == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;接口响应中没有匹配的品种 name/symbol=${expectedSymbol}，接口返回记录数=${apiRows.size()}&quot;)
    return
}

Map sourceRow = new LinkedHashMap()
String sourceLabel = shujuku == &apos;1&apos; ? &apos;DB&apos; : &apos;CSV&apos;
if (shujuku == &apos;1&apos;) {
    def dbRows = (vars.getObject(&apos;db_symbol_ex_check_rows&apos;) ?: []).collect { rowToMap(it) }
    sourceRow = dbRows.find {
        String.valueOf(readByAliases(it, [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;])).equalsIgnoreCase(expectedSymbol)
    }
    if (sourceRow == null &amp;&amp; dbRows.size() == 1) sourceRow = dbRows[0]
    if (sourceRow == null) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;数据库没有查询到匹配品种: instanceid=${instanceId}, symbol=${expectedSymbol}, DB记录数=${dbRows.size()}&quot;)
        return
    }
} else {
    aliases.keySet().each { field -&gt;
        def csvVal = vars.get(field)
        if (csvVal == null &amp;&amp; field == &apos;name&apos;) csvVal = expectedSymbol
        sourceRow[field] = csvVal
    }
    sourceRow[&apos;symbol_val&apos;] = expectedSymbol
    sourceRow[&apos;order_instanceid_val&apos;] = instanceId
}

int apiFieldTotal = apiRow.keySet().size()
def ok = []
def bad = []
def skipped = []

apiRow.each { field, apiValue -&gt;
    String fieldKey = normKey(field)
    Map located = locateField(sourceRow, field, aliases)
    String matchedSourceField = located.present ? String.valueOf(located.key) : field
    Map prepared = comparisonSourceValue(field, located, shujuku, platform)
    Object expectedValue = prepared.value
    String transformNote = prepared.transform

    // 跳过配置优先级最高：即使DB根本无字段，也允许明确配置后跳过。
    if (disabled.contains(&apos;*&apos;) || disabled.contains(fieldKey)) {
        String skipLine = valueLine(field, apiValue, expectedValue, sourceLabel, matchedSourceField, !located.present, transformNote)
        skipped &lt;&lt; skipLine + &quot; | 备注=字段已配置在${disabledConfigName}，未校验&quot;
        return
    }

    // 字段是否存在必须通过Map的key判断，不能把“存在但NULL”误判成“数据库无此字段”。
    if (!located.present) {
        String aliasesText = ([field] + (aliases[field] ?: [])).unique().join(&apos;/&apos;)
        String missingLine = valueLine(field, apiValue, null, sourceLabel, aliasesText, true, null)
        String missingNote = shujuku == &apos;1&apos;
            ? &apos;数据库无此字段，可配置跳过&apos;
            : &apos;CSV无此字段，可配置跳过&apos;
        bad &lt;&lt; missingLine + &quot; | 备注=${missingNote}&quot;
        return
    }

    String line = valueLine(field, apiValue, expectedValue, sourceLabel, matchedSourceField, false, transformNote)

    if (isBlankValue(apiValue) &amp;&amp; isBlankValue(expectedValue)) {
        ok &lt;&lt; line + &quot; | matched=${sourceLabel}(${matchedSourceField}) | 字段误差=0% | 差值=0 | 差值百分比=0% | 计算公式=API与${sourceLabel}均为空 | 备注=API 和 ${sourceLabel} 返回都是为空，通过&quot;
        return
    }

    BigDecimal apiNumber = decimalOrNull(apiValue)
    if (isBlankValue(expectedValue) &amp;&amp; apiNumber != null &amp;&amp; apiNumber.compareTo(BigDecimal.ZERO) == 0) {
        ok &lt;&lt; line + &quot; | matched=${sourceLabel}(${matchedSourceField}) | 字段误差=0% | 差值=0 | 差值百分比=0% | 计算公式=API=0且${sourceLabel}字段存在但数据为空 | 备注=API=0 和 ${sourceLabel} 查询字段数据是空，通过&quot;
        return
    }

    BigDecimal tolerance = toleranceFor(field, toleranceMap)
    Map comparison = compareValues(apiValue, expectedValue, field, sourceLabel, tolerance)
    String detail = &quot; | matched=${sourceLabel}(${matchedSourceField}) | 字段误差=${decimalText(tolerance)}% | 差值=${comparison.diff} | 差值百分比=${comparison.percent} | 计算公式=${comparison.formula} | 备注=${comparison.note}&quot;
    if (comparison.same) ok &lt;&lt; line + detail else bad &lt;&lt; line + detail
}

def reportLines = []
reportLines &lt;&lt; &apos;============================================================&apos;
reportLines &lt;&lt; &quot;符号规格和实时报价 ${compareSource} 字段对比结果&quot;
reportLines &lt;&lt; &quot;状态: ${bad.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;} | instanceid=${instanceId} | symbol=${expectedSymbol} | platform=${platform} | shujuku=${shujuku}&quot;
reportLines &lt;&lt; &quot;接口对比字段总数量: ${apiFieldTotal} | 成功字段数量: ${ok.size()} | 失败字段数量: ${bad.size()} | 跳过字段(未校验)数量: ${skipped.size()}&quot;
reportLines &lt;&lt; &quot;当前跳过字段配置: ${disabledConfigName}=${disabledRaw?.trim() ? disabledRaw : &apos;&lt;empty&gt;&apos;}&quot;
reportLines &lt;&lt; &quot;当前字段误差配置: ${toleranceConfigName}=${toleranceRaw?.trim() ? toleranceRaw : &apos;&lt;empty&gt;&apos;}；未配置数值字段默认0%；以${sourceLabel}绝对值为基准计算，误差小于等于字段配置值通过&quot;
reportLines &lt;&lt; &quot;空值规则: API与${sourceLabel}字段值均为空则通过；API=0且${sourceLabel}字段存在但值为空则通过；${sourceLabel}根本无字段仍失败并可配置跳过&quot;
reportLines &lt;&lt; &quot;MT5 volume规则: shujuku=1且platform=MT5时，volume_max/volume_min/volume_step使用DB原值除以10000后对比；MT4与CSV不缩放&quot;
reportLines &lt;&lt; &quot;时间规则: 最新OpenAPI规定*_utc_ms为Unix epoch毫秒；API按Asia/Shanghai展示并以UTC比较；MT5 18位Windows FILETIME会先转换为Unix epoch毫秒&quot;
reportLines &lt;&lt; &apos;============================================================&apos;
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;成功字段（${ok.size()}）：&quot;
reportLines.addAll(ok ? ok.collect { &apos; [成功] &apos; + it } : [&apos; - 无&apos;])
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;失败字段（${bad.size()}）：&quot;
reportLines.addAll(bad ? bad.collect { &apos; [失败] &apos; + it } : [&apos; - 无&apos;])
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;跳过字段（未校验）（${skipped.size()}）：&quot;
reportLines.addAll(skipped ? skipped.collect { &apos; [跳过] &apos; + it } : [&apos; - 无&apos;])

String report = reportLines.join(&apos;\n&apos;)
vars.put(&apos;symbol_ex_compare_report&apos;, report)

try {
    SampleResult detail = new SampleResult()
    detail.setSampleLabel(&quot;符号规格和实时报价 ${compareSource} 字段对比结果&quot;)
    detail.setDataType(SampleResult.TEXT)
    detail.sampleStart()
    detail.setResponseCode(bad.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(bad.isEmpty() ? &quot;${compareSource} compare passed&quot; : &quot;${compareSource} compare failed&quot;)
    detail.setSuccessful(bad.isEmpty())
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    detail.setResponseData(report, &apos;UTF-8&apos;)
    detail.sampleEnd()
    prev.addSubResult(detail)
} catch (Throwable e) {
    log.warn(&apos;Add symbol_ex compare detail failed: &apos; + e.message, e)
}

if (bad) {
    log.warn(report)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(report)
} else {
    log.info(report)
    AssertionResult.setFailure(false)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">依据MT-Hub API 1.0.1-beta1.59.9：shujuku=1执行DB/API字段对比，shujuku=0执行CSV/API字段对比。MT4、MT5、CSV分别支持所有字段跳过和逐字段百分比误差，未配置误差默认0%；严格按Map key区分字段存在但为空与根本无字段；空空、API=0且来源字段存在但为空时通过；DB无字段失败且可人工跳过。MT5 volume_max/volume_min/volume_step先将DB原值除以10000，MT4不缩放。*_utc_ms按Unix epoch毫秒比较，并兼容MT5 Windows FILETIME。</stringProp>
            </JSR223Assertion>
