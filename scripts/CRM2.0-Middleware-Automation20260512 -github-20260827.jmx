                <stringProp name="variableNames">instanceid,login,money,deal_type,order_ticket,margin,balance,margin_free,deal_ticket,credit,margin_level,equity,profit</stringProp>
                <boolProp name="ignoreFirstLine">true</boolProp>
                <stringProp name="delimiter">,</stringProp>
                <boolProp name="quotedData">false</boolProp>
