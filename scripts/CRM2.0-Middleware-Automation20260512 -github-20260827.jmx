                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT5数据库与API字段对比的跳过字段，不影响CSV/API；多个字段用逗号分隔；填 * 表示只校验订单号匹配。</stringProp>
              </elementProp>
            </collectionProp>
