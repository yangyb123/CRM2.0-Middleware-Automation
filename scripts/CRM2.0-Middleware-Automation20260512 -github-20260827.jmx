    &quot;instanceid&quot;: &quot;${instanceid_val}&quot;,&#xd;
	&quot;login&quot;: &quot;${login_val}&quot;,&#xd;
	&quot;password&quot;: &quot;Passw0rd.&quot;,&#xd;
