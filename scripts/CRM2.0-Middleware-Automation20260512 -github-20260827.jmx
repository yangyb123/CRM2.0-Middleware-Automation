                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">是否校验summary；只有当前页为全量页时校验summary金额/手数字段，否则只校验summary字段存在和total_orders=data.total。</stringProp>
              </elementProp>
              <elementProp name="open_positions_aux_profit_calc_enabled" elementType="Argument">
                <stringProp name="Argument.name">open_positions_aux_profit_calc_enabled</stringProp>
