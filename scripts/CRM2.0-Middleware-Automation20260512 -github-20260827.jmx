          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化本次盈亏校验时间窗口-北京时间偏移177分钟" enabled="false">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">long offsetMs = 177L * 60L * 1000L
long startMs = System.currentTimeMillis()
long closeFromMs = startMs + offsetMs
vars.put(&apos;profit_check_start_utc_ms&apos;, String.valueOf(startMs))
vars.put(&apos;close_time_from_utc_ms&apos;, String.valueOf(closeFromMs))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
SampleResult.setResponseData(&apos;close_time_from_utc_ms=System.currentTimeMillis()+177*60*1000=&apos; + closeFromMs, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
