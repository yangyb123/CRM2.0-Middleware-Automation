          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="自定义统计聚合001-MT5 DB/API跳过字段" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="custom_stat_mt5_db_api_disabled_fields" elementType="Argument">
                <stringProp name="Argument.name">custom_stat_mt5_db_api_disabled_fields</stringProp>
                <stringProp name="Argument.value">avg,stddev,max,min,balance_avg,balance_max,balance_min,balance_stddev,credit_avg,credit_max,credit_min,credit_stddev,,equity_avg,equity_max,equity_min,equity_stddev,leverage_avg,leverage_max,leverage_min,leverage_stddev,margin_avg,margin_max,margin_min,margin_stddev,margin_free_avg,margin_free_max,margin_free_min,margin_free_stddev,margin_level_avg,margin_level_max,margin_level_min,margin_level_stddev,position_count_avg,position_count_max,position_count_min,position_count_stddev,profit_avg,profit_max,profit_min,profit_stddev,balance_max,credit_max,equity_max,leverage_max,margin_max,margin_free_max,margin_level_min,margin_level_stddev,position_count_max,profit_min,balance_min,balance_stddev,credit_avg,credit_min,credit_stddev,equity_avg,equity_min,equity_stddev,leverage_avg,leverage_min,leverage_stddev,margin_avg,margin_min,margin_stddev,margin_free_avg,margin_free_min,margin_free_stddev,margin_level_avg,margin_level_max,position_count_avg,position_count_min,position_count_stddev,profit_avg,profit_max,profit_stddev,count,leverage_sum,margin_sum,margin_free_sum,margin_level_sum,position_count_sum,profit_sum,margin_sum ,margin_free_sum,position_count_sum,profit_sum</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT5 DB/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
