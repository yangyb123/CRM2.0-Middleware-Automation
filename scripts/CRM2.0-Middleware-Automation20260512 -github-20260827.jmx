          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询多个账户当前持仓订单-${open_positions_mode}-${open_positions_case_index_display}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
