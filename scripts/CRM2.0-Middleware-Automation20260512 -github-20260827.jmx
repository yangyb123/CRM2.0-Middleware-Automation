        String calcEvidence=&apos;formula_case=&apos;+formulaCase+&apos;,symbol=&apos;+calcSymbol+&apos;,normalized_pair=&apos;+pairCore+&apos;,inferred_fx=&apos;+inferredFx+&apos;,volume_lots=&apos;+numText(calcVolume)+&apos;,contract_size=&apos;+numText(calcContract)+&apos;,open_price=&apos;+numText(calcOpenPrice)+&apos;,close_price=&apos;+numText(calcClosePrice)+&apos;,profit_mode=&apos;+pm+&apos;,currency_base=&apos;+cb+&apos;,currency_profit=&apos;+cp+&apos;,symbol_fallback=&apos;+(si.__symbol_fallback?:&apos;&lt;none&gt;&apos;)+&apos;,symbol_retry_no=&apos;+(si.__retry_no?:&apos;1&apos;)+&apos;,symbol_retry_errors=&apos;+(si.__retry_errors?:&apos;&lt;none&gt;&apos;)+&apos;,conversion_symbol=&apos;+(ci.__query_symbol?:&apos;&lt;not-required&gt;&apos;)+&apos;,conversion_direction=&apos;+(ci.__rate_direction?:&apos;&lt;not-required&gt;&apos;)+&apos;,conversion_attempts=&apos;+(ci.__candidate_attempts?:&apos;&lt;not-required&gt;&apos;)+&apos;,bid=&apos;+numText(rateBid)+&apos;,ask=&apos;+numText(rateAsk)+&apos;,MidPrice5=&apos;+numText(calcUsdRate)+&apos;,symbol_error=&apos;+(si.__error?:&apos;&lt;none&gt;&apos;)+&apos;,primary_symbol_error=&apos;+(si.__primary_symbol_error?:&apos;&lt;none&gt;&apos;)+&apos;,conversion_error=&apos;+(ci.__error?:&apos;&lt;none&gt;&apos;)
        if(dbMode)disabled&lt;&lt;norm(&apos;notional_calculation_version&apos;)
        String notionalPercentRaw=vars.get(&apos;competition_history_notional_calc_api_tolerance_percent&apos;)?:&apos;&apos;
        String notionalAbsoluteRaw=vars.get(&apos;competition_history_notional_calc_api_absolute_tolerance&apos;)?:&apos;&apos;
        Map&lt;String,BigDecimal&gt; notionalPercentMap=valueMap(notionalPercentRaw),notionalAbsoluteMap=valueMap(notionalAbsoluteRaw)
        def notionalTolerance={Map&lt;String,BigDecimal&gt; cfg,String calcField,String apiField,BigDecimal defaultValue-&gt;String calcKeyNorm=norm(calcField),apiFieldKeyNorm=norm(apiField);cfg.containsKey(calcKeyNorm)?cfg[calcKeyNorm]:(cfg.containsKey(apiFieldKeyNorm)?cfg[apiFieldKeyNorm]:defaultValue)}
        String statusLine=&apos;field=notional_status | API.notional_status=&apos;+apiStatus+&apos; | calc_cnotional_status=&apos;+calcCnotionalStatus+&apos; | data.row=&apos;+(i+1)+&apos; | 判断条件=开仓侧、平仓侧、合约规格、计价币种及get_symbol_ex转换报价完整才resolved，否则unresolved | 证据=&apos;+calcEvidence
        if(disabled.contains(&apos;*&apos;)||disabled.contains(norm(&apos;notional_status&apos;))){skipLines&lt;&lt;&apos; - [跳过] | &apos;+statusLine+&apos; | 备注=notional_status已配置跳过&apos;}else if(apiStatus==calcCnotionalStatus)okLines&lt;&lt;&apos; - [通过] | &apos;+statusLine else failLines&lt;&lt;&apos; - [失败] | &apos;+statusLine
        [[field:&apos;open_notional_value_usd&apos;,calcField:&apos;calc_open_notional_value_usd&apos;,api:apiRow.open_notional_value_usd,calc:calcOpenNotional],
         [field:&apos;close_notional_value_usd&apos;,calcField:&apos;calc_close_notional_value_usd&apos;,api:apiRow.close_notional_value_usd,calc:calcCloseNotional]].each{Map nc-&gt;
            BigDecimal av=number(nc.api),cv=number(nc.calc),diff=av!=null&amp;&amp;cv!=null?av.subtract(cv).abs():null
            String calcCompareField=String.valueOf(nc.calcField),apiCompareField=String.valueOf(nc.field)
            boolean skipNotional=disabled.contains(&apos;*&apos;)||disabled.contains(norm(calcCompareField))||disabled.contains(norm(apiCompareField))
            BigDecimal legacyPercent=notionalTolerance(notionalPercentMap,calcCompareField,apiCompareField,BigDecimal.ZERO)
            BigDecimal legacyAbsolute=notionalTolerance(notionalAbsoluteMap,calcCompareField,apiCompareField,new BigDecimal(&apos;0.00001&apos;))
            BigDecimal allowedPercent=notionalTolerance(percentMap,calcCompareField,apiCompareField,legacyPercent)
            BigDecimal allowedAbsolute=notionalTolerance(absoluteMap,calcCompareField,apiCompareField,legacyAbsolute)
            BigDecimal relativeAllowed=cv!=null?cv.abs().multiply(allowedPercent).divide(new BigDecimal(&apos;100&apos;),12,RoundingMode.HALF_UP):BigDecimal.ZERO
            BigDecimal finalAllowed=allowedAbsolute.max(relativeAllowed)
            String actualPercent=diff!=null&amp;&amp;cv!=null&amp;&amp;cv!=BigDecimal.ZERO?diff.multiply(new BigDecimal(&apos;100&apos;)).divide(cv.abs(),10,RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()+&apos;%&apos;:(diff==BigDecimal.ZERO?&apos;0%&apos;:&apos;N/A&apos;)
            boolean same=calcCnotionalStatus==&apos;unresolved&apos;?(nc.api==null&amp;&amp;nc.calc==null):(av!=null&amp;&amp;cv!=null&amp;&amp;diff&lt;=finalAllowed)
            BigDecimal eventPrice=nc.field==&apos;open_notional_value_usd&apos;?calcOpenPrice:calcClosePrice
            BigDecimal rawSingleNotional=nc.field==&apos;open_notional_value_usd&apos;?rawOpenNotional:rawCloseNotional
            String actualExpression=numText(calcContract)+&apos;*&apos;+numText(calcVolume)+(requiresMarketPrice?&apos;*&apos;+numText(eventPrice):&apos;&apos;)+((formulaCase.startsWith(&apos;1-&apos;)||formulaCase.startsWith(&apos;4-&apos;))?&apos;&apos;:&apos;*&apos;+numText(calcUsdRate))+&apos;=&apos;+(rawSingleNotional==null?&apos;null&apos;:numText(rawSingleNotional))+&apos;；ROUND_HALF_UP(raw,5)=&apos;+(nc.calc==null?&apos;null&apos;:numText(nc.calc))
            String bilateralExpression=&apos;raw_open=&apos;+(rawOpenNotional==null?&apos;null&apos;:numText(rawOpenNotional))+&apos; + raw_close=&apos;+(rawCloseNotional==null?&apos;null&apos;:numText(rawCloseNotional))+&apos; = raw_bilateral=&apos;+(rawBilateralNotional==null?&apos;null&apos;:numText(rawBilateralNotional))+&apos;；ROUND_HALF_UP(raw_bilateral,5)=&apos;+(calcBilateralNotional==null?&apos;null&apos;:numText(calcBilateralNotional))
            String toleranceDetail=&apos;配置百分比误差=&apos;+numText(allowedPercent)+&apos;% | 配置绝对误差=&apos;+numText(allowedAbsolute)+&apos; | 百分比折算绝对误差=&apos;+numText(relativeAllowed)+&apos; | 最终允许差值=max(配置绝对误差,百分比折算)=&apos;+numText(finalAllowed)+&apos; | 实际相差百分比=&apos;+actualPercent
            String unresolvedRule=calcCnotionalStatus==&apos;unresolved&apos;?&apos; | unresolved规则=calc与API的open/close名义价值都应为null&apos;:&apos;&apos;
            String line=&apos;NOTIONAL_CALC_PRINT_V4 | field=&apos;+nc.field+&apos; | &apos;+nc.calcField.replace(&apos;calc_open_notional_value_usdcale&apos;,&apos;calc_open_notional_value_usd&apos;)+&apos;=&apos;+(nc.calc==null?&apos;null&apos;:numText(nc.calc))+&apos; | calc_bilateral_notional_value_usd=&apos;+(calcBilateralNotional==null?&apos;null&apos;:numText(calcBilateralNotional))+&apos; | API_&apos;+nc.field+&apos;=&apos;+(nc.api==null?&apos;null&apos;:numText(nc.api))+&apos; | API.notional_status=&apos;+apiStatus+&apos; | calc_cnotional_status=&apos;+calcCnotionalStatus+&apos; | formula_case=&apos;+formulaCase+&apos; | formula=&apos;+formulaTemplate+&apos; | Symbol=&apos;+calcSymbol+&apos; | Base_Currency=&apos;+cb+&apos; | Quote_Currency=&apos;+quoteCurrency+&apos; | Contract_Size=&apos;+numText(calcContract)+&apos; | Trading_Volume_Lots=&apos;+numText(calcVolume)+&apos; | Open_Price=&apos;+numText(calcOpenPrice)+&apos; | Close_Price=&apos;+numText(calcClosePrice)+&apos; | Current_Leg_Market_Price=&apos;+numText(eventPrice)+&apos; | Conversion_Symbol=&apos;+(ci.__query_symbol?:&apos;&lt;not-required&gt;&apos;)+&apos; | Conversion_Direction=&apos;+(ci.__rate_direction?:&apos;&lt;not-required&gt;&apos;)+&apos; | Conversion_Attempts=&apos;+(ci.__candidate_attempts?:&apos;&lt;not-required&gt;&apos;)+&apos; | Bid=&apos;+numText(rateBid)+&apos; | Ask=&apos;+numText(rateAsk)+&apos; | Bid_Plus_Ask=&apos;+((rateBid!=null&amp;&amp;rateAsk!=null)?numText(rateBid.add(rateAsk)):&apos;null&apos;)+&apos; | Exchange_USD=&apos;+midPriceProcess+&apos; | Bid_Ask_Usage=&apos;+(ci.__bid_ask_usage?:&apos;used_for_exchange_usd&apos;)+&apos; | quote_source=&apos;+(ci.__rate_source?:&apos;get_symbol_ex_current_quote&apos;)+&apos; | primary_request=&apos;+(si.__request?:&apos;&lt;none&gt;&apos;)+&apos; | conversion_request=&apos;+(ci.__request?:&apos;&lt;none&gt;&apos;)+&apos; | 单边计算过程=&apos;+actualExpression+&apos; | 双边计算过程=&apos;+bilateralExpression+&apos; | 差值=&apos;+(diff==null?&apos;N/A&apos;:numText(diff))+&apos; | &apos;+toleranceDetail+&apos; | instanceid=&apos;+String.valueOf(apiRow.instance_id?:&apos;&lt;empty&gt;&apos;)+&apos; | login=&apos;+idText(apiRow.login)+&apos; | order_id=&apos;+idText(apiRow.order_id)+&apos; | position_id=&apos;+String.valueOf(apiRow.position_id?:&apos;&lt;empty&gt;&apos;)+&apos; | position_lifecycle_id=&apos;+String.valueOf(apiRow.position_lifecycle_id?:&apos;&lt;empty&gt;&apos;)+&apos; | symbol=&apos;+String.valueOf(apiRow.symbol?:&apos;&lt;empty&gt;&apos;)+&apos; | data.row=&apos;+(i+1)+unresolvedRule
            if(skipNotional)skipLines&lt;&lt;&apos; - [跳过] | &apos;+line+&apos; | 备注=字段已配置跳过（支持&apos;+calcCompareField+&apos;或&apos;+apiCompareField+&apos;）&apos; else if(same)okLines&lt;&lt;&apos; - [通过] | &apos;+line else failLines&lt;&lt;&apos; - [失败] | &apos;+line
        }
        List&lt;String&gt; dbCompareFields=new ArrayList&lt;String&gt;(fields)
        String dbManualCompareRaw=vars.get(&apos;competition_history_db_api_manual_compare_fields&apos;)?:&apos;&apos;
        String.valueOf(dbManualCompareRaw).split(/[,;\r\n]+/).each{String configuredField-&gt;String fieldName=String.valueOf(configuredField?:&apos;&apos;).trim();if(fieldName&amp;&amp;!dbCompareFields.any{norm(it)==norm(fieldName)})dbCompareFields&lt;&lt;fieldName}
        dbCompareFields.each{String f-&gt;
            Map a=lookup(apiRow,f),d=lookup(dbRow,f)
            if(disabled.contains(&apos;*&apos;)||disabled.contains(norm(f))){skipLines&lt;&lt;&apos; - [跳过] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&apos;+(a.exists?numText(a.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | DB=&apos;+(d.exists?numText(d.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | 备注=DB/API无条件跳过配置&apos;;return}
            if(!a.exists){failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&lt;field-missing&gt; | DB=&apos;+(d.exists?numText(d.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | 原因=接口缺少必返字段&apos;;return}
            if(!d.exists){if(missingSkip.contains(&apos;*&apos;)||missingSkip.contains(norm(f)))skipLines&lt;&lt;&apos; - [跳过] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&apos;+numText(a.value)+&apos; | DB=&lt;field-missing&gt; | 备注=数据库无此字段，已按配置跳过&apos;;else failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&apos;+numText(a.value)+&apos; | DB=&lt;field-missing&gt; | 原因=数据库无此字段；字段不存在不等于字段值为空，可设置跳过&apos;;return}
            Map cr=compare(f,a.value,d.value,&apos;DB&apos;,percentMap,defaultPercent,absoluteMap,defaultAbsolute)
            String line=&apos;field=&apos;+f+&apos; | API=&apos;+cr.api+&apos; | DB=&apos;+cr.expected+&apos; | data.row=&apos;+(i+1)+&apos; | APIField=&apos;+a.key+&apos; | DBField=&apos;+d.key+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+cr.formula+&apos; | 备注=&apos;+cr.note
            if(cr.same)okLines&lt;&lt;&apos; - [通过] | &apos;+line else failLines&lt;&lt;&apos; - [失败] | &apos;+line
        }
    }
    boolean paged=!blank(root.next_cursor)||!blank(vars.get(&apos;competition_history_cursor&apos;))
    if(!paged&amp;&amp;apiRows.isEmpty()&amp;&amp;!dbRows.isEmpty()&amp;&amp;errors.isEmpty())failLines&lt;&lt;&apos; - [失败] | API完全关闭生命周期记录=0 | DB原始候选记录=&apos;+dbRows.size()+&apos; | 原因=非分页请求不允许将DB全部记录当作投影差异跳过&apos;
dbRows.eachWithIndex{Map r,int j-&gt;if(!used.contains(j)){unmatchedDbCount++;String line=&apos; | DB键=&apos;+dbDisplayKey(r)+&apos; | DB记录=&apos;+r;if(paged)skipLines&lt;&lt;&apos; - [跳过] | DB未匹配记录&apos;+line+&apos; | 备注=存在cursor，仅校验当前页，其他分页记录不判接口遗漏&apos;;else if(unmatchedDbPolicy==&apos;fail&apos;)failLines&lt;&lt;&apos; - [失败] | 数据库有记录但接口未返回&apos;+line+&apos; | 备注=失败原因：数据库中正常查询到有数据，但是在接口中未返回此条数据&apos;;else skipLines&lt;&lt;&apos; - [跳过] | 数据库存在未进入当前API生命周期投影的原始报表记录&apos;+line+&apos; | 备注=仅在显式配置skip时跳过；默认fail会将数据库有而接口无的记录列入失败&apos;}}
    if(!apiRows&amp;&amp;!dbRows&amp;&amp;!errors)okLines&lt;&lt;&apos; - [通过] | DB/API历史记录数均为0&apos;
}else{
    List&lt;String&gt; csvCompareFields=new ArrayList&lt;String&gt;(fields)
    String csvManualCompareRaw=vars.get(&apos;competition_history_csv_api_manual_compare_fields&apos;)?:&apos;&apos;
    String.valueOf(csvManualCompareRaw).split(/[,;\r\n]+/).each{String configuredField-&gt;String fieldName=String.valueOf(configuredField?:&apos;&apos;).trim();if(fieldName&amp;&amp;!csvCompareFields.any{norm(it)==norm(fieldName)})csvCompareFields&lt;&lt;fieldName}
    Map csvRow=vars.getObject(&apos;competition_history_current_csv_row&apos;) instanceof Map?new LinkedHashMap((Map)vars.getObject(&apos;competition_history_current_csv_row&apos;)):[:]
    String expectedInstance=String.valueOf(csvRow.instance_id?:csvRow.instanceid?:&apos;&apos;).trim();String expectedLogin=idText(csvRow.login)
    String wantedLifecycle=String.valueOf(csvRow.position_lifecycle_id?:&apos;&apos;).trim(),wantedPosition=String.valueOf(csvRow.position_id?:&apos;&apos;).trim(),wantedOrder=idText(csvRow.order_id),wantedSymbol=String.valueOf(csvRow.symbol?:&apos;&apos;).trim()
    List&lt;Map&gt; candidates=apiRows.findAll{Map r-&gt;if(String.valueOf(r.instance_id?:&apos;&apos;)!=expectedInstance||idText(r.login)!=expectedLogin)return false;if(wantedLifecycle)return String.valueOf(r.position_lifecycle_id?:&apos;&apos;)==wantedLifecycle;if(wantedPosition)return String.valueOf(r.position_id?:&apos;&apos;)==wantedPosition;if(wantedOrder)return idText(r.order_id)==wantedOrder;wantedSymbol?String.valueOf(r.symbol?:&apos;&apos;)==wantedSymbol:true}
    if(candidates.size()!=1)failLines&lt;&lt;&apos; - [失败] | CSV行=&apos;+vars.get(&apos;competition_history_csv_line_no&apos;)+&apos; | account=&apos;+expectedInstance+&apos;|&apos;+expectedLogin+&apos; | lifecycle=&apos;+(wantedLifecycle?:&apos;&lt;empty&gt;&apos;)+&apos; | position=&apos;+(wantedPosition?:&apos;&lt;empty&gt;&apos;)+&apos; | 原因=接口匹配记录应为1条，实际=&apos;+candidates.size()
    else{Map apiRow=candidates[0];reportCsvApiRow=apiRow;csvCompareFields.each{String f-&gt;
        Map a=lookup(apiRow,f);Object rawObj;boolean has=true
        if(f==&apos;instance_id&apos;)rawObj=csvRow.instance_id?:csvRow.instanceid
        else if(f==&apos;login&apos;)rawObj=csvRow.login
        else if(f==&apos;platform&apos;){String p=String.valueOf(csvRow.platform?:&apos;&apos;).trim().toLowerCase();rawObj=p?:(expectedInstance.toUpperCase().contains(&apos;MT4&apos;)?&apos;mt4&apos;:expectedInstance.toUpperCase().contains(&apos;MT5&apos;)?&apos;mt5&apos;:&apos;&apos;)}
        else if(csvRow.containsKey(f))rawObj=csvRow[f]
        else has=false
        String raw=rawObj==null?&apos;&apos;:String.valueOf(rawObj).trim()
        if(disabled.contains(&apos;*&apos;)||disabled.contains(norm(f))){skipLines&lt;&lt;&apos; - [跳过] | field=&apos;+f+&apos; | API=&apos;+(a.exists?numText(a.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | CSV=&apos;+(raw?:&apos;&lt;empty&gt;&apos;)+&apos; | 备注=CSV/API跳过配置&apos;;return}
        if(!has){failLines&lt;&lt;&apos; - [失败] | field=&apos;+f+&apos; | 原因=CSV表头缺少V1字段&apos;;return}
        if(!raw){skipLines&lt;&lt;&apos; - [跳过] | field=&apos;+f+&apos; | API=&apos;+(a.exists?numText(a.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | CSV=&lt;empty&gt; | 备注=未填写期望值；字段结构和类型仍已校验，断言空值请填写&lt;empty&gt;&apos;;return}
        if(!a.exists){failLines&lt;&lt;&apos; - [失败] | field=&apos;+f+&apos; | API=&lt;field-missing&gt; | CSV=&apos;+raw;return}
        Object expected=raw in [&apos;&lt;empty&gt;&apos;,&apos;&lt;null&gt;&apos;]?null:raw;Map cr=compare(f,a.value,expected,&apos;CSV&apos;,percentMap,defaultPercent,absoluteMap,defaultAbsolute)
        String line=&apos;field=&apos;+f+&apos; | API=&apos;+cr.api+&apos; | CSV=&apos;+cr.expected+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+cr.formula+&apos; | 备注=&apos;+cr.note
        if(cr.same)okLines&lt;&lt;&apos; - [通过] | &apos;+line else failLines&lt;&lt;&apos; - [失败] | &apos;+line
    }}
}

// HISTORY_TRADE_CONTEXT_V1: 为每条可定位的字段明细统一补充账户、订单、持仓及生命周期上下文，不改变原有比对结果。
def reportValue={Object v,boolean integerId-&gt;String text=integerId?idText(v):(blank(v)?&apos;&apos;:String.valueOf(v).trim());text?:&apos;&lt;empty&gt;&apos;}
def withHistoryTradeContext={String line-&gt;
    if(!line)return line
    if(line.contains(&apos;NOTIONAL_CALC_PRINT_V3&apos;)||line.contains(&apos;NOTIONAL_CALC_PRINT_V4&apos;))return line.replace(&apos;NOTIONAL_CALC_PRINT_V3 | &apos;,&apos;&apos;).replace(&apos;NOTIONAL_CALC_PRINT_V4 | &apos;,&apos;&apos;)
    Map apiRow=null
    def rowMatcher=(line=~/((?:^|\|\s*)data\.row=(\d+))/)
    if(rowMatcher.find()){int rowNo=Integer.parseInt(rowMatcher.group(2));if(rowNo&gt;0&amp;&amp;rowNo&lt;=apiRows.size())apiRow=apiRows[rowNo-1]}
    if(apiRow==null&amp;&amp;!dbMode&amp;&amp;reportCsvApiRow&amp;&amp;line.contains(&apos; | field=&apos;)&amp;&amp;!line.contains(&apos;errors.row=&apos;)&amp;&amp;!line.contains(&apos;envelope.field=&apos;))apiRow=reportCsvApiRow
    if(!(apiRow instanceof Map))return line
    String context=&apos;instanceid=&apos;+reportValue(apiRow.instance_id,false)+&apos; | login=&apos;+reportValue(apiRow.login,true)+&apos; | order_id=&apos;+reportValue(apiRow.order_id,true)+&apos; | position_id=&apos;+reportValue(apiRow.position_id,false)+&apos; | position_lifecycle_id=&apos;+reportValue(apiRow.position_lifecycle_id,false)+&apos; | symbol=&apos;+reportValue(apiRow.symbol,false)
    // HISTORY_FIELD_API_DB_FIRST_V2: 固定输出field | API | DB，再追加订单和生命周期上下文。
    String workingLine=line,fieldToken=null
    def fieldMatcher=(workingLine=~/\s*\|\s*field=([^|]*)/)
    if(fieldMatcher.find()){
        fieldToken=&apos;field=&apos;+fieldMatcher.group(1).trim()
        String beforeField=workingLine.substring(0,fieldMatcher.start()).replaceFirst(/\s+$/,&apos;&apos;)
        String afterField=workingLine.substring(fieldMatcher.end()).replaceFirst(/^\s*\|\s*/,&apos;&apos;)
        workingLine=beforeField+(afterField?&apos; | &apos;+afterField:&apos;&apos;)
    }
    List&lt;String&gt; comparisonTokens=[]
    [&apos;API&apos;,&apos;DB&apos;].each{String label-&gt;
        def valueMatcher=(workingLine=~/\s*\|\s*${label}=([^|]*)/)
        if(valueMatcher.find()){
            comparisonTokens&lt;&lt;label+&apos;=&apos;+valueMatcher.group(1).trim()
            String beforeValue=workingLine.substring(0,valueMatcher.start()).replaceFirst(/\s+$/,&apos;&apos;)
            String afterValue=workingLine.substring(valueMatcher.end()).replaceFirst(/^\s*\|\s*/,&apos;&apos;)
            workingLine=beforeValue+(afterValue?&apos; | &apos;+afterValue:&apos;&apos;)
        }
    }
    String leading=(([fieldToken]+comparisonTokens+[context]).findAll{it}.join(&apos; | &apos;))
    int firstPipe=workingLine.indexOf(&apos;|&apos;)
    if(firstPipe&lt;0)return leading+&apos; | &apos;+workingLine
    String left=workingLine.substring(0,firstPipe).replaceFirst(/\s+$/,&apos;&apos;)
    String right=workingLine.substring(firstPipe+1).replaceFirst(/^\s+/,&apos;&apos;)
    left+&apos; | &apos;+leading+(right?&apos; | &apos;+right:&apos;&apos;)
}
List&lt;String&gt; displayFailLines=failLines.collect{withHistoryTradeContext(it)}
List&lt;String&gt; displayOkLines=okLines.collect{withHistoryTradeContext(it)}
List&lt;String&gt; displaySkipLines=skipLines.collect{withHistoryTradeContext(it)}
String status=failLines.isEmpty()?&apos;PASS&apos;:&apos;FAIL&apos;;List&lt;String&gt; report=[]
report&lt;&lt;&apos;Assertion message: 交易大赛-批量查询完全关闭持仓生命周期 V1响应每字段/DB或CSV校验 | status=&apos;+status+&apos; | mode=&apos;+mode+&apos; | case=&apos;+vars.get(&apos;competition_history_case_index_display&apos;)+&apos;/&apos;+vars.get(&apos;competition_history_case_total&apos;)+&apos; | CSV行=&apos;+vars.get(&apos;competition_history_csv_line_no&apos;)+&apos; | shujuku=&apos;+vars.get(&apos;competition_history_shujuku&apos;)
report&lt;&lt;&apos;接口: POST /v1/positions/history/query | 文档: mt-hub-openapi 7.html | 版本: MT-Hub API 1.0.1-beta1.60.3&apos;
report&lt;&lt;&apos;已校验响应字段: envelope=[&apos;+envelopeFields.join(&apos;,&apos;)+&apos;] | data[]=[&apos;+fields.join(&apos;,&apos;)+&apos;] | errors[]=[&apos;+allowedErrorFields.join(&apos;,&apos;)+&apos;]&apos;
report&lt;&lt;&apos;响应信封: data=&apos;+apiRows.size()+&apos; | errors=&apos;+errors.size()+&apos; | next_cursor=&apos;+(blank(root.next_cursor)?&apos;&lt;empty&gt;&apos;:root.next_cursor)+&apos; | as_of_time_ms=&apos;+numText(root.as_of_time_ms)
report&lt;&lt;&apos;请求close_time范围=[&apos;+fromMs+&apos;,&apos;+toMs+&apos;]；数据库缺失字段跳过配置=[&apos;+missingSkipRaw+&apos;]；字段不存在与字段值为空严格区分&apos;
report&lt;&lt;&apos;DB聚合说明: 依据mt4_report.sql/mt5_report.sql；MT4按已关闭交易且排除epoch未平仓哨兵；MT5按Login/PositionID/Symbol聚合开平Deal，平仓有效手数优先使用VolumeClosedExt/VolumeClosed，并排除mt5_positions中仍存在的当前持仓。&apos;
report&lt;&lt;&apos;notional_status独立判断: 按《订单名义价值计算公式.v1.md》5分支选择路径；公式3按Quote Currency查找USD转换品种；合约规格、币种、开平仓价格和所需Bid/Ask完整时resolved，否则unresolved。&apos;
report&lt;&lt;&apos;名义价值独立计算: 公式3=ContractSize*Lots*Open/ClosePrice*ExchangeUSD；USD在后ExchangeUSD=(Bid+Ask)/2，USD在前ExchangeUSD=2/(Bid+Ask)；开仓、平仓分别计算，calc_bilateral_notional_value_usd=开仓+平仓；最终名义价值保留5位HALF_UP。其他4类公式保持原逻辑。&apos;
report&lt;&lt;&apos;报价口径警示: get_symbol_ex是调用时当前Bid/Ask，不是开/平仓历史时点报价；明细以quote_source=get_symbol_ex_current_quote标识。&apos;
report&lt;&lt;&apos;DB未匹配行策略: policy=&apos;+unmatchedDbPolicy+&apos; | unmatched_db_rows=&apos;+unmatchedDbCount+&apos;；无论策略为何，API记录找不到唯一DB行或任一可比字段不一致都判失败。&apos;
report&lt;&lt;&apos;数值误差配置: percent=[&apos;+percentRaw+&apos;] | absolute=[&apos;+absoluteRaw+&apos;]&apos;
report&lt;&lt;&apos;空值规则: API/DB均空通过；API=0且DB空通过；storage均空通过；数据库无字段默认失败，只有配置后才跳过。&apos;
report&lt;&lt;&apos;订单上下文: 每条可定位的通过/失败/跳过字段明细先打印field，再打印instanceid、login、order_id、position_id、position_lifecycle_id、symbol和data.row；同一position_id的不同完全关闭生命周期以position_lifecycle_id区分。&apos;
report&lt;&lt;&apos;统计: 失败=&apos;+failLines.size()+&apos; | 通过=&apos;+okLines.size()+&apos; | 跳过=&apos;+skipLines.size()+&apos; | API记录=&apos;+apiRows.size()+&apos; | DB模式=&apos;+dbMode
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【失败明细：&apos;+failLines.size()+&apos;条】&apos;;report.addAll(displayFailLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【通过明细：&apos;+okLines.size()+&apos;条】&apos;;report.addAll(displayOkLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【跳过明细：&apos;+skipLines.size()+&apos;条】&apos;;report.addAll(displaySkipLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【接口请求Body】&apos;&lt;&lt;(vars.get(&apos;competition_history_request_body&apos;)?:&apos;&apos;)
String finalReport=report.join(&apos;\n&apos;);publish(finalReport,failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
