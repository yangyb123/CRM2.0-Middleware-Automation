          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询账户级财务指标数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;acct_metrics_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;acct_metrics_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5账户级财务指标-${acct_metrics_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">SELECT
  mt.*,
  mt.Login AS login,
  &apos;mt5&apos; AS platform,
  &apos;MT5_1&apos; AS instance_id,
  &apos;live&apos; AS server_type,
  u.`Group` AS `group`,
  d.Currency AS currency,
  u.Leverage AS leverage,
  mt.Balance AS balance,
  mt.Credit AS credit,
  mt.Equity AS equity,
  mt.Margin AS margin,
  (mt.Equity - mt.Margin) AS margin_free,
  (mt.Equity - mt.Balance - mt.Credit) AS profit,
  CASE WHEN mt.Margin &gt; 0 THEN mt.Equity / mt.Margin * 100 ELSE 0 END AS margin_level,
  IFNULL(pos.position_count, 0) AS position_count,
  UNIX_TIMESTAMP(NOW(3)) * 1000 AS metrics_updated_utc_ms,
  false AS metrics_degraded
FROM mt5_accounts mt
LEFT JOIN mt5_users u ON u.Login = mt.Login
LEFT JOIN (
  SELECT d1.*
  FROM mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_daily
    GROUP BY Login
  ) latest ON latest.Login = d1.Login AND latest.max_datetime = d1.`Datetime`
) d ON d.Login = mt.Login
LEFT JOIN (
  SELECT
    p.Login,
    COUNT(*) AS position_count
  FROM mt5_positions p
  WHERE p.Position &gt; 0
    AND p.Symbol IS NOT NULL
    AND TRIM(p.Symbol) &lt;&gt; &apos;&apos;
    AND p.Symbol REGEXP &apos;[A-Za-z]&apos;
    AND p.Action IN (0, 1)
    AND p.Volume &gt; 0
    AND p.PriceOpen &gt; 0
  GROUP BY p.Login
) pos ON pos.Login = mt.Login
WHERE mt.Login = ?</stringProp>
              <stringProp name="queryArguments">${acct_metrics_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_acct_metrics_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
