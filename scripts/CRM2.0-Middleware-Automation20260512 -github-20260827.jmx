                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

def valA = vars.get(&quot;Rights&quot;)
def valB = vars.get(&quot;rights&quot;)

log.info(&quot;&gt;&gt;&gt; 判断权限是否修改成功：API-Rights=[&quot; + valA + &quot;] GET-rights=[&quot; + valB + &quot;]&quot;)

if (valA == null) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;API 响应未提取到 Rights，修改权限可能失败&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}
if (valB == null) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;get_user_info 响应未提取到 rights&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}
if (valA.toString().trim() != valB.toString().trim()) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;权限未修改成功：修改接口 Rights=[&quot; + valA + &quot;] 查询接口 rights=[&quot; + valB + &quot;]&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
} else {
    log.info(&quot;&gt;&gt;&gt; 判断权限是否修改成功：通过 Rights=[&quot; + valA + &quot;]&quot;)
}
</stringProp>
