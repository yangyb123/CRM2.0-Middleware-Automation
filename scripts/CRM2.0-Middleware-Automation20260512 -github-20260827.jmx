              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询多个账户的挂单订单-手工验证" enabled="true">
            <stringProp name="TestPlan.comments">用途：查询多个账户的挂单订单，数据源是 SHM SharedOrders，会跨账号/跨实例合并、全局排序、分页。挂单还没有成交，所以财务字段为 0。</stringProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/list_pending_orders</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;accounts&quot;: [&#xd;
       {&#xd;
      &quot;instanceid&quot;: &quot;MT5_1&quot;,&#xd;
      &quot;login&quot;: 4050&#xd;
    },&#xd;
    {&#xd;
      &quot;instanceid&quot;: &quot;MT4_1&quot;,&#xd;
      &quot;login&quot;: 1070&#xd;
    },&#xd;
     {&#xd;
      &quot;instanceid&quot;: &quot;MT4_1&quot;,&#xd;
      &quot;login&quot;: 1012&#xd;
    }&#xd;
  ],&#xd;
  &quot;page&quot;: 1,&#xd;
  &quot;page_size&quot;: 50,&#xd;
  &quot;filters&quot;: {&#xd;
    &quot;order_types&quot;: [2, 3, 4, 5],&#xd;
    &quot;volume_lots&quot;: {&#xd;
      &quot;condition&quot;: &quot;gte&quot;,&#xd;
      &quot;value&quot;: 0.01&#xd;
    }&#xd;
  },&#xd;
  &quot;sort_by&quot;: &quot;time_setup_utc_ms&quot;,&#xd;
  &quot;sort_order&quot;: &quot;desc&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="查询多个账户的历史平仓仓位/已平仓订单事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户历史平仓" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的历史平仓仓位-数据库校验.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_deal_ticket,symbol,order_types,close_time_from_utc_ms,close_time_to_utc_ms,volume_lots_condition,volume_lots_value,floating_pl,sort_by,sort_order,reason,price_close,position_ticket,updated_utc_ms,fee,open_time_utc_ms,price_open,source,price_sl,commission,digits_currency,order_type,profit,volume_lots,side,swap,deal_ticket,price_tp,order_ticket,close_time_utc_ms,instance_id,net_profit,comment,digits,contract_size,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓MT4/MT5 DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_mt4_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_mt4_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">order_type,side,deal_ticket,digits_currency</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT4账号DB/API明细字段跳过；不控制CSV/API字段对比；多个字段用英文逗号分隔，* 表示跳过MT4明细全部字段。</stringProp>
              </elementProp>
              <elementProp name="history_positions_mt5_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_mt5_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">order_type,side</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT5账号DB/API明细字段跳过；不控制CSV/API字段对比；多个字段用英文逗号分隔，* 表示跳过MT5明细全部字段。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">DB/API跳过字段按平台拆分：MT4配置只影响source=mt4的DB/API明细，MT5配置只影响source=mt5的DB/API明细；CSV/API仍由独立CSV配置控制。</stringProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户历史平仓参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的历史平仓仓位-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户历史平仓CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户历史平仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户历史平仓CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;history_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户历史平仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;history_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String login = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
    String platform = platformOf(instanceId)
    if (instanceId &amp;&amp; login &amp;&amp; platform) {
        String key = instanceId + &apos;|&apos; + login
        if (!accountKeys.contains(key)) {
            accountKeys &lt;&lt; key
            accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
        }
        if (platform == &apos;MT4&apos;) {
            mt4Logins &lt;&lt; login
            mt4LoginInstance[login] = instanceId
        } else if (platform == &apos;MT5&apos;) {
            mt5Logins &lt;&lt; login
            mt5LoginInstance[login] = instanceId
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户历史平仓没有可用accounts，CSV需要填写 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;close_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;symbol&apos;, &apos;filter_symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String closeFrom = cleanInt(firstValue(currentRow, [&apos;close_time_from_utc_ms&apos;, &apos;close_time_utc_ms__gte&apos;, &apos;close_time_from&apos;]))
String closeTo = cleanInt(firstValue(currentRow, [&apos;close_time_to_utc_ms&apos;, &apos;close_time_utc_ms__lte&apos;, &apos;close_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;volume_lots&apos;, &apos;volume&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (closeFrom) filters[&apos;close_time_from_utc_ms&apos;] = Long.parseLong(closeFrom)
if (closeTo) filters[&apos;close_time_to_utc_ms&apos;] = Long.parseLong(closeTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;history_positions_shujuku&apos;, shujuku)
vars.put(&apos;history_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;history_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;history_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;history_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;history_positions_request_body&apos;, requestBody)
vars.put(&apos;history_positions_page&apos;, page)
vars.put(&apos;history_positions_page_size&apos;, pageSize)
vars.put(&apos;history_positions_sort_by&apos;, sortBy)
vars.put(&apos;history_positions_sort_order&apos;, sortOrder)
vars.put(&apos;history_positions_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;history_positions_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;history_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_history_positions_summary_rows&apos;, [])
vars.putObject(&apos;db_history_positions_mt4_summary_rows&apos;, [])
vars.putObject(&apos;db_history_positions_mt5_summary_rows&apos;, [])
vars.putObject(&apos;db_history_positions_page_rows&apos;, [])
vars.putObject(&apos;db_history_positions_all_rows&apos;, [])
vars.putObject(&apos;db_history_positions_mt4_all_rows&apos;, [])
vars.putObject(&apos;db_history_positions_mt5_all_rows&apos;, [])

String closeMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.CLOSE_TIME) / 1000 AS UNSIGNED)&quot;
String openMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String closeMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, d.TimeMsc) / 1000 AS UNSIGNED)&quot;
String openMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, COALESCE(in_d.open_time_msc, d.TimeMsc)) / 1000 AS UNSIGNED)&quot;
String orderTypeSql = orderTypeList ? orderTypeList.join(&apos;,&apos;) : &apos;0,1&apos;
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

String mt4LoginSql = mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;
String mt5LoginSql = mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + mt4LoginSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.VOLUME &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.CLOSE_TIME IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;mt.CLOSE_TIME &lt;&gt; &apos;1970-01-01 00:00:00&apos;&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (filterDealTicket) mt4Where &lt;&lt; (filterDealTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;0 = &apos; + filterDealTicket)
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (closeFrom) mt4Where &lt;&lt; closeMsMt4 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt4Where &lt;&lt; closeMsMt4 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &lt; 0&apos;

List mt5Where = []
mt5Where &lt;&lt; &apos;d.Login IN (&apos; + mt5LoginSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Action IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;d.Entry IN (1, 3)&apos;
mt5Where &lt;&lt; &apos;d.VolumeExt &gt; 0&apos;
if (filterOrderTicket) mt5Where &lt;&lt; &apos;d.`Order` = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; &apos;d.PositionID = &apos; + filterPositionTicket
if (filterDealTicket) mt5Where &lt;&lt; &apos;d.Deal = &apos; + filterDealTicket
if (symbol) mt5Where &lt;&lt; &apos;d.Symbol = &apos; + sqlQuote(symbol)
if (closeFrom) mt5Where &lt;&lt; closeMsMt5 + &apos; &gt;= &apos; + closeFrom
if (closeTo) mt5Where &lt;&lt; closeMsMt5 + &apos; &lt;= &apos; + closeTo
if (volumeValue) mt5Where &lt;&lt; &apos;(d.VolumeExt / 100000000.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt5Where &lt;&lt; &apos;d.Profit &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt5Where &lt;&lt; &apos;d.Profit &lt; 0&apos;

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;d.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.TICKET AS position_ticket,
  0 AS deal_ticket,
  mt.SYMBOL AS symbol,
  mt.CMD AS order_type,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(mt.CMD AS CHAR) END AS side,
  mt.REASON AS reason,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS price_open,
  mt.CLOSE_PRICE AS price_close,
  mt.SL AS price_sl,
  mt.TP AS price_tp,
  mt.PROFIT AS profit,
  mt.SWAPS AS swap,
  mt.COMMISSION AS commission,
  0 AS fee,
  mt.PROFIT + mt.SWAPS + mt.COMMISSION AS net_profit,
  ${openMsMt4} AS open_time_utc_ms,
  ${closeMsMt4} AS close_time_utc_ms,
  ${closeMsMt4} AS updated_utc_ms,
  mt.DIGITS AS digits,
  mt.DIGITS AS digits_currency,
  0 AS contract_size,
  mt.COMMENT AS comment,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USC&apos;) THEN 1 ELSE 0 END AS is_cent_account
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  d.Login AS login,
  &apos;mt5&apos; AS source,
  d.`Order` AS order_ticket,
  d.PositionID AS position_ticket,
  d.Deal AS deal_ticket,
  d.Symbol AS symbol,
  d.Action AS order_type,
  CASE d.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CAST(d.Action AS CHAR) END AS side,
  d.Reason AS reason,
  d.VolumeExt / 100000000.0 AS volume_lots,
  COALESCE(in_d.open_price, d.PricePosition) AS price_open,
  d.Price AS price_close,
  d.PriceSL AS price_sl,
  d.PriceTP AS price_tp,
  d.Profit AS profit,
  d.Storage AS swap,
  COALESCE(cost_d.commission, d.Commission, 0) AS commission,
  COALESCE(cost_d.fee, d.Fee, 0) AS fee,
  d.Profit + d.Storage + COALESCE(cost_d.commission, d.Commission, 0) + COALESCE(cost_d.fee, d.Fee, 0) AS net_profit,
  ${openMsMt5} AS open_time_utc_ms,
  ${closeMsMt5} AS close_time_utc_ms,
  ${closeMsMt5} AS updated_utc_ms,
  d.Digits AS digits,
  d.DigitsCurrency AS digits_currency,
  d.ContractSize AS contract_size,
  d.Comment AS comment,
  CASE WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) IN (&apos;USC&apos;) THEN 1 ELSE 0 END AS is_cent_account
FROM mt5_report.mt5_deals d
LEFT JOIN (
  SELECT d1.Login, MAX(COALESCE(d1.Currency, &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${mt5LoginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) acct_currency ON acct_currency.Login = d.Login
LEFT JOIN (
  SELECT
    Login,
    PositionID,
    Symbol,
    MIN(TimeMsc) AS open_time_msc,
    SUBSTRING_INDEX(GROUP_CONCAT(Price ORDER BY TimeMsc ASC, Deal ASC), &apos;,&apos;, 1) + 0 AS open_price
  FROM mt5_report.mt5_deals
  WHERE Entry = 0
    AND Action IN (0, 1)
  GROUP BY Login, PositionID, Symbol
) in_d
  ON in_d.Login = d.Login
 AND in_d.PositionID = d.PositionID
 AND in_d.Symbol = d.Symbol
LEFT JOIN (
  SELECT
    Login,
    PositionID,
    Symbol,
    SUM(Commission) AS commission,
    SUM(Fee) AS fee
  FROM mt5_report.mt5_deals
  WHERE Login IN (${mt5LoginSql})
    AND Action IN (0, 1)
    AND PositionID &gt; 0
  GROUP BY Login, PositionID, Symbol
) cost_d
  ON cost_d.Login = d.Login
 AND cost_d.PositionID = d.PositionID
 AND cost_d.Symbol = d.Symbol
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;close_time_utc_ms&apos;, &apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;close_time_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
int maxRowsInt = Integer.parseInt(maxRows)
int detailFetchLimit = Math.max(maxRowsInt, offsetInt + pageSizeInt)
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String historyRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN 0 ELSE volume_lots END), 0) AS standard_volume,
  COALESCE(SUM(COALESCE(commission, 0)), 0) AS total_commission,
  COALESCE(SUM(COALESCE(fee, 0)), 0) AS total_raw_fee,
  COALESCE(SUM(COALESCE(commission, 0) + COALESCE(fee, 0)), 0) AS total_fee,
  COALESCE(SUM(swap), 0) AS total_storage,
  COALESCE(SUM(profit), 0) AS total_profit
FROM (
${historyRowsSql}
) history_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  instance_id,
  login,
  source,
  order_ticket,
  position_ticket,
  deal_ticket,
  symbol,
  order_type,
  side,
  reason,
  volume_lots,
  price_open,
  price_close,
  price_sl,
  price_tp,
  profit,
  swap,
  commission,
  fee,
  COALESCE(commission, 0) + COALESCE(fee, 0) AS row_total_fee,
  net_profit,
  open_time_utc_ms,
  close_time_utc_ms,
  updated_utc_ms,
  digits,
  digits_currency,
  contract_size,
  comment
FROM (
${historyRowsSql}
) history_rows
ORDER BY ${sortColumn} ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()
String allSql = pageSql.replace(&apos;LIMIT &apos; + pageSizeInt + &apos; OFFSET &apos; + offsetInt, &apos;LIMIT &apos; + detailFetchLimit)
def detailSqlFor = { String rowsSql -&gt;
    &quot;&quot;&quot;
SELECT
  instance_id,
  login,
  source,
  order_ticket,
  position_ticket,
  deal_ticket,
  symbol,
  order_type,
  side,
  reason,
  volume_lots,
  price_open,
  price_close,
  price_sl,
  price_tp,
  profit,
  swap,
  commission,
  fee,
  COALESCE(commission, 0) + COALESCE(fee, 0) AS row_total_fee,
  net_profit,
  open_time_utc_ms,
  close_time_utc_ms,
  updated_utc_ms,
  digits,
  digits_currency,
  contract_size,
  comment,
  is_cent_account
FROM (
${rowsSql}
) history_rows
ORDER BY ${sortColumn} ${dbOrder}
LIMIT ${detailFetchLimit}
&quot;&quot;&quot;.trim()
}
def summarySqlFor = { String rowsSql -&gt;
    &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN is_cent_account = 1 THEN 0 ELSE volume_lots END), 0) AS standard_volume,
  COALESCE(SUM(COALESCE(commission, 0)), 0) AS total_commission,
  COALESCE(SUM(COALESCE(fee, 0)), 0) AS total_raw_fee,
  COALESCE(SUM(COALESCE(commission, 0) + COALESCE(fee, 0)), 0) AS total_fee,
  COALESCE(SUM(swap), 0) AS total_storage,
  COALESCE(SUM(profit), 0) AS total_profit
FROM (
${rowsSql}
) history_rows
&quot;&quot;&quot;.trim()
}
String mt4SummarySql = summarySqlFor(mt4Sql)
String mt5SummarySql = summarySqlFor(mt5Sql)
String mt4AllSql = detailSqlFor(mt4Sql)
String mt5AllSql = detailSqlFor(mt5Sql)

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\\r&apos;, &apos; &apos;).replace(&apos;\\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
String allSqlExec = compactSql(allSql)
String mt4SummarySqlExec = compactSql(mt4SummarySql)
String mt5SummarySqlExec = compactSql(mt5SummarySql)
String mt4AllSqlExec = compactSql(mt4AllSql)
String mt5AllSqlExec = compactSql(mt5AllSql)
vars.put(&apos;history_positions_summary_sql&apos;, summarySqlExec)
vars.put(&apos;history_positions_page_sql&apos;, pageSqlExec)
vars.put(&apos;history_positions_all_sql&apos;, allSqlExec)
vars.put(&apos;history_positions_mt4_summary_sql&apos;, mt4SummarySqlExec)
vars.put(&apos;history_positions_mt5_summary_sql&apos;, mt5SummarySqlExec)
vars.put(&apos;history_positions_mt4_all_sql&apos;, mt4AllSqlExec)
vars.put(&apos;history_positions_mt5_all_sql&apos;, mt5AllSqlExec)

String initReport = &apos;list_history_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;history_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;history_positions_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
