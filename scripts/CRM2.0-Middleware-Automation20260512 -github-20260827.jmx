    &apos;is_cent&apos;: [&apos;is_cent&apos;], &apos;reporting_currency&apos;: [&apos;reporting_currency&apos;], &apos;normalization_complete&apos;: [&apos;normalization_complete&apos;],
&apos;profit_reporting&apos;: [&apos;profit_reporting&apos;, &apos;calc_profit_reporting&apos;, &apos;api_profit_reporting&apos;], &apos;swap_reporting&apos;: [&apos;swap_reporting&apos;], &apos;commission_reporting&apos;: [&apos;commission_reporting&apos;],
    &apos;fee_reporting&apos;: [&apos;fee_reporting&apos;], &apos;net_profit_reporting&apos;: [&apos;net_profit_reporting&apos;]
]

def findKey
findKey = { Map m, String field -&gt;
    if (m == null) return null
    if (m.containsKey(field)) return field
    for (String a : (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    String want = normKey(field)
    m.keySet().find { normKey(it) == want }
}

def valueOf
valueOf = { Map m, String field -&gt;
    def k = findKey(m, field)
    k == null ? null : m[k]
}

def idOf = { Map row -&gt;
    for (String f : [&apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;deal_ticket&apos;]) {
        def v = valueOf(row, f)
        if (!blank(v)) return cleanNumText(v)
    }
    &apos;&apos;
}

boolean timeField(String f) {
    String n = (f ?: &apos;&apos;).toLowerCase()
    return n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;) || n.contains(&apos;updated&apos;)
}

Date parseDateLike(v) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return null
    if (v instanceof java.util.Date) return v
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (String fmt : [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    sdf.format(d)
}

String normalizeApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String normalizeDbTime(v) {
    Date d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeCsvTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String displayApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

long secondDiff(String a, String b) {
    try {
        SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
        return Math.abs((sdf.parse(a).time - sdf.parse(b).time) / 1000L)
    } catch (ignored) { return Long.MAX_VALUE }
}

String renderValue(String field, Object v, String side, boolean dbMode) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&lt;empty&gt;&apos;
    if (!timeField(field)) return String.valueOf(v)
    if (side == &apos;API&apos; &amp;&amp; dbMode) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
    if (side == &apos;API&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值=&apos; + normalizeCsvTime(v)
    if (side == &apos;DB&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    return String.valueOf(v) + &apos; -&gt; &apos; + normalizeCsvTime(v)
}

def asNum = { Object v -&gt;
    if (blank(v)) return null
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

def fmtNum = { BigDecimal n -&gt; n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() }
def pctText = { BigDecimal p -&gt; p == null ? &apos;N/A&apos; : p.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos; }
Set exactNumericFields = [&apos;login&apos;, &apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;deal_ticket&apos;, &apos;reason&apos;, &apos;order_type&apos;, &apos;digits&apos;, &apos;digits_currency&apos;, &apos;money_scale&apos;, &apos;total&apos;, &apos;total_orders&apos;, &apos;unresolved_currency_account_count&apos;] as Set
Set apiOnlyItemFields = [&apos;rate_profit&apos;, &apos;rate_profit_used&apos;, &apos;rate_profit_used_resolved&apos;, &apos;is_cent&apos;, &apos;normalization_complete&apos;] as Set
Set summaryContractFields = [&apos;reporting_currency&apos;, &apos;money_mode&apos;, &apos;normalization_complete&apos;, &apos;unresolved_currency_accounts&apos;] as Set

def toleranceRaw = { boolean currentDbMode -&gt;
    currentDbMode ? (vars.get(&apos;open_positions_db_api_field_tolerance_percent&apos;) ?: &apos;&apos;) : (vars.get(&apos;open_positions_csv_api_field_tolerance_percent&apos;) ?: &apos;&apos;)
}
def toleranceConfigName = { boolean currentDbMode -&gt; currentDbMode ? &apos;open_positions_db_api_field_tolerance_percent&apos; : &apos;open_positions_csv_api_field_tolerance_percent&apos; }
def parseToleranceMap = { String raw -&gt;
    Map out = [:]
    def addTolerance = { Object keyRaw, Object valRaw -&gt;
        String k = normKey(keyRaw)
        String v = String.valueOf(valRaw ?: &apos;&apos;).replace(&apos;%&apos;, &apos;&apos;).trim()
        if (k &amp;&amp; (v ==~ /^-?\d+(\.\d+)?$/)) {
            try {
                BigDecimal pct = new BigDecimal(v)
                if (pct.compareTo(BigDecimal.ZERO) &gt;= 0) out[k] = pct
            } catch (ignored) {}
        }
    }
    String text = String.valueOf(raw ?: &apos;&apos;)
    def matcher = text =~ /([A-Za-z][A-Za-z0-9_]*)(?:\s*(?:=|:|：)\s*|\s+)(-?\d+(?:\.\d+)?)\s*%?/
    matcher.each { m -&gt; addTolerance(m[1], m[2]) }
    List tokens = text.split(/[，,;；|\s]+/).collect { String.valueOf(it ?: &apos;&apos;).trim() }.findAll { it }
    for (int i = 0; i &lt; tokens.size(); i++) {
        String t = tokens[i]
        def pair = t =~ /^([A-Za-z][A-Za-z0-9_]*)(?:=|:|：)(-?\d+(?:\.\d+)?)%?$/
        if (pair.matches()) {
            addTolerance(pair[0][1], pair[0][2])
        } else if (i + 1 &lt; tokens.size()) {
            String next = tokens[i + 1].replace(&apos;%&apos;, &apos;&apos;)
            if ((t ==~ /^[A-Za-z][A-Za-z0-9_]*$/) &amp;&amp; (next ==~ /^-?\d+(\.\d+)?$/)) {
                addTolerance(t, next)
                i++
            }
        }
    }
    out
}
def toleranceMapForMode = { boolean currentDbMode -&gt; parseToleranceMap(toleranceRaw(currentDbMode)) }
def toleranceMapText = { boolean currentDbMode -&gt;
    Map m = toleranceMapForMode(currentDbMode)
    m ? m.collect { k, v -&gt; k + &apos;=&apos; + pctText(v) }.join(&apos;,&apos;) : &apos;&lt;empty&gt;&apos;
}
def toleranceForField = { String field, boolean currentDbMode -&gt;
    BigDecimal defaultPct = currentDbMode ? new BigDecimal(&apos;10&apos;) : new BigDecimal(&apos;5&apos;)
    Map toleranceMap = toleranceMapForMode(currentDbMode)
    Set candidates = [normKey(field)] as Set
    aliases.each { canonical, aliasList -&gt;
        if (candidates.contains(normKey(canonical)) || aliasList.any { candidates.contains(normKey(it)) }) {
            candidates &lt;&lt; normKey(canonical)
            aliasList.each { candidates &lt;&lt; normKey(it) }
        }
    }
    BigDecimal configured = null
    for (String c : candidates) {
        if (toleranceMap.containsKey(c)) {
            configured = toleranceMap[c]
            break
        }
    }
    configured == null ? defaultPct : configured
}

def compareValue = { String field, Object apiVal, Object expectedVal, String expectedSource, boolean dbMode -&gt;
    if (blank(apiVal) &amp;&amp; blank(expectedVal)) {
        return [same: true, apiPrint: &apos;&lt;empty&gt;&apos;, expPrint: &apos;&lt;empty&gt;&apos;, diff: &apos;N/A&apos;, percent: &apos;N/A(空值)&apos;, formula: &apos;API 和 &apos; + expectedSource + &apos; 返回都是为空&apos;, note: &apos;API 和 &apos; + expectedSource + &apos; 返回都是为空，通过&apos;]
    }
    if (blank(apiVal) || blank(expectedVal)) {
        String note = blank(apiVal) ? &apos;API返回为空，&apos; + expectedSource + &apos;有值，失败&apos; : expectedSource + &apos;字段存在但值为空，失败&apos;
        return [same: false, apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: &apos;N/A&apos;, percent: &apos;N/A(空值)&apos;, formula: &apos;空值比较：&apos; + note, note: note]
    }
    if (timeField(field)) {
        String aCmp = dbMode ? normalizeApiTime(apiVal) : normalizeCsvTime(apiVal)
        String eCmp = dbMode ? normalizeDbTime(expectedVal) : normalizeCsvTime(expectedVal)
        long diffSec = secondDiff(aCmp, eCmp)
        return [same: (aCmp == eCmp || diffSec &lt;= 60L), apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: diffSec + &apos;秒&apos;, percent: &apos;N/A(时间字段)&apos;, formula: &apos;时间字段按yyyy-MM-dd HH:mm:ss比较，允许相差&lt;=60秒&apos;]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactNumericFields.contains(field)) {
            return [same: cleanNumText(apiVal) == cleanNumText(expectedVal), apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: &apos;N/A(编号类字段精确比较)&apos;, formula: &apos;编号类字段不使用误差，按数值精确比较&apos;]
        }
        BigDecimal tolerancePercent = toleranceForField(field, dbMode)
        BigDecimal base = en.abs()
        BigDecimal allowed = BigDecimal.ZERO
        boolean same
        String pct
        String formula
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            same = diff.compareTo(BigDecimal.ZERO) == 0
            pct = same ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0无法作分母)&apos;
            formula = &apos;abs(&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;))=&apos; + fmtNum(diff) + &apos;，&apos; + expectedSource + &apos;=0，无法计算百分比，要求API也等于0&apos;
        } else {
            allowed = base.multiply(tolerancePercent).divide(new BigDecimal(&apos;100&apos;), 10, RoundingMode.HALF_UP)
            same = diff.compareTo(allowed) &lt;= 0
            BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
            pct = pctText(percent)
            formula = &apos;abs((&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;)) / &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
        }
        String toleranceText = pctText(tolerancePercent)
        String note = same ? field + &apos; 误差小于&apos; + toleranceText + &apos;，通过&apos; : field + &apos; 误差大于&apos; + toleranceText + &apos;，失败&apos;
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: pct, formula: formula + &apos; | 允许误差&lt;=&apos; + toleranceText + &apos;(允许差值=&apos; + fmtNum(allowed) + &apos;)&apos;, note: note]
    }
    boolean same = String.valueOf(apiVal ?: &apos;&apos;).trim() == String.valueOf(expectedVal ?: &apos;&apos;).trim()
    [same: same, apiPrint: String.valueOf(apiVal ?: &apos;&apos;), expPrint: String.valueOf(expectedVal ?: &apos;&apos;), diff: &apos;N/A&apos;, percent: &apos;N/A(非数值字段)&apos;, formula: &apos;非数值字段按字符串精确比较&apos;]
}

def compareComparable = { Object v -&gt;
    if (numeric(v)) return new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;))
    String.valueOf(v ?: &apos;&apos;)
}

def sumField = { List rows, String field -&gt;
    BigDecimal total = BigDecimal.ZERO
    rows.each { r -&gt;
        BigDecimal n = asNum(valueOf(r, field))
        if (n != null) total = total.add(n)
    }
    total
}

def disabledRaw = { boolean dbMode -&gt; dbMode ? (vars.get(&apos;open_positions_db_api_disabled_compare_fields&apos;) ?: &apos;&apos;) : (vars.get(&apos;open_positions_csv_api_disabled_compare_fields&apos;) ?: &apos;&apos;) }
def disabledSet = { String raw -&gt; raw.split(/[，,;|\s]+/).collect { String t = String.valueOf(it ?: &apos;&apos;).trim(); t == &apos;*&apos; ? &apos;*&apos; : normKey(t) }.findAll { it }.toSet() }

String shujuku = vars.get(&apos;open_positions_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
String sourceName = dbMode ? &apos;DB&apos; : &apos;CSV&apos;
String modeText = dbMode ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String sortBy = vars.get(&apos;open_positions_sort_by&apos;) ?: &apos;open_time_utc_ms&apos;
boolean desc = (vars.get(&apos;open_positions_sort_order&apos;) ?: &apos;desc&apos;).toLowerCase() != &apos;asc&apos;
int page = ((vars.get(&apos;open_positions_page&apos;) ?: &apos;1&apos;) as int)
int pageSize = ((vars.get(&apos;open_positions_page_size&apos;) ?: &apos;50&apos;) as int)
int offset = Math.max(page - 1, 0) * pageSize
Set disabled = disabledSet(disabledRaw(dbMode))
boolean skipAll = disabled.contains(&apos;*&apos;)

def isDisabledField = { String field, String apiFieldName = null -&gt;
    if (skipAll) return true
    List candidates = [field, apiFieldName].findAll { !blank(it) }.collect { normKey(it) }
    aliases.each { canonical, aliasList -&gt;
        boolean matched = candidates.contains(normKey(canonical)) || aliasList.any { candidates.contains(normKey(it)) }
        if (matched) {
            candidates &lt;&lt; normKey(canonical)
            aliasList.each { candidates &lt;&lt; normKey(it) }
        }
    }
    candidates.any { disabled.contains(it) }
}
def data = parsed instanceof Map ? parsed.data : null
List apiItems = []
if (data instanceof Map &amp;&amp; data.items instanceof List) apiItems = data.items.collect { rowToMap(it) }
else if (data instanceof List) apiItems = data.collect { rowToMap(it) }
else if (parsed instanceof Map &amp;&amp; parsed.items instanceof List) apiItems = parsed.items.collect { rowToMap(it) }
if (!apiItems) {
    String finalReport = &apos;Assertion message: 查询多个账户的当前持仓订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;open_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;open_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;open_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
        &apos;\n接口: POST /crm20/list_open_positions&apos; +
        &apos;\n【失败明细】\n - [失败] | 接口没有返回data.items可对比记录，可能接口失败或data为空&apos; +
        &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;open_positions_request_body&apos;) ?: &apos;&apos;) +
        &apos;\n\n【接口响应原文】\n&apos; + responseText
    publishReport(&apos;查询多个账户当前持仓字段对比结果&apos;, finalReport, false)
    return
}
Map apiSummary = data instanceof Map &amp;&amp; data.summary instanceof Map ? rowToMap(data.summary) : [:]
Object apiTotal = data instanceof Map ? data.total : parsed.total

List okLines = []
List failLines = []
List skipLines = []
int apiFieldTotal = 0

List expectedRows = []
List allDbRows = []
Object dbTotalForReport = null
String dbSummaryFeeBreakdown = &apos;&apos;
String dbPageFeeBreakdown = &apos;&apos;
if (dbMode) {
    List summaryRows = rowsFromObject(vars.getObject(&apos;db_open_positions_summary_rows&apos;))
    List pageRows = rowsFromObject(vars.getObject(&apos;db_open_positions_page_rows&apos;))
    if (!summaryRows) {
        String finalReport = &apos;Assertion message: 查询多个账户的当前持仓订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;open_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;open_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;open_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
            &apos;\n接口: POST /crm20/list_open_positions&apos; +
            &apos;\n请求accounts: MT4_login=&apos; + vars.get(&apos;open_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;open_positions_mt5_login&apos;) +
            &apos;\n【失败明细】\n - [失败] | 数据库summary统计SQL未返回记录&apos; +
            &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;open_positions_request_body&apos;) ?: &apos;&apos;) +
            &apos;\n\n【接口响应原文】\n&apos; + responseText
        publishReport(&apos;查询多个账户当前持仓字段对比结果&apos;, finalReport, false)
        return
    }
    Map dbSummary = summaryRows[0]
    dbTotalForReport = valueOf(dbSummary, &apos;total&apos;)
    expectedRows = pageRows
    allDbRows = pageRows
    Object dbTotalCommissionVal = valueOf(dbSummary, &apos;total_commission&apos;)
    Object dbTotalRawFeeVal = valueOf(dbSummary, &apos;total_raw_fee&apos;)
    Object dbTotalFeeVal = valueOf(dbSummary, &apos;total_fee&apos;)
    String dbTotalCommissionText = blank(dbTotalCommissionVal) ? &apos;&lt;empty&gt;&apos; : String.valueOf(dbTotalCommissionVal)
    String dbTotalRawFeeText = blank(dbTotalRawFeeVal) ? &apos;&lt;empty&gt;&apos; : String.valueOf(dbTotalRawFeeVal)
    String dbTotalFeeText = blank(dbTotalFeeVal) ? &apos;&lt;empty&gt;&apos; : String.valueOf(dbTotalFeeVal)
    BigDecimal pageCommissionSum = sumField(pageRows, &apos;commission&apos;)
    BigDecimal pageRawFeeSum = sumField(pageRows, &apos;fee&apos;)
    BigDecimal pageCommissionFeeSum = pageCommissionSum.add(pageRawFeeSum)
    dbSummaryFeeBreakdown = &apos;DB total_fee breakdown: total_fee=&apos; + dbTotalFeeText + &apos; = total_commission(&apos; + dbTotalCommissionText + &apos;) + total_raw_fee(&apos; + dbTotalRawFeeText + &apos;)&apos;
    dbPageFeeBreakdown = &apos;DB current page fee detail: commission_sum=&apos; + fmtNum(pageCommissionSum) + &apos; + fee_sum=&apos; + fmtNum(pageRawFeeSum) + &apos; = commission_plus_fee_sum(&apos; + fmtNum(pageCommissionFeeSum) + &apos;); row_total_fee column is commission+fee; open-position fee is expected to be 0.&apos;
    Map summaryExpected = [total: valueOf(dbSummary, &apos;total&apos;), total_orders: valueOf(dbSummary, &apos;total_orders&apos;), total_volume: valueOf(dbSummary, &apos;total_volume&apos;), cent_volume: valueOf(dbSummary, &apos;cent_volume&apos;), standard_volume: valueOf(dbSummary, &apos;standard_volume&apos;), unresolved_volume: valueOf(dbSummary, &apos;unresolved_volume&apos;), unresolved_currency_account_count: valueOf(dbSummary, &apos;unresolved_currency_account_count&apos;), total_commission: dbTotalCommissionVal, total_raw_fee: dbTotalRawFeeVal, total_fee: dbTotalFeeVal, total_storage: valueOf(dbSummary, &apos;total_storage&apos;), total_profit: valueOf(dbSummary, &apos;total_profit&apos;)]

    Map summaryActual = new LinkedHashMap()
    if (apiTotal != null) summaryActual[&apos;total&apos;] = apiTotal
    apiSummary.each { k, v -&gt; summaryActual[String.valueOf(k)] = v }
    summaryActual.each { f, apiVal -&gt;
        String field = String.valueOf(f)
        apiFieldTotal++
        if (summaryContractFields.contains(field)) { skipLines &lt;&lt; &apos; - [??] | summary | field=&apos; + field + &apos; | reason=validated by response contract&apos;; return }
        def expKey = findKey(summaryExpected, field)
        Object expVal = expKey == null ? null : summaryExpected[expKey]
        if (isDisabledField(field, null)) {
            skipLines &lt;&lt; &quot; - [跳过] | summary | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, true)} | DB=${expKey == null ? &apos;&lt;empty&gt; 数据库summary SQL未返回此字段&apos; : renderValue(field, expVal, &apos;DB&apos;, true)} | DBField=${expKey ?: field} | reason=字段在DB/API跳过配置中&quot;
            return
        }
        if (expKey == null) {
            failLines &lt;&lt; &quot; - [失败] | summary | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, true)} | DB=&lt;empty&gt; 数据库无此字段 | DBField=${field} | 备注=数据库无此字段&quot;
            return
        }
        def cr = compareValue(field, apiVal, expVal, &apos;DB&apos;, true)

        if (field == &apos;total_fee&apos;) {
            cr.formula = cr.formula + &apos; | DB total_fee = total_commission(&apos; + dbTotalCommissionText + &apos;) + total_raw_fee(&apos; + dbTotalRawFeeText + &apos;)&apos;
            cr.note = (cr.note ? cr.note + &apos;; &apos; : &apos;&apos;) + &apos;total_fee is commission+fee, not fee only; for open positions fee is expected to be 0, so total_fee normally equals commission&apos;
        }
        String note = cr.note ? &apos; | 备注=&apos; + cr.note : &apos;&apos;
        String line = &quot;summary | field=${field} | API=${cr.apiPrint} | DB=${cr.expPrint} | DBField=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}${note}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
} else {
    Map currentCsv = vars.getObject(&apos;open_positions_current_csv_row&apos;) instanceof Map ? vars.getObject(&apos;open_positions_current_csv_row&apos;) : [:]
    String csvId = idOf(currentCsv)
    Map apiRow = csvId ? apiItems.find { idOf(it) == csvId } : apiItems[0]
    if (!apiRow) {
        String finalReport = &apos;Assertion message: 查询多个账户的当前持仓订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;open_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;open_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;open_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
            &apos;\n接口: POST /crm20/list_open_positions&apos; +
            &apos;\n【失败明细】\n - [失败] | CSV订单号/仓位号和接口响应没有匹配上 | csvId=&apos; + csvId + &apos; | apiIds=&apos; + apiItems.collect { idOf(it) }.join(&apos;,&apos;) +
            &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;open_positions_request_body&apos;) ?: &apos;&apos;) +
            &apos;\n\n【接口响应原文】\n&apos; + responseText
        publishReport(&apos;查询多个账户当前持仓字段对比结果&apos;, finalReport, false)
        return
    }
    apiItems = [apiRow]
    expectedRows = [currentCsv]
}

if (dbMode) {
    if (apiItems.size() != expectedRows.size()) {
        failLines &lt;&lt; &quot; - [失败] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    } else {
        okLines &lt;&lt; &quot; - [通过] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    }
}

Map expectedById = [:]
Set matchedDbIds = [] as Set
if (dbMode) {
    expectedRows.each { Map r -&gt;
        String rid = idOf(r)
        if (rid &amp;&amp; !expectedById.containsKey(rid)) expectedById[rid] = r
    }
}

List compareDrivers = apiItems
compareDrivers.eachWithIndex { Map driverRow, int idx -&gt;
    Map apiRow = driverRow ?: [:]
    String apiId = idOf(apiRow)
    Map expectedRow = dbMode ? ((apiId &amp;&amp; expectedById.containsKey(apiId)) ? (expectedById[apiId] ?: [:]) : [:]) : (idx &lt; expectedRows.size() ? expectedRows[idx] : [:])
    String expectedId = idOf(expectedRow)
    def apiLoginKey = findKey(apiRow, &apos;login&apos;)
    def expectedLoginKey = findKey(expectedRow, &apos;login&apos;)
    String rowLogin = apiLoginKey == null ? (expectedLoginKey == null ? &apos;&lt;empty&gt;&apos; : String.valueOf(expectedRow[expectedLoginKey])) : String.valueOf(apiRow[apiLoginKey])
    String rowText = &apos;row=&apos; + (idx + 1 + offset) + &apos; | apiId=&apos; + apiId + &apos; | expectedId=&apos; + expectedId + &apos; | login=&apos; + rowLogin
    if (dbMode &amp;&amp; !apiRow) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | API=&lt;empty&gt; 接口返回缺少明细记录 | DB记录=${expectedRow}&quot;
        return
    }
    if (dbMode &amp;&amp; !expectedRow) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | DB=&lt;empty&gt; 数据库当前页没有匹配到接口返回的订单/持仓记录 | 匹配方式=order_ticket/position_ticket/deal_ticket | API记录=${apiRow}&quot;
        return
    }
    if (dbMode &amp;&amp; expectedId) matchedDbIds &lt;&lt; expectedId
    List compareFields = apiRow ? apiRow.keySet().collect { String.valueOf(it) } : expectedRow.keySet().collect { String.valueOf(it) }
    apiFieldTotal += compareFields.size()
    compareFields.each { rawField -&gt;
        String field = String.valueOf(rawField)
        String expKey = findKey(expectedRow, field)
        Object expVal = expKey == null ? null : expectedRow[expKey]
        String apiKey = findKey(apiRow, field)
        Object apiVal = apiKey == null ? null : apiRow[apiKey]
        if (apiOnlyItemFields.contains(field)) {
            boolean valid = field == &apos;rate_profit&apos; ? asNum(apiVal) != null : (field == &apos;rate_profit_used&apos; ? (apiVal == null || asNum(apiVal) != null) : (String.valueOf(apiVal) in [&apos;true&apos;,&apos;false&apos;]))
            if (valid) okLines &lt;&lt; &apos; - [??] | &apos; + rowText + &apos; | field=&apos; + field + &apos; | API=&apos; + apiVal + &apos; | contract=numeric/boolean&apos;
            else failLines &lt;&lt; &apos; - [??] | &apos; + rowText + &apos; | field=&apos; + field + &apos; | API=&apos; + apiVal + &apos; | contract=numeric/boolean&apos;
            return
        }
        if (isDisabledField(field, apiKey)) {
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${apiKey == null ? &apos;&lt;empty&gt; 接口响应无此字段&apos; : renderValue(apiKey, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=${expKey == null ? &apos;&lt;empty&gt; &apos; + (dbMode ? &apos;数据库无此字段&apos; : &apos;CSV未配置此字段&apos;) : renderValue(field, expVal, sourceName, dbMode)} | APIField=${apiKey ?: field} | ${sourceName}Field=${expKey ?: field} | reason=字段在跳过配置中&quot;
            return
        }
        if (expKey == null) {
            String missingReason = dbMode ? &apos;数据库无此字段&apos; : &apos;CSV未配置此字段&apos;
            String missingLine = &quot;${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=&lt;empty&gt; ${missingReason} | ${sourceName}Field=${field} | 备注=${missingReason}&quot;
            if (dbMode) failLines &lt;&lt; &apos; - [失败] | &apos; + missingLine else skipLines &lt;&lt; &apos; - [跳过] | &apos; + missingLine
            return
        }
        if (dbMode &amp;&amp; apiKey == null) {
            failLines &lt;&lt; &quot; - [失败] | ${rowText} | field=${field} | API=&lt;empty&gt; 接口响应无此字段 | DB=${renderValue(field, expVal, sourceName, dbMode)} | DBField=${expKey}&quot;
            return
        }
        def cr = compareValue(field, apiVal, expVal, sourceName, dbMode)
        String note = cr.note ? &apos; | 备注=&apos; + cr.note : &apos;&apos;
        String line = &quot;${rowText} | field=${field} | API=${cr.apiPrint} | ${sourceName}=${cr.expPrint} | APIField=${apiKey ?: field} | ${sourceName}Field=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}${note}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

if (dbMode) {
    expectedRows.eachWithIndex { Map expectedRow, int dbIdx -&gt;
        String expectedId = idOf(expectedRow)
        if (expectedId &amp;&amp; !matchedDbIds.contains(expectedId)) {
            String dbLogin = valueOf(expectedRow, &apos;login&apos;) ?: &apos;&lt;empty&gt;&apos;
            failLines &lt;&lt; &quot; - [失败] | dbRow=${dbIdx + 1 + offset} | expectedId=${expectedId} | login=${dbLogin} | API=&lt;empty&gt; 接口当前页没有返回数据库中的订单/持仓记录 | 匹配方式=order_ticket/position_ticket/deal_ticket | DB记录=${expectedRow}&quot;
        }
    }
}

// Auxiliary profit recalculation: print calc_profit and compare with list_open_positions.items[].profit
List aux_profit_calc_detail_lines = []
List aux_profit_calc_ok_lines = []
List aux_profit_calc_fail_lines = []
List aux_profit_calc_skip_lines = []
Map aux_user_currency_cache = [:]
Map aux_symbol_cache = [:]
def aux_int_var = { String name, int defaultValue, int minValue, int maxValue -&gt;
    try {
        int v = Integer.parseInt(String.valueOf(vars.get(name) ?: defaultValue).trim())
        return Math.max(minValue, Math.min(maxValue, v))
    } catch (Throwable ignored) {
        return defaultValue
    }
}
boolean aux_profit_enabled = ![&apos;0&apos;, &apos;false&apos;, &apos;no&apos;, &apos;off&apos;].contains(String.valueOf(vars.get(&apos;open_positions_aux_profit_calc_enabled&apos;) ?: &apos;1&apos;).trim().toLowerCase())
int aux_profit_max_rows = aux_int_var(&apos;open_positions_aux_profit_calc_max_rows&apos;, 500, 0, 5000)
int aux_connect_timeout_ms = aux_int_var(&apos;open_positions_aux_http_connect_timeout_ms&apos;, 1000, 200, 30000)
int aux_read_timeout_ms = aux_int_var(&apos;open_positions_aux_http_read_timeout_ms&apos;, 3000, 500, 60000)
String aux_profit_disabled_raw = vars.get(&apos;open_positions_aux_profit_calc_disabled_compare_fields&apos;) ?: &apos;&apos;
Set aux_profit_disabled = disabledSet(aux_profit_disabled_raw)
boolean aux_profit_skip_all = aux_profit_disabled.contains(&apos;*&apos;)
def auxProfitFieldDisabled = { String field -&gt;
    if (aux_profit_skip_all) return true
    Set candidates = [normKey(field)] as Set
    aliases.each { canonical, aliasList -&gt;
        if (candidates.contains(normKey(canonical)) || aliasList.any { candidates.contains(normKey(it)) }) {
            candidates &lt;&lt; normKey(canonical)
            aliasList.each { candidates &lt;&lt; normKey(it) }
        }
    }
    candidates.any { aux_profit_disabled.contains(it) }
}
String aux_profit_tolerance_raw = vars.get(&apos;open_positions_aux_profit_calc_field_tolerance_percent&apos;) ?: &apos;&apos;
Map aux_profit_tolerance_map = parseToleranceMap(aux_profit_tolerance_raw)
def auxProfitToleranceForField = { String field -&gt;
    BigDecimal configured = null
    Set candidates = [normKey(field)] as Set
    aliases.each { canonical, aliasList -&gt;
        if (candidates.contains(normKey(canonical)) || aliasList.any { candidates.contains(normKey(it)) }) {
            candidates &lt;&lt; normKey(canonical)
            aliasList.each { candidates &lt;&lt; normKey(it) }
        }
    }
    candidates.each { k -&gt; if (configured == null &amp;&amp; aux_profit_tolerance_map.containsKey(k)) configured = aux_profit_tolerance_map[k] }
    if (configured != null) return configured
    normKey(field) == &apos;profit_reporting&apos; ? BigDecimal.ZERO : new BigDecimal(&apos;10&apos;)
}
def auxToleranceMapText = { -&gt;
    aux_profit_tolerance_map ? aux_profit_tolerance_map.collect { k, v -&gt; k + &apos;=&apos; + pctText(v) }.join(&apos;,&apos;) : &apos;&lt;empty&gt;(profit_reporting default 0%; other fields default 10%)&apos;
}
def auxCompareValue = { String field, Object apiVal, Object expectedVal, String expectedSource -&gt;
    if (blank(apiVal) &amp;&amp; blank(expectedVal)) {
        return [same: true, apiPrint: &apos;&lt;empty&gt;&apos;, expPrint: &apos;&lt;empty&gt;&apos;, diff: &apos;N/A&apos;, percent: &apos;N/A(empty)&apos;, formula: &apos;API and &apos; + expectedSource + &apos; are both empty&apos;, note: &apos;API and &apos; + expectedSource + &apos; are both empty, pass&apos;]
    }
    if (blank(apiVal) || blank(expectedVal)) {
        String note = blank(apiVal) ? &apos;API is empty, &apos; + expectedSource + &apos; has value, fail&apos; : expectedSource + &apos; is empty, fail&apos;
        return [same: false, apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: &apos;N/A&apos;, percent: &apos;N/A(empty)&apos;, formula: &apos;empty compare: &apos; + note, note: note]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        BigDecimal tolerancePercent = auxProfitToleranceForField(field)
        BigDecimal base = en.abs()
        BigDecimal allowed = BigDecimal.ZERO
        boolean same
        String pct
        String formula
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            same = diff.compareTo(BigDecimal.ZERO) == 0
            pct = same ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0)&apos;
            formula = &apos;abs(&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;))=&apos; + fmtNum(diff) + &apos;, &apos; + expectedSource + &apos;=0, require API also equals 0&apos;
        } else {
            allowed = base.multiply(tolerancePercent).divide(new BigDecimal(&apos;100&apos;), 10, RoundingMode.HALF_UP)
            same = diff.compareTo(allowed) &lt;= 0
            BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
            pct = pctText(percent)
            formula = &apos;abs((&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;)) / &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
        }
        String toleranceText = pctText(tolerancePercent)
        String note = same ? field + &apos; 误差小于等于&apos; + toleranceText + &apos;，通过&apos; : field + &apos; 误差大于&apos; + toleranceText + &apos;，失败&apos;
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: pct, formula: formula + &apos; | 允许误差&lt;=&apos; + toleranceText + &apos;(允许差值=&apos; + fmtNum(allowed) + &apos;)&apos;, note: note]
    }
    boolean same = String.valueOf(apiVal ?: &apos;&apos;).trim() == String.valueOf(expectedVal ?: &apos;&apos;).trim()
    [same: same, apiPrint: String.valueOf(apiVal ?: &apos;&apos;), expPrint: String.valueOf(expectedVal ?: &apos;&apos;), diff: &apos;N/A&apos;, percent: &apos;N/A(non_numeric)&apos;, formula: &apos;non numeric exact compare&apos;]
}
String aux_host = (vars.get(&apos;middlewareip&apos;) ?: vars.get(&apos;CRM2.0middlewareip&apos;) ?: vars.get(&apos;ip&apos;) ?: &apos;&apos;).trim()
String aux_port = (vars.get(&apos;port&apos;) ?: &apos;8080&apos;).trim()
String aux_base_url = &apos;http://&apos; + aux_host + (aux_port ? &apos;:&apos; + aux_port : &apos;&apos;)
def aux_urlenc = { Object v -&gt; java.net.URLEncoder.encode(String.valueOf(v ?: &apos;&apos;), &apos;UTF-8&apos;) }
def aux_json_rows = { Object json -&gt;
    if (json instanceof Map &amp;&amp; json.data instanceof List) return json.data.collect { rowToMap(it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map &amp;&amp; json.data.items instanceof List) return json.data.items.collect { rowToMap(it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map) return [rowToMap(json.data)]
    if (json instanceof Map &amp;&amp; json.items instanceof List) return json.items.collect { rowToMap(it) }
    if (json instanceof List) return json.collect { rowToMap(it) }
    []
}
def aux_get_json = { String path -&gt;
    if (!aux_host) throw new IllegalStateException(&apos;middlewareip/CRM2.0middlewareip is empty&apos;)
    java.net.HttpURLConnection conn = null
    try {
        conn = (java.net.HttpURLConnection) new java.net.URL(aux_base_url + path).openConnection()
        conn.setRequestMethod(&apos;GET&apos;)
        conn.setConnectTimeout(aux_connect_timeout_ms)
        conn.setReadTimeout(aux_read_timeout_ms)
        conn.setRequestProperty(&apos;Accept&apos;, &apos;application/json&apos;)
        String text
        try {
            text = conn.getInputStream().getText(&apos;UTF-8&apos;)
        } catch (Throwable io) {
            text = conn.getErrorStream() == null ? &apos;&apos; : conn.getErrorStream().getText(&apos;UTF-8&apos;)
            throw new IllegalStateException(&apos;GET &apos; + path + &apos; failed, http=&apos; + conn.getResponseCode() + &apos;, body=&apos; + text, io)
        }
        return new JsonSlurper().parseText(text ?: &apos;{}&apos;)
    } finally {
        try { conn?.disconnect() } catch (ignored) {}
    }
}
def aux_account_currency = { String instanceId, Object loginRaw -&gt;
    String loginText = cleanNumText(loginRaw)
    String key = instanceId + &apos;|&apos; + loginText
    if (aux_user_currency_cache.containsKey(key)) return aux_user_currency_cache[key]
    def json = aux_get_json(&apos;/crm20/get_user_info?instanceid=&apos; + aux_urlenc(instanceId) + &apos;&amp;login=&apos; + aux_urlenc(loginText))
    List rows = aux_json_rows(json)
    Map row = rows ? rows[0] : [:]
    Object cur = valueOf(row, &apos;currency&apos;)
    if (blank(cur) &amp;&amp; row.Group instanceof Map) cur = row.Group.Currency
    if (blank(cur) &amp;&amp; row.group instanceof Map) cur = row.group.currency ?: row.group.Currency
    String out = blank(cur) ? &apos;&apos; : String.valueOf(cur).trim().toUpperCase()
    aux_user_currency_cache[key] = out
    return out
}
def aux_symbol_info = { String instanceId, String symbolRaw -&gt;
    String symbolText = String.valueOf(symbolRaw ?: &apos;&apos;).trim()
    String key = instanceId + &apos;|&apos; + symbolText.toUpperCase()
    if (aux_symbol_cache.containsKey(key)) return aux_symbol_cache[key]
    Map out = [:]
    try {
        def json = aux_get_json(&apos;/crm20/get_symbol_ex?instanceid=&apos; + aux_urlenc(instanceId) + &apos;&amp;name=&apos; + aux_urlenc(symbolText) + &apos;&amp;_select=name,currency_profit,currency_margin,currency_base,contract_size,tick_size,tick_value,bid,ask,digits,profit_mode,quote_updated_utc_ms&apos;)
        List rows = aux_json_rows(json)
        out = rows ? rows[0] : [:]

    } catch (Throwable e) {
        out = [__error: e.class.simpleName + &apos;: &apos; + e.message]
    }
    out[&apos;__query_symbol&apos;] = symbolText
    aux_symbol_cache[key] = out
    return out
}
Set aux_cent_currencies = [&apos;USC&apos;] as Set
Set aux_usd_like_currencies = [&apos;USD&apos;, &apos;USDT&apos;, &apos;USDC&apos;] as Set
def aux_primary_quote = { Map symbolInfo, String fromRaw, String toRaw -&gt;
    if (!(symbolInfo instanceof Map)) return null
    String baseCur = String.valueOf(valueOf(symbolInfo, &apos;currency_base&apos;) ?: &apos;&apos;).trim().toUpperCase()
    String profitCur = String.valueOf(valueOf(symbolInfo, &apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
    String from = String.valueOf(fromRaw ?: &apos;&apos;).trim().toUpperCase()
    String to = String.valueOf(toRaw ?: &apos;&apos;).trim().toUpperCase()
    if (baseCur == from &amp;&amp; profitCur == to) return symbolInfo
    return null
}
def aux_currency_rate
aux_currency_rate = { String fromRaw, String toRaw, String instanceId, BigDecimal rawProfit, Map primarySymbolInfo -&gt;
    String from = String.valueOf(fromRaw ?: &apos;&apos;).trim().toUpperCase()
    String to = String.valueOf(toRaw ?: &apos;&apos;).trim().toUpperCase()
    if (!from || !to) return [rate: null, path: &apos;missing currency&apos;, quote_detail: &apos;rate_quote_source=missing_currency&apos;]
    if (from == to) return [rate: BigDecimal.ONE, path: from + &apos;-&gt;&apos; + to + &apos;=1&apos;, quote_detail: &apos;rate_quote_source=same_currency | rate_quote_calc=&apos; + from + &apos;-&gt;&apos; + to + &apos;=1&apos;]
    if (from == &apos;USD&apos; &amp;&amp; aux_cent_currencies.contains(to)) return [rate: new BigDecimal(&apos;100&apos;), path: &apos;USD-&gt;&apos; + to + &apos;=100(cent account)&apos;, quote_detail: &apos;rate_quote_source=fixed_cent_rule | rate_quote_calc=USD-&gt;&apos; + to + &apos;=100&apos;]
    if (aux_cent_currencies.contains(from) &amp;&amp; to == &apos;USD&apos;) return [rate: new BigDecimal(&apos;0.01&apos;), path: from + &apos;-&gt;USD=0.01(cent account)&apos;, quote_detail: &apos;rate_quote_source=fixed_cent_rule | rate_quote_calc=&apos; + from + &apos;-&gt;USD=0.01&apos;]
    boolean positive = rawProfit == null || rawProfit.compareTo(BigDecimal.ZERO) &gt;= 0
    Map direct = aux_primary_quote(primarySymbolInfo, from, to)
    if (!(direct instanceof Map)) direct = aux_symbol_info(instanceId, from + to)
    BigDecimal directBid = asNum(valueOf(direct, &apos;bid&apos;))
    BigDecimal directAsk = asNum(valueOf(direct, &apos;ask&apos;))
    if (directBid != null &amp;&amp; directAsk != null) {
        BigDecimal price = positive ? directBid : directAsk
        String quoteName = valueOf(direct, &apos;__query_symbol&apos;) ?: (from + to)
        String quoteField = positive ? &apos;bid&apos; : &apos;ask&apos;
        String quoteDetail = &apos;rate_quote_symbol=&apos; + quoteName + &apos; | rate_quote_field=&apos; + quoteField + &apos; | rate_quote_value=&apos; + fmtNum(price) + &apos; | rate_quote_bid=&apos; + fmtNum(directBid) + &apos; | rate_quote_ask=&apos; + fmtNum(directAsk) + &apos; | rate_quote_source=get_symbol_ex(instanceid=&apos; + instanceId + &apos;,name=&apos; + quoteName + &apos;) | rate_quote_calc=rate_profit=rate_quote_value=&apos; + fmtNum(price)
        return [rate: price, path: quoteName + &apos; &apos; + from + &apos;-&gt;&apos; + to + (positive ? &apos;.bid&apos; : &apos;.ask&apos;) + &apos;=&apos; + fmtNum(price), quote_detail: quoteDetail]
    }
    Map reverse = aux_primary_quote(primarySymbolInfo, to, from)
    if (!(reverse instanceof Map)) reverse = aux_symbol_info(instanceId, to + from)
    BigDecimal reverseBid = asNum(valueOf(reverse, &apos;bid&apos;))
    BigDecimal reverseAsk = asNum(valueOf(reverse, &apos;ask&apos;))
    if (reverseBid != null &amp;&amp; reverseAsk != null) {
        BigDecimal price = positive ? reverseAsk : reverseBid
        if (price.compareTo(BigDecimal.ZERO) != 0) {
            BigDecimal rate = BigDecimal.ONE.divide(price, 12, RoundingMode.HALF_UP)
            String quoteName = valueOf(reverse, &apos;__query_symbol&apos;) ?: (to + from)
            String quoteField = positive ? &apos;ask&apos; : &apos;bid&apos;
            String quoteDetail = &apos;rate_quote_symbol=&apos; + quoteName + &apos; | rate_quote_field=&apos; + quoteField + &apos; | rate_quote_value=&apos; + fmtNum(price) + &apos; | rate_quote_bid=&apos; + fmtNum(reverseBid) + &apos; | rate_quote_ask=&apos; + fmtNum(reverseAsk) + &apos; | rate_quote_source=get_symbol_ex(instanceid=&apos; + instanceId + &apos;,name=&apos; + quoteName + &apos;) | rate_quote_calc=rate_profit=1 / rate_quote_value = 1 / &apos; + fmtNum(price) + &apos; = &apos; + fmtNum(rate)
            return [rate: rate, path: &apos;1/&apos; + quoteName + &apos; &apos; + from + &apos;-&gt;&apos; + to + (positive ? &apos;.ask&apos; : &apos;.bid&apos;) + &apos;=1/&apos; + fmtNum(price), quote_detail: quoteDetail]
        }
    }
    if (aux_usd_like_currencies.contains(from) &amp;&amp; aux_usd_like_currencies.contains(to)) {
        return [rate: BigDecimal.ONE, path: from + &apos;-&gt;&apos; + to + &apos;=1(USD-like fallback; no quote found)&apos;, quote_detail: &apos;rate_quote_source=usd_like_fallback | rate_quote_calc=&apos; + from + &apos;-&gt;&apos; + to + &apos;=1&apos;]
    }
    if (aux_cent_currencies.contains(to) &amp;&amp; from != &apos;USD&apos;) {
        def left = aux_currency_rate(from, &apos;USD&apos;, instanceId, rawProfit, primarySymbolInfo)
        if (left.rate != null) return [rate: left.rate.multiply(new BigDecimal(&apos;100&apos;)), path: &apos;(&apos; + left.path + &apos;) * (USD-&gt;&apos; + to + &apos;=100)&apos;, quote_detail: &apos;rate_quote_chain=(&apos; + (left.quote_detail ?: left.path) + &apos;) * (rate_quote_source=fixed_cent_rule | rate_quote_calc=USD-&gt;&apos; + to + &apos;=100)&apos;]
    }
    if (aux_cent_currencies.contains(from) &amp;&amp; to != &apos;USD&apos;) {
        def right = aux_currency_rate(&apos;USD&apos;, to, instanceId, rawProfit, primarySymbolInfo)
        if (right.rate != null) return [rate: new BigDecimal(&apos;0.01&apos;).multiply(right.rate), path: &apos;(&apos; + from + &apos;-&gt;USD=0.01) * (&apos; + right.path + &apos;)&apos;, quote_detail: &apos;rate_quote_chain=(rate_quote_source=fixed_cent_rule | rate_quote_calc=&apos; + from + &apos;-&gt;USD=0.01) * (&apos; + (right.quote_detail ?: right.path) + &apos;)&apos;]
    }
    if (from != &apos;USD&apos; &amp;&amp; to != &apos;USD&apos;) {
        def left = aux_currency_rate(from, &apos;USD&apos;, instanceId, rawProfit, primarySymbolInfo)
        def right = aux_currency_rate(&apos;USD&apos;, to, instanceId, rawProfit, primarySymbolInfo)
        if (left.rate != null &amp;&amp; right.rate != null) {
            BigDecimal rate = left.rate.multiply(right.rate)
            return [rate: rate, path: &apos;(&apos; + left.path + &apos;) * (&apos; + right.path + &apos;)&apos;, quote_detail: &apos;rate_quote_chain=(&apos; + (left.quote_detail ?: left.path) + &apos;) * (&apos; + (right.quote_detail ?: right.path) + &apos;)&apos;]
        }
    }
    return [rate: null, path: &apos;no quote path for &apos; + from + &apos;-&gt;&apos; + to, quote_detail: &apos;rate_quote_source=not_found | rate_quote_calc=no quote path for &apos; + from + &apos;-&gt;&apos; + to]
}

List aux_calc_items = aux_profit_enabled ? apiItems.take(aux_profit_max_rows) : []
if (!aux_profit_enabled) {
    String line = &apos;reason=open_positions_aux_profit_calc_enabled=0&apos;
    String fullLine = &apos; - [跳过] | 辅助接口profit计算 | &apos; + line
    aux_profit_calc_detail_lines &lt;&lt; fullLine
    aux_profit_calc_skip_lines &lt;&lt; fullLine
} else if (apiItems.size() &gt; aux_calc_items.size()) {
    String line = &apos;reason=只复算前&apos; + aux_calc_items.size() + &apos;条，接口返回&apos; + apiItems.size() + &apos;条；可调大 open_positions_aux_profit_calc_max_rows&apos;
    String fullLine = &apos; - [跳过] | 辅助接口profit计算 | &apos; + line
    aux_profit_calc_detail_lines &lt;&lt; fullLine
    aux_profit_calc_skip_lines &lt;&lt; fullLine
}
aux_calc_items.eachWithIndex { Map apiRow, int idx -&gt;
    String rowNo = String.valueOf(idx + 1 + offset)
    String rowId = idOf(apiRow)
    String instanceId = String.valueOf(valueOf(apiRow, &apos;instance_id&apos;) ?: &apos;&apos;).trim()
    Object loginVal = valueOf(apiRow, &apos;login&apos;)
    String symbolText = String.valueOf(valueOf(apiRow, &apos;symbol&apos;) ?: &apos;&apos;).trim()
    String sideText = String.valueOf(valueOf(apiRow, &apos;side&apos;) ?: &apos;&apos;).trim().toLowerCase()
    BigDecimal priceOpen = asNum(valueOf(apiRow, &apos;price_open&apos;))
    BigDecimal priceCurrent = asNum(valueOf(apiRow, &apos;price_current&apos;))
    BigDecimal volumeLots = asNum(valueOf(apiRow, &apos;volume_lots&apos;))
    BigDecimal apiProfit = asNum(valueOf(apiRow, &apos;profit&apos;))
    String detailPrefix = &apos;row=&apos; + rowNo + &apos; | apiId=&apos; + rowId + &apos; | instance_id=&apos; + (instanceId ?: &apos;&lt;empty&gt;&apos;) + &apos; | login=&apos; + String.valueOf(loginVal ?: &apos;&lt;empty&gt;&apos;) + &apos; | symbol=&apos; + symbolText + &apos; | 辅助接口变量来源=list_open_positions.items[] | get_user_info参数=instance_id+login | get_symbol_ex参数=instance_id+symbol&apos;
    Map auxDbRow = [:]
    if (dbMode) {
        auxDbRow = rowId &amp;&amp; expectedById.containsKey(rowId) ? (expectedById[rowId] ?: [:]) : (expectedRows.find { idOf(it) == rowId } ?: [:])
    }
    if (auxProfitFieldDisabled(&apos;profit&apos;)) {
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | field=profit | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=字段在 open_positions_aux_profit_calc_disabled_compare_fields 跳过配置中 | disabled_config=&apos; + aux_profit_disabled_raw
        String fullLine = &apos; - [跳过] | 辅助接口profit计算 | &apos; + line
        aux_profit_calc_detail_lines &lt;&lt; fullLine
        aux_profit_calc_skip_lines &lt;&lt; fullLine
        return
    }
    try {
        if (!instanceId || blank(loginVal) || !symbolText || !sideText || priceOpen == null || volumeLots == null || apiProfit == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=缺少主接口字段(instance_id/login/symbol/side/price_open/volume_lots/profit)&apos;
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            aux_profit_calc_fail_lines &lt;&lt; line
            return
        }
        String accountCurrency = aux_account_currency(instanceId, loginVal)
        Map symbolInfo = aux_symbol_info(instanceId, symbolText)
        String currencyProfit = String.valueOf(valueOf(symbolInfo, &apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
        BigDecimal bid = asNum(valueOf(symbolInfo, &apos;bid&apos;))
        BigDecimal ask = asNum(valueOf(symbolInfo, &apos;ask&apos;))
        BigDecimal contractSize = asNum(valueOf(symbolInfo, &apos;contract_size&apos;)) ?: asNum(valueOf(apiRow, &apos;contract_size&apos;))
        String symbolError = String.valueOf(valueOf(symbolInfo, &apos;__error&apos;) ?: &apos;&apos;).trim()
        if (!accountCurrency || !currencyProfit || bid == null || ask == null || contractSize == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | account_currency=&apos; + accountCurrency + &apos; | currency_profit=&apos; + currencyProfit + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | bid=&apos; + fmtNum(bid) + &apos; | ask=&apos; + fmtNum(ask) + &apos; | contract_size=&apos; + fmtNum(contractSize) + (symbolError ? &apos; | symbol_error=&apos; + symbolError : &apos;&apos;) + &apos; | reason=辅助接口字段缺失&apos;
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            aux_profit_calc_fail_lines &lt;&lt; line
            return
        }
        BigDecimal rawProfit
        String basis
        String formulaLeft
        if (sideText == &apos;sell&apos;) {
            rawProfit = priceOpen.subtract(ask).multiply(contractSize).multiply(volumeLots)
            basis = &apos;ask&apos;
            formulaLeft = &apos;(price_open - ask)&apos;
        } else {
            rawProfit = bid.subtract(priceOpen).multiply(contractSize).multiply(volumeLots)
            basis = &apos;bid&apos;
            formulaLeft = &apos;(bid - price_open)&apos;
        }
        def rateInfo = aux_currency_rate(currencyProfit, accountCurrency, instanceId, rawProfit, symbolInfo)
        if (rateInfo.rate == null) {
            String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | raw_profit=&apos; + fmtNum(rawProfit) + &apos; | account_currency=&apos; + accountCurrency + &apos; | currency_profit=&apos; + currencyProfit + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | reason=rate_profit不可计算 | rate_path=&apos; + rateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(rateInfo.quote_detail ?: &apos;&apos;)
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            aux_profit_calc_fail_lines &lt;&lt; line
            return
        }
        BigDecimal calcProfit = rawProfit.multiply(rateInfo.rate).setScale(8, RoundingMode.HALF_UP)
        def cr = auxCompareValue(&apos;profit&apos;, apiProfit, calcProfit, &apos;辅助接口计算&apos;)
        String formula = formulaLeft + &apos; * contract_size * volume_lots * rate_profit = &apos; + fmtNum(calcProfit)
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&apos; + fmtNum(calcProfit) + &apos; | &apos; + detailPrefix + &apos; | raw_profit=&apos; + fmtNum(rawProfit) + &apos; | rate_profit=&apos; + fmtNum(rateInfo.rate) + &apos; | rate_path=&apos; + rateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(rateInfo.quote_detail ?: &apos;&apos;) + &apos; | account_currency=&apos; + accountCurrency + &apos; | currency_profit=&apos; + currencyProfit + &apos; | side=&apos; + sideText + &apos; | price_open=&apos; + fmtNum(priceOpen) + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | price_basis=&apos; + basis + &apos; | bid=&apos; + fmtNum(bid) + &apos; | ask=&apos; + fmtNum(ask) + &apos; | contract_size=&apos; + fmtNum(contractSize) + &apos; | volume_lots=&apos; + fmtNum(volumeLots) + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + formula
        if (cr.same) {
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [通过] | 辅助接口profit计算 | &apos; + line
            aux_profit_calc_ok_lines &lt;&lt; line
        } else {
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
            aux_profit_calc_fail_lines &lt;&lt; line
        }

        // Reporting calculation starts from the freshly calculated native calc_profit, never from API profit_reporting.
        BigDecimal apiProfitReporting = asNum(valueOf(apiRow, &apos;profit_reporting&apos;))
        BigDecimal apiNetProfitReporting = asNum(valueOf(apiRow, &apos;net_profit_reporting&apos;))
        Object normalizationRaw = valueOf(apiRow, &apos;normalization_complete&apos;)
        boolean normalizationComplete = normalizationRaw instanceof Boolean ? ((Boolean) normalizationRaw).booleanValue() : String.valueOf(normalizationRaw ?: &apos;&apos;).trim().equalsIgnoreCase(&apos;true&apos;)
        if (!normalizationComplete) {
            String reportingLine = &apos;API_profit_reporting=&apos; + fmtNum(apiProfitReporting) + &apos; | calc_profit_reporting=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | reason=normalization_complete=false; reporting values may be null&apos;
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [SKIP] | aux profit_reporting calculation | &apos; + reportingLine
            aux_profit_calc_skip_lines &lt;&lt; reportingLine
        } else if (auxProfitFieldDisabled(&apos;profit_reporting&apos;)) {
            String reportingLine = &apos;API_profit_reporting=&apos; + fmtNum(apiProfitReporting) + &apos; | calc_profit_reporting=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | field=profit_reporting | reason=disabled by open_positions_aux_profit_calc_disabled_compare_fields | disabled_config=&apos; + aux_profit_disabled_raw
            aux_profit_calc_detail_lines &lt;&lt; &apos; - [SKIP] | aux profit_reporting calculation | &apos; + reportingLine
            aux_profit_calc_skip_lines &lt;&lt; reportingLine
        } else {
            def reportingRateInfo = aux_currency_rate(accountCurrency, &apos;USD&apos;, instanceId, calcProfit, symbolInfo)
            if (reportingRateInfo.rate == null || apiProfitReporting == null) {
                String reportingLine = &apos;API_profit_reporting=&apos; + fmtNum(apiProfitReporting) + &apos; | calc_profit_reporting=&lt;empty&gt; | &apos; + detailPrefix + &apos; | calc_profit=&apos; + fmtNum(calcProfit) + &apos; | account_currency=&apos; + accountCurrency + &apos; | reason=&apos; + (reportingRateInfo.rate == null ? &apos;account-currency-to-USD rate unavailable&apos; : &apos;API profit_reporting is empty&apos;) + &apos; | reporting_rate_path=&apos; + reportingRateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(reportingRateInfo.quote_detail ?: &apos;&apos;)
                aux_profit_calc_detail_lines &lt;&lt; &apos; - [FAIL] | aux profit_reporting calculation | &apos; + reportingLine
                aux_profit_calc_fail_lines &lt;&lt; reportingLine
            } else {
                BigDecimal calcProfitReporting = calcProfit.multiply(reportingRateInfo.rate).setScale(8, RoundingMode.HALF_UP)
                def reportingCr = auxCompareValue(&apos;profit_reporting&apos;, apiProfitReporting, calcProfitReporting, &apos;aux calc_profit_reporting&apos;)
                String reportingFormula = &apos;calc_profit(&apos; + fmtNum(calcProfit) + &apos;) * account_currency_to_USD_rate(&apos; + fmtNum(reportingRateInfo.rate) + &apos;) = &apos; + fmtNum(calcProfitReporting)
                String reportingLine = &apos;field=profit_reporting | API_profit_reporting=&apos; + fmtNum(apiProfitReporting) + &apos; | calc_profit_reporting=&apos; + fmtNum(calcProfitReporting) + &apos; | &apos; + detailPrefix + &apos; | calc_profit=&apos; + fmtNum(calcProfit) + &apos; | account_currency=&apos; + accountCurrency + &apos; | reporting_currency=USD | reporting_rate=&apos; + fmtNum(reportingRateInfo.rate) + &apos; | reporting_rate_path=&apos; + reportingRateInfo.path + &apos; | rate_quote_detail=&apos; + String.valueOf(reportingRateInfo.quote_detail ?: &apos;&apos;) + &apos; | 差值=abs(API_profit_reporting-calc_profit_reporting)=&apos; + reportingCr.diff + &apos; | 相差百分比=&apos; + reportingCr.percent + &apos; | 误差计算过程=&apos; + reportingCr.formula + &apos; | 数值计算过程=&apos; + reportingFormula + &apos; | 备注=&apos; + reportingCr.note
                if (reportingCr.same) {
                    aux_profit_calc_detail_lines &lt;&lt; &apos; - [通过] | 辅助接口profit_reporting计算/API对比 | &apos; + reportingLine
                    aux_profit_calc_ok_lines &lt;&lt; reportingLine
                } else {
                    aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit_reporting计算/API对比 | &apos; + reportingLine
                    aux_profit_calc_fail_lines &lt;&lt; reportingLine
                }
                if (!dbMode || !auxDbRow) {
                    String netLine = &apos;API_net_profit_reporting=&apos; + fmtNum(apiNetProfitReporting) + &apos; | calc_net_profit_reporting=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | reason=DB mode/DB row is required for swap_reporting, commission_reporting and fee_reporting&apos;
                    aux_profit_calc_detail_lines &lt;&lt; &apos; - [SKIP] | aux net_profit_reporting calculation | &apos; + netLine
                    aux_profit_calc_skip_lines &lt;&lt; netLine
                } else if (auxProfitFieldDisabled(&apos;net_profit_reporting&apos;)) {
                    String netLine = &apos;API_net_profit_reporting=&apos; + fmtNum(apiNetProfitReporting) + &apos; | calc_net_profit_reporting=&lt;skipped&gt; | &apos; + detailPrefix + &apos; | field=net_profit_reporting | reason=disabled by open_positions_aux_profit_calc_disabled_compare_fields | disabled_config=&apos; + aux_profit_disabled_raw
                    aux_profit_calc_detail_lines &lt;&lt; &apos; - [SKIP] | aux net_profit_reporting calculation | &apos; + netLine
                    aux_profit_calc_skip_lines &lt;&lt; netLine
                } else {
                    BigDecimal dbSwapReporting = asNum(valueOf(auxDbRow, &apos;swap_reporting&apos;))
                    BigDecimal dbCommissionReporting = asNum(valueOf(auxDbRow, &apos;commission_reporting&apos;))
                    BigDecimal dbFeeReporting = asNum(valueOf(auxDbRow, &apos;fee_reporting&apos;))
                    if (apiNetProfitReporting == null || dbSwapReporting == null || dbCommissionReporting == null || dbFeeReporting == null) {
                        String netLine = &apos;API_net_profit_reporting=&apos; + fmtNum(apiNetProfitReporting) + &apos; | calc_net_profit_reporting=&lt;empty&gt; | &apos; + detailPrefix + &apos; | calc_profit_reporting=&apos; + fmtNum(calcProfitReporting) + &apos; | DB_swap_reporting=&apos; + fmtNum(dbSwapReporting) + &apos; | DB_commission_reporting=&apos; + fmtNum(dbCommissionReporting) + &apos; | DB_fee_reporting=&apos; + fmtNum(dbFeeReporting) + &apos; | reason=an API/DB component is empty&apos;
                        aux_profit_calc_detail_lines &lt;&lt; &apos; - [FAIL] | aux net_profit_reporting calculation | &apos; + netLine
                        aux_profit_calc_fail_lines &lt;&lt; netLine
                    } else {
                        BigDecimal calcNetProfitReporting = calcProfitReporting.add(dbSwapReporting).add(dbCommissionReporting).add(dbFeeReporting).setScale(8, RoundingMode.HALF_UP)
                        def netCr = auxCompareValue(&apos;net_profit_reporting&apos;, apiNetProfitReporting, calcNetProfitReporting, &apos;aux calc_net_profit_reporting&apos;)
                        String netFormula = &apos;calc_profit_reporting(&apos; + fmtNum(calcProfitReporting) + &apos;) + DB_swap_reporting(&apos; + fmtNum(dbSwapReporting) + &apos;) + DB_commission_reporting(&apos; + fmtNum(dbCommissionReporting) + &apos;) + DB_fee_reporting(&apos; + fmtNum(dbFeeReporting) + &apos;) = &apos; + fmtNum(calcNetProfitReporting)
                        String netLine = &apos;API_net_profit_reporting=&apos; + fmtNum(apiNetProfitReporting) + &apos; | calc_net_profit_reporting=&apos; + fmtNum(calcNetProfitReporting) + &apos; | &apos; + detailPrefix + &apos; | calc_profit_reporting=&apos; + fmtNum(calcProfitReporting) + &apos; | DB_swap_reporting=&apos; + fmtNum(dbSwapReporting) + &apos; | DB_commission_reporting=&apos; + fmtNum(dbCommissionReporting) + &apos; | DB_fee_reporting=&apos; + fmtNum(dbFeeReporting) + &apos; | diff=&apos; + netCr.diff + &apos; | percent=&apos; + netCr.percent + &apos; | formula=&apos; + netFormula
                        if (netCr.same) {
                            aux_profit_calc_detail_lines &lt;&lt; &apos; - [PASS] | aux net_profit_reporting calculation | &apos; + netLine
                            aux_profit_calc_ok_lines &lt;&lt; netLine
                        } else {
                            aux_profit_calc_detail_lines &lt;&lt; &apos; - [FAIL] | aux net_profit_reporting calculation | &apos; + netLine
                            aux_profit_calc_fail_lines &lt;&lt; netLine
                        }
                    }
                }
            }
        }
    } catch (Throwable e) {
        String line = &apos;API_profit=&apos; + fmtNum(apiProfit) + &apos; | calc_profit=&lt;empty&gt; | &apos; + detailPrefix + &apos; | price_current=&apos; + fmtNum(priceCurrent) + &apos; | exception=&apos; + e.class.simpleName + &apos;: &apos; + e.message
        aux_profit_calc_detail_lines &lt;&lt; &apos; - [失败] | 辅助接口profit计算 | &apos; + line
        aux_profit_calc_fail_lines &lt;&lt; line
    }
}
okLines.addAll(aux_profit_calc_detail_lines.findAll { it.contains(&apos;[通过]&apos;) || it.contains(&apos;[PASS]&apos;) })
failLines.addAll(aux_profit_calc_detail_lines.findAll { it.contains(&apos;[失败]&apos;) || it.contains(&apos;[FAIL]&apos;) })
skipLines.addAll(aux_profit_calc_skip_lines)

List aux_profit_calc_fail_report_lines = aux_profit_calc_fail_lines.collect { &apos; - [失败] | 辅助接口profit计算 | &apos; + it }
List aux_profit_calc_ok_report_lines = aux_profit_calc_ok_lines.collect { &apos; - [通过] | 辅助接口profit计算 | &apos; + it }
List aux_profit_calc_skip_report_lines = aux_profit_calc_skip_lines

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List report = []
report &lt;&lt; &apos;Assertion message: 查询多个账户的当前持仓订单 &apos; + modeText + &apos; 对比结果 | status=&apos; + status + &apos; | case=&apos; + vars.get(&apos;open_positions_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;open_positions_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;open_positions_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku
report &lt;&lt; &apos;接口: POST /crm20/list_open_positions&apos;
report &lt;&lt; &apos;请求accounts: MT4_login=&apos; + vars.get(&apos;open_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;open_positions_mt5_login&apos;)
report &lt;&lt; &apos;分页排序: page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort_by=&apos; + sortBy + &apos; | sort_order=&apos; + (desc ? &apos;desc&apos; : &apos;asc&apos;)
report &lt;&lt; &apos;跳过字段配置: &apos; + (dbMode ? &apos;open_positions_db_api_disabled_compare_fields&apos; : &apos;open_positions_csv_api_disabled_compare_fields&apos;) + &apos;=[&apos; + disabledRaw(dbMode) + &apos;]&apos;
report &lt;&lt; &apos;字段误差配置: &apos; + toleranceConfigName(dbMode) + &apos;=[&apos; + toleranceRaw(dbMode) + &apos;]；未配置字段默认&apos; + (dbMode ? &apos;10%&apos; : &apos;5%&apos;) + &apos;；字段配置优先生效；同字段重复配置时后面的配置覆盖前面的配置&apos;
report &lt;&lt; &apos;字段误差配置解析结果: &apos; + toleranceMapText(dbMode)
report &lt;&lt; &apos;辅助接口profit计算跳过字段配置: open_positions_aux_profit_calc_disabled_compare_fields=[&apos; + aux_profit_disabled_raw + &apos;]&apos;
report &lt;&lt; &apos;辅助接口profit计算误差配置: open_positions_aux_profit_calc_field_tolerance_percent=[&apos; + aux_profit_tolerance_raw + &apos;]；profit_reporting未配置默认0%，其他字段未配置默认10%；误差以calc计算值为分母；不读取DB/API或CSV/API字段误差配置&apos;
report &lt;&lt; &apos;辅助接口profit计算误差配置解析结果: &apos; + auxToleranceMapText()
report &lt;&lt; &apos;接口summary: total=&apos; + apiTotal + &apos; | summary=&apos; + apiSummary
if (dbMode) report &lt;&lt; &apos;DB汇总: total_orders=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | DB总记录数(summary SQL)=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | 当前页DB记录数(page SQL)=&apos; + expectedRows.size()
if (dbMode &amp;&amp; dbSummaryFeeBreakdown) report &lt;&lt; dbSummaryFeeBreakdown
if (dbMode &amp;&amp; dbPageFeeBreakdown) report &lt;&lt; dbPageFeeBreakdown
report &lt;&lt; &apos;对比结果统计: 失败数量=&apos; + failLines.size() + &apos; | 成功数量=&apos; + okLines.size() + &apos; | 跳过数量=&apos; + skipLines.size() + &apos; | 对比字段总数=&apos; + apiFieldTotal
report &lt;&lt; &apos;辅助接口profit计算统计: 失败数量=&apos; + aux_profit_calc_fail_lines.size() + &apos; | 成功数量=&apos; + aux_profit_calc_ok_lines.size() + &apos; | 跳过数量=&apos; + aux_profit_calc_skip_lines.size() + &apos; | 计算明细数量=&apos; + aux_profit_calc_detail_lines.size()
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【辅助接口profit计算失败明细：&apos; + aux_profit_calc_fail_report_lines.size() + &apos;条】&apos;
report.addAll(aux_profit_calc_fail_report_lines ? aux_profit_calc_fail_report_lines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【辅助接口profit计算通过明细：&apos; + aux_profit_calc_ok_report_lines.size() + &apos;条】&apos;
report.addAll(aux_profit_calc_ok_report_lines ? aux_profit_calc_ok_report_lines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【辅助接口profit计算跳过明细：&apos; + aux_profit_calc_skip_report_lines.size() + &apos;条】&apos;
report.addAll(aux_profit_calc_skip_report_lines ? aux_profit_calc_skip_report_lines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;数值规则: DB/API普通数值字段默认按DB为基准允许误差&lt;=10%，CSV/API默认允许误差&lt;=5%；可通过各自字段误差配置按字段覆盖（例如DB/API配置profit=20,net_profit=50；CSV/API配置profit=20,net_profit=20）；DB/API与CSV/API误差配置互不覆盖；辅助接口profit计算只读取open_positions_aux_profit_calc_field_tolerance_percent，profit_reporting未配置默认0%、其他辅助计算字段未配置默认10%，均以calc计算值为误差分母；配置0表示必须完全相等；API和DB/CSV返回都是为空时判定通过；数据库无此字段判定失败；当前持仓summary的cent_volume/standard_volume按账户入金币种deposit currency是否属于cent set(当前SQL: USC)拆分；编号类字段精确比较；时间字段API按Asia/Shanghai展示后减8小时与DB比较，允许相差&lt;=60秒。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败明细：&apos; + failLines.size() + &apos;条】&apos;
report.addAll(failLines ? failLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细：&apos; + okLines.size() + &apos;条】&apos;
report.addAll(okLines ? okLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细：&apos; + skipLines.size() + &apos;条（含DB/CSV数值）】&apos;
report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【接口请求Body】&apos;
report &lt;&lt; (vars.get(&apos;open_positions_request_body&apos;) ?: &apos;&apos;)

String finalReport = report.join(&apos;\n&apos;)
publishReport(&apos;查询多个账户当前持仓字段对比结果&apos;, finalReport, failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">summary按接口summary字段逐字段对比；字段误差由 open_positions_db_api_field_tolerance_percent / open_positions_csv_api_field_tolerance_percent 按当前模式分别控制，DB/API只读取DB/API配置，CSV/API只读取CSV/API配置，未配置默认DB/API&lt;=10%、CSV/API&lt;=5%，配置0表示必须完全相等；辅助接口profit计算只读取 open_positions_aux_profit_calc_field_tolerance_percent，profit_reporting未配置默认0%、其他辅助计算字段未配置默认10%，误差以calc计算值为分母；API和DB/CSV返回都是为空时判定通过；数据库无此字段判定失败；当前持仓summary的cent_volume/standard_volume按账户入金币种deposit currency是否属于cent set(当前SQL: USC)拆分；DB/API当前页明细按SQL行顺序循环，每条DB记录下所有SQL字段都逐字段对比API items对应行；打印成功、失败、跳过字段明细；跳过字段同时打印API与DB/CSV值。</stringProp>
