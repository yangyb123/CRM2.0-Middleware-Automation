          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="符号规格和实时报价MT4-DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="symbol_ex_mt4_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">symbol_ex_mt4_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">volume_max,volume_min,volume_step,quote_updated_utc_ms,updated_utc_ms,contract_size,currency_base,currency_margin,currency_profit,profit_mode,trade_mode</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT4 DB/API跳过字段；支持英文/中文逗号、分号、空白分隔，*表示跳过全部。所有API返回字段均支持跳过；未配置字段继续比较。</stringProp>
              </elementProp>
              <elementProp name="symbol_ex_mt4_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">symbol_ex_mt4_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">ask=10,bid=10</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT4 DB/API逐字段百分比误差；支持field=10、field:10、field 10、field=10%，多个字段用逗号/分号/换行分隔；以DB绝对值为基准，误差小于等于配置值通过；未配置数值字段默认0%。</stringProp>
              </elementProp>
