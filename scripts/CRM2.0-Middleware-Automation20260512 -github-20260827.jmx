                  <stringProp name="Header.value">auth_token=3e05fa3e-27d0-4322-9957-52257b3dbe0d; HttpOnly; Secure; SameSite=Lax; Max-Age=86400; Path=/</stringProp>
                </elementProp>
              </collectionProp>
              <stringProp name="TestPlan.comments">Authorization	Bearer 5d7636bcbb5ea1315a780d3bbed0b49909e38ff9e6427a587ee30b60ce10dbae</stringProp>
            </HeaderManager>
            <hashTree/>
