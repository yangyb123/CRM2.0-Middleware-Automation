                <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def expectedLogin = vars.get(&quot;login_val&quot;)
def expectedRights = &quot;355&quot;

def errors = []

if (json.data.login?.toString() != expectedLogin) {
    errors &lt;&lt; &quot;login 期望: ${expectedLogin}，实际: ${json.data.login}&quot;
}

if (json.data.rights?.toString() != expectedRights) {
    errors &lt;&lt; &quot;rights 期望: ${expectedRights}，实际: ${json.data.rights}&quot;
}

if (errors) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;断言失败:\n&quot; + errors.join(&quot;\n&quot;))
}
