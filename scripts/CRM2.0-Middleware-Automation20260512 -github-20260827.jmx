              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="CSV字段对比断言-获取货币信息" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

// 读取当前接口响应正文，并解析成 JSON 对象。
String responseText = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(responseText)

// 从当前 CSV 行读取 Symbol，并在响应 data 数组里找到对应货币记录。
String expectedSymbol = vars.get(&apos;currency_Symbol&apos;)
def symbolInfo = json.data?.find { it.Symbol?.toString() == expectedSymbol }

// 如果响应中没有当前 CSV 行的 Symbol，直接断言失败。
if (symbolInfo == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;未找到 Symbol=&quot; + expectedSymbol)
    return
}

// failures 用来收集所有字段差异，最后一次性输出，方便定位多个字段不一致的问题。
def failures = []

// 字符串字段直接按文本比较，Group 为空字符串时也会参与比较。
def stringFields = [&apos;Status&apos;, &apos;Group&apos;, &apos;ServerType&apos;, &apos;Description&apos;, &apos;Symbol&apos;]

// 数值字段使用 BigDecimal 比较，避免 100000 和 100000.0 这类格式差异导致误判。
def numericFields = [&apos;ContractSize&apos;, &apos;TradeMode&apos;]

stringFields.each { field -&gt;
    String expected = vars.get(&apos;currency_&apos; + field)
    String actual = symbolInfo[field]?.toString()
    if (actual != expected) {
        failures &lt;&lt; &quot;${field}: expected=${expected}, actual=${actual}&quot;
    }
}

numericFields.each { field -&gt;
    String expected = vars.get(&apos;currency_&apos; + field)
    def actual = symbolInfo[field]
    if (expected == null || actual == null) {
        failures &lt;&lt; &quot;${field}: expected=${expected}, actual=${actual}&quot;
    } else if (new BigDecimal(actual.toString()).compareTo(new BigDecimal(expected)) != 0) {
        failures &lt;&lt; &quot;${field}: expected=${expected}, actual=${actual}&quot;
    }
}

// 只要有任意字段不一致，就把 JMeter 断言标记为失败，并输出全部差异。
if (!failures.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failures.join(&apos;; &apos;))
}</stringProp>
