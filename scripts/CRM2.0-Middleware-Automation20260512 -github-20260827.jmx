          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询get_position_info数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;position_info_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;position_info_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5 get_position_info-${position_info_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">SELECT
  mt.`Position` AS `order`,
  mt.`Login` AS `login`,
  mt.`Symbol` AS `symbol`,
  mt.`Action` AS `cmd`,
  mt.`Volume` AS `volume`,
  mt.`PriceOpen` AS `open_price`,
  COALESCE(
    CASE mt.`Action`
      WHEN 0 THEN p.`BidLast`
      WHEN 1 THEN p.`AskLast`
    END,
    mt.`PriceCurrent`
  ) AS `current_price`,
  0.0 AS `close_price`,
  mt.`PriceSL` AS `sl`,
  mt.`PriceTP` AS `tp`,
  UNIX_TIMESTAMP(mt.`TimeCreate`) AS `open_time`,
  0 AS `close_time`,
  mt.`Profit` AS `profit`,
  COALESCE(d.`commission`, 0) AS `commission`,
  mt.`Storage` AS `storage`,
  mt.`Comment` AS `comment`,
  mt.`Digits` AS `digits`,
  mt.`RateMargin` AS `margin_rate`,
  mt.`Reason` AS `reason`,
  0 AS `state`
FROM mt5_report.`mt5_positions` mt
LEFT JOIN mt5_report.`mt5_prices` p
  ON p.`Symbol` = mt.`Symbol`
LEFT JOIN (
  SELECT
    `PositionID`,
    SUM(`Commission` + `Fee`) AS `commission`
  FROM mt5_report.`mt5_deals`
  WHERE `Login` = ?
  GROUP BY `PositionID`
) d
  ON d.`PositionID` = mt.`Position`
WHERE mt.`Login` = ?
ORDER BY mt.`TimeUpdateMsc` DESC, mt.`Position` DESC</stringProp>
              <stringProp name="queryArguments">${position_info_login},${position_info_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT,BIGINT</stringProp>
