                <stringProp name="query">SELECT Rights FROM mt5_users WHERE LOGIN = ${login_val};</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="variableNames">Rights_val</stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
              </JDBCSampler>
              <hashTree>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

// 修正：DB 变量需要加 _1 后缀
String apiValue = vars.get(&quot;Rights&quot;)
String dbValue = vars.get(&quot;Rights_val_1&quot;)

log.info(&quot;&gt;&gt;&gt; 修改权限断言：API=[&quot; + apiValue + &quot;] DB=[&quot; + dbValue + &quot;]&quot;)

if (apiValue == null) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;API变量 [Rights] 不存在&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

if (dbValue == null) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;数据库变量 [Rights_val_1] 不存在，查询可能无结果&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
    return
}

def apiStr = apiValue.toString().trim()
def dbStr = dbValue.toString().trim()

if (apiStr != dbStr) {
    def result = new AssertionResult()
    result.setFailure(true)
    result.setFailureMessage(&quot;Rights 不一致：API=[&quot; + apiStr + &quot;] DB=[&quot; + dbStr + &quot;]&quot;)
    prev.setSuccessful(false)
    prev.addAssertionResult(result)
} else {
    log.info(&quot;&gt;&gt;&gt; 修改权限断言通过：Rights=[&quot; + apiStr + &quot;]&quot;)
}
</stringProp>
                </JSR223Assertion>
                <hashTree/>
              </hashTree>
            </hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="固定定时器" enabled="true">
              <stringProp name="ConstantTimer.delay">1000</stringProp>
            </ConstantTimer>
            <hashTree/>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取用户信息 ${instanceid_val} ${login_val} " enabled="true">
              <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
              <stringProp name="HTTPSampler.port">${port}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">crm20/get_user_info?instanceid=${instanceid_val}&amp;login=${login_val}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname=" 断言 ${login_val}" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def expectedLogin = vars.get(&quot;login_val&quot;)

def allMatch = json.data.every { item -&gt;

    // 忽略字段名大小写
    def actualLogin = item.find { k, v -&gt;
        k.equalsIgnoreCase(&quot;login&quot;)
    }?.value

    actualLogin?.toString() == expectedLogin
}

if (!allMatch) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;存在 login 字段值不等于 ${expectedLogin} 的数据&quot;)
}</stringProp>
              </JSR223Assertion>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="提取 rights" enabled="true">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">rights</stringProp>
                <stringProp name="RegexExtractor.regex">&quot;(?i)rights&quot;\s*:\s*([^,}\s]+)</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
                <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                <stringProp name="RegexExtractor.match_number">1</stringProp>
              </RegexExtractor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="判断权限是否修改成功" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.assertions.AssertionResult

def rightsApi = vars.get(&quot;Rights&quot;)       // modify_balance API 返回的 Rights
def rightsGet = vars.get(&quot;rights&quot;)       // get_user_info 返回的 rights
def rightsVal = vars.get(&quot;rights_val&quot;)   // 入参：要修改的目标权限值
def instanceidVal = vars.get(&quot;instanceid_val&quot;) // 平台标识

// ===== 判断平台 =====
def isMT5 = instanceidVal != null &amp;&amp; instanceidVal.toUpperCase().startsWith(&quot;MT5&quot;)
def isMT4 = instanceidVal != null &amp;&amp; instanceidVal.toUpperCase().startsWith(&quot;MT4&quot;)
def platform = isMT5 ? &quot;MT5&quot; : (isMT4 ? &quot;MT4&quot; : &quot;UNKNOWN&quot;)

// ===== 根据平台+入参映射期望值 =====
String expectedVal

if (isMT4) {
    // MT4 映射规则
    if (&quot;354&quot;.equals(rightsVal))       expectedVal = &quot;358&quot;
    else if (&quot;866&quot;.equals(rightsVal))  expectedVal = &quot;870&quot;
    else                               expectedVal = rightsVal
} else if (isMT5) {
    // MT5 映射规则
    if (&quot;871&quot;.equals(rightsVal))       expectedVal = &quot;359&quot;
    else if (&quot;866&quot;.equals(rightsVal))  expectedVal = &quot;354&quot;
    else                               expectedVal = rightsVal
} else {
    // 未知平台，按直通处理
    expectedVal = rightsVal
}

log.info(&quot;&gt;&gt;&gt; 权限校验：平台=[&quot; + platform + &quot;] 入参=[&quot; + rightsVal + &quot;] 期望=[&quot; + expectedVal + &quot;] API-Rights=[&quot; + rightsApi + &quot;] GET-rights=[&quot; + rightsGet + &quot;]&quot;)

// ===== 辅助函数：生成失败断言 =====
def fail(msg) {
    def r = new AssertionResult()
    r.setFailure(true)
    r.setFailureMessage(msg)
    prev.setSuccessful(false)
    prev.addAssertionResult(r)
}

// ===== 校验 modify_balance API 返回的 Rights =====
// MT5: API 返回入参原值; MT4: API 返回映射后值
if (rightsApi == null) {
    fail(&quot;API 响应未提取到 Rights，修改权限可能失败&quot;)
    return
}
if (isMT5) {
    // MT5: API Rights 应等于入参原值
    if (rightsApi.toString().trim() != rightsVal) {
        fail(&quot;MT5-API返回Rights与入参不一致：入参=[&quot; + rightsVal + &quot;] 实际=[&quot; + rightsApi + &quot;]&quot;)
        return
    }
} else if (isMT4) {
    // MT4: API Rights 应等于映射后期望值
    if (rightsApi.toString().trim() != expectedVal) {
        fail(&quot;MT4-API返回Rights不匹配：期望=[&quot; + expectedVal + &quot;] 实际=[&quot; + rightsApi + &quot;] 入参=[&quot; + rightsVal + &quot;]&quot;)
        return
    }
} else {
    // 未知平台按入参原值
    if (rightsApi.toString().trim() != rightsVal) {
        fail(&quot;API返回Rights与入参不一致：入参=[&quot; + rightsVal + &quot;] 实际=[&quot; + rightsApi + &quot;] | 平台=&quot; + platform)
        return
    }
}

// ===== 校验 get_user_info 返回的 rights（应等于映射后期望值） =====
if (rightsGet == null) {
    fail(&quot;get_user_info 响应未提取到 rights&quot;)
    return
}
if (rightsGet.toString().trim() != expectedVal) {
    fail(&quot;get_user_info返回rights不匹配：期望=[&quot; + expectedVal + &quot;] 实际=[&quot; + rightsGet + &quot;] | 平台=&quot; + platform + &quot; 入参=[&quot; + rightsVal + &quot;]&quot;)
    return
}

// ===== 全部通过 =====
log.info(&quot;&gt;&gt;&gt; 权限校验通过：平台=[&quot; + platform + &quot;] 入参=[&quot; + rightsVal + &quot;] 期望=[&quot; + expectedVal + &quot;]&quot;)
</stringProp>
