            <stringProp name="script">import org.apache.jmeter.samplers.SampleResult
String finalReport = vars.get(&apos;production_open_positions_compare_report&apos;)
if (finalReport == null || finalReport.trim().length() == 0) {
    finalReport = &apos;未生成生产环境-list_open_positions辅助接口校验结果，请检查初始化、接口请求和断言是否执行。&apos;
}
String status = vars.get(&apos;production_open_positions_compare_status&apos;) ?: &apos;UNKNOWN&apos;
boolean success = status == &apos;PASS&apos;
SampleResult.setSuccessful(success)
SampleResult.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(status)
SampleResult.setDataType(SampleResult.TEXT)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(finalReport, &apos;UTF-8&apos;)</stringProp>
