          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户历史平仓MT4/MT5 DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_positions_mt4_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_mt4_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">order_type,side,deal_ticket,digits_currency</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT4账号DB/API明细字段跳过；不控制CSV/API字段对比；多个字段用英文逗号分隔，* 表示跳过MT4明细全部字段。</stringProp>
              </elementProp>
              <elementProp name="history_positions_mt5_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_positions_mt5_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">order_type,side</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT5账号DB/API明细字段跳过；不控制CSV/API字段对比；多个字段用英文逗号分隔，* 表示跳过MT5明细全部字段。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">DB/API跳过字段按平台拆分：MT4配置只影响source=mt4的DB/API明细，MT5配置只影响source=mt5的DB/API明细；CSV/API仍由独立CSV配置控制。</stringProp>
          </Arguments>
