              <elementProp name="production_open_positions_aux_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">production_open_positions_aux_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">辅助接口字段值对比跳过字段；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
              <elementProp name="production_open_positions_aux_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">production_open_positions_aux_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,net_profit=20,price_current=5,margin_rate=5,total_profit=20,total_fee=5,total_storage=5,total_volume=0,standard_volume=0,cent_volume=0</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
