          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="自定义统计聚合(SUM、AVG、MINMAX等)，支持可选分组" enabled="false">
            <stringProp name="TestPlan.comments">&quot;login__in&quot;: &quot;${userSearchValue51},${userSearchValue41},${account_id1},${account_id2}&quot;,</stringProp>
            <stringProp name="HTTPSampler.domain">${CRM2.0middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_account_metrics_stat_ex?</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
&quot;login__in&quot;: &quot;${userSearchValue51},${userSearchValue41}&quot;,&#xd;
&quot;_stat&quot;: {&#xd;
&quot;equity&quot;: [&quot;sum&quot;, &quot;avg&quot;],&#xd;
&quot;profit&quot;: [&quot;sum&quot;, &quot;avg&quot;],&#xd;
&quot;balance&quot;: [&quot;sum&quot;]&#xd;
},&#xd;
&quot;_group_by&quot;: &quot;currency&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="响应断言" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-339185956">balance</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

// 1. 解析响应
def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// 2. 基础接口校验
if (json.code != 0 || json.msg != &quot;OK&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;接口失败：code=${json.code}，msg=${json.msg}&quot;)
    return
}

// 3. data 必须存在
if (json.data == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;data 节点为空&quot;)
    return
}

// 4. 匹配数量必须 &gt; 0
if (json.data.matched_count &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;matched_count 必须大于0&quot;)
    return
}

// 5. groups 数组必须存在且不为空
def groups = json.data.groups
if (groups == null || groups.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;groups 数组为空&quot;)
    return
}

// 6. 每组必须包含的关键字段（核心统计校验）
def groupValid = groups.every { g -&gt;
    g.currency != null &amp;&amp;
    g.count != null &amp;&amp;
    g.stat != null &amp;&amp;
    g.stat.balance?.sum != null &amp;&amp;
    g.stat.equity?.avg != null &amp;&amp;
    g.stat.profit?.avg != null
}

if (!groupValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;groups 存在缺失关键字段（currency/stat/balance/equity/profit）&quot;)
    return
}

// 7. 数值必须是合法数字
def numberValid = groups.every { g -&gt;
    g.count instanceof Number &amp;&amp;
    g.stat.balance.sum instanceof Number &amp;&amp;
    g.stat.equity.avg instanceof Number &amp;&amp;
    g.stat.profit.avg instanceof Number
}

if (!numberValid) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;统计数值不是有效数字&quot;)
    return
}

// 8. meta 校验
if (json.meta.group_by != &quot;currency&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;分组字段错误，必须按 currency 分组&quot;)
    return
}

// 成功日志
log.info(&quot;✅ 分组统计接口断言全部通过！matched_count=${json.data.matched_count}&quot;)</stringProp>
            </JSR223Assertion>
