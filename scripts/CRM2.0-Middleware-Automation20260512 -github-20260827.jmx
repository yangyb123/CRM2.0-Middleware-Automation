              </elementProp>
              <elementProp name="open_positions_aux_http_read_timeout_ms" elementType="Argument">
                <stringProp name="Argument.name">open_positions_aux_http_read_timeout_ms</stringProp>
                <stringProp name="Argument.value">3000</stringProp>
