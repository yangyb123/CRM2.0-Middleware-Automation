def findKey
findKey = { Map m, String field -&gt;
    if (m == null) return null
    if (m.containsKey(field)) return field
    for (String a : (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    String want = normKey(field)
    m.keySet().find { normKey(it) == want }
}

def valueOf
valueOf = { Map m, String field -&gt;
    def k = findKey(m, field)
    k == null ? null : m[k]
}

def idOf = { Map row -&gt;
    for (String f : [&apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;deal_ticket&apos;]) {
        def v = valueOf(row, f)
        if (!blank(v)) return cleanNumText(v)
    }
    &apos;&apos;
}

boolean timeField(String f) {
    String n = (f ?: &apos;&apos;).toLowerCase()
    return n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;) || n.contains(&apos;updated&apos;)
}

Date parseDateLike(v) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return null
    if (v instanceof java.util.Date) return v
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (String fmt : [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    sdf.format(d)
}

String normalizeApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String normalizeDbTime(v) {
    Date d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeCsvTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String displayApiTime(v) {
    Date d = parseDateLike(v)
    d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

long secondDiff(String a, String b) {
    try {
        SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
        return Math.abs((sdf.parse(a).time - sdf.parse(b).time) / 1000L)
    } catch (ignored) { return Long.MAX_VALUE }
}

String renderValue(String field, Object v, String side, boolean dbMode) {
    if (v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&lt;empty&gt;&apos;
    if (!timeField(field)) return String.valueOf(v)
    if (side == &apos;API&apos; &amp;&amp; dbMode) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
    if (side == &apos;API&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值=&apos; + normalizeCsvTime(v)
    if (side == &apos;DB&apos;) return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    return String.valueOf(v) + &apos; -&gt; &apos; + normalizeCsvTime(v)
}

def asNum = { Object v -&gt;
    if (blank(v)) return null
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

def fmtNum = { BigDecimal n -&gt; n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() }
def pctText = { BigDecimal p -&gt; p == null ? &apos;N/A&apos; : p.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos; }
Set exactNumericFields = [&apos;login&apos;, &apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;deal_ticket&apos;, &apos;reason&apos;, &apos;order_type&apos;, &apos;digits&apos;, &apos;digits_currency&apos;, &apos;money_scale&apos;, &apos;total&apos;, &apos;total_orders&apos;, &apos;unresolved_currency_account_count&apos;] as Set
Set booleanFields = [&apos;is_cent&apos;, &apos;normalization_complete&apos;] as Set
def boolValue = { Object v -&gt;
    if (v == null || String.valueOf(v).trim().length() == 0) return null
    String s = String.valueOf(v).trim().toLowerCase()
    if (s in [&apos;true&apos;, &apos;1&apos;]) return true
    if (s in [&apos;false&apos;, &apos;0&apos;]) return false
    null
}

def compareValue = { String field, Object apiVal, Object expectedVal, String expectedSource, boolean dbMode -&gt;
    if (booleanFields.contains(field)) {
        def ab = boolValue(apiVal); def eb = boolValue(expectedVal)
        boolean same = ab != null &amp;&amp; eb != null &amp;&amp; ab == eb
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: &apos;N/A&apos;, percent: &apos;N/A(boolean)&apos;, formula: &apos;Boolean fields normalize true/1 and false/0 before exact comparison&apos;]
    }
    if (timeField(field)) {
        String aCmp = dbMode ? normalizeApiTime(apiVal) : normalizeCsvTime(apiVal)
        String eCmp = dbMode ? normalizeDbTime(expectedVal) : normalizeCsvTime(expectedVal)
        long diffSec = secondDiff(aCmp, eCmp)
        return [same: (aCmp == eCmp || diffSec &lt;= 60L), apiPrint: renderValue(field, apiVal, &apos;API&apos;, dbMode), expPrint: renderValue(field, expectedVal, expectedSource, dbMode), diff: diffSec + &apos;秒&apos;, percent: &apos;N/A(时间字段)&apos;, formula: &apos;时间字段按yyyy-MM-dd HH:mm:ss比较，允许相差&lt;=60秒&apos;]
    }
    BigDecimal an = asNum(apiVal)
    BigDecimal en = asNum(expectedVal)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactNumericFields.contains(field)) {
            return [same: cleanNumText(apiVal) == cleanNumText(expectedVal), apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: &apos;N/A(编号类字段精确比较)&apos;, formula: &apos;编号类字段不使用误差，按数值精确比较&apos;]
        }
        BigDecimal tolerancePercent = dbMode ? new BigDecimal(&apos;10&apos;) : new BigDecimal(&apos;5&apos;)
        BigDecimal base = en.abs()
        BigDecimal allowed = BigDecimal.ZERO
        boolean same
        String pct
        String formula
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            same = diff.compareTo(BigDecimal.ZERO) == 0
            pct = same ? &apos;0%&apos; : &apos;N/A(&apos; + expectedSource + &apos;=0无法作分母)&apos;
            formula = &apos;abs(&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;))=&apos; + fmtNum(diff) + &apos;，&apos; + expectedSource + &apos;=0，无法计算百分比，要求API也等于0&apos;
        } else {
            allowed = base.multiply(tolerancePercent).divide(new BigDecimal(&apos;100&apos;), 10, RoundingMode.HALF_UP)
            same = diff.compareTo(allowed) &lt;= 0
            BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
            pct = pctText(percent)
            formula = &apos;abs((&apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;)) / &apos; + expectedSource + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
        }
        String toleranceText = pctText(tolerancePercent)
        String note = same ? field + &apos; 误差小于&apos; + toleranceText + &apos;，通过&apos; : field + &apos; 误差大于&apos; + toleranceText + &apos;，失败&apos;
        return [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expectedVal), diff: fmtNum(diff), percent: pct, formula: formula + &apos; | 允许误差&lt;=&apos; + toleranceText + &apos;(允许差值=&apos; + fmtNum(allowed) + &apos;)&apos;, note: note]
    }
    boolean same = String.valueOf(apiVal ?: &apos;&apos;).trim() == String.valueOf(expectedVal ?: &apos;&apos;).trim()
    [same: same, apiPrint: String.valueOf(apiVal ?: &apos;&apos;), expPrint: String.valueOf(expectedVal ?: &apos;&apos;), diff: &apos;N/A&apos;, percent: &apos;N/A(非数值字段)&apos;, formula: &apos;非数值字段按字符串精确比较&apos;]
}

def compareComparable = { Object v -&gt;
    if (numeric(v)) return new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;))
    String.valueOf(v ?: &apos;&apos;)
}

def sumField = { List rows, String field -&gt;
    BigDecimal total = BigDecimal.ZERO
    rows.each { r -&gt;
        BigDecimal n = asNum(valueOf(r, field))
        if (n != null) total = total.add(n)
    }
    total
}

def disabledRaw = { boolean dbMode -&gt; dbMode ? (vars.get(&apos;pending_orders_db_api_disabled_compare_fields&apos;) ?: &apos;&apos;) : (vars.get(&apos;pending_orders_csv_api_disabled_compare_fields&apos;) ?: &apos;&apos;) }
def disabledSet = { String raw -&gt; raw.split(/[，,;|\s]+/).collect { String t = String.valueOf(it ?: &apos;&apos;).trim(); t == &apos;*&apos; ? &apos;*&apos; : normKey(t) }.findAll { it }.toSet() }

String shujuku = vars.get(&apos;pending_orders_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
String sourceName = dbMode ? &apos;DB&apos; : &apos;CSV&apos;
String modeText = dbMode ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String sortBy = vars.get(&apos;pending_orders_sort_by&apos;) ?: &apos;time_setup_utc_ms&apos;
boolean desc = (vars.get(&apos;pending_orders_sort_order&apos;) ?: &apos;desc&apos;).toLowerCase() != &apos;asc&apos;
int page = ((vars.get(&apos;pending_orders_page&apos;) ?: &apos;1&apos;) as int)
int pageSize = ((vars.get(&apos;pending_orders_page_size&apos;) ?: &apos;50&apos;) as int)
int offset = Math.max(page - 1, 0) * pageSize
Set disabled = disabledSet(disabledRaw(dbMode))
boolean skipAll = disabled.contains(&apos;*&apos;)

def isDisabledField = { String field, String apiFieldName = null -&gt;
    if (skipAll) return true
    List candidates = [field, apiFieldName].findAll { !blank(it) }.collect { normKey(it) }
    aliases.each { canonical, aliasList -&gt;
        boolean matched = candidates.contains(normKey(canonical)) || aliasList.any { candidates.contains(normKey(it)) }
        if (matched) {
            candidates &lt;&lt; normKey(canonical)
            aliasList.each { candidates &lt;&lt; normKey(it) }
        }
    }
    candidates.any { disabled.contains(it) }
}
def data = parsed instanceof Map ? parsed.data : null
List apiItems = []
if (data instanceof Map &amp;&amp; data.items instanceof List) apiItems = data.items.collect { rowToMap(it) }
else if (data instanceof List) apiItems = data.collect { rowToMap(it) }
else if (parsed instanceof Map &amp;&amp; parsed.items instanceof List) apiItems = parsed.items.collect { rowToMap(it) }
if (!apiItems) {
    String finalReport = &apos;Assertion message: 查询多个账户的挂单订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;pending_orders_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;pending_orders_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;pending_orders_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
        &apos;\n接口: POST /crm20/list_pending_orders&apos; +
        &apos;\n【失败明细】\n - [失败] | 接口没有返回data.items可对比记录，可能接口失败或data为空&apos; +
        &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;pending_orders_request_body&apos;) ?: &apos;&apos;) +
        &apos;\n\n【接口响应原文】\n&apos; + responseText
    publishReport(&apos;查询多个账户挂单订单字段对比结果&apos;, finalReport, false)
    return
}
Map apiSummary = data instanceof Map &amp;&amp; data.summary instanceof Map ? rowToMap(data.summary) : [:]
Object apiTotal = data instanceof Map ? data.total : parsed.total

List okLines = []
List failLines = []
List skipLines = []
int apiFieldTotal = 0

String dbSummaryFeeBreakdown = &apos;&apos;
String dbPageFeeBreakdown = &apos;&apos;

List expectedRows = []
List allDbRows = []
Object dbTotalForReport = null
if (dbMode) {
    List summaryRows = rowsFromObject(vars.getObject(&apos;db_pending_orders_summary_rows&apos;))
    List pageRows = rowsFromObject(vars.getObject(&apos;db_pending_orders_page_rows&apos;))
    if (!summaryRows) {
        String finalReport = &apos;Assertion message: 查询多个账户的挂单订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;pending_orders_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;pending_orders_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;pending_orders_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
            &apos;\n接口: POST /crm20/list_pending_orders&apos; +
            &apos;\n请求accounts: MT4_login=&apos; + vars.get(&apos;pending_orders_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;pending_orders_mt5_login&apos;) +
            &apos;\n【失败明细】\n - [失败] | 数据库summary统计SQL未返回记录&apos; +
            &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;pending_orders_request_body&apos;) ?: &apos;&apos;) +
            &apos;\n\n【接口响应原文】\n&apos; + responseText
        publishReport(&apos;查询多个账户挂单订单字段对比结果&apos;, finalReport, false)
        return
    }
    Map dbSummary = summaryRows[0]
    dbTotalForReport = valueOf(dbSummary, &apos;total&apos;)
    expectedRows = pageRows
    allDbRows = pageRows
    Object dbTotalCommissionVal = valueOf(dbSummary, &apos;total_commission&apos;)
    Object dbTotalRawFeeVal = valueOf(dbSummary, &apos;total_raw_fee&apos;)
    Object dbTotalFeeVal = valueOf(dbSummary, &apos;total_fee&apos;)
    String dbTotalCommissionText = dbTotalCommissionVal == null ? &apos;&lt;empty&gt;&apos; : renderValue(&apos;total_commission&apos;, dbTotalCommissionVal, &apos;DB&apos;, true)
    String dbTotalRawFeeText = dbTotalRawFeeVal == null ? &apos;&lt;empty&gt;&apos; : renderValue(&apos;total_raw_fee&apos;, dbTotalRawFeeVal, &apos;DB&apos;, true)
    String dbTotalFeeText = dbTotalFeeVal == null ? &apos;&lt;empty&gt;&apos; : renderValue(&apos;total_fee&apos;, dbTotalFeeVal, &apos;DB&apos;, true)
    BigDecimal pageCommissionSum = sumField(pageRows, &apos;commission&apos;)
    BigDecimal pageRawFeeSum = sumField(pageRows, &apos;fee&apos;)
    BigDecimal pageCommissionFeeSum = pageCommissionSum.add(pageRawFeeSum)
    dbSummaryFeeBreakdown = &apos;DB total_fee breakdown: total_fee=&apos; + dbTotalFeeText + &apos; = total_commission(&apos; + dbTotalCommissionText + &apos;) + total_raw_fee(&apos; + dbTotalRawFeeText + &apos;); pending orders are not executed, so expected value is 0.&apos;
    dbPageFeeBreakdown = &apos;DB current page fee detail: commission_sum=&apos; + fmtNum(pageCommissionSum) + &apos; + fee_sum=&apos; + fmtNum(pageRawFeeSum) + &apos; = commission_plus_fee_sum(&apos; + fmtNum(pageCommissionFeeSum) + &apos;); row_total_fee column is commission+fee; pending-order financial fields are expected to be 0.&apos;
    Map summaryExpected = [
        total: valueOf(dbSummary, &apos;total&apos;), total_orders: valueOf(dbSummary, &apos;total_orders&apos;),
        total_volume: valueOf(dbSummary, &apos;total_volume&apos;), cent_volume: valueOf(dbSummary, &apos;cent_volume&apos;), standard_volume: valueOf(dbSummary, &apos;standard_volume&apos;),
        unresolved_volume: valueOf(dbSummary, &apos;unresolved_volume&apos;), unresolved_currency_account_count: valueOf(dbSummary, &apos;unresolved_currency_account_count&apos;),
        total_commission: dbTotalCommissionVal, total_raw_fee: dbTotalRawFeeVal, total_fee: dbTotalFeeVal,
        total_storage: valueOf(dbSummary, &apos;total_storage&apos;), total_profit: valueOf(dbSummary, &apos;total_profit&apos;),
        reporting_currency: &apos;USD&apos;, money_mode: &apos;reporting&apos;,
        normalization_complete: (asNum(valueOf(dbSummary, &apos;unresolved_currency_account_count&apos;)) ?: BigDecimal.ZERO).compareTo(BigDecimal.ZERO) == 0 ? 1 : 0
    ]
    Set strictSummaryVolumeFields = [&apos;total_volume&apos;, &apos;cent_volume&apos;, &apos;standard_volume&apos;, &apos;unresolved_volume&apos;] as Set
    Map summaryActual = new LinkedHashMap()
    if (apiTotal != null) summaryActual[&apos;total&apos;] = apiTotal
    apiSummary.each { k, v -&gt; summaryActual[String.valueOf(k)] = v }
    summaryActual.each { f, apiVal -&gt;
        String field = String.valueOf(f)
        apiFieldTotal++
        def expKey = findKey(summaryExpected, field)
        Object expVal = expKey == null ? null : summaryExpected[expKey]
        if (isDisabledField(field, null)) {
            skipLines &lt;&lt; &quot; - [跳过] | summary | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, true)} | DB=${expKey == null ? &apos;&lt;empty&gt; 数据库summary SQL未返回此字段&apos; : renderValue(field, expVal, &apos;DB&apos;, true)} | DBField=${expKey ?: field} | reason=字段在DB/API跳过配置中&quot;
            return
        }
        if (field == &apos;unresolved_currency_accounts&apos;) {
            boolean isList = apiVal instanceof List
            BigDecimal apiCount = isList ? new BigDecimal(apiVal.size()) : null
            BigDecimal dbCount = asNum(valueOf(dbSummary, &apos;unresolved_currency_account_count&apos;))
            boolean same = isList &amp;&amp; apiCount != null &amp;&amp; dbCount != null &amp;&amp; apiCount.compareTo(dbCount) == 0
            String line = &quot;summary | field=${field} | API=${apiVal} | DB_unresolved_currency_account_count=${dbCount == null ? &apos;&lt;empty&gt;&apos; : fmtNum(dbCount)} | diff=${apiCount == null || dbCount == null ? &apos;N/A&apos; : fmtNum(apiCount.subtract(dbCount).abs())} | formula=unresolved_currency_accounts must be a list and its size must equal unresolved_currency_account_count&quot;
            if (same) okLines &lt;&lt; &apos; - [PASS] | &apos; + line else failLines &lt;&lt; &apos; - [FAIL] | &apos; + line
            return
        }
        if (expKey == null || blank(expVal)) {
            failLines &lt;&lt; &quot; - [失败] | summary | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, true)} | DB=&lt;empty&gt; 数据库summary SQL未返回此字段或值为空 | DBField=${expKey ?: field}&quot;
            return
        }
        def cr = compareValue(field, apiVal, expVal, &apos;DB&apos;, true)
        if (strictSummaryVolumeFields.contains(field)) {
            BigDecimal an = asNum(apiVal)
            BigDecimal en = asNum(expVal)
            if (an != null &amp;&amp; en != null) {
                BigDecimal diff = an.subtract(en).abs()
                BigDecimal base = en.abs()
                String pct
                String formula
                if (base.compareTo(BigDecimal.ZERO) == 0) {
                    pct = diff.compareTo(BigDecimal.ZERO) == 0 ? &apos;0%&apos; : &apos;N/A(DB=0无法作分母)&apos;
                    formula = &apos;abs(DB(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;))=&apos; + fmtNum(diff) + &apos;，summary成交量字段不使用百分比误差，要求差值=0&apos;
                } else {
                    BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
                    pct = pctText(percent)
                    formula = &apos;abs((DB(&apos; + fmtNum(en) + &apos;) - API(&apos; + fmtNum(an) + &apos;)) / DB(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct + &apos;，summary成交量字段不使用10%或50%误差，要求差值=0&apos;
                }
                boolean same = diff.compareTo(BigDecimal.ZERO) == 0
                cr = [same: same, apiPrint: String.valueOf(apiVal), expPrint: String.valueOf(expVal), diff: fmtNum(diff), percent: pct, formula: formula, note: same ? field + &apos; 差值=0，通过&apos; : field + &apos; 差值不为0，失败&apos;]
            }
        }
        if (field == &apos;total_fee&apos;) {
            cr.formula = cr.formula + &apos; | DB total_fee = total_commission(&apos; + dbTotalCommissionText + &apos;) + total_raw_fee(&apos; + dbTotalRawFeeText + &apos;)&apos;
            cr.note = (cr.note ? cr.note + &apos;; &apos; : &apos;&apos;) + &apos;pending orders are not executed; total_fee should be 0, and equals commission+fee(0+0)&apos;
        }
        if (field == &apos;total_storage&apos; || field == &apos;total_profit&apos;) {
            cr.note = (cr.note ? cr.note + &apos;; &apos; : &apos;&apos;) + &apos;pending orders are not executed; this summary financial field should be 0&apos;
        }
        String note = cr.note ? &apos; | 备注=&apos; + cr.note : &apos;&apos;
        String line = &quot;summary | field=${field} | API=${cr.apiPrint} | DB=${cr.expPrint} | DBField=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}${note}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
} else {
    Map currentCsv = vars.getObject(&apos;pending_orders_current_csv_row&apos;) instanceof Map ? vars.getObject(&apos;pending_orders_current_csv_row&apos;) : [:]
    String csvId = idOf(currentCsv)
    Map apiRow = csvId ? apiItems.find { idOf(it) == csvId } : apiItems[0]
    if (!apiRow) {
        String finalReport = &apos;Assertion message: 查询多个账户的挂单订单 &apos; + modeText + &apos; 对比结果 | status=FAIL | case=&apos; + vars.get(&apos;pending_orders_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;pending_orders_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;pending_orders_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku +
            &apos;\n接口: POST /crm20/list_pending_orders&apos; +
            &apos;\n【失败明细】\n - [失败] | CSV订单号/仓位号和接口响应没有匹配上 | csvId=&apos; + csvId + &apos; | apiIds=&apos; + apiItems.collect { idOf(it) }.join(&apos;,&apos;) +
            &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;pending_orders_request_body&apos;) ?: &apos;&apos;) +
            &apos;\n\n【接口响应原文】\n&apos; + responseText
        publishReport(&apos;查询多个账户挂单订单字段对比结果&apos;, finalReport, false)
        return
    }
    apiItems = [apiRow]
    expectedRows = [currentCsv]
}

if (dbMode) {
    if (apiItems.size() != expectedRows.size()) {
        failLines &lt;&lt; &quot; - [失败] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    } else {
        okLines &lt;&lt; &quot; - [通过] | page=${page} | 接口返回items数量=${apiItems.size()} | DB分页后数量=${expectedRows.size()} | offset=${offset} | page_size=${pageSize}&quot;
    }
}

List compareDrivers = dbMode ? expectedRows : apiItems
compareDrivers.eachWithIndex { Map driverRow, int idx -&gt;
    Map apiRow = idx &lt; apiItems.size() ? apiItems[idx] : [:]
    Map expectedRow = dbMode ? (driverRow ?: [:]) : (idx &lt; expectedRows.size() ? expectedRows[idx] : [:])
    String apiId = idOf(apiRow)
    String expectedId = idOf(expectedRow)
    def apiLoginKey = findKey(apiRow, &apos;login&apos;)
    def expectedLoginKey = findKey(expectedRow, &apos;login&apos;)
    String rowLogin = apiLoginKey == null ? (expectedLoginKey == null ? &apos;&lt;empty&gt;&apos; : String.valueOf(expectedRow[expectedLoginKey])) : String.valueOf(apiRow[apiLoginKey])
    String rowText = &apos;row=&apos; + (idx + 1 + offset) + &apos; | apiId=&apos; + apiId + &apos; | expectedId=&apos; + expectedId + &apos; | login=&apos; + rowLogin
    if (dbMode &amp;&amp; !apiRow) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | API=&lt;empty&gt; 接口返回缺少第${idx + 1}条明细记录 | DB记录=${expectedRow}&quot;
        return
    }
    if (dbMode &amp;&amp; apiId &amp;&amp; expectedId &amp;&amp; apiId != expectedId) {
        failLines &lt;&lt; &quot; - [失败] | ${rowText} | 接口和数据库数据记录没有匹配上&quot;
    }
    List compareFields = apiRow ? apiRow.keySet().collect { String.valueOf(it) } : expectedRow.keySet().collect { String.valueOf(it) }
    apiFieldTotal += compareFields.size()
    compareFields.each { rawField -&gt;
        String field = String.valueOf(rawField)
        String expKey = findKey(expectedRow, field)
        Object expVal = expKey == null ? null : expectedRow[expKey]
        String apiKey = findKey(apiRow, field)
        Object apiVal = apiKey == null ? null : apiRow[apiKey]
        if (isDisabledField(field, apiKey)) {
            skipLines &lt;&lt; &quot; - [跳过] | ${rowText} | field=${field} | API=${apiKey == null ? &apos;&lt;empty&gt; 接口响应无此字段&apos; : renderValue(apiKey, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=${expKey == null ? &apos;&lt;empty&gt; &apos; + (dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段&apos;) : renderValue(field, expVal, sourceName, dbMode)} | APIField=${apiKey ?: field} | ${sourceName}Field=${expKey ?: field} | reason=字段在跳过配置中&quot;
            return
        }
        if (expKey == null) {
            String missingLine = &quot;${rowText} | field=${field} | API=${renderValue(field, apiVal, &apos;API&apos;, dbMode)} | ${sourceName}=&lt;empty&gt; ${dbMode ? &apos;数据库查询无此字段数据&apos; : &apos;CSV未配置此字段&apos;} | ${sourceName}Field=${field}&quot;
            if (dbMode) failLines &lt;&lt; &apos; - [失败] | &apos; + missingLine else skipLines &lt;&lt; &apos; - [跳过] | &apos; + missingLine
            return
        }
        if (dbMode &amp;&amp; apiKey == null) {
            failLines &lt;&lt; &quot; - [失败] | ${rowText} | field=${field} | API=&lt;empty&gt; 接口响应无此字段 | DB=${renderValue(field, expVal, sourceName, dbMode)} | DBField=${expKey}&quot;
            return
        }
        def cr = compareValue(field, apiVal, expVal, sourceName, dbMode)
        String note = cr.note ? &apos; | 备注=&apos; + cr.note : &apos;&apos;
        String line = &quot;${rowText} | field=${field} | API=${cr.apiPrint} | ${sourceName}=${cr.expPrint} | APIField=${apiKey ?: field} | ${sourceName}Field=${expKey} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula}${note}&quot;
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

if (dbMode &amp;&amp; apiItems.size() &gt; expectedRows.size()) {
    apiItems.drop(expectedRows.size()).eachWithIndex { Map apiRow, int extraIdx -&gt;
        int rowNo = offset + expectedRows.size() + extraIdx + 1
        String apiLogin = valueOf(apiRow, &apos;login&apos;) ?: &apos;&lt;empty&gt;&apos;
        failLines &lt;&lt; &quot; - [失败] | row=${rowNo} | API订单/仓位号=${idOf(apiRow)} | login=${apiLogin} | DB=&lt;empty&gt; 接口多返回该明细记录 | API记录=${apiRow}&quot;
    }
}

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List report = []
report &lt;&lt; &apos;Assertion message: 查询多个账户的挂单订单 &apos; + modeText + &apos; 对比结果 | status=&apos; + status + &apos; | case=&apos; + vars.get(&apos;pending_orders_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;pending_orders_case_total&apos;) + &apos; | CSV行=&apos; + vars.get(&apos;pending_orders_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku
report &lt;&lt; &apos;接口: POST /crm20/list_pending_orders&apos;
report &lt;&lt; &apos;请求accounts: MT4_login=&apos; + vars.get(&apos;pending_orders_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;pending_orders_mt5_login&apos;)
report &lt;&lt; &apos;分页排序: page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort_by=&apos; + sortBy + &apos; | sort_order=&apos; + (desc ? &apos;desc&apos; : &apos;asc&apos;)
report &lt;&lt; &apos;跳过字段配置: &apos; + (dbMode ? &apos;pending_orders_db_api_disabled_compare_fields&apos; : &apos;pending_orders_csv_api_disabled_compare_fields&apos;) + &apos;=[&apos; + disabledRaw(dbMode) + &apos;]&apos;
report &lt;&lt; &apos;接口summary: total=&apos; + apiTotal + &apos; | summary=&apos; + apiSummary
if (dbMode) report &lt;&lt; &apos;DB汇总: total_orders=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | DB总记录数(summary SQL)=&apos; + (dbTotalForReport == null ? &apos;&lt;empty&gt;&apos; : dbTotalForReport) + &apos; | 当前页DB记录数(page SQL)=&apos; + expectedRows.size()
if (dbMode &amp;&amp; dbSummaryFeeBreakdown) report &lt;&lt; dbSummaryFeeBreakdown
if (dbMode &amp;&amp; dbPageFeeBreakdown) report &lt;&lt; dbPageFeeBreakdown
report &lt;&lt; &apos;对比结果统计: 失败数量=&apos; + failLines.size() + &apos; | 成功数量=&apos; + okLines.size() + &apos; | 跳过数量=&apos; + skipLines.size() + &apos; | 对比字段总数=&apos; + apiFieldTotal
report &lt;&lt; &apos;数值规则: DB/API普通数值字段按DB为基准允许误差&lt;=10%；CSV/API普通数值字段允许误差&lt;=5%；编号类字段精确比较；时间字段API按Asia/Shanghai展示后减8小时与DB比较，允许相差&lt;=60秒。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败明细：&apos; + failLines.size() + &apos;条】&apos;
report.addAll(failLines ? failLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细：&apos; + okLines.size() + &apos;条】&apos;
report.addAll(okLines ? okLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细：&apos; + skipLines.size() + &apos;条（含DB/CSV数值）】&apos;
report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【接口请求Body】&apos;
report &lt;&lt; (vars.get(&apos;pending_orders_request_body&apos;) ?: &apos;&apos;)

String finalReport = report.join(&apos;\n&apos;)
publishReport(&apos;查询多个账户挂单订单字段对比结果&apos;, finalReport, failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">summary按接口summary字段逐字段对比；DB/API当前页明细按SQL行顺序循环，每条DB记录下所有SQL字段都逐字段对比API items对应行；DB/API普通数值字段按DB为基准允许误差&lt;=10%；打印成功、失败、跳过字段明细；跳过字段同时打印API与DB/CSV值。</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="打印查询多个账户挂单订单对比结果" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String finalReport = vars.get(&apos;pending_orders_compare_report&apos;)
if (finalReport == null || finalReport.trim().length() == 0) {
    finalReport = &apos;未生成查询多个账户挂单订单对比结果，请检查前置接口请求和DB或CSV字段对比断言是否执行。&apos;
}
String status = vars.get(&apos;pending_orders_compare_status&apos;) ?: &apos;UNKNOWN&apos;
boolean success = status == &apos;PASS&apos;
SampleResult.setSuccessful(success)
SampleResult.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(status)
SampleResult.setDataType(SampleResult.TEXT)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(finalReport, &apos;UTF-8&apos;)</stringProp>
