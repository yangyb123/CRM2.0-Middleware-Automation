          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化待处理/历史订单数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
String csvName = &apos;待处理-历史订单-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;待处理/历史订单CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;待处理/历史订单CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;待处理/历史订单 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;待处理/历史订单 order_instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;待处理/历史订单 order_login/login不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;待处理/历史订单 order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

vars.put(&apos;order_ex_check_shujuku&apos;, shujuku)
vars.put(&apos;order_ex_check_login&apos;, login)
vars.put(&apos;order_ex_check_instanceid&apos;, instanceId)
vars.put(&apos;order_ex_check_db_platform&apos;, platform)
vars.put(&apos;instanceid&apos;, instanceId)
vars.put(&apos;login&apos;, login)
vars.putObject(&apos;db_order_ex_check_rows&apos;, [])
log.info(&apos;order_ex_check init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT4-查询待处理历史订单数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;order_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;order_ex_check_db_platform&apos;) == &apos;MT4&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4待处理历史订单-${order_ex_check_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT4</stringProp>
              <stringProp name="query">SELECT
  CASE
    WHEN mt.CMD IN (2, 3, 4, 5) THEN &apos;pending_order&apos;
    WHEN mt.CMD IN (0, 1) AND (CAST(mt.CLOSE_TIME AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) OR mt.CLOSE_TIME IS NULL) THEN &apos;position&apos;
    WHEN mt.CMD IN (0, 1) THEN &apos;history_order&apos;
    ELSE &apos;other&apos;
  END AS record_type,
  mt.SYMBOL AS symbol,
  mt.TICKET AS position_ticket,
  mt.OPEN_PRICE AS price_open,
  mt.VOLUME / 100.0 AS volume_initial,
  NULLIF(mt.TP, 0) AS price_tp,
  &apos;mt4&apos; AS source,
  mt.LOGIN AS login,
  mt.CMD AS type,
  UNIX_TIMESTAMP(mt.OPEN_TIME) * 1000 AS time_setup_utc_ms,
  mt.TICKET AS order_ticket,
  &apos;MT4_1&apos; AS instance_id,
  CASE
    WHEN CAST(mt.CLOSE_TIME AS CHAR) NOT IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) AND mt.CLOSE_TIME IS NOT NULL THEN UNIX_TIMESTAMP(mt.CLOSE_TIME) * 1000
    ELSE 0
  END AS time_done_utc_ms,
  NULLIF(mt.SL, 0) AS price_sl,
  CASE
    WHEN mt.CMD IN (0, 1) AND (CAST(mt.CLOSE_TIME AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) OR mt.CLOSE_TIME IS NULL) THEN mt.VOLUME / 100.0
    WHEN mt.CMD IN (2, 3, 4, 5) THEN mt.VOLUME / 100.0
    ELSE 0
  END AS volume_current,
  mt.DIGITS AS digits,
  CASE
    WHEN mt.CMD IN (0, 1) AND CAST(mt.CLOSE_TIME AS CHAR) NOT IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) AND mt.CLOSE_TIME IS NOT NULL THEN 4
    ELSE 0
  END AS state,
  CASE
    WHEN mt.CLOSE_PRICE &lt;&gt; 0 THEN mt.CLOSE_PRICE
    ELSE mt.OPEN_PRICE
  END AS price_current,
  0 AS account_mode,
  CASE
    WHEN mt.CMD IN (0, 1) THEN CONCAT(mt.LOGIN, &apos;:&apos;, mt.SYMBOL, &apos;:&apos;, mt.TICKET)
    ELSE NULL
  END AS position_id,
  mt.*
FROM MT4_TRADES mt
WHERE mt.LOGIN = ?
ORDER BY mt.OPEN_TIME DESC, mt.TICKET DESC</stringProp>
              <stringProp name="queryArguments">${order_ex_check_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_order_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询待处理历史订单数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;order_ex_check_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;order_ex_check_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5待处理历史订单-${order_ex_check_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">(SELECT
  mt.Symbol AS symbol,
  mt.PositionID AS position_ticket,
  mt.PriceOrder AS price_open,
  mt.VolumeInitial / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Type AS type,
  UNIX_TIMESTAMP(mt.TimeSetupMsc) * 1000 AS time_setup_utc_ms,
  mt.`Order` AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  UNIX_TIMESTAMP(mt.TimeDoneMsc) * 1000 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.VolumeCurrent / 10000.0 AS volume_current,
  mt.Digits AS digits,
  mt.State AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.PositionID) AS position_id,
  &apos;pending_order&apos; AS record_type
FROM mt5_orders mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND mt.Symbol &lt;&gt; &apos;&apos;
  AND mt.Type IN (2, 3, 4, 5, 6, 7)
  AND mt.VolumeCurrent &gt; 0
ORDER BY mt.TimeSetupMsc DESC, mt.`Order` DESC
LIMIT 500)

UNION ALL

(SELECT
  mt.Symbol AS symbol,
  mt.Position AS position_ticket,
  mt.PriceOpen AS price_open,
  mt.Volume / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Action AS type,
  UNIX_TIMESTAMP(mt.TimeCreateMsc) * 1000 AS time_setup_utc_ms,
  mt.Position AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  0 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.Volume / 10000.0 AS volume_current,
  mt.Digits AS digits,
  0 AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.Position) AS position_id,
  &apos;position&apos; AS record_type
FROM mt5_positions mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND mt.Symbol &lt;&gt; &apos;&apos;
  AND mt.Action IN (0, 1)
  AND mt.Volume &gt; 0
ORDER BY mt.TimeCreateMsc DESC, mt.Position DESC
LIMIT 500)

UNION ALL

(SELECT
  mt.Symbol AS symbol,
  mt.PositionID AS position_ticket,
  mt.PriceOrder AS price_open,
  mt.VolumeInitial / 10000.0 AS volume_initial,
  NULLIF(mt.PriceTP, 0) AS price_tp,
  &apos;mt5&apos; AS source,
  mt.Login AS login,
  mt.Type AS type,
  UNIX_TIMESTAMP(mt.TimeSetupMsc) * 1000 AS time_setup_utc_ms,
  mt.`Order` AS order_ticket,
  &apos;MT5_1&apos; AS instance_id,
  UNIX_TIMESTAMP(mt.TimeDoneMsc) * 1000 AS time_done_utc_ms,
  NULLIF(mt.PriceSL, 0) AS price_sl,
  mt.VolumeCurrent / 10000.0 AS volume_current,
  mt.Digits AS digits,
  mt.State AS state,
  mt.PriceCurrent AS price_current,
  2 AS account_mode,
  CONCAT(mt.Login, &apos;:&apos;, mt.Symbol, &apos;:&apos;, mt.PositionID) AS position_id,
  &apos;history_order&apos; AS record_type
FROM mt5_orders_history mt
WHERE mt.Login = ?
  AND mt.Symbol IS NOT NULL
  AND mt.Symbol &lt;&gt; &apos;&apos;
  AND mt.Type IN (0, 1, 2, 3, 4, 5, 6, 7)
  AND mt.State &lt;&gt; 7
ORDER BY mt.TimeSetupMsc DESC, mt.`Order` DESC
LIMIT 500)

ORDER BY time_setup_utc_ms DESC, order_ticket DESC
LIMIT 500</stringProp>
              <stringProp name="queryArguments">${order_ex_check_login},${order_ex_check_login},${order_ex_check_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT,BIGINT,BIGINT</stringProp>
              <stringProp name="queryTimeout">60</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">500</stringProp>
              <stringProp name="resultVariable">db_order_ex_check_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取待处理/历史订单-数据库校验-${login}-${instanceid}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_order_ex?instanceid=${instanceid}&amp;login=${login}&amp;_limit=500</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-待处理历史订单" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import groovy.transform.Field
import java.math.BigDecimal
import java.text.SimpleDateFormat

def text = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(text ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + text)
    return
}

List asRows(obj) {
    if (obj == null) return []
    if (obj instanceof List) return obj.findAll { it instanceof Map }
    if (obj instanceof Map) {
        for (k in [&apos;orders&apos;, &apos;data&apos;, &apos;rows&apos;, &apos;records&apos;, &apos;list&apos;, &apos;items&apos;, &apos;result&apos;, &apos;results&apos;]) {
            def v = obj[k]
            if (v instanceof List) return v.findAll { it instanceof Map }
            if (v instanceof Map) {
                def nested = asRows(v)
                if (nested) return nested
            }
        }
        def firstList = obj.values().find { it instanceof List &amp;&amp; it.any { it instanceof Map } }
        if (firstList instanceof List) return firstList.findAll { it instanceof Map }
        return [obj]
    }
    return []
}

Map rowToMap(row) {
    def out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else {
        try {
            row.metaClass.properties.each { p -&gt;
                if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot;
            }
        } catch (ignored) {}
    }
    return out
}

String normKey(String s) {
    return (s ?: &apos;&apos;).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase()
}

@Field def aliases = [
    &apos;order_ticket&apos;      : [&apos;order_ticket&apos;, &apos;orderId&apos;, &apos;order_id&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;position_ticket&apos;   : [&apos;position_ticket&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;Position&apos;, &apos;position&apos;, &apos;TICKET&apos;],
    &apos;symbol&apos;            : [&apos;symbol&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;order_symbol&apos;],
    &apos;price_open&apos;        : [&apos;price_open&apos;, &apos;PriceOrder&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;open_price&apos;         : [&apos;open_price&apos;, &apos;price_open&apos;, &apos;PriceOrder&apos;, &apos;PriceOpen&apos;, &apos;OPEN_PRICE&apos;],
    &apos;price_close&apos;       : [&apos;price_close&apos;, &apos;close_price&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;close_price&apos;       : [&apos;close_price&apos;, &apos;price_close&apos;, &apos;PriceClose&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;volume_initial&apos;    : [&apos;volume_initial&apos;, &apos;VolumeInitial&apos;, &apos;VOLUME&apos;],
    &apos;price_tp&apos;          : [&apos;price_tp&apos;, &apos;PriceTP&apos;, &apos;TP&apos;],
    &apos;source&apos;            : [&apos;source&apos;, &apos;platform&apos;],
    &apos;login&apos;             : [&apos;login&apos;, &apos;Login&apos;, &apos;LOGIN&apos;, &apos;order_login&apos;],
    &apos;type&apos;              : [&apos;type&apos;, &apos;Type&apos;, &apos;CMD&apos;],
    &apos;time_setup_utc_ms&apos; : [&apos;time_setup_utc_ms&apos;, &apos;TimeSetupMsc&apos;, &apos;TimeCreateMsc&apos;, &apos;OPEN_TIME&apos;],
    &apos;instance_id&apos;       : [&apos;instance_id&apos;, &apos;instanceid&apos;, &apos;instanceId&apos;, &apos;order_instanceid_val&apos;],
    &apos;time_done_utc_ms&apos;  : [&apos;time_done_utc_ms&apos;, &apos;TimeDoneMsc&apos;, &apos;CLOSE_TIME&apos;],
    &apos;price_sl&apos;          : [&apos;price_sl&apos;, &apos;PriceSL&apos;, &apos;SL&apos;],
    &apos;sl&apos;                : [&apos;sl&apos;, &apos;price_sl&apos;, &apos;PriceSL&apos;, &apos;SL&apos;],
    &apos;tp&apos;                : [&apos;tp&apos;, &apos;price_tp&apos;, &apos;PriceTP&apos;, &apos;TP&apos;],
    &apos;volume_current&apos;    : [&apos;volume_current&apos;, &apos;VolumeCurrent&apos;, &apos;Volume&apos;, &apos;VOLUME&apos;],
    &apos;digits&apos;            : [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;state&apos;             : [&apos;state&apos;, &apos;State&apos;],
    &apos;price_current&apos;     : [&apos;price_current&apos;, &apos;PriceCurrent&apos;, &apos;CLOSE_PRICE&apos;],
    &apos;account_mode&apos;      : [&apos;account_mode&apos;, &apos;accountMode&apos;],
    &apos;position_id&apos;       : [&apos;position_id&apos;, &apos;positionId&apos;],
    &apos;record_type&apos;       : [&apos;record_type&apos;]
]

def findKey(Map m, String field) {
    if (m.containsKey(field)) return field
    for (a in (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    def want = normKey(field)
    return m.keySet().find { normKey(String.valueOf(it)) == want }
}

def valueOf(Map m, String field) {
    def k = findKey(m, field)
    return k == null ? null : m[k]
}

String cleanNumber(String s) {
    if (s == null) return &apos;&apos;
    def t = s.trim()
    if (t ==~ /^-?\d+\.0+$/) return t.substring(0, t.indexOf(&apos;.&apos;))
    return t
}

String idOf(Map row) {
    for (f in [&apos;order_ticket&apos;, &apos;orderId&apos;, &apos;order_id&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;]) {
        def v = valueOf(row, f)
        if (v != null &amp;&amp; String.valueOf(v).trim()) return cleanNumber(String.valueOf(v))
    }
    return &apos;&apos;
}

boolean blank(v) {
    return v == null || String.valueOf(v).trim() == &apos;&apos; || String.valueOf(v).trim().equalsIgnoreCase(&apos;null&apos;) || String.valueOf(v).trim() == &apos;&lt;EOF&gt;&apos;
}

boolean numeric(v) {
    if (v == null) return false
    return String.valueOf(v).trim() ==~ /^-?\d+(\.\d+)?$/
}

boolean timeField(String f) {
    def n = (f ?: &apos;&apos;).toLowerCase()
    return n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;)
}

Date parseDateLike(v) {
    if (blank(v)) return null
    if (v instanceof java.util.Date) return v
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (fmt in [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            def sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    return null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    def sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    return sdf.format(d)
}

String normalizeApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String displayApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeDbTime(v) {
    def d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    return numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizePlain(v) {
    if (blank(v)) return &apos;&apos;
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        try {
            return new BigDecimal(s).stripTrailingZeros().toPlainString()
        } catch (ignored) {}
    }
    return s
}
BigDecimal decimalValue(v) {
    if (blank(v)) return null
    def s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^[+-]?\d+(\.\d+)?([eE][+-]?\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

String decimalText(BigDecimal n) {
    if (n == null) return &apos;null&apos;
    try {
        return n.setScale(8, java.math.RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()
    } catch (Throwable ignored) {
        return n.toPlainString()
    }
}

String percentText(BigDecimal n) {
    return decimalText(n) + &apos;%&apos;
}

boolean priceCompareField(String field) {
    return [&apos;openprice&apos;, &apos;priceopen&apos;, &apos;closeprice&apos;, &apos;priceclose&apos;, &apos;pricecurrent&apos;, &apos;currentprice&apos;].contains(normKey(field))
}

String priceDisplayName(String field) {
    def n = normKey(field)
    if ([&apos;openprice&apos;, &apos;priceopen&apos;].contains(n)) return &apos;open_price&apos;
    if ([&apos;pricecurrent&apos;, &apos;currentprice&apos;].contains(n)) return &apos;price_current&apos;
    return &apos;close_price&apos;
}

BigDecimal priceTolerancePercent(String field) {
    return [&apos;pricecurrent&apos;, &apos;currentprice&apos;].contains(normKey(field)) ? new BigDecimal(&apos;10&apos;) : new BigDecimal(&apos;2&apos;)
}

boolean slTpCompareField(String field) {
    return [&apos;pricesl&apos;, &apos;sl&apos;, &apos;pricetp&apos;, &apos;tp&apos;].contains(normKey(field))
}

String slTpDisplayName(String field) {
    return [&apos;pricesl&apos;, &apos;sl&apos;].contains(normKey(field)) ? &apos;price_sl&apos; : &apos;price_tp&apos;
}

String valueTextFor(Map row, String field) {
    def v = valueOf(row, field)
    return blank(v) ? &apos;&apos; : String.valueOf(v).trim()
}

String orderTypeText(Map apiRow, Map expectedRow) {
    String recordType = (valueTextFor(apiRow, &apos;record_type&apos;) ?: valueTextFor(expectedRow, &apos;record_type&apos;)).toLowerCase()
    if (recordType in [&apos;pending_order&apos;, &apos;pending&apos;]) return &apos;挂单&apos;
    if (recordType in [&apos;position&apos;, &apos;open_position&apos;]) return &apos;持仓订单&apos;
    if (recordType in [&apos;history_order&apos;, &apos;closed_order&apos;, &apos;closed_history&apos;]) return &apos;历史平仓订单&apos;
    BigDecimal stateNum = decimalValue(valueOf(apiRow, &apos;state&apos;) ?: valueOf(expectedRow, &apos;state&apos;))
    if (stateNum != null &amp;&amp; stateNum.intValue() == 4) return &apos;历史平仓订单&apos;
    BigDecimal typeNum = decimalValue(valueOf(apiRow, &apos;type&apos;) ?: valueOf(expectedRow, &apos;type&apos;))
    if (typeNum != null &amp;&amp; [2, 3, 4, 5, 6, 7].contains(typeNum.intValue())) return &apos;挂单&apos;
    BigDecimal doneTime = decimalValue(valueOf(apiRow, &apos;time_done_utc_ms&apos;) ?: valueOf(expectedRow, &apos;time_done_utc_ms&apos;))
    if (doneTime != null &amp;&amp; doneTime.compareTo(BigDecimal.ZERO) &gt; 0) return &apos;历史平仓订单&apos;
    BigDecimal currentVol = decimalValue(valueOf(apiRow, &apos;volume_current&apos;) ?: valueOf(expectedRow, &apos;volume_current&apos;))
    if (currentVol != null &amp;&amp; currentVol.compareTo(BigDecimal.ZERO) &gt; 0) return &apos;持仓订单&apos;
    return &apos;未知订单类型&apos;
}

boolean sameValue(String field, api, expected, boolean expectedIsDb) {
    if (timeField(field)) {
        return normalizeApiTime(api) == (expectedIsDb ? normalizeDbTime(expected) : normalizeApiTime(expected))
    }
    return normalizePlain(api) == normalizePlain(expected)
}

String rendered(String field, v, boolean apiSide, String sourceName) {
    if (blank(v)) return &apos;&lt;empty&gt;&apos;
    if (timeField(field)) {
        if (apiSide) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
        return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
    }
    return String.valueOf(v)
}

String csvDisabledRaw = vars.get(&apos;order_ex_csv_disabled_compare_fields&apos;) ?: &apos;&apos;

String shujuku = vars.get(&apos;order_ex_check_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
String login = vars.get(&apos;order_ex_check_login&apos;) ?: vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;
String instanceId = vars.get(&apos;order_ex_check_instanceid&apos;) ?: vars.get(&apos;order_instanceid_val&apos;) ?: &apos;&apos;
String dbDisabledConfigName = instanceId?.toUpperCase()?.contains(&apos;MT4&apos;) ? &apos;order_ex_mt4_disabled_compare_fields&apos; : (instanceId?.toUpperCase()?.contains(&apos;MT5&apos;) ? &apos;order_ex_mt5_disabled_compare_fields&apos; : &apos;order_ex_unknown_disabled_compare_fields&apos;)
String dbDisabledRaw = vars.get(dbDisabledConfigName) ?: &apos;&apos;
def apiRows = asRows(parsed).collect { rowToMap(it) }
if (!apiRows) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口没有返回可对比的待处理/历史订单记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
    return
}

Map apiRow = null
Map expectedRow = null
boolean expectedIsDb = shujuku == &apos;1&apos;
String sourceName = expectedIsDb ? &apos;DB&apos; : &apos;CSV&apos;
String disabledRaw = expectedIsDb ? dbDisabledRaw : csvDisabledRaw
String disabledConfigName = expectedIsDb ? dbDisabledConfigName + &apos;(DB/API)&apos; : &apos;order_ex_csv_disabled_compare_fields(CSV/API)&apos;
Set disabled = (disabledRaw
    .split(/[，,\s]+/)
    .collect { it.trim() }
    .findAll { it })
    .collect { normKey(it) } as Set
def isDisabledField = { String field -&gt;
    String fNorm = normKey(field)
    if (disabled.contains(fNorm)) return true
    for (entry in aliases) {
        def names = ([entry.key] + (entry.value ?: [])).collect { normKey(String.valueOf(it)) }
        if (names.contains(fNorm) &amp;&amp; names.any { disabled.contains(it) }) return true
    }
    return false
}
String matchedId = &apos;&apos;
String dbFirstId = &apos;&apos;
String apiFirstId = idOf(apiRows[0])

if (expectedIsDb) {
    def dbObj = vars.getObject(&apos;db_order_ex_check_rows&apos;)
    def dbRows = []
    if (dbObj instanceof List) dbRows = dbObj.collect { rowToMap(it) }
    else if (dbObj != null) dbRows = [rowToMap(dbObj)]
    dbRows = dbRows.findAll { it }
    if (!dbRows) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;数据库未返回待处理/历史订单记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
        return
    }
    dbFirstId = idOf(dbRows[0])
    for (a in apiRows) {
        def aid = idOf(a)
        def d = dbRows.find { idOf(it) == aid }
        if (d) {
            apiRow = a
            expectedRow = d
            matchedId = aid
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;接口和数据库数据记录没有匹配上订单号 | apiFirst=&apos; + apiFirstId + &apos; | dbFirst=&apos; + dbFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;) + &apos; | dbIds=&apos; + dbRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
} else {
    expectedRow = new LinkedHashMap()
    def csvFields = &apos;shujuku,order_instanceid_val,order_login,order_id,order_symbol,symbol,position_ticket,price_open,volume_initial,price_tp,source,login,type,time_setup_utc_ms,order_ticket,instance_id,time_done_utc_ms,price_sl,volume_current,digits,state,price_current,account_mode,position_id&apos;.split(&apos;,&apos;)
    csvFields.each { key -&gt;
        def val = vars.get(key)
        if (val != null) expectedRow[key] = val
    }
    def csvId = idOf(expectedRow)
    for (a in apiRows) {
        if (idOf(a) == csvId) {
            apiRow = a
            matchedId = csvId
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;CSV订单号和接口响应返回订单号没有匹配上 | csvId=&apos; + csvId + &apos; | apiFirst=&apos; + apiFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
}

def apiFields = apiRow.keySet().collect { String.valueOf(it) }
def detailsOk = []
def detailsFail = []
def detailsSkip = []
String matchedLoginText = valueTextFor(apiRow, &apos;login&apos;) ?: valueTextFor(expectedRow, &apos;login&apos;) ?: login
String matchedOrderType = orderTypeText(apiRow, expectedRow)
String orderNoText = (matchedId ? &quot;订单号=${matchedId} | &quot; : &apos;&apos;) + &quot;login=${matchedLoginText} | 订单类型=${matchedOrderType} | &quot;
int comparedTotal = 0
int successCount = 0
int failCount = 0
int skipCount = 0

for (field in apiFields) {
    def apiVal = apiRow[field]
    def expectedKey = findKey(expectedRow, field)
    def expVal = expectedKey == null ? null : expectedRow[expectedKey]
    String sourceMissingDisplay = expectedIsDb ? &apos;&lt;empty&gt; 数据库查询结果无此字段&apos; : &apos;&lt;empty&gt; CSV未配置此字段&apos;
    String sourceMissingNote = expectedIsDb ? &apos;DB查询结果无此字段：数据库表中没有该字段，或当前SQL没有SELECT/别名没有映射该字段&apos; : &apos;CSV未配置此字段&apos;
    String sourceEmptyDisplay = expectedIsDb ? &apos;&lt;empty&gt; 字段存在但DB值为空&apos; : &apos;&lt;empty&gt; 字段存在但CSV当前行值为空&apos;
    String sourceEmptyNote = expectedIsDb ? &apos;DB查询字段存在，但字段值为NULL或空字符串（数据库表原值为空或SQL返回NULL）&apos; : &apos;CSV字段存在，但当前行值为空&apos;
    if (isDisabledField(field)) {
        skipCount++
        def expectedDisplay = expectedKey == null ? sourceMissingDisplay : (blank(expVal) ? sourceEmptyDisplay : rendered(field, expVal, !expectedIsDb, sourceName))
        String sourceStateNote = expectedKey == null ? sourceMissingNote : (blank(expVal) ? sourceEmptyNote : &apos;&apos;)
        detailsSkip &lt;&lt; &quot;跳过 | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${expectedDisplay} | ${sourceName}字段=${expectedKey ?: &apos;&lt;not found&gt;&apos;} | 原因=字段在${disabledConfigName}中，未参与${sourceName}/API校验${sourceStateNote ? &apos; | 备注=&apos; + sourceStateNote : &apos;&apos;}&quot;
        continue
    }
    if (expectedKey == null) {
        comparedTotal++
        failCount++
        detailsFail &lt;&lt; &quot;失败 | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${sourceMissingDisplay} | ${sourceName}字段=&lt;not found&gt; | 备注=${sourceMissingNote}&quot;
        continue
    }
    if (blank(apiVal) &amp;&amp; blank(expVal)) {
        comparedTotal++
        successCount++
        String note = expectedIsDb ? &apos;API为空；DB查询字段存在，但字段值为NULL或空字符串，双方一致，通过&apos; : &apos;API为空；CSV字段存在但当前行值为空，双方一致，通过&apos;
        detailsOk &lt;&lt; &quot;成功 | ${orderNoText}字段=${field} | API=&lt;empty&gt; | ${sourceName}=&lt;empty&gt; | ${sourceName}字段=${expectedKey} | 备注=${note}&quot;
        continue
    }
    if (blank(apiVal) || blank(expVal)) {
        comparedTotal++
        failCount++
        String note = blank(apiVal) ? &apos;API返回为空，&apos; + sourceName + &apos;有值，失败&apos; : sourceEmptyNote + &apos;，失败&apos;
        detailsFail &lt;&lt; &quot;失败 | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${rendered(field, expVal, !expectedIsDb, sourceName)} | ${sourceName}字段=${expectedKey} | 备注=${note}&quot;
        continue
    }
    comparedTotal++
    if (priceCompareField(field)) {
        BigDecimal apiNum = decimalValue(apiVal)
        BigDecimal baseNum = decimalValue(expVal)
        if (apiNum != null &amp;&amp; baseNum != null) {
            BigDecimal diff = baseNum.subtract(apiNum).abs()
            String apiPrint = rendered(field, apiVal, true, sourceName)
            String basePrint = rendered(field, expVal, !expectedIsDb, sourceName)
            String priceName = priceDisplayName(field)
            if (baseNum.compareTo(BigDecimal.ZERO) == 0) {
                boolean zeroPass = apiNum.compareTo(BigDecimal.ZERO) == 0
                String zeroNote = zeroPass ? priceName + &apos; 基准&apos; + sourceName + &apos;值为0且API也是0，通过&apos; : priceName + &apos; 基准&apos; + sourceName + &apos;值为0，无法计算百分比且API不为0，失败&apos;
                def zeroLine = &quot;${zeroPass ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=无法计算(${sourceName}基准值为0) | 计算公式=abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 | 备注=${zeroNote}&quot;
                if (zeroPass) { successCount++; detailsOk &lt;&lt; zeroLine } else { failCount++; detailsFail &lt;&lt; zeroLine }
                continue
            }
            BigDecimal limitPct = priceTolerancePercent(field)
            BigDecimal pct = diff.divide(baseNum.abs(), 10, java.math.RoundingMode.HALF_UP).multiply(new BigDecimal(&apos;100&apos;))
            boolean priceOk = pct.compareTo(limitPct) &lt;= 0
            String limitText = decimalText(limitPct)
            String note = priceOk ? priceName + &apos; 误差小于&apos; + limitText + &apos;%，通过&apos; : priceName + &apos; 误差大于&apos; + limitText + &apos;%，失败&apos;
            String formula = &quot;abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 = ${percentText(pct)}&quot;
            def priceLine = &quot;${priceOk ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=${percentText(pct)} | 计算公式=${formula} | 备注=${note}&quot;
            if (priceOk) { successCount++; detailsOk &lt;&lt; priceLine } else { failCount++; detailsFail &lt;&lt; priceLine }
            continue
        }
    }
    if (slTpCompareField(field)) {
        BigDecimal apiNum = decimalValue(apiVal)
        BigDecimal baseNum = decimalValue(expVal)
        if (apiNum != null &amp;&amp; baseNum != null) {
            BigDecimal diff = baseNum.subtract(apiNum).abs()
            String apiPrint = rendered(field, apiVal, true, sourceName)
            String basePrint = rendered(field, expVal, !expectedIsDb, sourceName)
            String priceName = slTpDisplayName(field)
            if (baseNum.compareTo(BigDecimal.ZERO) == 0) {
                boolean zeroPass = apiNum.compareTo(BigDecimal.ZERO) == 0
                String zeroNote = zeroPass ? priceName + &apos; 基准&apos; + sourceName + &apos;值为0且API也是0，通过&apos; : priceName + &apos; 基准&apos; + sourceName + &apos;值为0，无法计算百分比且API不为0，失败&apos;
                def zeroLine = &quot;${zeroPass ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=无法计算(${sourceName}基准值为0) | 计算公式=abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 | 备注=${zeroNote}&quot;
                if (zeroPass) { successCount++; detailsOk &lt;&lt; zeroLine } else { failCount++; detailsFail &lt;&lt; zeroLine }
                continue
            }
            BigDecimal pct = diff.divide(baseNum.abs(), 10, java.math.RoundingMode.HALF_UP).multiply(new BigDecimal(&apos;100&apos;))
            boolean priceOk = pct.compareTo(new BigDecimal(&apos;5&apos;)) &lt;= 0
            String note = priceOk ? priceName + &apos; 误差小于5%，通过&apos; : priceName + &apos; 误差大于5%，失败&apos;
            String formula = &quot;abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 = ${percentText(pct)}&quot;
            def priceLine = &quot;${priceOk ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=${percentText(pct)} | 计算公式=${formula} | 备注=${note}&quot;
            if (priceOk) { successCount++; detailsOk &lt;&lt; priceLine } else { failCount++; detailsFail &lt;&lt; priceLine }
            continue
        }
    }
    boolean ok = sameValue(field, apiVal, expVal, expectedIsDb)
    def line = &quot;${ok ? &apos;成功&apos; : &apos;失败&apos;} | ${orderNoText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${rendered(field, expVal, !expectedIsDb, sourceName)} | ${sourceName}字段=${expectedKey}&quot;
    if (ok) {
        successCount++
        detailsOk &lt;&lt; line
    } else {
        failCount++
        detailsFail &lt;&lt; line
    }
}

def status = failCount == 0 ? &apos;PASS&apos; : &apos;FAIL&apos;
def report = []
report &lt;&lt; &apos;╔══════════════════════════════════════════════════════════════╗&apos;
report &lt;&lt; &apos;║  【待处理/历史订单 对比结果】                               ║&apos;
report &lt;&lt; &apos;╚══════════════════════════════════════════════════════════════╝&apos;
report &lt;&lt; &quot;状态: ${status}&quot;
report &lt;&lt; &quot;数据来源: API vs ${sourceName}&quot;
report &lt;&lt; &quot;当前跳过字段配置: ${disabledConfigName}=[${disabledRaw}]&quot;
report &lt;&lt; &quot;instanceid=${instanceId} | login=${login} | 匹配订单号=${matchedId} | 订单类型=${matchedOrderType} | 本次对比login=${matchedLoginText}&quot;
report &lt;&lt; &quot;接口返回记录数: ${apiRows.size()} | 接口首条订单号: ${apiFirstId}&quot; + (expectedIsDb ? &quot; | DB首条订单号: ${dbFirstId}&quot; : &apos;&apos;)
report &lt;&lt; &quot;接口对比字段总数量: ${apiFields.size()}&quot;
report &lt;&lt; &quot;实际参与对比字段数量: ${comparedTotal}&quot;
report &lt;&lt; &quot;成功字段数量: ${successCount}&quot;
report &lt;&lt; &quot;失败字段数量: ${failCount}&quot;
report &lt;&lt; &quot;跳过字段（未参与校验）数量: ${skipCount}&quot;
report &lt;&lt; &apos;时间字段规则: API/CSV秒或毫秒时间戳先按Asia/Shanghai展示，再减8小时取UTC格式后与DB时间比较&apos;
report &lt;&lt; &apos;价格字段规则: open_price/price_open、close_price/price_close 按DB或CSV为基准计算差值百分比，误差大于2%计入失败字段；price_current/PriceCurrent 按DB或CSV为基准计算差值百分比，误差大于10%计入失败字段，误差小于10%计入成功字段；price_sl/sl、price_tp/tp 按DB或CSV为基准计算差值百分比，误差大于5%计入失败字段；字段跳过配置仍优先，配置字段名或别名均可跳过。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败字段明细】&apos;
report.addAll(detailsFail ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细】&apos;
report.addAll(detailsOk ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细（含跳过原因）】&apos;
report.addAll(detailsSkip ?: [&apos;无&apos;])

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)

def detail = new SampleResult()
detail.setSampleLabel(&apos;待处理/历史订单字段对比结果&apos;)
detail.setSuccessful(failCount == 0)
detail.setResponseCode(failCount == 0 ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(status)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
prev.addSubResult(detail)

if (failCount &gt; 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
}
</stringProp>
