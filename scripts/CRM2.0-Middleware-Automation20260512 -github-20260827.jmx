                <stringProp name="Argument.name">position_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">open_time_utc_ms,price_current,profit,swap,margin_rate,updated_utc_ms,pos_uid,account_mode,digits,reason,time_update_utc_ms</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制DB/API对比的跳过字段，多个字段用逗号分隔；填 * 表示只校验订单号匹配。</stringProp>
              </elementProp>
              <elementProp name="position_db_api_field_tolerance_percent" elementType="Argument">
