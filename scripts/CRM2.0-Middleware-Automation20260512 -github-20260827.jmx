              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言&quot;msg&quot;: &quot;ok&quot;" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="CSV群组比对断言-按实例列" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def fail = { String message -&gt;
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(message)
    prev.setSuccessful(false)
}

def instanceId = (vars.get(&quot;instanceid_val&quot;) ?: &quot;&quot;).trim()
def columnMap = [
    &quot;MT5_1&quot;    : [&quot;MT5Group&quot;, &quot;MT5ServerType&quot;],
    &quot;MT5_1_TS1&quot;: [&quot;MT5_1_TS1Group&quot;, &quot;MT5_1_TS1ServerType&quot;],
    &quot;MT5_1_TS2&quot;: [&quot;MT5_1_TS2Group&quot;, &quot;MT5_1_TS2ServerType&quot;],
    &quot;MT4_1&quot;    : [&quot;MT4Group&quot;, &quot;MT4ServerType&quot;],
    &quot;MT4_3&quot;    : [&quot;MT4_3Group&quot;, &quot;MT4_3ServerType&quot;]
]

def selectedColumns = columnMap[instanceId]
if (!selectedColumns) {
    fail(&quot;不支持的 instanceid_val=[${instanceId}]；支持的实例: ${columnMap.keySet().sort().join(&apos;, &apos;)}&quot;)
    return
}

def groupColumnName = selectedColumns[0]
def serverTypeColumnName = selectedColumns[1]
def platformLabel = instanceId.startsWith(&quot;MT5&quot;) ? &quot;MT5&quot; : &quot;MT4&quot;

// ====== 解析API返回的群组列表 ======
def response = prev.getResponseDataAsString()
def json
try {
    json = new JsonSlurper().parseText(response ?: &quot;{}&quot;)
} catch (Exception e) {
    fail(&quot;${instanceId} 群组信息接口返回不是合法JSON: ${e.message}\n响应内容: ${response}&quot;)
    return
}

def apiRows = (json?.data instanceof Collection) ? json.data : []
def apiGroups = [:]
apiRows.each { item -&gt;
    def groupName = item.Group?.toString()?.trim() ?: &quot;&quot;
    if (groupName) {
        apiGroups[groupName] = item.ServerType?.toString()?.trim() ?: &quot;&quot;
    }
}
log.info(&quot;${instanceId}(${platformLabel}) API返回群组数量: ${apiGroups.size()}&quot;)

// ====== 读取CSV文件 ======
def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
def csvFile = new File(baseDir, &quot;get_groups_info.csv&quot;)
if (!csvFile.exists()) {
    fail(&quot;CSV文件不存在：${csvFile.absolutePath}&quot;)
    return
}

def csvLines = csvFile.readLines(&quot;UTF-8&quot;)
if (csvLines.size() &lt; 2) {
    fail(&quot;CSV文件数据不足（需要表头+至少1行数据）：${csvFile.absolutePath}&quot;)
    return
}

// 解析CSV表头（处理BOM字符）
def firstLine = csvLines[0]
if (firstLine.startsWith(&quot;\uFEFF&quot;)) {
    firstLine = firstLine.substring(1)
}
def csvHeaders = firstLine.split(&quot;,&quot;, -1)*.trim()

// 根据instanceid_val精确匹配CSV列
def groupColIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(groupColumnName) }
def serverTypeColIdx = csvHeaders.findIndexOf { it.equalsIgnoreCase(serverTypeColumnName) }
def missingColumns = []
if (groupColIdx &lt; 0) missingColumns &lt;&lt; groupColumnName
if (serverTypeColIdx &lt; 0) missingColumns &lt;&lt; serverTypeColumnName
if (missingColumns) {
    fail(&quot;CSV文件中未找到 ${instanceId} 需要的列: ${missingColumns.join(&apos;, &apos;)}\n当前表头: ${csvHeaders.join(&apos;, &apos;)}&quot;)
    return
}

// 解析CSV数据（跳过空行和空Group行）
def csvGroups = [:]
for (int i = 1; i &lt; csvLines.size(); i++) {
    def rawLine = csvLines[i]
    if (!rawLine?.trim()) continue
    def cols = rawLine.split(&quot;,&quot;, -1)*.trim()
    if (cols.size() &lt;= groupColIdx) continue
    def csvGroup = cols[groupColIdx]
    if (!csvGroup) continue
    def csvServerType = cols.size() &gt; serverTypeColIdx ? cols[serverTypeColIdx] : &quot;&quot;
    csvGroups[csvGroup] = csvServerType
}
log.info(&quot;\nCSV中${instanceId}群组数量: ${csvGroups.size()}，读取列: ${groupColumnName}/${serverTypeColumnName}&quot;)

// ====== 集合比对 ======
def failures = []

def missingInCsv = apiGroups.keySet() - csvGroups.keySet()
if (missingInCsv) {
    failures &lt;&lt; &quot;API中存在但CSV列[${groupColumnName}]中缺少的群组(${missingInCsv.size()}个)：${missingInCsv.sort().join(&apos;, &apos;)}&quot;
}

def missingInApi = csvGroups.keySet() - apiGroups.keySet()
if (missingInApi) {
    failures &lt;&lt; &quot;CSV列[${groupColumnName}]中存在但API缺少的群组(${missingInApi.size()}个)：${missingInApi.sort().join(&apos;, &apos;)}&quot;
}

def matchingGroups = apiGroups.keySet().intersect(csvGroups.keySet())
def serverTypeMismatches = []
matchingGroups.each { groupName -&gt;
    def apiST = apiGroups[groupName]
    def csvST = csvGroups[groupName]
    if (apiST != csvST) {
        serverTypeMismatches &lt;&lt; &quot;${groupName}: 预期CSV[${serverTypeColumnName}]=[${csvST}], 实际API[ServerType]=[${apiST}]&quot;
    }
}
if (serverTypeMismatches) {
    failures &lt;&lt; &quot;ServerType不一致的群组(${serverTypeMismatches.size()}个)：\n  ${serverTypeMismatches.join(&apos;\n  &apos;)}&quot;
}

// ====== 断言结果 ======
if (failures.isEmpty()) {
    def msg = &quot;\n${instanceId}(${platformLabel}) 群组信息CSV比对通过！CSV列=${groupColumnName}/${serverTypeColumnName}, API=${apiGroups.size()}个, CSV=${csvGroups.size()}个, 共同=${matchingGroups.size()}个&quot;
    prev.setResponseMessage(msg)
    log.info(msg)
} else {
    fail(&quot;\n${instanceId}(${platformLabel}) 群组信息CSV比对失败！CSV列=${groupColumnName}/${serverTypeColumnName}\n&quot; + failures.join(&quot;\n\n&quot;) +
        &quot;\n\n---统计---\nAPI群组: ${apiGroups.size()}个, CSV群组: ${csvGroups.size()}个, 共同匹配: ${matchingGroups.size()}个&quot;)
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="19查询多个账户的挂单订单-数据库校验✅✅" enabled="true">
        <stringProp name="TestPlan.comments">list_pending_orders：按CSV行数循环；shujuku=1时聚合CSV中全部 shujuku=1 的 accounts 一次请求并DB/API对比；shujuku=0时按当前CSV行做CSV/API对比。只修改本线程组。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="查询多个账户挂单订单CSV循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;查询多个账户的挂单订单.csv&apos;); if (!f.exists()) return 0; def lines = f.readLines(&apos;UTF-8&apos;); if (lines.size() &lt;= 1) return 0; boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = -1; for (int j = 0; j &lt; line.length(); j++) { if ((int)line.charAt(j) == 44) { p = j; break } }; String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == (65279 as char)) first = first.drop(1); first = first.trim(); if (first.length() &gt;= 2 &amp;&amp; first.charAt(0) == (&apos;&quot;&apos; as char) &amp;&amp; first.charAt(first.length() - 1) == (&apos;&quot;&apos; as char)) first = first.drop(1).take(first.length() - 2).trim(); if (first == &apos;1&apos;) hasDb = true; else if (first == &apos;0&apos;) csvCount++ } }; return csvCount + (hasDb ? 1 : 0))}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="19查询多个账户的挂单订单事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户挂单订单" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的挂单订单.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_symbol,order_types,time_setup_from_utc_ms,time_setup_to_utc_ms,volume_lots_condition,volume_lots_value,sort_by,sort_order,reason,symbol,side,swap,updated_utc_ms,fee,price_open,price_tp,source,time_expiration_utc_ms,time_setup_utc_ms,order_ticket,instance_id,price_sl,comment,digits,contract_size,digits_currency,state,order_type,profit,price_current,volume_lots,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户挂单订单DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="pending_orders_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">pending_orders_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">updated_utc_ms</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段跳过配置；同时控制summary和当前页明细；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户挂单订单CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="pending_orders_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">pending_orders_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户挂单订单参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的挂单订单.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户挂单订单CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户挂单订单CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户挂单订单CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户挂单订单CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;pending_orders_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户挂单订单循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;pending_orders_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String platform = platformOf(instanceId)
    List loginValues = splitList(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;])).collect { cleanInt(it) }.findAll { it }
    if (!loginValues) {
        String singleLogin = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
        if (singleLogin) loginValues &lt;&lt; singleLogin
    }
    loginValues.each { login -&gt;
        if (instanceId &amp;&amp; login &amp;&amp; platform) {
            String key = instanceId + &apos;|&apos; + login
            if (!accountKeys.contains(key)) {
                accountKeys &lt;&lt; key
                accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
            }
            if (platform == &apos;MT4&apos;) {
                mt4Logins &lt;&lt; login
                mt4LoginInstance[login] = instanceId
            } else if (platform == &apos;MT5&apos;) {
                mt5Logins &lt;&lt; login
                mt5LoginInstance[login] = instanceId
            }
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户挂单订单没有可用accounts，CSV需要填写 order_instanceid_val/order_login 或 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;time_setup_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;filter_symbol&apos;, &apos;symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;2&apos;, &apos;3&apos;, &apos;4&apos;, &apos;5&apos;] }.unique()
if (!orderTypeList) orderTypeList = [&apos;2&apos;, &apos;3&apos;, &apos;4&apos;, &apos;5&apos;]
String setupFrom = cleanInt(firstValue(currentRow, [&apos;time_setup_from_utc_ms&apos;, &apos;setup_time_from_utc_ms&apos;]))
String setupTo = cleanInt(firstValue(currentRow, [&apos;time_setup_to_utc_ms&apos;, &apos;setup_time_to_utc_ms&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;filter_volume_lots_value&apos;]))
if (!volumeValue) volumeValue = &apos;0.01&apos;

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (setupFrom) filters[&apos;time_setup_from_utc_ms&apos;] = Long.parseLong(setupFrom)
if (setupTo) filters[&apos;time_setup_to_utc_ms&apos;] = Long.parseLong(setupTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;pending_orders_shujuku&apos;, shujuku)
vars.put(&apos;pending_orders_mode&apos;, runCase.mode.toString())
vars.put(&apos;pending_orders_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;pending_orders_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;pending_orders_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;pending_orders_request_body&apos;, requestBody)
vars.put(&apos;pending_orders_page&apos;, page)
vars.put(&apos;pending_orders_page_size&apos;, pageSize)
vars.put(&apos;pending_orders_sort_by&apos;, sortBy)
vars.put(&apos;pending_orders_sort_order&apos;, sortOrder)
vars.put(&apos;pending_orders_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;pending_orders_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;pending_orders_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_pending_orders_summary_rows&apos;, [])
vars.putObject(&apos;db_pending_orders_page_rows&apos;, [])

String mt5VolumeExpr = &quot;(CASE WHEN mt.VolumeCurrentExt &gt; 0 THEN mt.VolumeCurrentExt / 100000000.0 ELSE mt.VolumeCurrent / 10000.0 END)&quot;
String setupMsMt5 = &quot;CASE WHEN CAST(mt.TimeSetupMsc AS CHAR) NOT IN (&apos;0000-00-00 00:00:00.000000&apos;, &apos;1970-01-01 00:00:00.000000&apos;) THEN CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeSetupMsc) / 1000 AS UNSIGNED) ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeSetup) / 1000 AS UNSIGNED) END&quot;
String updatedMsMt5 = &quot;CASE WHEN mt.`Timestamp` &gt; 100000000000 THEN CAST(mt.`Timestamp` AS UNSIGNED) WHEN mt.`Timestamp` &gt; 0 THEN CAST(mt.`Timestamp` AS UNSIGNED) * 1000 WHEN CAST(mt.TimeDoneMsc AS CHAR) NOT IN (&apos;0000-00-00 00:00:00.000000&apos;, &apos;1970-01-01 00:00:00.000000&apos;) THEN CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeDoneMsc) / 1000 AS UNSIGNED) ELSE ${setupMsMt5} END&quot;
String expirationMsMt5 = &quot;CASE WHEN CAST(mt.TimeExpiration AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) THEN 0 ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeExpiration) / 1000 AS UNSIGNED) END&quot;
String setupMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String updatedMsMt4 = &quot;CASE WHEN mt.`TIMESTAMP` &gt; 100000000000 THEN CAST(mt.`TIMESTAMP` AS UNSIGNED) WHEN mt.`TIMESTAMP` &gt; 0 THEN CAST(mt.`TIMESTAMP` AS UNSIGNED) * 1000 ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.MODIFY_TIME) / 1000 AS UNSIGNED) END&quot;
String expirationMsMt4 = &quot;CASE WHEN CAST(mt.EXPIRATION AS CHAR) IN (&apos;0000-00-00 00:00:00&apos;, &apos;1970-01-01 00:00:00&apos;) THEN 0 ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.EXPIRATION) / 1000 AS UNSIGNED) END&quot;
String orderTypeSql = orderTypeList.join(&apos;,&apos;)
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

String mt4LoginSql = mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;
String mt5LoginSql = mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + mt4LoginSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
mt4Where &lt;&lt; &apos;mt.CONV_RATE1 = 0&apos;
mt4Where &lt;&lt; &quot;CAST(mt.CLOSE_TIME AS CHAR) IN (&apos;1970-01-01 00:00:00&apos;, &apos;0000-00-00 00:00:00&apos;)&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (setupFrom) mt4Where &lt;&lt; setupMsMt4 + &apos; &gt;= &apos; + setupFrom
if (setupTo) mt4Where &lt;&lt; setupMsMt4 + &apos; &lt;= &apos; + setupTo

List mt5Where = []
mt5Where &lt;&lt; &apos;mt.Login IN (&apos; + mt5LoginSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;mt.`Order` &gt; 0&apos;
mt5Where &lt;&lt; &apos;mt.Symbol IS NOT NULL&apos;
mt5Where &lt;&lt; &quot;TRIM(mt.Symbol) &lt;&gt; &apos;&apos;&quot;
mt5Where &lt;&lt; &quot;mt.Symbol REGEXP &apos;[A-Za-z]&apos;&quot;
mt5Where &lt;&lt; &apos;mt.Type IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;mt.State = 1&apos;
mt5Where &lt;&lt; mt5VolumeExpr + &apos; &apos; + volOp + &apos; &apos; + volumeValue
if (filterOrderTicket) mt5Where &lt;&lt; &apos;mt.`Order` = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; (filterPositionTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;mt.PositionID = &apos; + filterPositionTicket)
if (symbol) mt5Where &lt;&lt; &apos;mt.Symbol = &apos; + sqlQuote(symbol)
if (setupFrom) mt5Where &lt;&lt; setupMsMt5 + &apos; &gt;= &apos; + setupFrom
if (setupTo) mt5Where &lt;&lt; setupMsMt5 + &apos; &lt;= &apos; + setupTo

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;mt.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.REASON AS reason,
  mt.SYMBOL AS symbol,
  CASE WHEN mt.CMD IN (2, 4) THEN &apos;buy&apos; WHEN mt.CMD IN (3, 5) THEN &apos;sell&apos; ELSE CAST(mt.CMD AS CHAR) END AS side,
  0.0 AS swap,
  ${updatedMsMt4} AS updated_utc_ms,
  0.0 AS fee,
  0.0 AS commission,
  mt.OPEN_PRICE AS price_open,
  mt.TP AS price_tp,
  ${expirationMsMt4} AS time_expiration_utc_ms,
  ${setupMsMt4} AS time_setup_utc_ms,
  mt.SL AS price_sl,
  mt.COMMENT AS comment,
  mt.DIGITS AS digits,
  0.0 AS contract_size,
  0 AS digits_currency,
  1 AS state,
  mt.CMD AS order_type,
  0.0 AS profit,
  0.0 AS price_current,
  mt.VOLUME / 100.0 AS volume_lots,
  UPPER(TRIM(NULLIF(u.CURRENCY, &apos;&apos;))) AS currency,
  &apos;native&apos; AS money_unit,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) = &apos;USC&apos; THEN 1 WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) = &apos;USD&apos; THEN 0 ELSE NULL END AS is_cent,
  &apos;USD&apos; AS reporting_currency,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 1 ELSE 0 END AS normalization_complete,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS profit_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS fee_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS swap_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) = &apos;USC&apos; THEN 1 ELSE 0 END AS is_cent_account
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  mt.Login AS login,
  &apos;mt5&apos; AS source,
  mt.`Order` AS order_ticket,
  mt.Reason AS reason,
  mt.Symbol AS symbol,
  CASE WHEN mt.Type IN (2, 4) THEN &apos;buy&apos; WHEN mt.Type IN (3, 5) THEN &apos;sell&apos; ELSE CAST(mt.Type AS CHAR) END AS side,
  0.0 AS swap,
  ${updatedMsMt5} AS updated_utc_ms,
  0.0 AS fee,
  0.0 AS commission,
  mt.PriceOrder AS price_open,
  mt.PriceTP AS price_tp,
  ${expirationMsMt5} AS time_expiration_utc_ms,
  ${setupMsMt5} AS time_setup_utc_ms,
  mt.PriceSL AS price_sl,
  mt.Comment AS comment,
  mt.Digits AS digits,
  mt.ContractSize AS contract_size,
  mt.DigitsCurrency AS digits_currency,
  mt.State AS state,
  mt.Type AS order_type,
  0.0 AS profit,
  mt.PriceCurrent AS price_current,
  ${mt5VolumeExpr} AS volume_lots,
  UPPER(TRIM(NULLIF(d.Currency, &apos;&apos;))) AS currency,
  &apos;native&apos; AS money_unit,
  CASE UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) = &apos;USC&apos; THEN 1 WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) = &apos;USD&apos; THEN 0 ELSE NULL END AS is_cent,
  &apos;USD&apos; AS reporting_currency,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 1 ELSE 0 END AS normalization_complete,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS profit_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS fee_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS swap_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(d.Currency, &apos;&apos;))) = &apos;USC&apos; THEN 1 ELSE 0 END AS is_cent_account
FROM mt5_report.mt5_orders mt
LEFT JOIN (
  SELECT d1.Login, MAX(COALESCE(d1.Currency, &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${mt5LoginSql})
    GROUP BY Login
  ) latest ON latest.Login = d1.Login AND latest.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) d ON d.Login = mt.Login
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;time_setup_utc_ms&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;, &apos;volume_lots&apos;, &apos;login&apos;, &apos;symbol&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;time_setup_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String pendingRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN currency = &apos;USC&apos; THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN currency = &apos;USD&apos; THEN volume_lots ELSE 0 END), 0) AS standard_volume,
  COALESCE(SUM(CASE WHEN normalization_complete = 0 THEN volume_lots ELSE 0 END), 0) AS unresolved_volume,
  COUNT(DISTINCT CASE WHEN normalization_complete = 0 THEN CONCAT(instance_id, &apos;:&apos;, login) ELSE NULL END) AS unresolved_currency_account_count,
  COALESCE(SUM(COALESCE(commission, 0)), 0) AS total_commission,
  COALESCE(SUM(COALESCE(fee, 0)), 0) AS total_raw_fee,
  0.0 AS total_fee,
  0.0 AS total_storage,
  0.0 AS total_profit
FROM (
${pendingRowsSql}
) pending_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  reason,
  symbol,
  side,
  swap,
  updated_utc_ms,
  fee,
  commission,
  COALESCE(commission, 0) + COALESCE(fee, 0) AS row_total_fee,
  price_open,
  price_tp,
  source,
  login,
  time_expiration_utc_ms,
  time_setup_utc_ms,
  order_ticket,
  instance_id,
  price_sl,
  comment,
  digits,
  contract_size,
  digits_currency,
  state,
  order_type,
  profit,
  price_current,
  volume_lots,
  currency,
  money_unit,
  money_scale,
  is_cent,
  reporting_currency,
  normalization_complete,
  profit_reporting,
  fee_reporting,
  swap_reporting
FROM (
${pendingRowsSql}
) pending_rows
ORDER BY ${sortColumn} ${dbOrder}, order_ticket ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
vars.put(&apos;pending_orders_summary_sql&apos;, summarySqlExec)
vars.put(&apos;pending_orders_page_sql&apos;, pageSqlExec)

String initReport = &apos;list_pending_orders init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;pending_orders_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;pending_orders_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;init passed&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + &apos;\n\n【统计summary SQL（MT4+MT5合并，只查询一次，实际执行SQL）】\n&apos; + summarySqlExec + &apos;\n\n【当前页明细 SQL（MT4+MT5合并，实际执行SQL）】\n&apos; + pageSqlExec, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">从查询多个账户的挂单订单.csv读取接口传参和期望结果；shujuku=1聚合全部DB模式accounts并执行MT4+MT5合并挂单SQL；shujuku=0按当前CSV行做CSV/API对比。</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当shujuku=1-查询挂单订单summary统计和当前页明细" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;pending_orders_shujuku&apos;) == &apos;1&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询多个账户挂单订单summary统计(MT4+MT5)" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">${pending_orders_summary_sql}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout">60</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">10</stringProp>
              <stringProp name="resultVariable">db_pending_orders_summary_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询多个账户挂单订单当前页明细(MT4+MT5)" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">${pending_orders_page_sql}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout">60</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">50000</stringProp>
              <stringProp name="resultVariable">db_pending_orders_page_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询多个账户挂单订单-${pending_orders_mode}-${pending_orders_case_index_display}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">10000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/list_pending_orders</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${pending_orders_request_body}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager-JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json; charset=UTF-8</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言msg为ok" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="-1887116403">&quot;msg&quot;\s*:\s*&quot;ok&quot;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="DB或CSV字段对比断言-查询多个账户挂单订单" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode
import java.text.SimpleDateFormat

String responseText = prev.getResponseDataAsString()
def publishReport = { String label, String text, boolean success -&gt;
    String out = text ?: &apos;&apos;
    vars.put(&apos;pending_orders_compare_report&apos;, out)
    vars.put(&apos;pending_orders_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    log.info(&apos;\n&apos; + out)
    def detail = new SampleResult()
    detail.setSampleLabel(label)
    detail.setSuccessful(success)
    detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    detail.setResponseData(out, &apos;UTF-8&apos;)
    detail.setDataType(SampleResult.TEXT)
    detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    prev.addSubResult(detail)
    AssertionResult.setFailure(!success)
    AssertionResult.setFailureMessage(out)
}
def parsed
try {
    parsed = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;)
} catch (Throwable e) {
    String finalReport = &apos;Assertion message: 查询多个账户的挂单订单 对比结果 | status=FAIL | reason=接口响应不是合法JSON&apos; +
        &apos;\n接口: POST /crm20/list_pending_orders&apos; +
        &apos;\n【失败明细】\n - [失败] | 接口响应不是合法JSON: &apos; + e.message +
        &apos;\n\n【接口请求Body】\n&apos; + (vars.get(&apos;pending_orders_request_body&apos;) ?: &apos;&apos;) +
        &apos;\n\n【接口响应原文】\n&apos; + responseText
    publishReport(&apos;查询多个账户挂单订单字段对比结果&apos;, finalReport, false)
    return
}

def rowToMap
rowToMap = { row -&gt;
    Map out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else if (row != null) {
        try {
            row.metaClass.properties.each { p -&gt; if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot; }
        } catch (ignored) {}
    }
    out
}

def rowsFromObject = { obj -&gt;
    if (obj == null) return []
    if (obj instanceof List) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Object[]) return obj.collect { rowToMap(it) }.findAll { it }
    if (obj instanceof Map) return [rowToMap(obj)]
    []
}

def blank = { v -&gt; v == null || String.valueOf(v).trim().length() == 0 || String.valueOf(v).trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) }
def normKey = { Object v -&gt; (v == null ? &apos;&apos; : v.toString()).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase() }
boolean numeric(Object v) {
    if (v == null) return false
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    return s.length() &gt; 0 &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) &amp;&amp; (s ==~ /^-?\d+(\.\d+)?$/)
}
def cleanNumText = { v -&gt;
    if (blank(v)) return &apos;&apos;
    String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (s ==~ /^-?\d+\.0+$/) return s.substring(0, s.indexOf(&apos;.&apos;))
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        try { return new BigDecimal(s).stripTrailingZeros().toPlainString() } catch (ignored) {}
    }
    s
}

Map aliases = [
    &apos;position_ticket&apos;: [&apos;position_ticket&apos;, &apos;position&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;order_ticket&apos;: [&apos;order_ticket&apos;, &apos;orderId&apos;, &apos;order_id&apos;, &apos;order&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
