            </JDBCSampler>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取用户信息-数据校验-${user_info_instanceid}-${user_info_login}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">8000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_user_info?instanceid=${user_info_instanceid}&amp;login=${user_info_login}&amp;live_equity=0</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-获取用户信息" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.math.BigDecimal
import java.math.BigInteger
import java.math.RoundingMode
import java.nio.charset.Charset
import java.nio.charset.StandardCharsets
import java.time.Instant
import java.time.ZoneId
import java.time.format.DateTimeFormatter

String cleanText(Object value) {
    if (value == null) return &apos;&apos;
    if (value instanceof Map || value instanceof List) return JsonOutput.toJson(value)
    if (value instanceof BigDecimal) return value.stripTrailingZeros().toPlainString()
    if (value instanceof BigInteger) return value.toString()
    if (value instanceof Number) {
        String s = String.valueOf(value).trim()
        if (s ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)[eE][-+]?\d+$/) {
            try { return new BigDecimal(s).stripTrailingZeros().toPlainString() } catch (Throwable ignored) {}
        }
        return s
    }
    String.valueOf(value).trim()
}

boolean blank(Object value) {
    String s = cleanText(value)
    s.length() == 0 || s.equalsIgnoreCase(&apos;&lt;empty&gt;&apos;) || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)
}

String normKey(Object value) {
    (value == null ? &apos;&apos; : String.valueOf(value))
        .replaceAll(/^\uFEFF/, &apos;&apos;)
        .replaceAll(/[\s_\-\.]/, &apos;&apos;)
        .toLowerCase()
}

String findKey(Map row, String field) {
    if (row == null || field == null) return null
    if (row.containsKey(field)) return field
    String lower = field.toLowerCase()
    Object exactCase = row.keySet().find { String.valueOf(it).toLowerCase() == lower }
    if (exactCase != null) return String.valueOf(exactCase)
    String normalized = normKey(field)
    Object normalizedKey = row.keySet().find { normKey(it) == normalized }
    normalizedKey == null ? null : String.valueOf(normalizedKey)
}

Object valueOf(Map row, String field) {
    String key = findKey(row, field)
    key == null ? null : row[key]
}

Map normalizeMap(Map raw) {
    Map out = new LinkedHashMap()
    if (raw == null) return out
    raw.each { key, value -&gt; out[String.valueOf(key).replaceAll(/^\uFEFF/, &apos;&apos;).trim()] = value }
    out
}

Set parseDisabled(String raw) {
    Set out = [] as Set
    (raw ?: &apos;&apos;).split(/[,，;|\s]+/).each { token -&gt;
        String value = (token ?: &apos;&apos;).trim()
        if (value) {
            out &lt;&lt; value
            out &lt;&lt; value.toLowerCase()
            out &lt;&lt; normKey(value)
        }
    }
    out
}

boolean isDisabled(String field, Set disabled) {
    disabled.contains(&apos;*&apos;) || disabled.contains(field) || disabled.contains((field ?: &apos;&apos;).toLowerCase()) || disabled.contains(normKey(field))
}

Map parseTolerance(String raw) {
    Map out = [:]
    (raw ?: &apos;&apos;).split(/[,，;\n\r]+/).each { token -&gt;
        String text = (token ?: &apos;&apos;).trim()
        if (!text) return
        def matcher = text =~ /^\s*([^:=\s]+)\s*(?:=|:|\s)\s*([0-9]+(?:\.[0-9]+)?)\s*%?\s*$/
        if (matcher.matches()) out[normKey(matcher.group(1))] = new BigDecimal(matcher.group(2))
    }
    out
}

BigDecimal toleranceFor(String field, Map toleranceMap) {
    Object configured = toleranceMap[normKey(field)]
    configured instanceof BigDecimal ? configured as BigDecimal : BigDecimal.ZERO
}

BigDecimal asNum(Object value) {
    if (blank(value)) return null
    String s = cleanText(value).replace(&apos;,&apos;, &apos;&apos;)
    if (!(s ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (Throwable ignored) { return null }
}

String fmtNum(BigDecimal number) {
    number == null ? &apos;&lt;empty&gt;&apos; : number.stripTrailingZeros().toPlainString()
}

String pctText(BigDecimal percent) {
    percent == null ? &apos;N/A&apos; : percent.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos;
}

boolean isTimeField(String field) {
    String normalized = normKey(field)
    if (normalized in [&apos;lastaccess&apos;, &apos;registration&apos;, &apos;lastdate&apos;, &apos;regdate&apos;, &apos;timestamp&apos;]) return true
    // 只把 UTC epoch 字段当作时间；timeout/age 都是时长，不能按时间戳转换。
    (normalized.endsWith(&apos;utcms&apos;) || normalized.endsWith(&apos;utc&apos;)) &amp;&amp; !normalized.contains(&apos;timeout&apos;) &amp;&amp; !normalized.contains(&apos;age&apos;)
}

Long epochMillis(Object value) {
    if (blank(value)) return null
    String s = cleanText(value).replaceAll(/\.0+$/, &apos;&apos;)
    if (!(s ==~ /^-?\d{10,17}$/)) return null
    try {
        long number = Long.parseLong(s)
        int digits = s.startsWith(&apos;-&apos;) ? s.length() - 1 : s.length()
        if (digits &lt;= 10) return number * 1000L
        if (digits == 13) return number
        if (digits == 16) return (long)(number / 1000L)
        if (digits == 17) return (long)(number / 10000L)
        number
    } catch (Throwable ignored) {
        null
    }
}

String formatMs(Long milliseconds) {
    if (milliseconds == null) return &apos;&lt;empty&gt;&apos;
    Instant.ofEpochMilli(milliseconds)
        .atZone(ZoneId.of(&apos;Asia/Shanghai&apos;))
        .format(DateTimeFormatter.ofPattern(&apos;yyyy-MM-dd HH:mm:ss&apos;))
}

String normalizeDateText(Object value) {
    if (blank(value)) return &apos;&apos;
    String text = cleanText(value).replace(&apos;T&apos;, &apos; &apos;).trim()
    text = text.replaceAll(/\.\d+$/, &apos;&apos;).replaceAll(/Z$/, &apos;&apos;)
    if (text ==~ /^\d{4}-\d{2}-\d{2}$/) return text + &apos; 00:00:00&apos;
    text
}

Map parseJsonValue(Object value) {
    if (value instanceof Map || value instanceof List) return [ok: true, value: value]
    String text = cleanText(value)
    if (!(text.startsWith(&apos;{&apos;) || text.startsWith(&apos;[&apos;))) return [ok: false, value: null]
    try {
        return [ok: true, value: new JsonSlurper().parseText(text)]
    } catch (Throwable ignored) {
        return [ok: false, value: null]
    }
}

Object canonicalJson(Object value) {
    if (value instanceof Map) {
        Map sorted = new TreeMap()
        (value as Map).each { key, child -&gt; sorted[String.valueOf(key)] = canonicalJson(child) }
        return sorted
    }
    if (value instanceof List) return (value as List).collect { canonicalJson(it) }
    if (value instanceof BigDecimal) return (value as BigDecimal).stripTrailingZeros()
    value
}

Set&lt;String&gt; textCandidates(String raw) {
    Set&lt;String&gt; candidates = [] as LinkedHashSet
    String first = (raw ?: &apos;&apos;).replaceAll(/[\r\n\t]/, &apos;&apos;)
    candidates &lt;&lt; first
    String current = first
    Charset gb18030 = Charset.forName(&apos;GB18030&apos;)
    for (int round = 0; round &lt; 2; round++) {
        try {
            String repaired = new String(current.getBytes(gb18030), StandardCharsets.UTF_8)
            if (!repaired.contains(&apos;\uFFFD&apos;) &amp;&amp; !repaired.contains(&apos;?&apos;) &amp;&amp; repaired != current) {
                candidates &lt;&lt; repaired
                current = repaired
            } else {
                break
            }
        } catch (Throwable ignored) {
            break
        }
    }
    candidates
}

Map compareValue(String field, Object apiValue, Object expectedValue, String sourceName, BigDecimal tolerance) {
    if (blank(apiValue) &amp;&amp; blank(expectedValue)) {
        return [same: true, apiPrint: &apos;&lt;empty&gt;&apos;, expectedPrint: &apos;&lt;empty&gt;&apos;, diff: &apos;0&apos;, percent: &apos;0%&apos;,
                formula: &apos;API与&apos; + sourceName + &apos;均为空&apos;, note: &apos;API和&apos; + sourceName + &apos;返回都为空，通过&apos;]
    }

    // 按需求：字段在DB/CSV中存在但值为空时，API明确返回数值0也判定通过。
    if (blank(expectedValue)) {
        BigDecimal apiNumber = asNum(apiValue)
        if (apiNumber != null &amp;&amp; apiNumber.compareTo(BigDecimal.ZERO) == 0) {
            return [same: true, apiPrint: &apos;0&apos;, expectedPrint: &apos;&lt;empty&gt;&apos;, diff: &apos;0&apos;, percent: &apos;0%&apos;,
                    formula: &apos;API=0且&apos; + sourceName + &apos;字段存在但值为空&apos;, note: &apos;API=0，&apos; + sourceName + &apos;查询字段数据为空，通过&apos;]
        }
    }

    if (blank(apiValue) || blank(expectedValue)) {
        return [same: false,
                apiPrint: blank(apiValue) ? &apos;&lt;empty&gt;&apos; : cleanText(apiValue),
                expectedPrint: blank(expectedValue) ? &apos;&lt;empty&gt;&apos; : cleanText(expectedValue),
                diff: &apos;N/A&apos;, percent: &apos;N/A&apos;, formula: &apos;API或&apos; + sourceName + &apos;单边为空&apos;, note: &apos;字段值单边为空，失败&apos;]
    }

    Map apiJson = parseJsonValue(apiValue)
    Map expectedJson = parseJsonValue(expectedValue)
    if (apiJson.ok &amp;&amp; expectedJson.ok) {
        String apiCanonical = JsonOutput.toJson(canonicalJson(apiJson.value))
        String expectedCanonical = JsonOutput.toJson(canonicalJson(expectedJson.value))
        boolean same = apiCanonical == expectedCanonical
        return [same: same, apiPrint: apiCanonical, expectedPrint: expectedCanonical,
                diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: same ? &apos;0%&apos; : &apos;N/A&apos;,
                formula: &apos;JSON解析后按键排序并比较结构和值&apos;, note: same ? &apos;JSON语义一致，通过&apos; : &apos;JSON语义不一致，失败&apos;]
    }

    if (isTimeField(field)) {
        Long apiMs = epochMillis(apiValue)
        Long expectedMs = epochMillis(expectedValue)
        if (apiMs != null &amp;&amp; expectedMs != null) {
            long difference = Math.abs(apiMs - expectedMs)
            boolean same = difference &lt;= 1000L
            return [same: same,
                    apiPrint: cleanText(apiValue) + &apos; -&gt; &apos; + formatMs(apiMs),
                    expectedPrint: cleanText(expectedValue) + &apos; -&gt; &apos; + formatMs(expectedMs),
                    diff: difference + &apos;ms&apos;, percent: &apos;N/A&apos;,
                    formula: &apos;abs(API epoch毫秒 - &apos; + sourceName + &apos; epoch毫秒) &lt;= 1000ms&apos;,
                    note: same ? &apos;时间戳一致，通过&apos; : &apos;时间戳不一致，失败&apos;]
        }
        String apiDate = apiMs == null ? normalizeDateText(apiValue) : formatMs(apiMs)
        String expectedDate = expectedMs == null ? normalizeDateText(expectedValue) : formatMs(expectedMs)
        boolean same = apiDate == expectedDate
        return [same: same, apiPrint: cleanText(apiValue) + &apos; -&gt; &apos; + apiDate,
                expectedPrint: cleanText(expectedValue) + &apos; -&gt; &apos; + expectedDate,
                diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: &apos;N/A&apos;,
                formula: &apos;Unix时间按Asia/Shanghai展示后与日期文本比较&apos;, note: same ? &apos;时间一致，通过&apos; : &apos;时间不一致，失败&apos;]
    }

    String apiBoolean = cleanText(apiValue).toLowerCase()
    String expectedBoolean = cleanText(expectedValue).toLowerCase()
    if (apiBoolean in [&apos;true&apos;, &apos;false&apos;] || expectedBoolean in [&apos;true&apos;, &apos;false&apos;]) {
        boolean same = apiBoolean == expectedBoolean
        return [same: same, apiPrint: cleanText(apiValue), expectedPrint: cleanText(expectedValue),
                diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: same ? &apos;0%&apos; : &apos;N/A&apos;,
                formula: &apos;布尔值统一转小写后比较&apos;, note: same ? &apos;布尔值一致，通过&apos; : &apos;布尔值不一致，失败&apos;]
    }

    BigDecimal apiNumber = asNum(apiValue)
    BigDecimal expectedNumber = asNum(expectedValue)
    if (apiNumber != null &amp;&amp; expectedNumber != null) {
        BigDecimal difference = apiNumber.subtract(expectedNumber).abs()
        BigDecimal base = expectedNumber.abs()
        if (base.compareTo(BigDecimal.ZERO) == 0) {
            boolean same = difference.compareTo(BigDecimal.ZERO) == 0
            return [same: same, apiPrint: fmtNum(apiNumber), expectedPrint: fmtNum(expectedNumber),
                    diff: fmtNum(difference), percent: same ? &apos;0%&apos; : &apos;N/A(&apos; + sourceName + &apos;=0)&apos;,
                    formula: &apos;abs(&apos; + sourceName + &apos;(0) - API(&apos; + fmtNum(apiNumber) + &apos;)) = &apos; + fmtNum(difference) + &apos;；基准为0时要求绝对差值为0&apos;,
                    note: same ? &apos;基准为0且数值一致，通过&apos; : &apos;基准为0但绝对差值不为0，失败&apos;]
        }
        BigDecimal percent = difference.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 12, RoundingMode.HALF_UP)
        boolean same = percent.compareTo(tolerance ?: BigDecimal.ZERO) &lt;= 0
        String percentText = pctText(percent)
        String toleranceText = fmtNum(tolerance ?: BigDecimal.ZERO) + &apos;%&apos;
        return [same: same, apiPrint: fmtNum(apiNumber), expectedPrint: fmtNum(expectedNumber),
                diff: fmtNum(difference), percent: percentText,
                formula: &apos;abs((&apos; + sourceName + &apos;(&apos; + fmtNum(expectedNumber) + &apos;) - API(&apos; + fmtNum(apiNumber) + &apos;)) / abs(&apos; + sourceName + &apos;(&apos; + fmtNum(expectedNumber) + &apos;))) * 100 = &apos; + percentText + &apos;；字段误差=&apos; + toleranceText,
                note: same ? &apos;误差小于等于&apos; + toleranceText + &apos;，通过&apos; : &apos;误差大于&apos; + toleranceText + &apos;，失败&apos;]
    }

    String apiString = cleanText(apiValue).replaceAll(/[\r\n\t]/, &apos;&apos;)
    String expectedString = cleanText(expectedValue).replaceAll(/[\r\n\t]/, &apos;&apos;)
    Set&lt;String&gt; apiCandidates = textCandidates(apiString)
    Set&lt;String&gt; expectedCandidates = textCandidates(expectedString)
    boolean same = !apiCandidates.intersect(expectedCandidates).isEmpty()
    boolean encodingRepaired = same &amp;&amp; apiString != expectedString
    return [same: same, apiPrint: apiString, expectedPrint: expectedString,
            diff: same ? &apos;0&apos; : &apos;N/A&apos;, percent: same ? &apos;0%&apos; : &apos;N/A&apos;,
            formula: encodingRepaired ? &apos;去除换行/制表符，并修复UTF-8被GB18030误解码后比较&apos; : &apos;字符串去除换行/制表符后精确比较&apos;,
            note: same ? (encodingRepaired ? &apos;字符编码归一化后一致，通过&apos; : &apos;字符串一致，通过&apos;) : &apos;字符串不一致，失败&apos;]
}

String renderValue(String field, Object value) {
    if (blank(value)) return &apos;&lt;empty&gt;&apos;
    if (isTimeField(field)) {
        Long milliseconds = epochMillis(value)
        if (milliseconds != null) return cleanText(value) + &apos; -&gt; &apos; + formatMs(milliseconds)
    }
    cleanText(value)
}

Map flattenApi(Map item) {
    Map out = new LinkedHashMap()
    if (item == null) return out
    item.each { rawKey, value -&gt;
        String key = String.valueOf(rawKey)
        if (key == &apos;Group&apos; &amp;&amp; value instanceof Map) {
            Map group = value as Map
            out[&apos;Group&apos;] = group[&apos;Group&apos;]
            out[&apos;GroupCurrency&apos;] = group[&apos;Currency&apos;]
            out[&apos;MarginStopOut&apos;] = group[&apos;MarginStopOut&apos;]
            out[&apos;MarginCall&apos;] = group[&apos;MarginCall&apos;]
        } else {
            out[key] = value
        }
    }
    out
}

String shujuku = (vars.get(&apos;user_info_shujuku&apos;) ?: &apos;&apos;).trim()
boolean dbMode = shujuku == &apos;1&apos;
String platform = (vars.get(&apos;user_info_platform&apos;) ?: &apos;&apos;).trim().toUpperCase()
String sourceName = dbMode ? &apos;DB&apos; : &apos;CSV&apos;
String login = vars.get(&apos;user_info_login&apos;) ?: &apos;&apos;
String instanceId = vars.get(&apos;user_info_instanceid&apos;) ?: &apos;&apos;
String liveEquity = vars.get(&apos;user_info_live_equity&apos;) ?: &apos;0&apos;
String responseText = prev.getResponseDataAsString()

List&lt;String&gt; failLines = []
List&lt;String&gt; okLines = []
List&lt;String&gt; skipLines = []
int apiFieldTotal = 0

Map response = null
try {
    response = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;) as Map
} catch (Throwable error) {
    failLines &lt;&lt; &apos; - [失败] | 接口响应不是合法JSON | error=&apos; + error.message + &apos; | response=&apos; + responseText
}

List apiData = []
if (response != null) {
    if (String.valueOf(response.code) != &apos;0&apos;) {
        failLines &lt;&lt; &apos; - [失败] | 接口返回code不是0 | code=&apos; + response.code + &apos; | msg=&apos; + response.msg
    }
    if (!(response.data instanceof List) || (response.data as List).isEmpty()) {
        failLines &lt;&lt; &apos; - [失败] | 接口data为空，无法按login匹配 | login=&apos; + login
    } else {
        apiData = response.data as List
    }
}

Map apiItem = [:]
if (apiData) {
    Object matched = apiData.find { row -&gt;
        if (!(row instanceof Map)) return false
        String loginKey = findKey(row as Map, &apos;Login&apos;) ?: findKey(row as Map, &apos;login&apos;)
        loginKey != null &amp;&amp; cleanText((row as Map)[loginKey]) == login
    }
    if (matched instanceof Map) {
        apiItem = matched as Map
    } else {
        failLines &lt;&lt; &apos; - [失败] | 接口响应没有匹配登录号 | expectedLogin=&apos; + login
        if (apiData[0] instanceof Map) apiItem = apiData[0] as Map
    }
}
Map apiFlat = flattenApi(apiItem)

Map expected = [:]
String disabledConfigName
String toleranceConfigName
if (dbMode) {
    disabledConfigName = platform == &apos;MT4&apos; ? &apos;user_info_mt4_db_api_disabled_compare_fields&apos; : &apos;user_info_mt5_db_api_disabled_compare_fields&apos;
    toleranceConfigName = platform == &apos;MT4&apos; ? &apos;user_info_mt4_db_api_field_tolerance_percent&apos; : &apos;user_info_mt5_db_api_field_tolerance_percent&apos;
    Object rowsObject = vars.getObject(&apos;db_user_info_rows&apos;)
    List databaseRows = rowsObject instanceof List ? rowsObject as List : []
    if (!databaseRows || !(databaseRows[0] instanceof Map)) {
        failLines &lt;&lt; &apos; - [失败] | 数据库没有查询到用户信息记录 | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | login=&apos; + login
    } else {
        expected = normalizeMap(databaseRows[0] as Map)
    }
} else {
    disabledConfigName = &apos;user_info_csv_api_disabled_compare_fields&apos;
    toleranceConfigName = &apos;user_info_csv_api_field_tolerance_percent&apos;
    Object csvObject = vars.getObject(&apos;user_info_current_csv_row&apos;)
    expected = csvObject instanceof Map ? normalizeMap(csvObject as Map) : [:]
}

String disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
String toleranceRaw = vars.get(toleranceConfigName) ?: &apos;&apos;
Set disabled = parseDisabled(disabledRaw)
Map toleranceMap = parseTolerance(toleranceRaw)
String compareModeText = dbMode ? platform + &apos; DB/API&apos; : &apos;CSV/API&apos;

String dataSource = cleanText(valueOf(apiFlat, &apos;_data_source&apos;)).toLowerCase()
String currencyKey = findKey(expected, &apos;currency&apos;) ?: findKey(expected, &apos;GroupCurrency&apos;)
String nativeCurrency = currencyKey == null ? &apos;&apos; : cleanText(expected[currencyKey]).toUpperCase()
BigDecimal reportingScale = nativeCurrency == &apos;USD&apos; ? BigDecimal.ONE : (nativeCurrency == &apos;USC&apos; ? new BigDecimal(&apos;100&apos;) : null)

Map reportingNativeFields = [
    balance_reporting: &apos;balance&apos;, credit_reporting: &apos;credit&apos;, equity_reporting: &apos;equity&apos;, margin_reporting: &apos;margin&apos;,
    margin_free_reporting: &apos;margin_free&apos;, profit_reporting: &apos;profit&apos;, floating_reporting: &apos;floating&apos;, storage_reporting: &apos;storage&apos;,
    swap_total_reporting: &apos;swap_total&apos;, commission_total_reporting: &apos;commission_total&apos;, margin_recompute_reporting: &apos;margin_recompute&apos;,
    equity_recompute_reporting: &apos;equity_recompute&apos;, margin_free_recompute_reporting: &apos;margin_free_recompute&apos;,
    profit_recompute_reporting: &apos;profit_recompute&apos;, floating_recompute_reporting: &apos;floating_recompute&apos;, storage_recompute_reporting: &apos;storage_recompute&apos;,
    taxes_reporting: &apos;taxes&apos;, prevmonthbalance_reporting: &apos;prevmonthbalance&apos;, prevbalance_reporting: &apos;prevbalance&apos;,
    prevmonthequity_reporting: &apos;prevmonthequity&apos;, prevequity_reporting: &apos;prevequity&apos;, commission_daily_reporting: &apos;commission_daily&apos;,
    commission_monthly_reporting: &apos;commission_monthly&apos;, commission_agent_daily_reporting: &apos;commission_agent_daily&apos;,
    commission_agent_monthly_reporting: &apos;commission_agent_monthly&apos;
].collectEntries { key, value -&gt; [(normKey(key)): value] }

Set durationFields = [
    &apos;brokeracquiretimeoutms&apos;, &apos;brokermanagersessionacquiretimeoutms&apos;, &apos;brokertimeoutms&apos;
] as Set
Set recomputeAmountFields = [
    &apos;marginrecompute&apos;, &apos;equityrecompute&apos;, &apos;marginfreerecompute&apos;, &apos;marginlevelrecompute&apos;,
    &apos;profitrecompute&apos;, &apos;floatingrecompute&apos;, &apos;storagerecompute&apos;,
    &apos;marginrecomputereporting&apos;, &apos;equityrecomputereporting&apos;, &apos;marginfreerecomputereporting&apos;,
    &apos;profitrecomputereporting&apos;, &apos;floatingrecomputereporting&apos;, &apos;storagerecomputereporting&apos;
] as Set
Map liveEquityDisabledExpected = [
    brokerattempted: false,
    brokertimedout: false,
    brokerfailedother: false,
    brokerrecomputefailed: false,
    brokerrecomputeretcode: 0,
    brokerfailurestage: &apos;live_equity_disabled&apos;,
    brokererrorcode: 0,
    brokererrormessage: null,
    brokererrorplatform: null,
    brokerrecomputeprobesymbol: null
]

apiFlat.each { rawField, apiValue -&gt;
    String field = String.valueOf(rawField)
    String normalizedField = normKey(field)
    apiFieldTotal++

    String directExpectedKey = findKey(expected, field)
    Object directExpectedValue = directExpectedKey == null ? null : expected[directExpectedKey]

    // 跳过配置优先于所有派生、空值、契约和缺字段规则，确保所有API返回字段都支持人工跳过。
    if (isDisabled(field, disabled)) {
        String sourceText = directExpectedKey == null ? &apos;&lt;empty&gt; &apos; + sourceName + &apos;无此字段&apos; : renderValue(field, directExpectedValue)
        skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) + &apos; | &apos; + sourceName + &apos;=&apos; + sourceText +
            &apos; | APIField=&apos; + field + &apos; | &apos; + sourceName + &apos;Field=&apos; + (directExpectedKey ?: &apos;&lt;not present&gt;&apos;) +
            &apos; | reason=字段已配置在&apos; + disabledConfigName
        return
    }

    // live_equity=0 的服务运行状态来自请求路径/服务配置，而不是账户数据库列。
    if (liveEquity == &apos;0&apos; &amp;&amp; normalizedField == &apos;datasource&apos;) {
        Set allowed = [&apos;shm&apos;, &apos;fallback_balance_credit&apos;] as Set
        boolean same = allowed.contains(cleanText(apiValue).toLowerCase())
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) +
            &apos; | expected=&apos; + allowed.join(&apos;/&apos;) + &apos; | expectedSource=接口契约(live_equity=0) | 差值=N/A | 相差百分比=N/A&apos; +
            &apos; | 计算过程=live_equity=0不发起Broker实时查询，允许SHM或最小余额信用回退来源&apos; +
            &apos; | 备注=&apos; + (same ? &apos;数据来源符合接口契约，通过&apos; : &apos;数据来源不符合接口契约，失败&apos;)
        if (same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    if (normalizedField == &apos;meta&apos;) {
        Map parsed = parseJsonValue(apiValue)
        boolean same = parsed.ok &amp;&amp; parsed.value instanceof Map
        if (same &amp;&amp; (parsed.value as Map).containsKey(&apos;shm_invariant_ok&apos;)) {
            String invariant = cleanText((parsed.value as Map)[&apos;shm_invariant_ok&apos;]).toLowerCase()
            same = invariant in [&apos;true&apos;, &apos;false&apos;]
        }
        String canonical = parsed.ok ? JsonOutput.toJson(canonicalJson(parsed.value)) : renderValue(field, apiValue)
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + canonical +
            &apos; | expected=JSON对象；shm_invariant_ok存在时必须为布尔值 | expectedSource=接口契约&apos; +
            &apos; | 差值=N/A | 相差百分比=N/A | 计算过程=JSON语义解析，不比较空格和键顺序&apos; +
            &apos; | 备注=&apos; + (same ? &apos;JSON元数据结构合法，通过&apos; : &apos;JSON元数据结构不合法，失败&apos;)
        if (same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    if (liveEquity == &apos;0&apos; &amp;&amp; durationFields.contains(normalizedField)) {
        BigDecimal duration = asNum(apiValue)
        boolean same = duration != null &amp;&amp; duration.compareTo(BigDecimal.ZERO) &gt;= 0
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) +
            &apos; | expected=非负毫秒配置值 | expectedSource=服务配置，不是账户DB字段 | 差值=N/A | 相差百分比=N/A&apos; +
            &apos; | 计算过程=按持续时间数值校验，不按Unix时间戳转换&apos; +
            &apos; | 备注=&apos; + (same ? &apos;持续时间配置合法，通过&apos; : &apos;持续时间配置为空或小于0，失败&apos;)
        if (same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    if (liveEquity == &apos;0&apos; &amp;&amp; normalizedField == &apos;brokerrecomputeunsupportedplatform&apos;) {
        String booleanText = cleanText(apiValue).toLowerCase()
        boolean same = booleanText in [&apos;true&apos;, &apos;false&apos;]
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) +
            &apos; | expected=boolean | expectedSource=接口契约(live_equity=0未执行recompute) | 差值=N/A | 相差百分比=N/A&apos; +
            &apos; | 计算过程=未执行重算时该标志只校验类型，不伪造DB值&apos; +
            &apos; | 备注=&apos; + (same ? &apos;布尔类型合法，通过&apos; : &apos;不是布尔值，失败&apos;)
        if (same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    if (liveEquity == &apos;0&apos; &amp;&amp; liveEquityDisabledExpected.containsKey(normalizedField)) {
        Object contractValue = liveEquityDisabledExpected[normalizedField]
        Map result = compareValue(field, apiValue, contractValue, &apos;接口契约&apos;, BigDecimal.ZERO)
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + result.apiPrint + &apos; | expected=&apos; + result.expectedPrint +
            &apos; | expectedSource=接口契约(live_equity=0) | 差值=&apos; + result.diff + &apos; | 相差百分比=&apos; + result.percent +
            &apos; | 计算过程=&apos; + result.formula + &apos; | 备注=&apos; + result.note
        if (result.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    if (liveEquity == &apos;0&apos; &amp;&amp; recomputeAmountFields.contains(normalizedField)) {
        Map result = compareValue(field, apiValue, null, &apos;接口契约&apos;, BigDecimal.ZERO)
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + result.apiPrint + &apos; | expected=&apos; + result.expectedPrint +
            &apos; | expectedSource=接口契约(live_equity=0不执行Broker Recompute) | 差值=&apos; + result.diff +
            &apos; | 相差百分比=&apos; + result.percent + &apos; | 计算过程=&apos; + result.formula + &apos; | 备注=&apos; + result.note
        if (result.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    // 最新OpenAPI：Floating/Storage是MT5 broker_live原始字段；MT4或SHM路径必须允许为空。
    if (dataSource != &apos;broker_live&apos; &amp;&amp; normalizedField in [&apos;floating&apos;, &apos;storage&apos;, &apos;floatingreporting&apos;, &apos;storagereporting&apos;]) {
        Map result = compareValue(field, apiValue, null, &apos;接口契约&apos;, BigDecimal.ZERO)
        String line = &apos;field=&apos; + field + &apos; | API=&apos; + result.apiPrint + &apos; | expected=&apos; + result.expectedPrint +
            &apos; | expectedSource=接口契约(_data_source=&apos; + (dataSource ?: &apos;&lt;empty&gt;&apos;) + &apos;) | 差值=&apos; + result.diff +
            &apos; | 相差百分比=&apos; + result.percent + &apos; | 计算过程=&apos; + result.formula +
            &apos; | 备注=&apos; + result.note + &apos;；SHM路径不拿DB账户Floating/Storage冒充接口原始字段&apos;
        if (result.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        return
    }

    String expectedKey = directExpectedKey
    Object expectedValue = directExpectedValue
    String reportingNativeField = reportingNativeFields[normalizedField]

    if (reportingNativeField != null) {
        String nativeKey = findKey(expected, reportingNativeField)
        if (nativeKey == null) {
            String message = &apos;field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) + &apos; | &apos; + sourceName + &apos;=&lt;empty&gt;&apos; +
                &apos; | APIField=&apos; + field + &apos; | &apos; + sourceName + &apos;Field=&lt;not present:&apos; + reportingNativeField + &apos;&gt;&apos; +
                &apos; | 差值=N/A | 相差百分比=N/A | 计算过程=reporting字段必须先取得原生字段&apos; + reportingNativeField +
                &apos; | 备注=&apos; + (dbMode ? &apos;数据库无此字段，失败；可配置跳过&apos; : &apos;CSV无此字段，失败；可配置跳过&apos;)
            failLines &lt;&lt; &apos; - [失败] | &apos; + message
            return
        }
        expectedKey = &apos;derived_&apos; + reportingNativeField + &apos;_reporting&apos;
        Object nativeValue = expected[nativeKey]
        if (reportingScale == null) {
            expectedValue = null
        } else if (blank(nativeValue)) {
            expectedValue = null
        } else {
            BigDecimal nativeNumber = asNum(nativeValue)
            if (nativeNumber == null) {
                failLines &lt;&lt; &apos; - [失败] | field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) +
                    &apos; | &apos; + sourceName + &apos;=&apos; + renderValue(reportingNativeField, nativeValue) +
                    &apos; | &apos; + sourceName + &apos;Field=&apos; + nativeKey + &apos; | 备注=原生字段不是数值，无法计算reporting字段&apos;
                return
            }
            expectedValue = nativeNumber.divide(reportingScale, 12, RoundingMode.HALF_UP)
        }
    } else if (normalizedField == &apos;moneyunit&apos;) {
        expectedKey = &apos;derived_money_unit&apos;; expectedValue = &apos;native&apos;
    } else if (normalizedField == &apos;moneyscale&apos;) {
        if (currencyKey == null) expectedKey = null
        else { expectedKey = &apos;derived_money_scale&apos;; expectedValue = reportingScale }
    } else if (normalizedField == &apos;iscent&apos;) {
        if (currencyKey == null) expectedKey = null
        else { expectedKey = &apos;derived_is_cent&apos;; expectedValue = reportingScale == null ? null : nativeCurrency == &apos;USC&apos; }
    } else if (normalizedField == &apos;reportingcurrency&apos;) {
        expectedKey = &apos;derived_reporting_currency&apos;; expectedValue = &apos;USD&apos;
    } else if (normalizedField == &apos;normalizationcomplete&apos;) {
        if (currencyKey == null) expectedKey = null
        else { expectedKey = &apos;derived_normalization_complete&apos;; expectedValue = reportingScale != null }
    }

    if (expectedKey == null) {
        String message = &apos;field=&apos; + field + &apos; | API=&apos; + renderValue(field, apiValue) + &apos; | &apos; + sourceName + &apos;=&lt;empty&gt;&apos; +
            &apos; | APIField=&apos; + field + &apos; | &apos; + sourceName + &apos;Field=&lt;not present&gt;&apos; +
            &apos; | 差值=N/A | 相差百分比=N/A | 计算过程=检查查询结果/CSV表头是否包含该字段&apos; +
            &apos; | 备注=&apos; + (dbMode ? &apos;数据库无此字段，失败；可配置跳过&apos; : &apos;CSV无此字段，失败；可配置跳过&apos;)
        failLines &lt;&lt; &apos; - [失败] | &apos; + message
        return
    }

    BigDecimal tolerance = toleranceFor(field, toleranceMap)
    Map result = compareValue(field, apiValue, expectedValue, sourceName, tolerance)
    String line = &apos;field=&apos; + field + &apos; | API=&apos; + result.apiPrint + &apos; | &apos; + sourceName + &apos;=&apos; + result.expectedPrint +
        &apos; | APIField=&apos; + field + &apos; | &apos; + sourceName + &apos;Field=&apos; + expectedKey +
        &apos; | 字段误差=&apos; + fmtNum(tolerance) + &apos;% | 差值=&apos; + result.diff + &apos; | 相差百分比=&apos; + result.percent +
        &apos; | 计算过程=&apos; + result.formula + &apos; | 备注=&apos; + result.note
    if (result.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
}

String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
List&lt;String&gt; report = []
report &lt;&lt; &apos;Assertion message: 获取用户信息 &apos; + compareModeText + &apos; 字段对比结果 | status=&apos; + status +
    &apos; | case=&apos; + vars.get(&apos;user_info_case_index_display&apos;) + &apos;/&apos; + vars.get(&apos;user_info_case_total&apos;) +
    &apos; | CSV行=&apos; + vars.get(&apos;user_info_csv_line_no&apos;) + &apos; | shujuku=&apos; + shujuku
report &lt;&lt; &apos;接口: GET /crm20/get_user_info?instanceid=&apos; + instanceId + &apos;&amp;login=&apos; + login + &apos;&amp;live_equity=&apos; + liveEquity
report &lt;&lt; &apos;匹配依据: login=&apos; + login + &apos; | platform=&apos; + platform + &apos; | source=&apos; + sourceName + &apos; | _data_source=&apos; + (dataSource ?: &apos;&lt;empty&gt;&apos;)
report &lt;&lt; &apos;跳过字段配置: &apos; + disabledConfigName + &apos;=[&apos; + disabledRaw + &apos;]&apos;
report &lt;&lt; &apos;字段误差配置: &apos; + toleranceConfigName + &apos;=[&apos; + toleranceRaw + &apos;]；格式 field=percent，逗号分隔；未配置数值字段默认0%&apos;
report &lt;&lt; &apos;数值规则: 以&apos; + sourceName + &apos;绝对值为基准，abs((&apos; + sourceName + &apos;-API)/abs(&apos; + sourceName + &apos;))*100；误差小于等于字段配置值通过&apos;
report &lt;&lt; &apos;空值规则: API与&apos; + sourceName + &apos;均为空通过；字段存在且API=0、&apos; + sourceName + &apos;为空通过；&apos; + sourceName + &apos;根本无字段则失败（可人工跳过）&apos;
report &lt;&lt; &apos;接口契约规则: live_equity=0不把Broker运行状态/超时配置伪造成DB列；SHM路径Floating/Storage及其reporting允许为空；_meta按JSON语义比较&apos;
report &lt;&lt; &apos;DB动态财务规则: MT4/MT5均从活动持仓聚合价格浮盈和Swap；Commission从MT4活动交易或MT5活动持仓关联成交聚合；profit=价格浮盈+swap+commission&apos;
report &lt;&lt; &apos;对比统计: API字段总数=&apos; + apiFieldTotal + &apos; | 成功字段=&apos; + okLines.size() + &apos; | 失败字段=&apos; + failLines.size() + &apos; | 跳过字段=&apos; + skipLines.size()
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败字段明细：&apos; + failLines.size() + &apos;条】&apos;
report.addAll(failLines ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细：&apos; + okLines.size() + &apos;条】&apos;
report.addAll(okLines ?: [&apos; - 无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细：&apos; + skipLines.size() + &apos;条】&apos;
report.addAll(skipLines ?: [&apos; - 无&apos;])

String finalReport = report.join(&apos;\n&apos;)
vars.put(&apos;user_info_compare_report&apos;, finalReport)
vars.put(&apos;user_info_compare_status&apos;, status)

if (status == &apos;PASS&apos;) {
    prev.setResponseMessage(&apos;获取用户信息字段对比成功 | 成功=&apos; + okLines.size() + &apos; | 跳过=&apos; + skipLines.size())
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;获取用户信息字段对比失败 | 失败=&apos; + failLines.size() + &apos; | 成功=&apos; + okLines.size() + &apos; | 跳过=&apos; + skipLines.size())
}
log.info(&apos;\n&apos; + finalReport)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
