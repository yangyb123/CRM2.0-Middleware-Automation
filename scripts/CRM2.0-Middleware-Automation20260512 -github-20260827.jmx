          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname=" 断言 ${login_val}" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def expectedLogin = vars.get(&quot;login_val&quot;)

def allMatch = json.data.every { item -&gt;

    // 忽略字段名大小写
    def actualLogin = item.find { k, v -&gt;
        k.equalsIgnoreCase(&quot;login&quot;)
    }?.value

    actualLogin?.toString() == expectedLogin
}

if (!allMatch) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;存在 login 字段值不等于 ${expectedLogin} 的数据&quot;)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取用户信息所有字段值" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)
def data = json.data[0]
def instanceId = vars.get(&quot;instanceid_val&quot;)

if (instanceId == &quot;MT5_1&quot;) {
    // MT5 字段提取（首字母大写）
    vars.put(&quot;Login&quot;,            data.Login?.toString() ?: &quot;&quot;)
    vars.put(&quot;Balance&quot;,          data.Balance?.toString() ?: &quot;&quot;)
    vars.put(&quot;Equity&quot;,           data.Equity?.toString() ?: &quot;&quot;)
    vars.put(&quot;Margin&quot;,           data.Margin?.toString() ?: &quot;&quot;)
    vars.put(&quot;MarginFree&quot;,       data.MarginFree?.toString() ?: &quot;&quot;)
    vars.put(&quot;MarginLevel&quot;,      data.MarginLevel?.toString() ?: &quot;&quot;)
    vars.put(&quot;Profit&quot;,           data.Profit?.toString() ?: &quot;&quot;)
    vars.put(&quot;Credit&quot;,           data.Credit?.toString() ?: &quot;&quot;)
    vars.put(&quot;Leverage&quot;,         data.Leverage?.toString() ?: &quot;&quot;)
    vars.put(&quot;SwapTotal&quot;,        data.SwapTotal?.toString() ?: &quot;&quot;)
    vars.put(&quot;CommissionTotal&quot;,  data.CommissionTotal?.toString() ?: &quot;&quot;)
    vars.put(&quot;Name&quot;,             data.Name?.toString() ?: &quot;&quot;)
    vars.put(&quot;EMail&quot;,            data.EMail?.toString() ?: &quot;&quot;)
    vars.put(&quot;Phone&quot;,            data.Phone?.toString() ?: &quot;&quot;)
    vars.put(&quot;Country&quot;,          data.Country?.toString() ?: &quot;&quot;)
    vars.put(&quot;City&quot;,             data.City?.toString() ?: &quot;&quot;)
    vars.put(&quot;Address&quot;,          data.Address?.toString() ?: &quot;&quot;)
    vars.put(&quot;State&quot;,            data.State?.toString() ?: &quot;&quot;)
    vars.put(&quot;ZIPCode&quot;,          data.ZIPCode?.toString() ?: &quot;&quot;)
    vars.put(&quot;Comment&quot;,          data.Comment?.toString() ?: &quot;&quot;)
    vars.put(&quot;Rights&quot;,           data.Rights?.toString() ?: &quot;&quot;)
    vars.put(&quot;Status&quot;,           data.Status?.toString() ?: &quot;&quot;)
    vars.put(&quot;Agent&quot;,            data.Agent?.toString() ?: &quot;&quot;)
    vars.put(&quot;MQID&quot;,             data.MQID?.toString() ?: &quot;&quot;)
    vars.put(&quot;LastAccess&quot;,       data.LastAccess?.toString() ?: &quot;&quot;)
    vars.put(&quot;Registration&quot;,     data.Registration?.toString() ?: &quot;&quot;)
    vars.put(&quot;Color&quot;,            data.Color?.toString() ?: &quot;&quot;)
    vars.put(&quot;DataSource&quot;,       data.DataSource?.toString() ?: &quot;&quot;)
    vars.put(&quot;ID&quot;,               data.ID?.toString() ?: &quot;&quot;)
    vars.put(&quot;LastIP&quot;,           data.LastIP?.toString() ?: &quot;&quot;)
    // Group 是嵌套对象，单独拆开
    def groupVal = data.Group?.Group?.toString() ?: &quot;&quot;
    vars.put(&quot;Group&quot;,            groupVal)
    vars.put(&quot;GroupEscaped&quot;,     groupVal.replace(&quot;\\&quot;, &quot;\\\\&quot;))
    log.info(&quot;&gt;&gt;&gt; Group=[&quot; + vars.get(&quot;Group&quot;) + &quot;] GroupEscaped=[&quot; + vars.get(&quot;GroupEscaped&quot;) + &quot;]&quot;)
    vars.put(&quot;Currency&quot;,         data.Group?.Currency?.toString() ?: &quot;&quot;)
    vars.put(&quot;GroupMarginCall&quot;,  data.Group?.MarginCall?.toString() ?: &quot;&quot;)
    vars.put(&quot;GroupMarginStopOut&quot;, data.Group?.MarginStopOut?.toString() ?: &quot;&quot;)
    // Broker 相关
    vars.put(&quot;BrokerErrorCode&quot;,        data.BrokerErrorCode?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerErrorMessage&quot;,     data.BrokerErrorMessage?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerErrorPlatform&quot;,    data.BrokerErrorPlatform?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerAttempted&quot;,        data.BrokerAttempted?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerTimedOut&quot;,         data.BrokerTimedOut?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerTimeoutMs&quot;,        data.BrokerTimeoutMs?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerAcquireTimeoutMs&quot;, data.BrokerAcquireTimeoutMs?.toString() ?: &quot;&quot;)
    vars.put(&quot;BrokerFailedOther&quot;,      data.BrokerFailedOther?.toString() ?: &quot;&quot;)
    
    log.info(&quot;MT5 data extracted, Login=&quot; + vars.get(&quot;Login&quot;))
    
    // ====== 记录已提取字段名 + 动态提取新增字段 ======
    def extractedUserFields = [
        &quot;Login&quot;,&quot;Balance&quot;,&quot;Equity&quot;,&quot;Margin&quot;,&quot;MarginFree&quot;,&quot;MarginLevel&quot;,
        &quot;Profit&quot;,&quot;Credit&quot;,&quot;Leverage&quot;,&quot;SwapTotal&quot;,&quot;CommissionTotal&quot;,
        &quot;Name&quot;,&quot;EMail&quot;,&quot;Phone&quot;,&quot;Country&quot;,&quot;City&quot;,&quot;Address&quot;,&quot;State&quot;,&quot;ZIPCode&quot;,
        &quot;Comment&quot;,&quot;Rights&quot;,&quot;Status&quot;,&quot;Agent&quot;,&quot;MQID&quot;,&quot;LastAccess&quot;,&quot;Registration&quot;,
        &quot;Color&quot;,&quot;DataSource&quot;,&quot;ID&quot;,&quot;LastIP&quot;,&quot;Group&quot;,&quot;GroupEscaped&quot;,
        &quot;Currency&quot;,&quot;GroupMarginCall&quot;,&quot;GroupMarginStopOut&quot;,
        &quot;BrokerErrorCode&quot;,&quot;BrokerErrorMessage&quot;,&quot;BrokerErrorPlatform&quot;,
        &quot;BrokerAttempted&quot;,&quot;BrokerTimedOut&quot;,&quot;BrokerTimeoutMs&quot;,
        &quot;BrokerAcquireTimeoutMs&quot;,&quot;BrokerFailedOther&quot;
    ]
    // 动态提取data中尚未显式提取的字段（新增字段）
    data.each { k, v -&gt;
        def key = k.toString()
        if (!(v instanceof Map) &amp;&amp; vars.get(key) == null) {
            vars.put(key, v?.toString() ?: &quot;&quot;)
            extractedUserFields &lt;&lt; key
            log.info(&quot;MT5 新增字段提取: {} = {}&quot;, key, v)
        }
    }
    vars.put(&quot;extracted_user_fields&quot;, extractedUserFields.unique().join(&quot;,&quot;))
    log.info(&quot;MT5 用户信息字段列表：{}&quot;, extractedUserFields.unique())
    
} else if (instanceId == &quot;MT4_1&quot;) {
    // MT4 字段提取（全小写）
    vars.put(&quot;login&quot;,            data.login?.toString() ?: &quot;&quot;)
    vars.put(&quot;balance&quot;,          data.balance?.toString() ?: &quot;&quot;)
    vars.put(&quot;equity&quot;,           data.equity?.toString() ?: &quot;&quot;)
    vars.put(&quot;margin&quot;,           data.margin?.toString() ?: &quot;&quot;)
    vars.put(&quot;margin_free&quot;,      data.margin_free?.toString() ?: &quot;&quot;)
    vars.put(&quot;margin_level&quot;,     data.margin_level?.toString() ?: &quot;&quot;)
    vars.put(&quot;margin_call&quot;,      data.margin_call?.toString() ?: &quot;&quot;)
    vars.put(&quot;margin_stopout&quot;,   data.margin_stopout?.toString() ?: &quot;&quot;)
    vars.put(&quot;profit&quot;,           data.profit?.toString() ?: &quot;&quot;)
    vars.put(&quot;credit&quot;,           data.credit?.toString() ?: &quot;&quot;)
    vars.put(&quot;leverage&quot;,         data.leverage?.toString() ?: &quot;&quot;)
    vars.put(&quot;swap_total&quot;,       data.swap_total?.toString() ?: &quot;&quot;)
    vars.put(&quot;commission_total&quot;, data.commission_total?.toString() ?: &quot;&quot;)
    vars.put(&quot;name&quot;,             data.name?.toString() ?: &quot;&quot;)
    vars.put(&quot;email&quot;,            data.email?.toString() ?: &quot;&quot;)
    vars.put(&quot;phone&quot;,            data.phone?.toString() ?: &quot;&quot;)
    vars.put(&quot;country&quot;,          data.country?.toString() ?: &quot;&quot;)
    vars.put(&quot;city&quot;,             data.city?.toString() ?: &quot;&quot;)
    vars.put(&quot;address&quot;,          data.address?.toString() ?: &quot;&quot;)
    vars.put(&quot;state&quot;,            data.state?.toString() ?: &quot;&quot;)
    vars.put(&quot;id&quot;,               data.id?.toString() ?: &quot;&quot;)
    vars.put(&quot;group&quot;,            data.group?.toString() ?: &quot;&quot;)
    vars.put(&quot;currency&quot;,         data.currency?.toString() ?: &quot;&quot;)
    vars.put(&quot;comment&quot;,          data.comment?.toString() ?: &quot;&quot;)
    vars.put(&quot;rights&quot;,           data.rights?.toString() ?: &quot;&quot;)
    vars.put(&quot;status&quot;,           data.status?.toString() ?: &quot;&quot;)
    vars.put(&quot;enable&quot;,           data.enable?.toString() ?: &quot;&quot;)
    vars.put(&quot;enable_otp&quot;,       data.enable_otp?.toString() ?: &quot;&quot;)
    vars.put(&quot;enable_change_password&quot;, data.enable_change_password?.toString() ?: &quot;&quot;)
    vars.put(&quot;enable_read_only&quot;, data.enable_read_only?.toString() ?: &quot;&quot;)
    vars.put(&quot;send_reports&quot;,     data.send_reports?.toString() ?: &quot;&quot;)
    vars.put(&quot;agent_account&quot;,    data.agent_account?.toString() ?: &quot;&quot;)
    vars.put(&quot;interestrate&quot;,     data.interestrate?.toString() ?: &quot;&quot;)
    vars.put(&quot;taxes&quot;,            data.taxes?.toString() ?: &quot;&quot;)
    vars.put(&quot;registration&quot;,     data.registration?.toString() ?: &quot;&quot;)
    vars.put(&quot;last_access&quot;,      data.last_access?.toString() ?: &quot;&quot;)
    vars.put(&quot;prevbalance&quot;,      data.prevbalance?.toString() ?: &quot;&quot;)
    vars.put(&quot;prevequity&quot;,       data.prevequity?.toString() ?: &quot;&quot;)
    vars.put(&quot;prevmonthbalance&quot;, data.prevmonthbalance?.toString() ?: &quot;&quot;)
    vars.put(&quot;prevmonthequity&quot;,  data.prevmonthequity?.toString() ?: &quot;&quot;)
    vars.put(&quot;timestamp&quot;,        data.timestamp?.toString() ?: &quot;&quot;)
    vars.put(&quot;data_source&quot;,      data.data_source?.toString() ?: &quot;&quot;)
    // Broker 相关
    vars.put(&quot;broker_error_code&quot;,         data.broker_error_code?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_error_message&quot;,      data.broker_error_message?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_error_platform&quot;,     data.broker_error_platform?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_attempted&quot;,          data.broker_attempted?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_timed_out&quot;,          data.broker_timed_out?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_timeout_ms&quot;,         data.broker_timeout_ms?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_acquire_timeout_ms&quot;, data.broker_acquire_timeout_ms?.toString() ?: &quot;&quot;)
    vars.put(&quot;broker_failed_other&quot;,       data.broker_failed_other?.toString() ?: &quot;&quot;)
    
    log.info(&quot;MT4 data extracted, login=&quot; + vars.get(&quot;login&quot;))
    
    // ====== 记录已提取字段名 + 动态提取新增字段 ======
    def extractedUserFields2 = [
        &quot;login&quot;,&quot;balance&quot;,&quot;equity&quot;,&quot;margin&quot;,&quot;margin_free&quot;,&quot;margin_level&quot;,
        &quot;margin_call&quot;,&quot;margin_stopout&quot;,&quot;profit&quot;,&quot;credit&quot;,&quot;leverage&quot;,
        &quot;swap_total&quot;,&quot;commission_total&quot;,&quot;name&quot;,&quot;email&quot;,&quot;phone&quot;,
        &quot;country&quot;,&quot;city&quot;,&quot;address&quot;,&quot;state&quot;,&quot;id&quot;,&quot;group&quot;,&quot;currency&quot;,
        &quot;comment&quot;,&quot;rights&quot;,&quot;status&quot;,&quot;enable&quot;,&quot;enable_otp&quot;,
        &quot;enable_change_password&quot;,&quot;enable_read_only&quot;,&quot;send_reports&quot;,
        &quot;agent_account&quot;,&quot;interestrate&quot;,&quot;taxes&quot;,&quot;registration&quot;,
        &quot;last_access&quot;,&quot;prevbalance&quot;,&quot;prevequity&quot;,&quot;prevmonthbalance&quot;,
        &quot;prevmonthequity&quot;,&quot;timestamp&quot;,&quot;data_source&quot;,
        &quot;broker_error_code&quot;,&quot;broker_error_message&quot;,&quot;broker_error_platform&quot;,
        &quot;broker_attempted&quot;,&quot;broker_timed_out&quot;,&quot;broker_timeout_ms&quot;,
        &quot;broker_acquire_timeout_ms&quot;,&quot;broker_failed_other&quot;
    ]
    // 动态提取data中尚未显式提取的字段（新增字段）
    data.each { k, v -&gt;
        def key = k.toString()
        if (!(v instanceof Map) &amp;&amp; vars.get(key) == null) {
            vars.put(key, v?.toString() ?: &quot;&quot;)
            extractedUserFields2 &lt;&lt; key
            log.info(&quot;MT4 新增字段提取: {} = {}&quot;, key, v)
        }
    }
    vars.put(&quot;extracted_user_fields&quot;, extractedUserFields2.unique().join(&quot;,&quot;))
    log.info(&quot;MT4 用户信息字段列表：{}&quot;, extractedUserFields2.unique())
    
} else {
    log.warn(&quot;未知 instanceid_val: &quot; + instanceId)
}

// 保存完整API响应用于CSV降级断言
vars.put(&quot;user_api_response&quot;, response)
log.info(&quot;已保存完整用户信息API响应到变量 user_api_response，长度: {}&quot;, response.length())
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="旧前置符号规格和实时报价-已停用-改由list_open_positions响应逐条查询" enabled="false">
          <intProp name="HTTPSampler.connect_timeout">3000</intProp>
          <intProp name="HTTPSampler.response_timeout">5000</intProp>
          <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
          <stringProp name="HTTPSampler.port">${port}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
          <stringProp name="HTTPSampler.path">/crm20/get_symbol_ex?instanceid=${instanceid}&amp;name=${symbol}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-符号规格和实时报价" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.text.SimpleDateFormat

def text = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(text ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + text)
    return
}

List asRows(obj) {
    if (obj == null) return []
    if (obj instanceof List) return obj.findAll { it instanceof Map }
    if (obj instanceof Map) {
        for (k in [&apos;symbols&apos;, &apos;symbol&apos;, &apos;data&apos;, &apos;rows&apos;, &apos;records&apos;, &apos;list&apos;, &apos;items&apos;, &apos;result&apos;, &apos;results&apos;]) {
            def v = obj[k]
            if (v instanceof List) return v.findAll { it instanceof Map }
            if (v instanceof Map) {
                def nested = asRows(v)
                if (nested) return nested
            }
        }
        def firstList = obj.values().find { it instanceof List &amp;&amp; it.any { it instanceof Map } }
        if (firstList instanceof List) return firstList.findAll { it instanceof Map }
        return [obj]
    }
    return []
}

Map rowToMap(row) {
    def out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else {
        try {
            row.metaClass.properties.each { p -&gt;
                if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot;
            }
        } catch (ignored) {}
    }
    return out
}

String normKey(String s) {
    return (s ?: &apos;&apos;).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase()
}

boolean isBlankValue(Object value) {
    if (value == null) return true
    String s = value.toString().trim()
    return s.length() == 0 || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)
}

String readByAliases(Map row, List aliases) {
    for (String alias : aliases) {
        def direct = row.find { k, v -&gt; k?.toString()?.equalsIgnoreCase(alias) }
        if (direct != null) return direct.value
    }
    def wanted = aliases.collect { normKey(it) } as Set
    def normalized = row.find { k, v -&gt; wanted.contains(normKey(k?.toString())) }
    return normalized == null ? null : normalized.value
}

String readField(Map row, String apiField, Map aliases) {
    def names = []
    names.add(apiField)
    if (aliases[apiField]) names.addAll(aliases[apiField])
    return readByAliases(row, names.unique())
}

boolean isTimeField(String field) {
    String k = normKey(field)
    return k.contains(&apos;time&apos;) || k.contains(&apos;utcms&apos;) || k.contains(&apos;updatedutcms&apos;)
}

Long epochMillis(Object value) {
    if (value == null) return null
    if (value instanceof Date) return value.time
    String s = value.toString().trim()
    if (!s) return null
    if (s ==~ /^-?\d+(\.\d+)?$/) {
        BigDecimal n = new BigDecimal(s)
        if (n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &lt; 0) n = n.multiply(new BigDecimal(&apos;1000&apos;))
        return n.longValue()
    }
    return null
}

String fmtDate(Date date, String tzId) {
    SimpleDateFormat sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tzId))
    return sdf.format(date)
}

Map apiTimeView(Object value) {
    Long ms = epochMillis(value)
    if (ms == null) return [raw: String.valueOf(value), display: String.valueOf(value), compare: String.valueOf(value)]
    Date d = new Date(ms)
    return [raw: String.valueOf(value), display: fmtDate(d, &apos;Asia/Shanghai&apos;), compare: fmtDate(d, &apos;UTC&apos;)]
}

Map dbTimeView(Object value) {
    Long ms = epochMillis(value)
    if (ms != null) {
        Date d = new Date(ms)
        String utc = fmtDate(d, &apos;UTC&apos;)
        return [raw: String.valueOf(value), display: utc, compare: utc]
    }
    if (value instanceof Date) {
        String out = fmtDate(value, &apos;UTC&apos;)
        return [raw: String.valueOf(value), display: out, compare: out]
    }
    String s = value == null ? &apos;&apos; : value.toString().trim()
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    s = s.replaceAll(/\.\d+$/, &apos;&apos;)
    if (s.length() &gt;= 19) s = s.substring(0, 19)
    return [raw: String.valueOf(value), display: s, compare: s]
}

BigDecimal decimalOrNull(Object value) {
    if (value == null) return null
    String s = value.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;null&apos;)) return null
    if (!(s ==~ /^-?\d+(\.\d+)?$/)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}

boolean valuesEqual(Object apiValue, Object expectedValue, String field) {
    if (isTimeField(field)) {
        return apiTimeView(apiValue).compare == dbTimeView(expectedValue).compare
    }
    if (isBlankValue(apiValue) || isBlankValue(expectedValue)) {
        return isBlankValue(apiValue) &amp;&amp; isBlankValue(expectedValue)
    }
    BigDecimal a = decimalOrNull(apiValue)
    BigDecimal b = decimalOrNull(expectedValue)
    if (a != null &amp;&amp; b != null) return a.subtract(b).abs().compareTo(new BigDecimal(&apos;0.000001&apos;)) &lt;= 0
    return apiValue.toString().trim() == expectedValue.toString().trim()
}

String valueLine(String field, Object apiValue, Object expectedValue, String sourceLabel, String sourceField, boolean missingSource) {
    if (isTimeField(field)) {
        def apiT = apiTimeView(apiValue)
        if (missingSource) return &quot;${field}: API=${apiT.raw} (${apiT.display}; 对比UTC=${apiT.compare}) | ${sourceLabel}=&lt;empty&gt; 数据库查询无此字段数据 | ${sourceLabel}字段=${sourceField}&quot;
        def dbT = dbTimeView(expectedValue)
        return &quot;${field}: API=${apiT.raw} (${apiT.display}; 对比UTC=${apiT.compare}) | ${sourceLabel}=${dbT.raw} (${dbT.display}) | ${sourceLabel}字段=${sourceField}&quot;
    }
    if (missingSource) return &quot;${field}: API=${apiValue} | ${sourceLabel}=&lt;empty&gt; 数据库查询无此字段数据 | ${sourceLabel}字段=${sourceField}&quot;
    return &quot;${field}: API=${apiValue} | ${sourceLabel}=${expectedValue} | ${sourceLabel}字段=${sourceField}&quot;
}

Set disabledSet(String raw) {
    return ((raw ?: &apos;&apos;).split(/[，,\s]+/).findAll { it?.trim() }.collect { normKey(it.trim()) }) as Set
}

def aliases = [
    &apos;updated_utc_ms&apos;       : [&apos;updated_utc_ms&apos;, &apos;Timestamp&apos;, &apos;MODIFY_TIME&apos;],
    &apos;quote_updated_utc_ms&apos; : [&apos;quote_updated_utc_ms&apos;, &apos;Time&apos;, &apos;TIME&apos;],
    &apos;currency_base&apos;        : [&apos;currency_base&apos;, &apos;CurrencyBase&apos;],
    &apos;currency_margin&apos;      : [&apos;currency_margin&apos;, &apos;CurrencyMargin&apos;],
    &apos;profit_mode&apos;          : [&apos;profit_mode&apos;, &apos;CalcMode&apos;],
    &apos;tick_size&apos;            : [&apos;tick_size&apos;, &apos;TickSize&apos;],
    &apos;currency_profit&apos;      : [&apos;currency_profit&apos;, &apos;CurrencyProfit&apos;],
    &apos;trade_mode&apos;           : [&apos;trade_mode&apos;, &apos;TradeMode&apos;],
    &apos;ask&apos;                  : [&apos;ask&apos;, &apos;AskLast&apos;, &apos;ASK&apos;],
    &apos;name&apos;                 : [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;symbol_val&apos;, &apos;order_symbol&apos;],
    &apos;digits&apos;               : [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;contract_size&apos;        : [&apos;contract_size&apos;, &apos;ContractSize&apos;],
    &apos;bid&apos;                  : [&apos;bid&apos;, &apos;BidLast&apos;, &apos;BID&apos;],
    &apos;tick_value&apos;           : [&apos;tick_value&apos;, &apos;TickValue&apos;]
]

String shujuku = vars.get(&apos;symbol_ex_check_shujuku&apos;) ?: (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = vars.get(&apos;symbol_ex_check_instanceid&apos;) ?: (vars.get(&apos;instanceid_val&apos;) ?: &apos;&apos;).trim()
String platform = vars.get(&apos;symbol_ex_check_db_platform&apos;) ?: &apos;&apos;
String expectedSymbol = vars.get(&apos;symbol_ex_check_symbol&apos;) ?: (vars.get(&apos;symbol_val&apos;) ?: vars.get(&apos;name&apos;) ?: &apos;&apos;).trim()
String compareSource = shujuku == &apos;1&apos; ? &apos;DB/API&apos; : &apos;CSV/API&apos;
String disabledConfigName
String disabledRaw
if (shujuku == &apos;1&apos;) {
    if (platform == &apos;MT4&apos;) {
        disabledConfigName = &apos;symbol_ex_mt4_disabled_compare_fields&apos;
        disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
    } else if (platform == &apos;MT5&apos;) {
        disabledConfigName = &apos;symbol_ex_mt5_disabled_compare_fields&apos;
        disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
    } else {
        disabledConfigName = &apos;symbol_ex_unknown_disabled_compare_fields&apos;
        disabledRaw = &apos;&apos;
    }
} else {
    disabledConfigName = &apos;symbol_ex_csv_disabled_compare_fields&apos;
    disabledRaw = vars.get(disabledConfigName) ?: &apos;&apos;
}
Set disabled = disabledSet(disabledRaw)

def apiRows = asRows(parsed).collect { rowToMap(it) }
def apiRow = apiRows.find {
    String.valueOf(readByAliases(it, [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;, &apos;symbol_val&apos;])).equalsIgnoreCase(expectedSymbol)
}
if (apiRow == null &amp;&amp; apiRows.size() == 1) apiRow = apiRows[0]

if (apiRow == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;接口响应中没有匹配的品种 name/symbol=${expectedSymbol}，接口返回记录数=${apiRows.size()}&quot;)
    return
}

Map sourceRow = new LinkedHashMap()
String sourceLabel = shujuku == &apos;1&apos; ? &apos;DB&apos; : &apos;CSV&apos;
if (shujuku == &apos;1&apos;) {
    def dbRows = (vars.getObject(&apos;db_symbol_ex_check_rows&apos;) ?: []).collect { rowToMap(it) }
    sourceRow = dbRows.find {
        String.valueOf(readByAliases(it, [&apos;name&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;])).equalsIgnoreCase(expectedSymbol)
    }
    if (sourceRow == null &amp;&amp; dbRows.size() == 1) sourceRow = dbRows[0]
    if (sourceRow == null) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;数据库没有查询到匹配品种: instanceid=${instanceId}, symbol=${expectedSymbol}, DB记录数=${dbRows.size()}&quot;)
        return
    }
} else {
    aliases.keySet().each { field -&gt;
        def csvVal = vars.get(field)
        if (csvVal == null &amp;&amp; field == &apos;name&apos;) csvVal = expectedSymbol
        sourceRow[field] = csvVal
    }
    sourceRow[&apos;symbol_val&apos;] = expectedSymbol
    sourceRow[&apos;order_instanceid_val&apos;] = instanceId
}

int apiFieldTotal = apiRow.keySet().size()
def ok = []
def bad = []
def skipped = []

apiRow.each { field, apiValue -&gt;
    String fieldKey = normKey(field)
    if (disabled.contains(fieldKey)) {
        skipped &lt;&lt; valueLine(field, apiValue, readField(sourceRow, field, aliases), sourceLabel, field, false)
        return
    }

    Object expectedValue = readField(sourceRow, field, aliases)
    String matchedSourceField = field
    if (isBlankValue(expectedValue)) {
        def match = sourceRow.find { k, v -&gt;
            !isBlankValue(v) &amp;&amp; ([field] + (aliases[field] ?: [])).collect { normKey(it) }.contains(normKey(k?.toString()))
        }
        if (match != null) {
            expectedValue = match.value
            matchedSourceField = match.key
        }
    } else {
        def match = sourceRow.find { k, v -&gt;
            v == expectedValue &amp;&amp; ([field] + (aliases[field] ?: [])).collect { normKey(it) }.contains(normKey(k?.toString()))
        }
        if (match != null) matchedSourceField = match.key
    }

    if (shujuku == &apos;0&apos; &amp;&amp; isBlankValue(expectedValue)) {
        skipped &lt;&lt; &quot;${field}: API=${apiValue} | CSV=&lt;empty&gt; CSV未填写此字段数据 | CSV字段=${matchedSourceField}&quot;
        return
    }

    if (shujuku == &apos;1&apos; &amp;&amp; isBlankValue(expectedValue)) {
        bad &lt;&lt; valueLine(field, apiValue, expectedValue, sourceLabel, matchedSourceField, true)
        return
    }

    String line = valueLine(field, apiValue, expectedValue, sourceLabel, matchedSourceField, false)
    if (valuesEqual(apiValue, expectedValue, field)) {
        ok &lt;&lt; line
    } else {
        bad &lt;&lt; line
    }
}

def reportLines = []
reportLines &lt;&lt; &apos;============================================================&apos;
reportLines &lt;&lt; &quot;符号规格和实时报价 ${compareSource} 字段对比结果&quot;
reportLines &lt;&lt; &quot;状态: ${bad.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;} | instanceid=${instanceId} | symbol=${expectedSymbol} | platform=${platform} | shujuku=${shujuku}&quot;
reportLines &lt;&lt; &quot;接口对比字段总数量: ${apiFieldTotal} | 成功字段数量: ${ok.size()} | 失败字段数量: ${bad.size()} | 跳过字段(未校验)数量: ${skipped.size()}&quot;
reportLines &lt;&lt; &quot;当前跳过字段配置: ${disabledConfigName}=${disabledRaw?.trim() ? disabledRaw : &apos;&lt;empty&gt;&apos;}&quot;
reportLines &lt;&lt; &apos;============================================================&apos;
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;成功字段（${ok.size()}）：&quot;
reportLines.addAll(ok ? ok.collect { &apos; [成功] &apos; + it } : [&apos; - 无&apos;])
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;失败字段（${bad.size()}）：&quot;
reportLines.addAll(bad ? bad.collect { &apos; [失败] &apos; + it } : [&apos; - 无&apos;])
reportLines &lt;&lt; &apos;&apos;
reportLines &lt;&lt; &quot;跳过字段（未校验）（${skipped.size()}）：&quot;
reportLines.addAll(skipped ? skipped.collect { &apos; [跳过] &apos; + it } : [&apos; - 无&apos;])

String report = reportLines.join(&apos;\n&apos;)
vars.put(&apos;symbol_ex_compare_report&apos;, report)

try {
    SampleResult detail = new SampleResult()
    detail.setSampleLabel(&quot;符号规格和实时报价 ${compareSource} 字段对比结果&quot;)
    detail.setDataType(SampleResult.TEXT)
    detail.sampleStart()
    detail.setResponseCode(bad.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(bad.isEmpty() ? &quot;${compareSource} compare passed&quot; : &quot;${compareSource} compare failed&quot;)
    detail.setSuccessful(bad.isEmpty())
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    detail.setResponseData(report, &apos;UTF-8&apos;)
    detail.sampleEnd()
    prev.addSubResult(detail)
} catch (Throwable e) {
    log.warn(&apos;Add symbol_ex compare detail failed: &apos; + e.message, e)
}

if (bad) {
    log.warn(report)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(report)
} else {
    log.info(report)
    AssertionResult.setFailure(false)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="TestPlan.comments">shujuku=1: DB/API字段对比；shujuku=0: CSV/API字段对比。两套跳过字段配置相互独立。输出接口字段总数、成功/失败/跳过数量和值；API/CSV时间戳按UTC+8显示，再按UTC与DB时间比较。</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="20查询多个账户的当前持仓订单事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-查询多个账户当前持仓" enabled="false">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./查询多个账户的当前持仓订单.csv</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames">shujuku,instanceid,login,page,page_size,filter_order_ticket,filter_position_ticket,filter_deal_ticket,filter_symbol,order_types,open_time_from_utc_ms,open_time_to_utc_ms,volume_lots_condition,volume_lots_value,floating_pl,sort_by,sort_order,reason,symbol,position_ticket,updated_utc_ms,fee,open_time_utc_ms,price_open,margin_rate,source,price_sl,commission,digits_currency,state,order_type,profit,price_current,volume_lots,side,swap,deal_ticket,price_tp,order_ticket,instance_id,net_profit,comment,digits,contract_size,db_result_max_rows</stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户当前持仓DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="open_positions_db_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">open_positions_db_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">comment,updated_utc_ms,contract_size,net_profit_reporting,net_profit,profit,profit_reporting</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段跳过配置；同时控制summary和当前页明细；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
              <elementProp name="open_positions_db_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">open_positions_db_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,net_profit=50,cent_volume=1,total_volume=1,standard_volume=1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">DB/API字段百分比误差配置；支持 field=20、field:20、field 20、field=20%、field,20 等输入；多个字段可用逗号/分号/空格/换行分隔；未配置字段默认10；0表示必须完全相等。</stringProp>
              </elementProp>
              <elementProp name="open_positions_aux_profit_calc_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">open_positions_aux_profit_calc_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">辅助接口profit计算/API字段跳过配置；多个字段用英文逗号分隔，例如 profit,profit_reporting；profit_reporting/calc_profit_reporting/API_profit_reporting视为同一字段；* 表示跳过全部辅助接口profit计算对比。</stringProp>
              </elementProp>
              <elementProp name="open_positions_aux_profit_calc_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">open_positions_aux_profit_calc_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=10,net_profit_reporting=15</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">辅助接口profit计算/API字段百分比误差配置；支持 profit=20、profit_reporting=10、calc_profit_reporting=10、field:20、field 20、field=20%；profit_reporting/calc_profit_reporting/API_profit_reporting视为同一字段；profit_reporting未配置时默认0%，其他字段未配置时默认10%；误差以calc计算值为分母；不读取DB/API或CSV/API字段误差配置；0表示必须完全相等。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">跳过字段仍由 open_positions_db_api_disabled_compare_fields 控制；字段误差由 open_positions_db_api_field_tolerance_percent 控制，例如 profit=20,net_profit=50,cent_volume=1；DB/API模式只读取 open_positions_db_api_field_tolerance_percent，不再合并 open_positions_csv_api_field_tolerance_percent；未配置字段默认10%；total_volume/standard_volume 默认配置0表示完全相等。
comment,（数据库是中文乱码）updated_utc_ms -接口更新时间   deal_ticket 是 eamon 说用到了  net_profit</stringProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="查询多个账户当前持仓CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="open_positions_csv_api_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">open_positions_csv_api_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value"></stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
              <elementProp name="open_positions_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">open_positions_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">profit=20,net_profit=20,cent_volume=1,total_volume=1,standard_volume=1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段百分比误差配置；支持 field=20、field:20、field 20、field=20%、field,20 等输入；多个字段可用逗号/分号/空格/换行分隔；CSV/API模式直接生效；不参与DB/API模式；未配置字段默认5；0表示必须完全相等。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化查询多个账户当前持仓参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

String csvName = &apos;查询多个账户的当前持仓订单.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) throw new AssertionError(&apos;查询多个账户当前持仓CSV文件不存在: &apos; + csvFile.getPath())
List rawLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
if (rawLines.size() &lt;= 1) throw new AssertionError(&apos;查询多个账户当前持仓CSV没有数据行: &apos; + csvFile.getPath())

def parseCsvLine = { String line -&gt;
    List values = []
    StringBuilder cur = new StringBuilder()
    boolean inQuotes = false
    for (int i = 0; i &lt; line.length(); i++) {
        char c = line.charAt(i)
        if (c == (&apos;&quot;&apos; as char)) {
            if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                cur.append(c)
                i++
            } else {
                inQuotes = !inQuotes
            }
        } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
            values &lt;&lt; cur.toString().trim()
            cur.setLength(0)
        } else {
            cur.append(c)
        }
    }
    values &lt;&lt; cur.toString().trim()
    values
}

List headers = parseCsvLine(rawLines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
List csvRows = []
rawLines.drop(1).eachWithIndex { line, idx -&gt;
    List vals = parseCsvLine(line)
    Map row = [__line_no: idx + 2]
    headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
    if ((row[&apos;shujuku&apos;] ?: &apos;&apos;).toString().trim()) csvRows &lt;&lt; row
}
if (!csvRows) throw new AssertionError(&apos;查询多个账户当前持仓CSV没有有效数据行: &apos; + csvFile.getPath())

def firstValue = { Map row, List names -&gt;
    for (String n : names) {
        Object v = row[n]
        String s = v == null ? &apos;&apos; : v.toString().trim()
        if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
    }
    &apos;&apos;
}

def cleanInt = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replaceAll(/\.0+$/, &apos;&apos;)
    s ==~ /^-?\d+$/ ? s : &apos;&apos;
}

def cleanNumber = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
    s = s.replace(&apos;,&apos;, &apos;&apos;)
    s ==~ /^-?\d+(\.\d+)?$/ ? s : &apos;&apos;
}

def intOrDefault = { Object raw, String defVal -&gt;
    String v = cleanInt(raw)
    v ? v : defVal
}

def sqlQuote = { Object raw -&gt;
    &quot;&apos;&quot; + (raw == null ? &apos;&apos; : raw.toString()).replace(&quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;&quot;
}

def platformOf = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim().toUpperCase()
    s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
}

def splitList = { Object raw -&gt;
    String s = raw == null ? &apos;&apos; : raw.toString().trim()
    if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return []
    s.split(/[，,;|\s]+/).collect { it.trim() }.findAll { it }
}

def opOf = { Object raw -&gt;
    String c = raw == null ? &apos;&apos; : raw.toString().trim().toLowerCase()
    [gte: &apos;&gt;=&apos;, gt: &apos;&gt;&apos;, eq: &apos;=&apos;, lt: &apos;&lt;&apos;, lte: &apos;&lt;=&apos;][c] ?: &apos;&gt;=&apos;
}

def putRowVars = { Map row -&gt;
    headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
}

List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
List runCases = []
if (dbRows) runCases &lt;&lt; [mode: &apos;DB&apos;, row: dbRows[0]]
csvModeRows.each { runCases &lt;&lt; [mode: &apos;CSV&apos;, row: it] }
if (!runCases) throw new AssertionError(&apos;查询多个账户当前持仓CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)

int caseIndex = ((vars.get(&apos;open_positions_case_index&apos;) ?: &apos;0&apos;) as int)
if (caseIndex &gt;= runCases.size()) throw new AssertionError(&apos;查询多个账户当前持仓循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
vars.put(&apos;open_positions_case_index&apos;, String.valueOf(caseIndex + 1))
Map runCase = runCases[caseIndex] as Map
Map currentRow = runCase.row as Map
putRowVars(currentRow)

String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
boolean dbMode = shujuku == &apos;1&apos;
List accountSourceRows = dbMode ? dbRows : [currentRow]
List accounts = []
Set accountKeys = [] as Set
List mt4Logins = []
List mt5Logins = []
Map mt4LoginInstance = [:]
Map mt5LoginInstance = [:]
accountSourceRows.each { row -&gt;
    String instanceId = firstValue(row, [&apos;instanceid&apos;, &apos;instance_id&apos;, &apos;order_instanceid_val&apos;, &apos;instanceid_val&apos;])
    String platform = platformOf(instanceId)
    List loginValues = splitList(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;])).collect { cleanInt(it) }.findAll { it }
    if (!loginValues) {
        String singleLogin = cleanInt(firstValue(row, [&apos;login&apos;, &apos;order_login&apos;, &apos;login_val&apos;]))
        if (singleLogin) loginValues &lt;&lt; singleLogin
    }
    loginValues.each { login -&gt;
        if (instanceId &amp;&amp; login &amp;&amp; platform) {
            String key = instanceId + &apos;|&apos; + login
            if (!accountKeys.contains(key)) {
                accountKeys &lt;&lt; key
                accounts &lt;&lt; [instanceid: instanceId, login: Long.parseLong(login)]
            }
            if (platform == &apos;MT4&apos;) {
                mt4Logins &lt;&lt; login
                mt4LoginInstance[login] = instanceId
            } else if (platform == &apos;MT5&apos;) {
                mt5Logins &lt;&lt; login
                mt5LoginInstance[login] = instanceId
            }
        }
    }
}
mt4Logins = mt4Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
mt5Logins = mt5Logins.collect { it.toString().trim() }.findAll { it ==~ /^\d+$/ }.unique()
if (!accounts) throw new AssertionError(&apos;查询多个账户当前持仓没有可用accounts，CSV需要填写 order_instanceid_val/order_login 或 instanceid/login&apos;)

String page = intOrDefault(firstValue(currentRow, [&apos;page&apos;]), &apos;1&apos;)
String pageSize = intOrDefault(firstValue(currentRow, [&apos;page_size&apos;]), &apos;50&apos;)
String sortBy = firstValue(currentRow, [&apos;sort_by&apos;]) ?: &apos;open_time_utc_ms&apos;
String sortOrder = (firstValue(currentRow, [&apos;sort_order&apos;]) ?: &apos;desc&apos;).toLowerCase() == &apos;asc&apos; ? &apos;asc&apos; : &apos;desc&apos;
String maxRows = intOrDefault(firstValue(currentRow, [&apos;db_result_max_rows&apos;]), &apos;50000&apos;)

String filterOrderTicket = cleanInt(firstValue(currentRow, [&apos;filter_order_ticket&apos;, &apos;order_ticket_filter&apos;]))
String filterPositionTicket = cleanInt(firstValue(currentRow, [&apos;filter_position_ticket&apos;, &apos;position_ticket_filter&apos;]))
String filterDealTicket = cleanInt(firstValue(currentRow, [&apos;filter_deal_ticket&apos;, &apos;deal_ticket_filter&apos;]))
String symbol = firstValue(currentRow, [&apos;filter_symbol&apos;, &apos;symbol&apos;])
List orderTypeList = splitList(firstValue(currentRow, [&apos;order_types&apos;, &apos;filter_order_types&apos;])).collect { cleanInt(it) }.findAll { it in [&apos;0&apos;, &apos;1&apos;] }.unique()
String openFrom = cleanInt(firstValue(currentRow, [&apos;open_time_from_utc_ms&apos;, &apos;open_time_utc_ms__gte&apos;, &apos;open_time_from&apos;]))
String openTo = cleanInt(firstValue(currentRow, [&apos;open_time_to_utc_ms&apos;, &apos;open_time_utc_ms__lte&apos;, &apos;open_time_to&apos;]))
String volumeCondition = firstValue(currentRow, [&apos;volume_lots_condition&apos;, &apos;volume_condition&apos;]) ?: &apos;gte&apos;
String volumeValue = cleanNumber(firstValue(currentRow, [&apos;volume_lots_value&apos;, &apos;filter_volume_lots_value&apos;]))
String floatingPl = (firstValue(currentRow, [&apos;floating_pl&apos;]) ?: &apos;&apos;).toLowerCase()

Map filters = [:]
if (filterOrderTicket) filters[&apos;order_ticket&apos;] = Long.parseLong(filterOrderTicket)
if (filterPositionTicket) filters[&apos;position_ticket&apos;] = Long.parseLong(filterPositionTicket)
if (filterDealTicket) filters[&apos;deal_ticket&apos;] = Long.parseLong(filterDealTicket)
if (symbol) filters[&apos;symbol&apos;] = symbol
if (orderTypeList) filters[&apos;order_types&apos;] = orderTypeList.collect { Integer.parseInt(it) }
if (openFrom) filters[&apos;open_time_from_utc_ms&apos;] = Long.parseLong(openFrom)
if (openTo) filters[&apos;open_time_to_utc_ms&apos;] = Long.parseLong(openTo)
if (volumeValue) filters[&apos;volume_lots&apos;] = [condition: volumeCondition, value: new BigDecimal(volumeValue)]
if (floatingPl in [&apos;profit&apos;, &apos;loss&apos;]) filters[&apos;floating_pl&apos;] = floatingPl

Map body = [accounts: accounts, page: Integer.parseInt(page), page_size: Integer.parseInt(pageSize)]
if (filters) body[&apos;filters&apos;] = filters
if (sortBy) body[&apos;sort_by&apos;] = sortBy
if (sortOrder) body[&apos;sort_order&apos;] = sortOrder
String requestBody = JsonOutput.prettyPrint(JsonOutput.toJson(body))

vars.put(&apos;shujuku&apos;, shujuku)
vars.put(&apos;open_positions_shujuku&apos;, shujuku)
vars.put(&apos;open_positions_mode&apos;, runCase.mode.toString())
vars.put(&apos;open_positions_case_index_display&apos;, String.valueOf(caseIndex + 1))
vars.put(&apos;open_positions_case_total&apos;, String.valueOf(runCases.size()))
vars.put(&apos;open_positions_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
vars.put(&apos;open_positions_request_body&apos;, requestBody)
vars.put(&apos;open_positions_page&apos;, page)
vars.put(&apos;open_positions_page_size&apos;, pageSize)
vars.put(&apos;open_positions_sort_by&apos;, sortBy)
vars.put(&apos;open_positions_sort_order&apos;, sortOrder)
vars.put(&apos;open_positions_mt4_login&apos;, mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.put(&apos;open_positions_mt5_login&apos;, mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;)
vars.putObject(&apos;open_positions_current_csv_row&apos;, currentRow)
vars.putObject(&apos;db_open_positions_summary_rows&apos;, [])
vars.putObject(&apos;db_open_positions_page_rows&apos;, [])

String openMsMt4 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.OPEN_TIME) / 1000 AS UNSIGNED)&quot;
String updateMsMt4 = &quot;CASE WHEN mt.TIMESTAMP IS NOT NULL AND mt.TIMESTAMP &gt; 0 THEN CAST(mt.TIMESTAMP AS UNSIGNED) * 1000 ELSE CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.MODIFY_TIME) / 1000 AS UNSIGNED) END&quot;
String openMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeCreateMsc) / 1000 AS UNSIGNED)&quot;
String updateMsMt5 = &quot;CAST(TIMESTAMPDIFF(MICROSECOND, &apos;1970-01-01 00:00:00&apos;, mt.TimeUpdateMsc) / 1000 AS UNSIGNED)&quot;
String mt5VolumeExpr = &quot;(CASE WHEN mt.VolumeExt &gt; 0 THEN mt.VolumeExt / 100000000.0 ELSE mt.Volume / 10000.0 END)&quot;
String orderTypeSql = orderTypeList ? orderTypeList.join(&apos;,&apos;) : &apos;0,1&apos;
String volOp = opOf(volumeCondition)

def caseInstance = { String expr, Map loginInstance, String defaultValue -&gt;
    if (!loginInstance) return sqlQuote(defaultValue)
    String cases = loginInstance.collect { k, v -&gt; &apos;WHEN &apos; + k + &apos; THEN &apos; + sqlQuote(v) }.join(&apos; &apos;)
    &apos;CASE &apos; + expr + &apos; &apos; + cases + &apos; ELSE &apos; + sqlQuote(defaultValue) + &apos; END&apos;
}

String mt4LoginSql = mt4Logins ? mt4Logins.join(&apos;,&apos;) : &apos;-1&apos;
String mt5LoginSql = mt5Logins ? mt5Logins.join(&apos;,&apos;) : &apos;-1&apos;

List mt4Where = []
mt4Where &lt;&lt; &apos;mt.LOGIN IN (&apos; + mt4LoginSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.TICKET &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.SYMBOL IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;TRIM(mt.SYMBOL) &lt;&gt; &apos;&apos;&quot;
mt4Where &lt;&lt; &quot;mt.SYMBOL REGEXP &apos;[A-Za-z]&apos;&quot;
mt4Where &lt;&lt; &apos;mt.CMD IN (&apos; + orderTypeSql + &apos;)&apos;
mt4Where &lt;&lt; &apos;mt.VOLUME &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.OPEN_PRICE &gt; 0&apos;
mt4Where &lt;&lt; &apos;mt.CLOSE_TIME IS NOT NULL&apos;
mt4Where &lt;&lt; &quot;mt.CLOSE_TIME &lt;= &apos;1970-01-02 00:00:00&apos;&quot;
if (filterOrderTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterOrderTicket
if (filterPositionTicket) mt4Where &lt;&lt; &apos;mt.TICKET = &apos; + filterPositionTicket
if (filterDealTicket) mt4Where &lt;&lt; (filterDealTicket == &apos;0&apos; ? &apos;0 = 0&apos; : &apos;0 = &apos; + filterDealTicket)
if (symbol) mt4Where &lt;&lt; &apos;mt.SYMBOL = &apos; + sqlQuote(symbol)
if (openFrom) mt4Where &lt;&lt; openMsMt4 + &apos; &gt;= &apos; + openFrom
if (openTo) mt4Where &lt;&lt; openMsMt4 + &apos; &lt;= &apos; + openTo
if (volumeValue) mt4Where &lt;&lt; &apos;(mt.VOLUME / 100.0) &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt4Where &lt;&lt; &apos;mt.PROFIT &lt; 0&apos;

List mt5Where = []
mt5Where &lt;&lt; &apos;mt.Login IN (&apos; + mt5LoginSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;mt.Position &gt; 0&apos;
mt5Where &lt;&lt; &apos;mt.Symbol IS NOT NULL&apos;
mt5Where &lt;&lt; &quot;TRIM(mt.Symbol) &lt;&gt; &apos;&apos;&quot;
mt5Where &lt;&lt; &quot;mt.Symbol REGEXP &apos;[A-Za-z]&apos;&quot;
mt5Where &lt;&lt; &apos;mt.Action IN (&apos; + orderTypeSql + &apos;)&apos;
mt5Where &lt;&lt; &apos;(mt.VolumeExt &gt; 0 OR mt.Volume &gt; 0)&apos;
mt5Where &lt;&lt; &apos;mt.PriceOpen &gt; 0&apos;
if (filterOrderTicket) mt5Where &lt;&lt; &apos;mt.Position = &apos; + filterOrderTicket
if (filterPositionTicket) mt5Where &lt;&lt; &apos;mt.Position = &apos; + filterPositionTicket
if (symbol) mt5Where &lt;&lt; &apos;mt.Symbol = &apos; + sqlQuote(symbol)
if (openFrom) mt5Where &lt;&lt; openMsMt5 + &apos; &gt;= &apos; + openFrom
if (openTo) mt5Where &lt;&lt; openMsMt5 + &apos; &lt;= &apos; + openTo
if (volumeValue) mt5Where &lt;&lt; mt5VolumeExpr + &apos; &apos; + volOp + &apos; &apos; + volumeValue
if (floatingPl == &apos;profit&apos;) mt5Where &lt;&lt; &apos;mt.Profit &gt; 0&apos;
if (floatingPl == &apos;loss&apos;) mt5Where &lt;&lt; &apos;mt.Profit &lt; 0&apos;
List mt5DealScopeWhere = mt5Where.collect { it.replace(&apos;mt.&apos;, &apos;p.&apos;) }
if (filterDealTicket) mt5Where &lt;&lt; &apos;COALESCE(ds.deal_ticket, 0) = &apos; + filterDealTicket

String mt4InstanceExpr = caseInstance(&apos;mt.LOGIN&apos;, mt4LoginInstance, mt4LoginInstance.values().find { it } ?: &apos;MT4&apos;)
String mt5InstanceExpr = caseInstance(&apos;mt.Login&apos;, mt5LoginInstance, mt5LoginInstance.values().find { it } ?: &apos;MT5&apos;)

String mt4Sql = &quot;&quot;&quot;
SELECT
  ${mt4InstanceExpr} AS instance_id,
  mt.LOGIN AS login,
  &apos;mt4&apos; AS source,
  mt.TICKET AS order_ticket,
  mt.TICKET AS position_ticket,
  0 AS deal_ticket,
  mt.SYMBOL AS symbol,
  mt.CMD AS order_type,
  CASE mt.CMD WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.CMD) END AS side,
  0 AS state,
  mt.REASON AS reason,
  mt.VOLUME / 100.0 AS volume_lots,
  mt.OPEN_PRICE AS price_open,
  mt.CLOSE_PRICE AS price_current,
  mt.SL AS price_sl,
  mt.TP AS price_tp,
  mt.PROFIT AS profit,
  mt.SWAPS AS swap,
  mt.COMMISSION AS commission,
  0 AS fee,
  mt.PROFIT + mt.SWAPS + mt.COMMISSION AS net_profit,
  ${openMsMt4} AS open_time_utc_ms,
  ${updateMsMt4} AS updated_utc_ms,
  mt.DIGITS AS digits,
  2 AS digits_currency,
  100000.0 AS contract_size,
  mt.MARGIN_RATE AS margin_rate,
  mt.COMMENT AS comment,
  UPPER(TRIM(NULLIF(u.CURRENCY, &apos;&apos;))) AS currency,
  &apos;native&apos; AS money_unit,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) = &apos;USC&apos; THEN 1 WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) = &apos;USD&apos; THEN 0 ELSE NULL END AS is_cent,
  &apos;USD&apos; AS reporting_currency,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 1 ELSE 0 END AS normalization_complete,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.PROFIT WHEN &apos;USC&apos; THEN mt.PROFIT / 100.0 ELSE NULL END AS profit_reporting,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.SWAPS WHEN &apos;USC&apos; THEN mt.SWAPS / 100.0 ELSE NULL END AS swap_reporting,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.COMMISSION WHEN &apos;USC&apos; THEN mt.COMMISSION / 100.0 ELSE NULL END AS commission_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS fee_reporting,
  CASE UPPER(TRIM(COALESCE(u.CURRENCY, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.PROFIT + mt.SWAPS + mt.COMMISSION WHEN &apos;USC&apos; THEN (mt.PROFIT + mt.SWAPS + mt.COMMISSION) / 100.0 ELSE NULL END AS net_profit_reporting
FROM mt4_report.MT4_TRADES mt
LEFT JOIN mt4_report.MT4_USERS u ON u.LOGIN = mt.LOGIN
WHERE ${mt4Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

String mt5Sql = &quot;&quot;&quot;
SELECT
  ${mt5InstanceExpr} AS instance_id,
  mt.Login AS login,
  &apos;mt5&apos; AS source,
  mt.Position AS order_ticket,
  mt.Position AS position_ticket,
  COALESCE(ds.deal_ticket, 0) AS deal_ticket,
  mt.Symbol AS symbol,
  mt.Action AS order_type,
  CASE mt.Action WHEN 0 THEN &apos;buy&apos; WHEN 1 THEN &apos;sell&apos; ELSE CONCAT(&apos;unknown_&apos;, mt.Action) END AS side,
  0 AS state,
  mt.Reason AS reason,
  ${mt5VolumeExpr} AS volume_lots,
  mt.PriceOpen AS price_open,
  mt.PriceCurrent AS price_current,
  mt.PriceSL AS price_sl,
  mt.PriceTP AS price_tp,
  mt.Profit AS profit,
  mt.Storage AS swap,
  COALESCE(ds.commission, 0) AS commission,
  0 AS fee,
  mt.Profit + mt.Storage + COALESCE(ds.commission, 0) AS net_profit,
  ${openMsMt5} AS open_time_utc_ms,
  ${updateMsMt5} AS updated_utc_ms,
  mt.Digits AS digits,
  mt.DigitsCurrency AS digits_currency,
  mt.ContractSize AS contract_size,
  mt.RateMargin AS margin_rate,
  mt.Comment AS comment,
  UPPER(TRIM(NULLIF(acct_currency.Currency, &apos;&apos;))) AS currency,
  &apos;native&apos; AS money_unit,
  CASE UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN 1 WHEN &apos;USC&apos; THEN 100 ELSE NULL END AS money_scale,
  CASE WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) = &apos;USC&apos; THEN 1 WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) = &apos;USD&apos; THEN 0 ELSE NULL END AS is_cent,
  &apos;USD&apos; AS reporting_currency,
  CASE WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 1 ELSE 0 END AS normalization_complete,
  CASE UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.Profit WHEN &apos;USC&apos; THEN mt.Profit / 100.0 ELSE NULL END AS profit_reporting,
  CASE UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.Storage WHEN &apos;USC&apos; THEN mt.Storage / 100.0 ELSE NULL END AS swap_reporting,
  CASE UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN COALESCE(ds.commission, 0) WHEN &apos;USC&apos; THEN COALESCE(ds.commission, 0) / 100.0 ELSE NULL END AS commission_reporting,
  CASE WHEN UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) IN (&apos;USD&apos;, &apos;USC&apos;) THEN 0.0 ELSE NULL END AS fee_reporting,
  CASE UPPER(TRIM(COALESCE(acct_currency.Currency, &apos;&apos;))) WHEN &apos;USD&apos; THEN mt.Profit + mt.Storage + COALESCE(ds.commission, 0) WHEN &apos;USC&apos; THEN (mt.Profit + mt.Storage + COALESCE(ds.commission, 0)) / 100.0 ELSE NULL END AS net_profit_reporting
FROM mt5_report.mt5_positions mt
LEFT JOIN (
  SELECT d1.Login, MAX(COALESCE(d1.Currency, &apos;&apos;)) AS Currency
  FROM mt5_report.mt5_daily d1
  INNER JOIN (
    SELECT Login, MAX(`Datetime`) AS max_datetime
    FROM mt5_report.mt5_daily
    WHERE Login IN (${mt5LoginSql})
    GROUP BY Login
  ) latest_d ON latest_d.Login = d1.Login AND latest_d.max_datetime = d1.`Datetime`
  GROUP BY d1.Login
) acct_currency ON acct_currency.Login = mt.Login
LEFT JOIN (
  SELECT
    d.Login,
    d.PositionID,
    d.Symbol,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Deal ORDER BY d.TimeMsc ASC, d.Deal ASC), &apos;,&apos;, 1) + 0 AS deal_ticket,
    SUM(d.Commission) AS commission
  FROM mt5_report.mt5_deals d
  INNER JOIN mt5_report.mt5_positions p
    ON p.Login = d.Login
   AND p.Position = d.PositionID
   AND p.Symbol = d.Symbol
  WHERE d.Login IN (${mt5LoginSql})
    AND d.Action IN (0, 1)
    AND d.PositionID &gt; 0
    AND ${mt5DealScopeWhere.join(&apos; AND &apos;)}
  GROUP BY d.Login, d.PositionID, d.Symbol
) ds
  ON ds.Login = mt.Login
 AND ds.PositionID = mt.Position
 AND ds.Symbol = mt.Symbol
WHERE ${mt5Where.join(&apos; AND &apos;)}
&quot;&quot;&quot;.trim()

Set allowedSortColumns = [&apos;open_time_utc_ms&apos;, &apos;position_ticket&apos;, &apos;order_ticket&apos;, &apos;updated_utc_ms&apos;, &apos;profit&apos;, &apos;volume_lots&apos;, &apos;login&apos;] as Set
String sortColumn = allowedSortColumns.contains(sortBy) ? sortBy : &apos;open_time_utc_ms&apos;
int pageNoInt = Integer.parseInt(page)
int pageSizeInt = Integer.parseInt(pageSize)
int offsetInt = Math.max(pageNoInt - 1, 0) * pageSizeInt
String dbOrder = sortOrder?.toLowerCase() == &apos;asc&apos; ? &apos;ASC&apos; : &apos;DESC&apos;
String openRowsSql = mt5Sql + &apos; UNION ALL &apos; + mt4Sql
String summarySql = &quot;&quot;&quot;
SELECT
  COUNT(*) AS total,
  COUNT(*) AS total_orders,
  COALESCE(SUM(volume_lots), 0) AS total_volume,
  COALESCE(SUM(CASE WHEN currency = &apos;USC&apos; THEN volume_lots ELSE 0 END), 0) AS cent_volume,
  COALESCE(SUM(CASE WHEN currency = &apos;USD&apos; THEN volume_lots ELSE 0 END), 0) AS standard_volume,
  COALESCE(SUM(CASE WHEN normalization_complete = 0 THEN volume_lots ELSE 0 END), 0) AS unresolved_volume,
  COUNT(DISTINCT CASE WHEN normalization_complete = 0 THEN CONCAT(instance_id, &apos;:&apos;, login) ELSE NULL END) AS unresolved_currency_account_count,
  COALESCE(SUM(COALESCE(commission, 0)), 0) AS total_commission,
  COALESCE(SUM(COALESCE(fee, 0)), 0) AS total_raw_fee,
  COALESCE(SUM(COALESCE(commission_reporting, 0) + COALESCE(fee_reporting, 0)), 0) AS total_fee,
  COALESCE(SUM(COALESCE(swap_reporting, 0)), 0) AS total_storage,
  COALESCE(SUM(COALESCE(profit_reporting, 0)), 0) AS total_profit
FROM (
${openRowsSql}
) open_rows
&quot;&quot;&quot;.trim()
String pageSql = &quot;&quot;&quot;
SELECT
  reason,
  symbol,
  position_ticket,
  updated_utc_ms,
  fee,
  COALESCE(commission, 0) + COALESCE(fee, 0) AS row_total_fee,
  open_time_utc_ms,
  price_open,
  margin_rate,
  source,
  login,
  price_sl,
  commission,
  digits_currency,
  state,
  order_type,
  profit,
  price_current,
  volume_lots,
  side,
  swap,
  deal_ticket,
  price_tp,
  order_ticket,
  instance_id,
  net_profit,
  comment,
  digits,
  contract_size,
  currency, money_unit, money_scale, is_cent, reporting_currency, normalization_complete,
  profit_reporting, swap_reporting, commission_reporting, fee_reporting, net_profit_reporting
FROM (
${openRowsSql}
) open_rows
ORDER BY ${sortColumn} ${dbOrder}, position_ticket ${dbOrder}
LIMIT ${pageSizeInt} OFFSET ${offsetInt}
&quot;&quot;&quot;.trim()

def compactSql = { String sql -&gt;
    (sql ?: &apos;&apos;).replace(&apos;\r&apos;, &apos; &apos;).replace(&apos;\n&apos;, &apos; &apos;).replaceAll(/[\r\n]+/, &apos; &apos;).replaceAll(/\s+/, &apos; &apos;).trim()
}
String summarySqlExec = compactSql(summarySql)
String pageSqlExec = compactSql(pageSql)
vars.put(&apos;open_positions_summary_sql&apos;, summarySqlExec)
vars.put(&apos;open_positions_page_sql&apos;, pageSqlExec)

String initReport = &apos;list_open_positions init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() +
    &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku +
    &apos; | accounts=&apos; + accounts.collect { it.instanceid + &apos;:&apos; + it.login }.join(&apos;,&apos;) +
    &apos; | MT4_login=&apos; + vars.get(&apos;open_positions_mt4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;open_positions_mt5_login&apos;) +
    &apos; | page=&apos; + page + &apos; | page_size=&apos; + pageSize + &apos; | sort=&apos; + sortBy + &apos; &apos; + sortOrder +
    &apos; | filters=&apos; + JsonOutput.toJson(filters)
log.info(initReport + &apos;\nrequestBody=&apos; + requestBody)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;init passed&apos;)
SampleResult.setDataType(&apos;text&apos;)
SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
SampleResult.setResponseData(initReport + &apos;\n\n【请求Body】\n&apos; + requestBody + &apos;\n\n【统计summary SQL（MT4+MT5合并，只查询一次，实际执行SQL）】\n&apos; + summarySqlExec + &apos;\n\n【当前页明细 SQL（MT4+MT5合并，实际执行SQL）】\n&apos; + pageSqlExec, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
