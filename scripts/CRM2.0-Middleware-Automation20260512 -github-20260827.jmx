          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="请求结果分类（响应返回/响应超时/连接超时/其他失败）" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def originalMessage = prev.getResponseMessage() ?: &apos;&apos;
def message = originalMessage.toLowerCase()
def responseCode = prev.getResponseCode() ?: &apos;&apos;
def elapsedMs = prev.getTime()
def currentSampler = ctx.getCurrentSampler()
def configuredConnectTimeoutMs = currentSampler?.getPropertyAsString(&apos;HTTPSampler.connect_timeout&apos;) ?: &apos;未设置&apos;
def configuredResponseTimeoutMs = currentSampler?.getPropertyAsString(&apos;HTTPSampler.response_timeout&apos;) ?: &apos;未设置&apos;

def resultType
def explanation
if (message.contains(&apos;read timed out&apos;) || message.contains(&apos;sockettimeoutexception&apos;)) {
    resultType = &apos;RESPONSE_TIMEOUT&apos;
    explanation = &apos;连接已建立/请求已发出，但在响应超时阈值内没有收到完整响应。JMeter 已停止等待，因此没有服务端之后才返回的响应体。&apos;
} else if (message.contains(&apos;connect timed out&apos;) || message.contains(&apos;connectexception&apos;)) {
    resultType = &apos;CONNECT_TIMEOUT&apos;
    explanation = &apos;在连接超时阈值内未能与目标服务器建立连接；这不是响应慢。&apos;
} else if (!prev.isSuccessful()) {
    resultType = &apos;REQUEST_FAILED&apos;
    explanation = &apos;请求失败，但不是已识别的连接超时或响应超时；请查看响应码和原始消息。&apos;
} else {
    resultType = &apos;RESPONSE_RETURNED&apos;
    explanation = &apos;接口在响应超时阈值内返回；响应数据页保留服务端真实响应体。&apos;
}

vars.put(&apos;request_result_type&apos;, resultType)
vars.put(&apos;actual_response_time_ms&apos;, String.valueOf(elapsedMs))
vars.put(&apos;request_response_code&apos;, responseCode)
vars.put(&apos;request_response_message&apos;, originalMessage)

if (resultType != &apos;RESPONSE_RETURNED&apos;) {
    def diagnostic = &quot;&quot;&quot;JMeter 接口慢响应/超时诊断
result_type=${resultType}
elapsed_ms=${elapsedMs}
connect_timeout_ms=${configuredConnectTimeoutMs}
response_timeout_ms=${configuredResponseTimeoutMs}
response_code=${responseCode}
response_message=${originalMessage}
说明=${explanation}
clumsy提示=请确认延迟规则命中了中间件与MT Server的实际通信端口；/version若不访问MT Server，则不会受到该链路延迟影响。
&quot;&quot;&quot;
    prev.setResponseData(diagnostic, &apos;UTF-8&apos;)
    prev.setContentType(&apos;text/plain; charset=UTF-8&apos;)
}

log.info(&apos;接口请求结果: type={}, elapsed={}ms, connectTimeout={}ms, responseTimeout={}ms, code={}, message={}&apos;,
    resultType, elapsedMs, configuredConnectTimeoutMs, configuredResponseTimeoutMs, responseCode, originalMessage)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
