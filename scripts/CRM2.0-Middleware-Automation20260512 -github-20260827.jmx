            </collectionProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="自定义统计聚合001-CSV/API跳过字段" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="custom_stat_csv_api_disabled_fields" elementType="Argument">
                <stringProp name="Argument.name">custom_stat_csv_api_disabled_fields</stringProp>
                <stringProp name="Argument.value">avg,stddev,max,min</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段跳过配置；多个字段用英文逗号分隔，* 表示跳过全部字段。</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化自定义统计聚合001参数" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
      
      String csvName = &apos;custom_account_metrics_stat_ex_check.csv&apos;
      File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
      if (!csvFile.exists()) throw new AssertionError(&apos;自定义统计聚合001 CSV文件不存在: &apos; + csvFile.getPath())
      List lines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim().length() &gt; 0 }
      if (lines.size() &lt;= 1) throw new AssertionError(&apos;自定义统计聚合001 CSV没有数据: &apos; + csvFile.getPath())
      
      def parseCsvLine = { String line -&gt;
          List values = []
          StringBuilder cur = new StringBuilder()
          boolean inQuotes = false
          for (int i = 0; i &lt; line.length(); i++) {
              char c = line.charAt(i)
              if (c == &apos;&quot;&apos; as char) {
                  if (inQuotes &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == (&apos;&quot;&apos; as char)) {
                      cur.append(c)
                      i++
                  } else {
                      inQuotes = !inQuotes
                  }
              } else if (c == (&apos;,&apos; as char) &amp;&amp; !inQuotes) {
                  values &lt;&lt; cur.toString().trim()
                  cur.setLength(0)
              } else {
                  cur.append(c)
              }
          }
          values &lt;&lt; cur.toString().trim()
          values
      }
      
      List headers = parseCsvLine(lines[0]).collect { (it ?: &apos;&apos;).replaceAll(/^\uFEFF/, &apos;&apos;).trim() }
      List csvRows = []
      lines.drop(1).eachWithIndex { line, idx -&gt;
          List vals = parseCsvLine(line)
          Map row = [__line_no: idx + 2]
          headers.eachWithIndex { h, hidx -&gt; if (h) row[h] = hidx &lt; vals.size() ? vals[hidx] : &apos;&apos; }
          csvRows &lt;&lt; row
      }
      
      def firstValue = { Map row, List names -&gt;
          for (String n : names) {
              Object v = row[n]
              String s = v == null ? &apos;&apos; : v.toString().trim()
              if (s &amp;&amp; !s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return s
          }
          &apos;&apos;
      }
      def cleanLoginList = { raw -&gt;
          String s = (raw ?: &apos;&apos;).toString().trim()
          if (!s || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) return &apos;&apos;
          def vals = s.split(&apos;,&apos;).collect { it.trim() }.findAll { it ==~ /\d+/ }.unique()
          vals ? vals.join(&apos;,&apos;) : &apos;&apos;
      }
      def platformOf = { raw -&gt;
          String s = (raw ?: &apos;&apos;).toString().trim().toUpperCase()
          s.contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (s.contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
      }
      def putRowVars = { Map row -&gt;
          headers.each { h -&gt; vars.put(h, row[h] == null ? &apos;&apos; : row[h].toString()) }
      }
      
      List dbRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;1&apos; }
      List csvModeRows = csvRows.findAll { firstValue(it, [&apos;shujuku&apos;]) == &apos;0&apos; }
      List runCases = []
      if (dbRows) runCases &lt;&lt; [mode:&apos;DB&apos;, row:dbRows[0]]
      csvModeRows.each { runCases &lt;&lt; [mode:&apos;CSV&apos;, row:it] }
      if (!runCases) throw new AssertionError(&apos;自定义统计聚合001 CSV中没有可执行数据：需要至少一行 shujuku=1 或 shujuku=0&apos;)
      
      int caseIndex = ((vars.get(&apos;custom_stat_001_case_index&apos;) ?: &apos;0&apos;) as int)
      if (caseIndex &gt;= runCases.size()) {
          throw new AssertionError(&apos;自定义统计聚合001 逻辑循环次数超出用例数 | caseIndex=&apos; + caseIndex + &apos; | caseCount=&apos; + runCases.size())
      }
      vars.put(&apos;custom_stat_001_case_index&apos;, String.valueOf(caseIndex + 1))
      Map runCase = runCases[caseIndex] as Map
      Map currentRow = runCase.row as Map
      putRowVars(currentRow)
      
      String shujuku = runCase.mode == &apos;DB&apos; ? &apos;1&apos; : &apos;0&apos;
      String currentInstance = firstValue(currentRow, [&apos;order_instanceid_val&apos;,&apos;instanceid_val&apos;,&apos;instanceid&apos;,&apos;instance_id&apos;])
      String groupBy = firstValue(currentRow, [&apos;_group_by&apos;,&apos;group_by&apos;])
      if (!groupBy) groupBy = csvRows.collect { firstValue(it, [&apos;_group_by&apos;,&apos;group_by&apos;]) }.find { it } ?: &apos;currency&apos;
      
      List mt4All = []
      List mt5All = []
      dbRows.each { row -&gt;
          String rowInstance = firstValue(row, [&apos;order_instanceid_val&apos;,&apos;instanceid_val&apos;,&apos;instanceid&apos;,&apos;instance_id&apos;])
          String rowPlatform = platformOf(rowInstance)
          String orderLogin = cleanLoginList(firstValue(row, [&apos;order_login&apos;,&apos;login__in&apos;,&apos;login&apos;,&apos;login_val&apos;]))
          String rowMt4 = cleanLoginList(firstValue(row, [&apos;MT4_login&apos;,&apos;mt4_login&apos;]))
          String rowMt5 = cleanLoginList(firstValue(row, [&apos;MT5_login&apos;,&apos;mt5_login&apos;]))
          if (rowPlatform == &apos;MT4&apos;) {
              String useLogin = orderLogin ?: rowMt4
              if (useLogin) mt4All.addAll(useLogin.split(&apos;,&apos;) as List)
          } else if (rowPlatform == &apos;MT5&apos;) {
              String useLogin = orderLogin ?: rowMt5
              if (useLogin) mt5All.addAll(useLogin.split(&apos;,&apos;) as List)
          } else {
              if (rowMt4) mt4All.addAll(rowMt4.split(&apos;,&apos;) as List)
              if (rowMt5) mt5All.addAll(rowMt5.split(&apos;,&apos;) as List)
          }
      }
      mt4All = mt4All.collect { it.toString().trim() }.findAll { it ==~ /\d+/ }.unique()
      mt5All = mt5All.collect { it.toString().trim() }.findAll { it ==~ /\d+/ }.unique()
      
      String loginIn
      String mt4Login
      String mt5Login
      String platform
      if (shujuku == &apos;1&apos;) {
          if (!mt4All &amp;&amp; !mt5All) throw new AssertionError(&apos;自定义统计聚合001 shujuku=1 但CSV中没有可用的MT4/MT5登录号&apos;)
          mt4Login = mt4All ? mt4All.join(&apos;,&apos;) : &apos;-1&apos;
          mt5Login = mt5All ? mt5All.join(&apos;,&apos;) : &apos;-1&apos;
          loginIn = (mt4All + mt5All).unique().join(&apos;,&apos;)
          platform = (mt4All &amp;&amp; mt5All) ? &apos;MIXED&apos; : (mt5All ? &apos;MT5&apos; : &apos;MT4&apos;)
          if (!currentInstance) currentInstance = platform
      } else {
          if (!currentInstance) throw new AssertionError(&apos;自定义统计聚合001 shujuku=0 时 order_instanceid_val/instanceid_val不能为空 | CSV行=&apos; + currentRow.__line_no)
          platform = platformOf(currentInstance)
          if (!platform) throw new AssertionError(&apos;自定义统计聚合001 instanceid必须包含MT4_*/MT5_*，当前=&apos; + currentInstance + &apos; | CSV行=&apos; + currentRow.__line_no)
          loginIn = cleanLoginList(firstValue(currentRow, [&apos;login__in&apos;,&apos;order_login&apos;,&apos;login&apos;,&apos;login_val&apos;]))
          if (!loginIn) throw new AssertionError(&apos;自定义统计聚合001 shujuku=0 时 login__in/order_login/login至少需要一个有效登录号 | CSV行=&apos; + currentRow.__line_no)
          mt4Login = platform == &apos;MT4&apos; ? loginIn : &apos;-1&apos;
          mt5Login = platform == &apos;MT5&apos; ? loginIn : &apos;-1&apos;
      }
      
      vars.put(&apos;shujuku&apos;, shujuku)
      vars.put(&apos;order_instanceid_val&apos;, currentInstance)
      vars.put(&apos;instanceid_val&apos;, currentInstance)
      vars.put(&apos;login__in&apos;, loginIn)
      vars.put(&apos;order_login&apos;, loginIn)
      vars.put(&apos;MT4_login&apos;, mt4Login ?: &apos;-1&apos;)
      vars.put(&apos;MT5_login&apos;, mt5Login ?: &apos;-1&apos;)
      vars.put(&apos;custom_stat_shujuku&apos;, shujuku)
      vars.put(&apos;custom_stat_platform&apos;, platform)
      vars.put(&apos;custom_stat_group_by&apos;, groupBy)
      vars.put(&apos;custom_stat_should_run&apos;, &apos;true&apos;)
      vars.put(&apos;custom_stat_skip_reason&apos;, &apos;&apos;)
      vars.put(&apos;custom_stat_case_index&apos;, String.valueOf(caseIndex + 1))
      vars.put(&apos;custom_stat_case_total&apos;, String.valueOf(runCases.size()))
      vars.put(&apos;custom_stat_case_mode&apos;, runCase.mode.toString())
      vars.put(&apos;custom_stat_csv_line_no&apos;, String.valueOf(currentRow.__line_no))
      vars.putObject(&apos;db_custom_metrics_stat_rows&apos;, [])
      
      def stat = [
          equity:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;], profit:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;],
          balance:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;], credit:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;],
          margin:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;], margin_free:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;],
          margin_level:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;], leverage:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;],
          position_count:[&apos;sum&apos;,&apos;avg&apos;,&apos;stddev&apos;,&apos;max&apos;,&apos;min&apos;]
      ]
      def body = [login__in: loginIn, _stat: stat]
      if (groupBy) body[&apos;_group_by&apos;] = groupBy
      vars.put(&apos;custom_stat_request_body&apos;, JsonOutput.toJson(body))
      String initReport = &apos;custom metrics stat 001 init | case=&apos; + (caseIndex + 1) + &apos;/&apos; + runCases.size() + &apos; | mode=&apos; + runCase.mode + &apos; | CSV行=&apos; + currentRow.__line_no + &apos; | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | login__in=&apos; + loginIn + &apos; | MT4_login=&apos; + vars.get(&apos;MT4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;MT5_login&apos;) + &apos; | group_by=&apos; + groupBy
      log.info(initReport)
      SampleResult.setSuccessful(true)
      SampleResult.setResponseCode(&apos;200&apos;)
      SampleResult.setResponseMessage(&apos;init passed&apos;)
      SampleResult.setDataType(&apos;text&apos;)
      SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
      SampleResult.setResponseData(initReport, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当需要执行-自定义统计聚合001接口/DB/CSV对比" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;custom_stat_should_run&apos;) == &apos;true&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="自定义统计聚合001接口-${login__in}-${order_instanceid_val}" enabled="true">
              <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
              <stringProp name="HTTPSampler.port">${port}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/crm20/get_account_metrics_stat_ex?</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${custom_stat_request_body}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP请求头管理器-JSON" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="保存自定义统计聚合001响应" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">vars.put(&apos;custom_stat_api_response&apos;, prev.getResponseDataAsString())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="当shujuku=1-查询自定义统计聚合001数据库" enabled="true">
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">true</boolProp>
              <stringProp name="IfController.condition">${__groovy(vars.get(&apos;custom_stat_shujuku&apos;) == &apos;1&apos;)}</stringProp>
            </IfController>
            <hashTree>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT4+MT5账户统计聚合001-${login__in}" enabled="true">
                <stringProp name="dataSource">mysqlMT4</stringProp>
                <stringProp name="query">WITH mt5_latest_daily AS (
                          SELECT * FROM (
                            SELECT d.*, ROW_NUMBER() OVER (PARTITION BY d.Login ORDER BY d.`Datetime` DESC) AS rn
                            FROM mt5_report.mt5_daily d
                WHERE d.Login IN (${MT5_login})
                          ) t WHERE t.rn = 1
                        ),
                        mt4_position_count AS (
                          SELECT t.LOGIN AS login, COUNT(*) AS position_count
                          FROM mt4_report.MT4_TRADES t
                          WHERE t.LOGIN IN (${MT4_login})
                            AND t.CMD IN (0, 1)
                            AND t.CLOSE_TIME &lt;= &apos;1970-01-02 00:00:00&apos;
                            AND t.OPEN_PRICE &lt;&gt; 0
                          GROUP BY t.LOGIN
                        ),
                        mt5_position_count AS (
                          SELECT p.Login AS login, COUNT(*) AS position_count
                          FROM mt5_report.mt5_positions p
                          WHERE p.Login IN (${MT5_login})
                          GROUP BY p.Login
                        ),
                        account_metrics_all AS (
                          SELECT mt.LOGIN AS login, COALESCE(mt.CURRENCY, &apos;&apos;) AS currency, mt.BALANCE AS balance, mt.CREDIT AS credit, mt.EQUITY AS equity, mt.MARGIN AS margin, mt.MARGIN_FREE AS margin_free, mt.MARGIN_LEVEL AS margin_level, mt.LEVERAGE AS leverage, (mt.EQUITY - mt.BALANCE - mt.CREDIT) AS profit, COALESCE(pos.position_count, 0) AS position_count
                          FROM mt4_report.MT4_USERS mt
                          LEFT JOIN mt4_position_count pos ON pos.login = mt.LOGIN
                          WHERE mt.LOGIN IN (${MT4_login})
                          UNION ALL
                          SELECT mt.Login AS login, COALESCE(d.Currency, &apos;&apos;) AS currency, mt.Balance AS balance, mt.Credit AS credit, mt.Equity AS equity, mt.Margin AS margin, mt.MarginFree AS margin_free, mt.MarginLevel AS margin_level, u.Leverage AS leverage, (mt.Equity - mt.Balance - mt.Credit) AS profit, COALESCE(pos.position_count, 0) AS position_count
                          FROM mt5_report.mt5_accounts mt
                          LEFT JOIN mt5_report.mt5_users u ON u.Login = mt.Login
                          LEFT JOIN mt5_latest_daily d ON d.Login = mt.Login
                          LEFT JOIN mt5_position_count pos ON pos.login = mt.Login
                          WHERE mt.Login IN (${MT5_login})
                        )
                        SELECT
                          currency,
                          COUNT(*) AS `count`,
                          ROUND(SUM(equity), 6) AS equity_sum, ROUND(AVG(equity), 6) AS equity_avg, ROUND(COALESCE(STDDEV_SAMP(equity), 0), 6) AS equity_stddev, ROUND(MAX(equity), 6) AS equity_max, ROUND(MIN(equity), 6) AS equity_min,
                          ROUND(SUM(profit), 6) AS profit_sum, ROUND(AVG(profit), 6) AS profit_avg, ROUND(COALESCE(STDDEV_SAMP(profit), 0), 6) AS profit_stddev, ROUND(MAX(profit), 6) AS profit_max, ROUND(MIN(profit), 6) AS profit_min,
                          ROUND(SUM(balance), 6) AS balance_sum, ROUND(AVG(balance), 6) AS balance_avg, ROUND(COALESCE(STDDEV_SAMP(balance), 0), 6) AS balance_stddev, ROUND(MAX(balance), 6) AS balance_max, ROUND(MIN(balance), 6) AS balance_min,
                          ROUND(SUM(credit), 6) AS credit_sum, ROUND(AVG(credit), 6) AS credit_avg, ROUND(COALESCE(STDDEV_SAMP(credit), 0), 6) AS credit_stddev, ROUND(MAX(credit), 6) AS credit_max, ROUND(MIN(credit), 6) AS credit_min,
                          ROUND(SUM(margin), 6) AS margin_sum, ROUND(AVG(margin), 6) AS margin_avg, ROUND(COALESCE(STDDEV_SAMP(margin), 0), 6) AS margin_stddev, ROUND(MAX(margin), 6) AS margin_max, ROUND(MIN(margin), 6) AS margin_min,
                          ROUND(SUM(margin_free), 6) AS margin_free_sum, ROUND(AVG(margin_free), 6) AS margin_free_avg, ROUND(COALESCE(STDDEV_SAMP(margin_free), 0), 6) AS margin_free_stddev, ROUND(MAX(margin_free), 6) AS margin_free_max, ROUND(MIN(margin_free), 6) AS margin_free_min,
                          ROUND(SUM(margin_level), 6) AS margin_level_sum, ROUND(AVG(margin_level), 6) AS margin_level_avg, ROUND(COALESCE(STDDEV_SAMP(margin_level), 0), 6) AS margin_level_stddev, ROUND(MAX(margin_level), 6) AS margin_level_max, ROUND(MIN(margin_level), 6) AS margin_level_min,
                          ROUND(SUM(leverage), 6) AS leverage_sum, ROUND(AVG(leverage), 6) AS leverage_avg, ROUND(COALESCE(STDDEV_SAMP(leverage), 0), 6) AS leverage_stddev, ROUND(MAX(leverage), 6) AS leverage_max, ROUND(MIN(leverage), 6) AS leverage_min,
                          ROUND(SUM(position_count), 6) AS position_count_sum, ROUND(AVG(position_count), 6) AS position_count_avg, ROUND(COALESCE(STDDEV_SAMP(position_count), 0), 6) AS position_count_stddev, ROUND(MAX(position_count), 6) AS position_count_max, ROUND(MIN(position_count), 6) AS position_count_min
                        FROM account_metrics_all
                        GROUP BY currency
                        ORDER BY currency</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout">120</stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="resultSetHandler">Store as Object</stringProp>
                <stringProp name="resultSetMaxRows">1000</stringProp>
                <stringProp name="resultVariable">db_custom_metrics_stat_rows</stringProp>
                <stringProp name="variableNames"></stringProp>
              </JDBCSampler>
              <hashTree/>
            </hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="自定义统计聚合：get_account_metrics_stat_ex" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
      import java.time.*
      import java.time.format.DateTimeFormatter
      import java.math.BigDecimal
      import java.math.RoundingMode
      
      String response = vars.get(&apos;custom_stat_api_response&apos;) ?: &apos;&apos;
      String shujuku = (vars.get(&apos;custom_stat_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
      String platform = (vars.get(&apos;custom_stat_platform&apos;) ?: &apos;&apos;).toUpperCase()
      String instanceId = vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: &apos;&apos;
      String loginIn = vars.get(&apos;login__in&apos;) ?: &apos;&apos;
      String groupBy = (vars.get(&apos;custom_stat_group_by&apos;) ?: &apos;currency&apos;).trim()
      boolean dbMode = shujuku == &apos;1&apos;
      String sourceName = dbMode ? &apos;DB/API&apos; : &apos;CSV/API&apos;
      String disabledRaw = dbMode ? [vars.get(&apos;custom_stat_mt4_db_api_disabled_fields&apos;), vars.get(&apos;custom_stat_mt5_db_api_disabled_fields&apos;)].findAll { it?.trim() }.join(&apos;,&apos;) : (vars.get(&apos;custom_stat_csv_api_disabled_fields&apos;) ?: &apos;&apos;)
      Set disabled = disabledRaw.split(&apos;,&apos;).collect { it.trim().toLowerCase() }.findAll { it }.toSet()
      boolean skipAll = disabled.contains(&apos;*&apos;)
      def disabledField = { String f -&gt; skipAll || disabled.contains((f ?: &apos;&apos;).toLowerCase()) }
      def raw = { Object v -&gt;
          if (v == null) return &apos;&lt;empty&gt;&apos;
          String s = v.toString().trim()
          if (s.length() == 0 || s.equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)) return &apos;&lt;empty&gt;&apos;
          if (v instanceof BigDecimal) return v.stripTrailingZeros().toPlainString()
          if (v instanceof BigInteger) return v.toString()
          if (v instanceof Number || s ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)[eE][-+]?\d+$/) {
              try { return new BigDecimal(s.replace(&apos;,&apos;, &apos;&apos;)).stripTrailingZeros().toPlainString() } catch (Throwable ignored) {}
          }
          return s
      }
      def normKey = { Object v -&gt; raw(v) == &apos;&lt;empty&gt;&apos; ? &apos;&apos; : raw(v).trim() }
      def lowerMap = { Map m -&gt; Map r = [:]; m.each { k,v -&gt; r[k.toString().toLowerCase()] = v }; r }
      def hasKey = { Map m, String f -&gt; m.containsKey((f ?: &apos;&apos;).toLowerCase()) }
      def valOf = { Map m, String f -&gt; m[(f ?: &apos;&apos;).toLowerCase()] }
      DateTimeFormatter fmt = DateTimeFormatter.ofPattern(&apos;yyyy-MM-dd HH:mm:ss&apos;)
      def renderValue = { String field, Object value, String source, boolean dbCompare -&gt;
          String s = raw(value)
          if (s == &apos;&lt;empty&gt;&apos;) return [print:s, compare:&apos;&apos;]
          String lf = (field ?: &apos;&apos;).toLowerCase()
          boolean maybeTime = lf.contains(&apos;time&apos;) || lf.endsWith(&apos;_utc_ms&apos;) || lf.contains(&apos;updated&apos;)
          if (!maybeTime) return [print:s, compare:s]
          try {
              LocalDateTime dt
              if (s ==~ /^-?\d+$/) {
                  long n = Long.parseLong(s)
                  Instant ins = Math.abs(n) &gt;= 100000000000L ? Instant.ofEpochMilli(n) : Instant.ofEpochSecond(n)
                  dt = LocalDateTime.ofInstant(ins, ZoneId.of(&apos;Asia/Shanghai&apos;))
              } else {
                  String t = s.replace(&apos;T&apos;,&apos; &apos;).replaceAll(/\.\d+$/, &apos;&apos;)
                  dt = LocalDateTime.parse(t.length() &gt;= 19 ? t.substring(0,19) : t, fmt)
              }
              String display = dt.format(fmt)
              LocalDateTime cmp = (source == &apos;API&apos; &amp;&amp; dbCompare) ? dt.minusHours(8) : dt
              return [print: s + &apos; -&gt; &apos; + display + ((source == &apos;API&apos; &amp;&amp; dbCompare) ? &apos; -&gt; DB_COMPARE=&apos; + cmp.format(fmt) : &apos;&apos;), compare: cmp.format(fmt)]
          } catch (Throwable ignored) { return [print:s, compare:s] }
      }
      def asNum = { Object v -&gt;
          if (v == null) return null
          String s = raw(v).trim().replace(&apos;,&apos;, &apos;&apos;)
          if (s == &apos;&lt;empty&gt;&apos;) return null
          if (!(s ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) return null
          new BigDecimal(s)
      }
      def fmtNum = { BigDecimal n -&gt; n == null ? &apos;&lt;empty&gt;&apos; : n.stripTrailingZeros().toPlainString() }
      def pctText = { BigDecimal p -&gt; p == null ? &apos;N/A&apos; : p.setScale(6, RoundingMode.HALF_UP).stripTrailingZeros().toPlainString() + &apos;%&apos; }
      def compareValue = { String field, Object expected, Object actual, String expectedSource, boolean dbCompare -&gt;
          def er = renderValue(field, expected, expectedSource, dbCompare)
          def ar = renderValue(field, actual, &apos;API&apos;, dbCompare)
          BigDecimal en = asNum(er.compare)
          BigDecimal an = asNum(ar.compare)
          if (en != null &amp;&amp; an != null) {
              BigDecimal diff = en.subtract(an).abs()
              BigDecimal base = en.abs()
              BigDecimal allowed = base.multiply(new BigDecimal(&apos;0.05&apos;))
              if (allowed.compareTo(new BigDecimal(&apos;0.000001&apos;)) &lt; 0) allowed = new BigDecimal(&apos;0.000001&apos;)
              boolean same = diff.compareTo(allowed) &lt;= 0
              String denomName = expectedSource
              String pct
              String formula
              if (base.compareTo(BigDecimal.ZERO) == 0) {
                  pct = diff.compareTo(BigDecimal.ZERO) == 0 ? &apos;0%&apos; : &apos;N/A(DB=0无法作分母)&apos;
                  formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + denomName + &apos;(&apos; + fmtNum(en) + &apos;))=&apos; + fmtNum(diff) + &apos;，&apos; + denomName + &apos;=0，无法按&apos; + denomName + &apos;作分母计算百分比&apos;
              } else {
                  BigDecimal percent = diff.multiply(new BigDecimal(&apos;100&apos;)).divide(base, 10, RoundingMode.HALF_UP)
                  pct = pctText(percent)
                  formula = &apos;abs(API(&apos; + fmtNum(an) + &apos;) - &apos; + denomName + &apos;(&apos; + fmtNum(en) + &apos;)) / abs(&apos; + denomName + &apos;(&apos; + fmtNum(en) + &apos;)) * 100 = &apos; + pct
              }
              return [same:same, er:er, ar:ar, numeric:true, diff:fmtNum(diff), allowed:fmtNum(allowed), percent:pct, formula:formula]
          }
          boolean same = er.compare.toString().trim() == ar.compare.toString().trim()
          [same:same, er:er, ar:ar, numeric:false, diff:&apos;N/A&apos;, allowed:&apos;N/A&apos;, percent:&apos;N/A(非数值字段)&apos;, formula:&apos;非数值字段不计算百分比，字符串按格式化后的普通文本比较&apos;]
      }
      def flattenGroup = { Object obj -&gt;
          Map g = obj instanceof Map ? obj as Map : [:]
          Map out = [:]
          g.each { k, v -&gt;
              String key = k.toString()
              if (key == &apos;stat&apos; &amp;&amp; v instanceof Map) {
                  v.each { metric, aggMap -&gt; if (aggMap instanceof Map) aggMap.each { agg, av -&gt; out[metric.toString() + &apos;_&apos; + agg.toString()] = av } }
              } else if (!(v instanceof Map) &amp;&amp; !(v instanceof List)) out[key] = v
          }
          out
      }
      List okLines = []; List failLines = []; List skipLines = []; int apiFieldTotal = 0
      try {
          def parsed = new JsonSlurper().parseText(response ?: &apos;{}&apos;)
          def data = parsed instanceof Map ? parsed.data : null
          List groups = []
          if (data instanceof Map &amp;&amp; data.groups instanceof List) groups = data.groups
          else if (parsed instanceof Map &amp;&amp; parsed.groups instanceof List) groups = parsed.groups
          else if (data instanceof List) groups = data
          else if (data instanceof Map) groups = [data]
          if (!groups) throw new AssertionError(&apos;接口响应未提取到groups/data数据 | login__in=&apos; + loginIn)
          List apiMaps = groups.collect { flattenGroup(it) }
          apiFieldTotal = apiMaps.sum { it.size() } ?: 0
          List expectedRows = []
          if (dbMode) {
              def dbObj = vars.getObject(&apos;db_custom_metrics_stat_rows&apos;)
              if (dbObj instanceof List) expectedRows = dbObj.findAll { it instanceof Map }.collect { lowerMap(it as Map) }
              else if (dbObj instanceof Object[]) expectedRows = dbObj.findAll { it instanceof Map }.collect { lowerMap(it as Map) }
              if (!expectedRows) throw new AssertionError(&apos;数据库未查询到账户统计聚合数据 | MT4_login=&apos; + vars.get(&apos;MT4_login&apos;) + &apos; | MT5_login=&apos; + vars.get(&apos;MT5_login&apos;))
          } else {
              expectedRows = [[:]]
              String csvGroupVal = groupBy ? normKey(vars.get(groupBy)) : &apos;&apos;
              if (groupBy &amp;&amp; csvGroupVal) {
                  apiMaps = apiMaps.findAll { api -&gt; normKey(api[groupBy]) == csvGroupVal }
                  if (!apiMaps) throw new AssertionError(&apos;CSV分组值在API响应中未匹配到 | group_by=&apos; + groupBy + &apos; | CSV=&apos; + raw(vars.get(groupBy)) + &apos; | API=&apos; + groups.collect { raw(flattenGroup(it)[groupBy]) }.join(&apos;,&apos;))
              }
          }
          apiMaps.each { api -&gt;
              String apiGroupVal = groupBy ? normKey(api[groupBy]) : &apos;&apos;
              Map expected = dbMode ? expectedRows.find { normKey(it[groupBy.toLowerCase()]) == apiGroupVal } : [:]
              if (dbMode &amp;&amp; expected == null) { failLines &lt;&lt; &quot; - [失败] group=${apiGroupVal} | 接口和数据库数据记录没有匹配上 | group_by=${groupBy}&quot;; return }
              api.each { k, apiVal -&gt;
                  String field = k.toString()
                  if (disabledField(field)) {
                      Object srcVal = dbMode ? (hasKey(expected, field) ? valOf(expected, field) : null) : vars.get(field)
                      def sr = renderValue(field, srcVal, dbMode ? &apos;DB&apos; : &apos;CSV&apos;, dbMode)
                      def ar = renderValue(field, apiVal, &apos;API&apos;, dbMode)
                      skipLines &lt;&lt; &quot; - [跳过] group=${apiGroupVal} | field=${field} | ${dbMode ? &apos;DB&apos; : &apos;CSV&apos;}=${sr.print} | API=${ar.print} | ${dbMode ? &apos;DBField&apos; : &apos;CSVField&apos;}=${field} | reason=disabled_compare_fields&quot;
                      return
                  }
                  if (dbMode) {
                      if (!hasKey(expected, field)) { def ar = renderValue(field, apiVal, &apos;API&apos;, true); skipLines &lt;&lt; &quot; - [跳过] group=${apiGroupVal} | field=${field} | DB=&lt;empty&gt; 数据库查询无此字段数据 | API=${ar.print} | DBField=${field}&quot;; return }
                      Object dbVal = valOf(expected, field)
                      def cr = compareValue(field, dbVal, apiVal, &apos;DB&apos;, true)
                      String line = &quot;group=${apiGroupVal} | field=${field} | API=${cr.ar.print} | DB=${cr.er.print} | DBField=${field} | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula} | 允许误差&lt;=5%(允许差值=${cr.allowed})&quot;
                      if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
                  } else {
                      String csvVal = vars.get(field)
                      if (csvVal == null || csvVal.trim().length() == 0 || csvVal.trim().equalsIgnoreCase(&apos;&lt;EOF&gt;&apos;)) { def ar = renderValue(field, apiVal, &apos;API&apos;, false); skipLines &lt;&lt; &quot; - [跳过] group=${apiGroupVal} | field=${field} | CSV=&lt;empty&gt; CSV value is empty | API=${ar.print} | CSVField=${field}&quot;; return }
                      def cr = compareValue(field, csvVal, apiVal, &apos;CSV&apos;, false)
                      String line = &quot;group=${apiGroupVal} | field=${field} | API=${cr.ar.print} | CSV=${cr.er.print} | CSVField=${field}&quot;
                      if (cr.numeric) line += &quot; | 差值=${cr.diff} | 相差百分比=${cr.percent} | 计算过程=${cr.formula} | 允许误差&lt;=5%(允许差值=${cr.allowed})&quot;
                      if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
                  }
              }
          }
      } catch (Throwable e) { failLines &lt;&lt; &apos; - [失败] &apos; + e.message }
      String status = failLines.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;
      List report = []
      report &lt;&lt; &quot;Assertion message: 自定义统计聚合 ${sourceName} 对比结果 | status=${status} | case=${vars.get(&apos;custom_stat_case_index&apos;)}/${vars.get(&apos;custom_stat_case_total&apos;)} | mode=${vars.get(&apos;custom_stat_case_mode&apos;)} | CSV行=${vars.get(&apos;custom_stat_csv_line_no&apos;)} | shujuku=${shujuku} | instanceid=${instanceId} | login__in=${loginIn} | group_by=${groupBy} | MT4_login=${vars.get(&apos;MT4_login&apos;)} | MT5_login=${vars.get(&apos;MT5_login&apos;)} | disabledFields=[${disabledRaw}] | tolerance=5% | percentBase=${dbMode ? &apos;DB&apos; : &apos;CSV&apos;}&quot;
      report &lt;&lt; &quot;接口字段总数=${apiFieldTotal} | 成功数=${okLines.size()} | 失败数=${failLines.size()} | 跳过数=${skipLines.size()}&quot;
      report &lt;&lt; &apos;&apos;; report &lt;&lt; &quot;成功明细(${okLines.size()}条)&quot;; report.addAll(okLines ? okLines : [&apos; - 无&apos;])
      report &lt;&lt; &apos;&apos;; report &lt;&lt; &quot;失败明细(${failLines.size()}条)&quot;; report.addAll(failLines ? failLines : [&apos; - 无&apos;])
      report &lt;&lt; &apos;&apos;; report &lt;&lt; &quot;跳过字段明细(${skipLines.size()}条)&quot;; report.addAll(skipLines ? skipLines : [&apos; - 无&apos;])
      String finalReport = report.join(&apos;\n&apos;)
      vars.put(&apos;custom_stat_compare_report&apos;, finalReport)
      SampleResult.setSuccessful(failLines.isEmpty())
      SampleResult.setResponseCode(failLines.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
      SampleResult.setResponseMessage(failLines.isEmpty() ? &apos;compare passed&apos; : &apos;compare failed&apos;)
      SampleResult.setDataType(&apos;text&apos;)
      SampleResult.setContentType(&apos;text/plain; charset=UTF-8&apos;)
      SampleResult.setResponseData(finalReport, &apos;UTF-8&apos;)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">自定义统计聚合001校验：shujuku=1时聚合CSV内所有MT4/MT5登录号后DB/API对比，shujuku=0时当前行CSV/API对比；数值允许5%误差；支持字段跳过配置。</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="12获取持仓订单get_position_info -20260612-验证成功✅✅" enabled="true">
        <stringProp name="TestPlan.comments">get_position_info：按CSV数据行数循环；shujuku=1时DB/API按订单号匹配后逐字段对比，shujuku=0时CSV/API按订单号匹配后逐字段对比。只改本线程组。

*** 备注：
RateMargin ：不是bug, 于订单无关系 MT5 账号
需要确认：20260618*****
 [不同] | 订单号=71042 | field=reason | DB=2 | API=0 | DB字段=reason/Reason/REASON | compare=number tolerance=0.00000001
*******</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="get_position_info数据库校验循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;获取持仓订单get_position_info-数据库校验.csv&apos;); if (!f.exists()) { return 0 }; def rows = f.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }; rows.size() &lt;= 1 ? 0 : rows.size() - 1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="12获取持仓订单get_position_info事务" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置-get_position_info数据库校验" enabled="true">
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">./获取持仓订单get_position_info-数据库校验.csv</stringProp>
            <boolProp name="ignoreFirstLine">false</boolProp>
            <boolProp name="quotedData">true</boolProp>
            <boolProp name="recycle">false</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">true</boolProp>
            <stringProp name="variableNames"></stringProp>
          </CSVDataSet>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="get_position_info MT4-DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="position_info_mt4_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">position_info_mt4_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">close_price,open_price,profit,margin_rate,_calc_profit_mode,_calc_raw_profit,_calc_bid</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制MT4数据库与API字段对比的跳过字段，不影响CSV/API；多个字段用逗号分隔；填 * 表示只校验订单号匹配。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">current_price</stringProp>
          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="get_position_info MT5-DB/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="position_info_mt5_db_query_timeout_seconds" elementType="Argument">
                <stringProp name="Argument.name">position_info_mt5_db_query_timeout_seconds</stringProp>
                <stringProp name="Argument.value">120</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">MT5 get_position_info JDBC查询超时秒数，可手动调整，默认120秒；请填写正整数。</stringProp>
              </elementProp>
              <elementProp name="position_info_mt5_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">position_info_mt5_disabled_compare_fields</stringProp>
