                  <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

vars.put(&quot;resp_balance&quot;, json.data.balance?.toString() ?: &quot;&quot;)
vars.put(&quot;resp_credit&quot;, json.data.credit?.toString() ?: &quot;&quot;)

log.info(&quot;&gt;&gt;&gt; 提取响应字段：resp_balance=[&quot; + vars.get(&quot;resp_balance&quot;) + &quot;] resp_credit=[&quot; + vars.get(&quot;resp_credit&quot;) + &quot;]&quot;)</stringProp>
