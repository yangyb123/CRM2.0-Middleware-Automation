            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取历史 ${instanceid_val} ${login_val} " enabled="true">
              <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
