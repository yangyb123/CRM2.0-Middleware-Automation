          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;获取持仓订单-数据库校验.csv&apos;); if (!f.exists()) { return 0 }; def rows = f.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }; rows.size() &lt;= 1 ? 0 : rows.size() - 1)}</stringProp>
