            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言-rights校验" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult

def text = { Object v -&gt;
    if (v == null) return &quot;&quot;
    String s = String.valueOf(v).trim()
    return s == &quot;null&quot; ? &quot;&quot; : s
}

String changedRights = text(vars.get(&quot;rights&quot;))
String expectedRights = text(vars.get(&quot;duanyan&quot;))
String actualRights = text(vars.get(&quot;rightsAAAcc&quot;))
String instanceId = text(vars.get(&quot;instanceid&quot;))
String login = text(vars.get(&quot;login&quot;))

if (!actualRights || actualRights == &quot;NOT_FOUND&quot;) {
    try {
        def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
        def data = json instanceof Map ? json.data : null
        def row = data instanceof List ? (data ? data[0] : null) : data
        def extracted = null
        if (row instanceof Map) {
            extracted = row.Rights != null ? row.Rights : row.rights
        }
        if (extracted == null &amp;&amp; json instanceof Map) {
            extracted = json.Rights != null ? json.Rights : json.rights
        }
        actualRights = text(extracted)
        if (actualRights) {
            vars.put(&quot;rightsAAAcc&quot;, actualRights)
            vars.put(&quot;rightsAABB&quot;, actualRights)
        }
    } catch (Throwable e) {
        log.warn(&quot;modify_user_info rights JSON解析失败: &quot; + e.message, e)
    }
}

String actualPrint = actualRights ?: &quot;NOT_FOUND&quot;
if (actualRights &amp;&amp; actualRights != &quot;NOT_FOUND&quot;) {
    vars.put(&quot;rightsAAAcc&quot;, actualRights)
    vars.put(&quot;rightsAABB&quot;, actualRights)
}
String resultText = &quot;modify_user_info 修改权限成 rights：${changedRights}  预期结果结果：get_user_info 响应信息rights：${expectedRights}  实际结果： get_user_info 响应信息rights：${actualPrint}&quot;
String contextText = &quot;instanceid=${instanceId} | login=${login}&quot;
boolean pass = actualRights &amp;&amp; actualRights != &quot;NOT_FOUND&quot; &amp;&amp; actualRights == expectedRights
String statusText = pass ? &quot;对比成功&quot; : &quot;对比失败&quot;
String report = statusText + &quot; | &quot; + resultText + &quot; | &quot; + contextText
vars.put(&quot;modify_user_info_rights_status&quot;, statusText)
vars.put(&quot;modify_user_info_rights_report&quot;, report)

try {
    SampleResult detail = new SampleResult()
    detail.setSampleLabel(&quot;modify_user_info rights对比结果&quot;)
    detail.setDataType(SampleResult.TEXT)
    detail.sampleStart()
    detail.setSuccessful(pass)
    detail.setResponseCode(pass ? &quot;200&quot; : &quot;500&quot;)
    detail.setResponseMessage(statusText)
    detail.setResponseHeaders(&quot;Content-Type: text/plain; charset=UTF-8&quot;)
    detail.setResponseData(report, &quot;UTF-8&quot;)
    detail.sampleEnd()
    prev.addSubResult(detail)
} catch (Throwable e) {
    log.warn(&quot;添加 modify_user_info rights对比明细失败: &quot; + e.message, e)
}

if (pass) {
    log.info(report)
    AssertionResult.setFailure(false)
} else {
    log.warn(report)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(report)
}</stringProp>
            </JSR223Assertion>
